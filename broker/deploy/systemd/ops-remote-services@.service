[Unit]
Description=Read-only SSH system state for reviewed Ops resource %i
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/ops-runbooks/remote-services-worker %i
TimeoutStartSec=80
KillMode=control-group
UMask=0077
ProtectSystem=strict
ReadWritePaths=/run/ops-remote-services
RuntimeDirectory=ops-remote-services
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryMax=128M
TasksMax=32
LimitFSIZE=128K
StandardOutput=null
StandardError=null
