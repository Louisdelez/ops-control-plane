#!/usr/bin/python3
"""Inspect the one-shot bootstrap deployment status."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
from typing import Any


UNITS: dict[str, str] = {}
LOCAL_INFERENCE_UNITS = ("ollama.service",)
RESULT = Path("/var/lib/ops-control-plane-deployment/last-result.json")
MAX_RESULT_BYTES = 16 * 1024
SAFE_TEXT = re.compile(r"\A[a-z0-9][a-z0-9._-]{0,127}\Z")


def _active(unit: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return completed.returncode == 0


def _enabled(unit: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "is-enabled", "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return completed.returncode == 0


def _loaded(unit: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return completed.returncode == 0 and completed.stdout.strip() not in {b"", b"not-found"}


def _local_inference_status() -> str:
    if any(_active(unit) for unit in LOCAL_INFERENCE_UNITS):
        return "active"
    if any(_enabled(unit) for unit in LOCAL_INFERENCE_UNITS):
        return "enabled"
    if any(_loaded(unit) for unit in LOCAL_INFERENCE_UNITS):
        return "disabled"
    return "absent"


def _safe_result() -> dict[str, Any] | None:
    try:
        metadata = os.lstat(RESULT)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) & 0o077
            or metadata.st_size > MAX_RESULT_BYTES
        ):
            return None
        descriptor = os.open(RESULT, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            raw = os.read(descriptor, MAX_RESULT_BYTES + 1)
        finally:
            os.close(descriptor)
        if len(raw) > MAX_RESULT_BYTES:
            return None
        document = json.loads(raw)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(document, dict):
        return None
    allowed = {
        "schema_version",
        "operation",
        "ok",
        "finished_at",
        "status",
        "release_id",
        "transaction_id",
        "error",
        "local_inference",
    }
    if set(document) - allowed:
        return None
    if document.get("schema_version") != 1 or not isinstance(document.get("ok"), bool):
        return None
    for key in (
        "operation",
        "status",
        "release_id",
        "transaction_id",
        "error",
        "local_inference",
    ):
        value = document.get(key)
        if value is not None and (not isinstance(value, str) or not SAFE_TEXT.fullmatch(value)):
            return None
    finished = document.get("finished_at")
    if isinstance(finished, bool) or not isinstance(finished, int) or finished < 0:
        return None
    return document


def status() -> int:
    active = [unit for unit in UNITS.values() if _active(unit)]
    payload: dict[str, Any] = {
        "ok": True,
        "status": "running" if active else "idle",
        "active_unit": active[0] if len(active) == 1 else None,
        "last_result": _safe_result(),
        "local_inference": _local_inference_status(),
    }
    if len(active) > 1:
        payload = {"ok": False, "status": "invalid-concurrent-workers"}
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    return 0 if payload["ok"] else 1


def queue(operation: str) -> int:
    active = [unit for unit in UNITS.values() if _active(unit)]
    if active:
        print(
            json.dumps(
                {"ok": True, "status": "already-running", "active_unit": active[0]},
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 0
    unit = UNITS[operation]
    completed = subprocess.run(
        ["/usr/bin/systemctl", "start", "--no-block", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=20,
    )
    if completed.returncode != 0:
        print('{"error":"queue_failed","ok":false,"status":"failed"}')
        return 1
    print(
        json.dumps(
            {"ok": True, "operation": operation, "status": "queued", "unit": unit},
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if len(arguments) != 1 or arguments[0] != "status":
        print('{"error":"operation_not_allowed","ok":false}', file=sys.stderr)
        return 64
    if os.geteuid() != 0:
        print('{"error":"root_required","ok":false}', file=sys.stderr)
        return 77
    if arguments[0] == "status":
        return status()
    return status()


if __name__ == "__main__":
    raise SystemExit(main())
