#!/usr/bin/python3 -I
"""Broker entry: start only the reviewed observation unit, return its fresh result."""
import runpy,fcntl,json,os,stat,subprocess,sys,time
from pathlib import Path
RESOURCES={'edge-vps','prod','nas','gamebox'}
DIRECTORY=Path('/run/ops-remote-services')
def validated(path,resource,started):
 fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC)
 try:
  metadata=os.fstat(fd)
  if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid!=0 or metadata.st_mode&0o022 or metadata.st_size>65536:raise ValueError()
  value=json.loads(os.read(fd,65537))
 finally:os.close(fd)
 if value.get('resource')!=resource or not started<=value.get('checked_at',0)<=time.time():raise ValueError()
 status=value.get('status')
 if status=='observed':
  if set(value)!={'resource','checked_at','status','metadata'}:raise ValueError()
  runpy.run_path('/usr/local/libexec/ops-runbooks/remote-services-worker')['validate_metadata'](value['metadata'])
 elif status=='unavailable':
  reasons={'timeout','ssh_or_remote_check_failed','host_key_unverified','authentication_failed','network_unreachable','connection_refused','name_resolution_failed'}
  allowed={'resource','checked_at','status','reason'}
  if 'alternate_reason' in value:
   if resource not in {'gamebox','prod'} or value['alternate_reason'] not in reasons:raise ValueError()
   allowed.add('alternate_reason')
  if set(value)!=allowed or value['reason'] not in reasons:raise ValueError()
 else:raise ValueError()
 return value
def main():
 if os.geteuid()!=0 or len(sys.argv)!=2 or sys.argv[1] not in RESOURCES:raise ValueError()
 resource=sys.argv[1]
 fd=os.open('/run/lock/ops-remote-services-'+resource+'.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
 with os.fdopen(fd,'w') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  started=time.time()
  subprocess.run(['/usr/bin/systemctl','start','ops-remote-services@'+resource+'.service'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=True,timeout=85,env={'PATH':'/usr/bin:/bin','LANG':'C'})
  print(json.dumps(validated(DIRECTORY/(resource+'.json'),resource,started)))
if __name__=='__main__':
 try:main()
 except Exception:print('{"status":"unavailable","reason":"local_observation_failed"}');raise SystemExit(1)
