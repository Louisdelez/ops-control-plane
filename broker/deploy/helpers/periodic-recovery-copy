#!/usr/bin/python3 -I
"""Copy the latest verified ciphertext; activation is a separate Class C action."""
from pathlib import Path
import hashlib,json,os,re,resource,runpy,shlex,stat,subprocess,sys,tarfile,tempfile,time
ROOT=Path('/var/lib/ops-recovery-bundles')

def main():
 if os.geteuid()!=0 or len(sys.argv)!=2 or sys.argv[1] not in {'nas','edge-vps'}:raise ValueError()
 target=sys.argv[1]
 marker=Path('/var/lib/ops-periodic-recovery')/(target+'.enabled.json')
 meta=marker.lstat()
 if not stat.S_ISREG(meta.st_mode) or meta.st_uid!=0 or meta.st_mode&0o077:raise ValueError()
 activation=json.loads(marker.read_text())
 if activation.get('resource')!=target or activation.get('schema_version')!=1:raise ValueError()
 for name in ('periodic-recovery-copy','receive-recovery-bundle.py'):
  if hashlib.sha256((Path('/usr/local/libexec/ops-runbooks')/name).read_bytes()).hexdigest()!=activation.get('pinned',{}).get(name):raise ValueError()
 manifest=json.loads((ROOT/'latest.json').read_text())
 name=manifest.get('bundle','')
 if not re.fullmatch(r'[0-9]{8}T[0-9]{6}\.[0-9]{6}Z\.tar\.age',name):raise ValueError()
 if not 0<=time.time()-manifest['created_at']<=30*3600:raise ValueError()
 path=ROOT/name;meta=path.lstat()
 if not stat.S_ISREG(meta.st_mode) or meta.st_uid!=0 or meta.st_mode&0o077 or not 0<meta.st_size<=256*1024*1024:raise ValueError()
 with path.open('rb') as f:digest=hashlib.file_digest(f,'sha256').hexdigest()
 if digest!=manifest['sha256'] or meta.st_size!=manifest['bytes'] or not manifest.get('decryption_verified') or manifest.get('private_identity_included') is not False:raise ValueError()
 with tempfile.TemporaryFile() as packed:
  with tarfile.open(fileobj=packed,mode='w') as archive:
   archive.add(path,arcname='bundle.tar.age',recursive=False)
   import io
   data=json.dumps(manifest).encode();info=tarfile.TarInfo('manifest.json');info.size=len(data);info.mode=0o600
   archive.addfile(info,io.BytesIO(data))
  packed.seek(0)
  script=Path('/usr/local/libexec/ops-runbooks/receive-recovery-bundle.py').read_text()
  command=runpy.run_path('/usr/local/libexec/ops-runbooks/remote-preflight-worker')['command'](target)
  command[-1]='/usr/bin/python3 -I -c '+shlex.quote(script)
  with tempfile.TemporaryFile() as output,tempfile.TemporaryFile() as errors:
   result=subprocess.run(command,stdin=packed,stdout=output,stderr=errors,timeout=240,
      preexec_fn=lambda:resource.setrlimit(resource.RLIMIT_FSIZE,(65536,65536)))
   output.seek(0);raw=output.read(4097)
  if result.returncode or len(raw)>4096:raise ValueError()
  receipt=json.loads(raw)
  expected={'status':'copied_and_verified','sha256':digest,'bytes':meta.st_size,'relative_directory':'ops-encrypted-backups/dell-daily-'+digest}
  if receipt!=expected:raise ValueError()
  receipt.update(resource=target,checked_at=time.time())
  folder=marker.parent
  (folder/(target+'-'+digest+'.json')).write_text(json.dumps(receipt)+'\n')
  next_path=folder/(target+'.latest.next');next_path.write_text(json.dumps(receipt)+'\n');next_path.replace(folder/(target+'.latest.json'))
  print(json.dumps(receipt))

if __name__=='__main__':
 os.umask(0o077)
 try:main()
 except Exception:raise SystemExit('Periodic recovery copy failed; existing remote backups preserved') from None
