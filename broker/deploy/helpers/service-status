#!/usr/bin/python3
"""Read a fixed set of systemd properties for one allowlisted unit."""

from __future__ import annotations

import json
import subprocess
import sys


ALLOWED_UNITS = frozenset(
    {
        "openbao.service",
        "ollama.service",
        "ops-broker.service",
        "hermes-gateway.service",
    }
)
PROPERTIES = (
    "Id",
    "LoadState",
    "ActiveState",
    "SubState",
    "UnitFileState",
    "Result",
    "NRestarts",
)
ENVIRONMENT = {"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ALLOWED_UNITS:
        print('{"error":"unit_not_allowed"}')
        return 64
    unit = sys.argv[1]
    completed = subprocess.run(
        [
            "/usr/bin/systemctl",
            "show",
            "--no-pager",
            f"--property={','.join(PROPERTIES)}",
            unit,
        ],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=5,
        check=False,
        env=ENVIRONMENT,
    )
    if completed.returncode != 0:
        print(json.dumps({"error": "systemctl_failed", "unit": unit}, sort_keys=True))
        return 1
    values = {}
    for line in completed.stdout.splitlines():
        name, separator, value = line.partition("=")
        if separator and name in PROPERTIES:
            values[name] = value[:512]
    print(json.dumps({"properties": values, "unit": unit}, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, subprocess.SubprocessError):
        print('{"error":"status_collection_failed"}')
        raise SystemExit(1) from None
