#!/usr/bin/python3 -I
"""Read one fixed remote systemd state through the owner's native SSH account."""
import re,shlex,json,os,signal,subprocess,sys,tempfile,time
from pathlib import Path
ALIASES={'edge-vps':'vps','prod':'prod','nas':'nas','gamebox':'gamebox'}
STATES={'initializing','starting','running','degraded','maintenance','stopping','offline','unknown'}
DIRECTORY=Path('/run/ops-remote-services')
COLLECTOR='import json,subprocess,re\nsafe=re.compile(r"^(?:[A-Za-z0-9_.@:/+%=-]|\\\\x[0-9A-Fa-f]{2}){1,256}$")\ndef read(args):\n try:\n  r=subprocess.run(args,stdin=subprocess.DEVNULL,capture_output=True,timeout=5,env={\'PATH\':\'/usr/bin:/bin\',\'LANG\':\'C\'})\n  if r.returncode:return {\'status\':\'unavailable\'}\n  lines=r.stdout.decode(\'utf-8\',\'strict\').splitlines()\n  if len(lines)>256:return {\'status\':\'too_many_entries\'}\n  rows=[line.split() for line in lines]\n  if any(not safe.fullmatch(cell) for row in rows for cell in row):return {\'status\':\'invalid_metadata\'}\n  return {\'status\':\'observed\',\'rows\':rows}\n except Exception:return {\'status\':\'unavailable\'}\nresult={\n \'hostname\':read([\'/usr/bin/hostname\']),\n \'containers\':read([\'/usr/bin/docker\',\'ps\',\'-a\',\'--format\',\'{{.Names}} {{.Image}} {{.State}}\']),\n \'filesystems\':read([\'/usr/bin/df\',\'--output=size,used,avail\',\'-k\',\'/\',\'/srv\']),\n}\n# Unit descriptions are not returned; names and finite state enums only.\ntry:\n r=subprocess.run([\'/usr/bin/systemctl\',\'list-units\',\'--type=service\',\'--all\',\'--plain\',\'--no-legend\',\'--no-pager\'],capture_output=True,timeout=5)\n rows=[line.split(None,4)[:4] for line in r.stdout.decode(\'utf-8\',\'strict\').splitlines() if line.strip()] if r.returncode==0 else None\n result[\'units\']={\'status\':\'observed\',\'rows\':rows} if rows is not None and len(rows)<=256 and all(len(row)==4 and all(safe.fullmatch(v) for v in row) for row in rows) else {\'status\':\'unavailable\'}\nexcept Exception:result[\'units\']={\'status\':\'unavailable\'}\nprint(json.dumps(result))\n'

def validate_metadata(value):
 if not isinstance(value,dict) or set(value)!={"hostname","units","containers","filesystems"}:raise ValueError()
 for entry in value.values():
  if not isinstance(entry,dict):raise ValueError()
  if entry.get("status") in {"unavailable","too_many_entries","invalid_metadata"} and set(entry)=={"status"}:continue
  if set(entry)!={"status","rows"} or entry["status"]!="observed" or not isinstance(entry["rows"],list) or len(entry["rows"])>256:raise ValueError()
  for row in entry["rows"]:
   if not isinstance(row,list) or len(row)>8 or not all(isinstance(cell,str) and re.fullmatch(r"(?:[A-Za-z0-9_.@:/+%=-]|\\x[0-9A-Fa-f]{2}){1,256}",cell) for cell in row):raise ValueError()
 return value

def command(resource,alternate=False):
 alias=ALIASES[resource]
 route=[]
 if alternate:
  if resource=='gamebox':alias='gamebox-remote'
  elif resource=='prod':
   route=['-J','vps','-o','HostName=198.51.100.4','-o','HostKeyAlias=192.0.2.65']
  else:raise ValueError('No reviewed alternate route')
 return ['/usr/sbin/runuser','-u','ops-user','--','/usr/bin/env','-i','HOME=/home/ops-user','USER=ops-user','LOGNAME=ops-user','PATH=/usr/bin:/bin','LANG=C',
 '/usr/bin/ssh','-T','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','ClearAllForwardings=yes',
 '-o','PermitLocalCommand=no','-o','RemoteCommand=none','-o','ConnectTimeout=8','-o','ConnectionAttempts=1',
 '-o','ServerAliveInterval=5','-o','ServerAliveCountMax=1',*route,alias,'/usr/bin/python3 -I -c '+shlex.quote(COLLECTOR)]
def failure_reason(raw):
 text=raw.lower()
 for markers,reason in [
  ((b'host key verification failed',b'remote host identification has changed'),'host_key_unverified'),
  ((b'permission denied',b'no supported authentication methods'),'authentication_failed'),
  ((b'no route to host',b'network is unreachable'),'network_unreachable'),
  ((b'connection refused',),'connection_refused'),
  ((b'connection timed out',b'operation timed out'),'timeout'),
  ((b'could not resolve hostname',),'name_resolution_failed')]:
  if any(marker in text for marker in markers):return reason
 return 'ssh_or_remote_check_failed'

def observe_route(resource,alternate=False):
 # Output is bounded on disk and never returned verbatim; no remote content is logged.
 with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
  process=subprocess.Popen(command(resource,alternate),stdin=subprocess.DEVNULL,stdout=output,stderr=errors,start_new_session=True)
  try:
   try:code=process.wait(timeout=35)
   except subprocess.TimeoutExpired:return {'status':'unavailable','reason':'timeout'}
   output.seek(0);raw=output.read(60001)
   if code==0 and len(raw)<=60000:
    try:return {'status':'observed','metadata':validate_metadata(json.loads(raw))}
    except (ValueError,TypeError):pass
   errors.seek(0)
   return {'status':'unavailable','reason':failure_reason(errors.read(8192))}
  finally:
   if process.poll() is None:
    try:os.killpg(process.pid,signal.SIGKILL)
    except ProcessLookupError:pass
    process.wait()
def observe(resource):
 result=observe_route(resource)
 if resource in {'gamebox','prod'} and result.get('reason') in {'network_unreachable','connection_refused','timeout'}:
  alternate=observe_route(resource,True)
  if alternate['status']=='observed':return alternate
  result['alternate_reason']=alternate['reason']
 return result

def main():
 if os.geteuid()!=0 or len(sys.argv)!=2 or sys.argv[1] not in ALIASES:raise SystemExit(2)
 resource=sys.argv[1];started=time.time()
 result={'resource':resource,'checked_at':started,**observe(resource)}
 DIRECTORY.mkdir(mode=0o755,exist_ok=True)
 fd,name=tempfile.mkstemp(prefix='.'+resource+'-',dir=DIRECTORY)
 try:
  with os.fdopen(fd,'w') as f:json.dump(result,f);f.write('\n');f.flush();os.fsync(f.fileno())
  os.chmod(name,0o644);os.replace(name,DIRECTORY/(resource+'.json'))
 finally:
  if os.path.exists(name):os.unlink(name)
if __name__=='__main__':main()
