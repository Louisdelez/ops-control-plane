#!/usr/bin/python3 -I
"""Class C: copy exactly the pinned encrypted seed to one reviewed SSH alias."""
import resource as limits
import hashlib,json,os,runpy,shlex,stat,subprocess,sys,tarfile,tempfile
from pathlib import Path
ROOT=Path('/usr/local/share/ops-native/recovery-seed')

def main():
 if os.geteuid()!=0 or len(sys.argv)!=2 or sys.argv[1] not in {'nas','edge-vps'}:raise ValueError()
 resource=sys.argv[1]
 manifest=json.loads((ROOT/'manifest.json').read_text())
 if set(manifest)!={'schema_version','files'} or manifest['schema_version']!=1:raise ValueError()
 if set(manifest['files'])!={'openbao-snapshot.age','unseal-shares.age','zulip-bundle.age'}:raise ValueError()
 with tempfile.TemporaryFile() as packed:
  with tarfile.open(fileobj=packed,mode='w') as bundle:
   for name,digest in sorted(manifest['files'].items()):
    path=ROOT/name;st=path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid!=0 or st.st_mode&0o022 or st.st_size>32*1024*1024:raise ValueError()
    data=path.read_bytes()
    if not data.startswith(b'age-encryption.org/v1\n') or hashlib.sha256(data).hexdigest()!=digest:raise ValueError()
    bundle.add(path,arcname=name,recursive=False)
  packed.seek(0)
  script=Path('/usr/local/libexec/ops-runbooks/receive-encrypted-seed.py').read_text()
  command=runpy.run_path('/usr/local/libexec/ops-runbooks/remote-preflight-worker')['command'](resource)
  command[-1]='/usr/bin/python3 -I -c '+shlex.quote(script)
  with tempfile.TemporaryFile() as output,tempfile.TemporaryFile() as errors:
   result=subprocess.run(command,stdin=packed,stdout=output,stderr=errors,timeout=100,preexec_fn=lambda:limits.setrlimit(limits.RLIMIT_FSIZE,(65536,65536)))
   output.seek(0);raw=output.read(4097)
  if result.returncode or len(raw)>4096:raise ValueError()
  receipt=json.loads(raw)
  identity=hashlib.sha256(json.dumps(manifest['files'],sort_keys=True).encode()).hexdigest()
  if receipt!={'status':'copied_and_verified','seed_id':identity,'relative_directory':'ops-encrypted-backups/dell-seed-'+identity,'sha256':manifest['files']}:raise ValueError()
  print(json.dumps({'resource':resource,**receipt,'private_key_copied':False,'full_restore_verified':False}))
if __name__=='__main__':
 try:main()
 except Exception:raise SystemExit('Encrypted seed transfer unavailable; inspect the recorded action before retrying') from None
