[Unit]
Description=Refresh reviewed provider balance snapshots through the local orchestrator
Documentation=file:/usr/share/doc/ops-orchestrator/orchestrator-v1.md
After=ops-orchestrator.service
Requires=ops-orchestrator.service
ConditionPathExists=/run/ops-orchestrator/api.sock

[Service]
Type=oneshot
User=ops-monitor
Group=opsorchestrator-api
ExecStart=/opt/ops-orchestrator/venv/bin/ops-orchestrator --socket /run/ops-orchestrator/api.sock refresh-finance --account all --project-id infra-shared
TimeoutStartSec=45
UMask=0077
StandardOutput=null
StandardError=journal

# This client can only ask the already-running daemon over its Unix socket.  It
# cannot read credential files or reach provider networks itself.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
LimitCORE=0
TasksMax=16
MemoryMax=64M
ReadOnlyPaths=/run/ops-orchestrator
