[Unit]
Description=Resolve the Ops memory Qdrant key from OpenBao
After=openbao-unseal.service
Requires=openbao-unseal.service
PartOf=openbao-unseal.service
Before=ops-memory-qdrant.service ops-memory.service ops-memory-maintenance.service
ConditionPathExists=/etc/credstore.encrypted/ops-memory-openbao-role-id
ConditionPathExists=/etc/credstore.encrypted/ops-memory-openbao-secret-id

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
RuntimeDirectory=ops-memory-secrets
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=ops-memory-openbao-role-id:/etc/credstore.encrypted/ops-memory-openbao-role-id
LoadCredentialEncrypted=ops-memory-openbao-secret-id:/etc/credstore.encrypted/ops-memory-openbao-secret-id
ExecStart=/opt/ops-memory/bin/ops-memory-openbao-resolve
ExecStop=/usr/bin/rm -f /run/ops-memory-secrets/qdrant-api-key
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/ops-memory-secrets
TimeoutStartSec=15s
TimeoutStopSec=5s
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
