[Unit]
Description=Unseal local OpenBao with TPM2-bound systemd credentials
Documentation=file:/etc/openbao.d/README.md
Requires=openbao.service
After=openbao.service
PartOf=openbao.service
Before=hermes-gateway.service ops-orchestrator.service ops-memory-secrets.service ops-memory.service
ConditionPathExists=/etc/credstore.encrypted/openbao-unseal-share-1
ConditionPathExists=/etc/credstore.encrypted/openbao-unseal-share-2

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/openbao-auto-unseal
RemainAfterExit=yes
TimeoutStartSec=90s

LoadCredentialEncrypted=openbao-unseal-share-1:/etc/credstore.encrypted/openbao-unseal-share-1
LoadCredentialEncrypted=openbao-unseal-share-2:/etc/credstore.encrypted/openbao-unseal-share-2

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
