[Unit]
Description=Build Dell Ops V1 short and detailed reports
After=ops-v1-observe.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/ops-v1 report --events /var/lib/ops-v1/audit/events.jsonl --checks /var/lib/ops-v1/checks/latest.json --output-dir /var/lib/ops-v1/reports --metrics-output /var/lib/node-exporter/textfile/ops-v1.prom
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/ops-v1/reports /var/lib/node-exporter/textfile
SystemCallArchitectures=native
