[Unit]
Description=Fail-closed local Ops semantic memory
After=local-fs.target ops-memory-secrets.service ops-memory-qdrant.service
Requires=ops-memory-secrets.service
Wants=ops-memory-qdrant.service
ConditionPathExists=/etc/ops-memory/memory.toml

[Service]
Type=notify
NotifyAccess=main
User=opsmemory
Group=ops-memory-api
SupplementaryGroups=opsmemory
UMask=0007
StateDirectory=ops-memory
StateDirectoryMode=0700
RuntimeDirectory=ops-memory
RuntimeDirectoryMode=0750
LoadCredential=qdrant-api-key:/run/ops-memory-secrets/qdrant-api-key
# Optional: missing named credentials are non-fatal while the providers remain disabled.
LoadCredentialEncrypted=embedding-api-token
LoadCredentialEncrypted=reranker-api-token
ExecStartPre=/opt/ops-memory/bin/ops-memory-openbao-preflight
ExecStart=/opt/ops-memory/bin/ops-memory serve --config /etc/ops-memory/memory.toml
Restart=on-failure
RestartSec=3s
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/ops-memory /run/ops-memory
LimitNOFILE=4096
TasksMax=128
MemoryMax=384M
OOMScoreAdjust=100

[Install]
WantedBy=multi-user.target
