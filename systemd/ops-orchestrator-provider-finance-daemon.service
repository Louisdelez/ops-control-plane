[Unit]
Description=Isolated reviewed provider-finance connector daemon
Documentation=file:/usr/share/doc/ops-orchestrator/orchestrator-v1.md
After=network-online.target openbao-unseal.service ops-orchestrator-secrets.service
Requires=ops-orchestrator-secrets.service
Wants=network-online.target
Before=ops-orchestrator.service
PartOf=ops-orchestrator.service
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-role-id
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-secret-id
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=opsfinance
Group=opsfinance
# The worker only needs read access to root:opsorchestrator configuration.
SupplementaryGroups=opsorchestrator
ExecStart=/opt/ops-orchestrator/venv/bin/ops-orchestrator-provider-financed --config /etc/ops-orchestrator/config.json
EnvironmentFile=-/etc/ops-orchestrator/orchestrator.env
# All finance credentials are optional at service start.  The daemon reports
# credential_unavailable and performs no provider request when a fallback wins.
LoadCredential=deepseek-api-key:/run/ops-orchestrator-secrets/current/deepseek-api-key
SetCredential=deepseek-api-key:\n
# Moonshot and StepFun keys are optional. Empty SetCredential fallbacks make a
# missing source non-fatal while `_read_secret` still rejects it as unavailable.
LoadCredential=moonshot-api-key:/run/ops-orchestrator-secrets/current/moonshot-api-key
SetCredential=moonshot-api-key:\n
LoadCredential=stepfun-api-key:/run/ops-orchestrator-secrets/current/stepfun-api-key
SetCredential=stepfun-api-key:\n
Environment=DEEPSEEK_API_KEY_FILE=%d/deepseek-api-key
Environment=MOONSHOT_API_KEY_FILE=%d/moonshot-api-key
Environment=STEPFUN_API_KEY_FILE=%d/stepfun-api-key
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=20
UMask=0077

RuntimeDirectory=ops-orchestrator-finance
RuntimeDirectoryMode=0750

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
LimitCORE=0
LimitNOFILE=256
TasksMax=24
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=0
OOMPolicy=stop

ReadOnlyPaths=/etc/ops-orchestrator
ReadWritePaths=/run/ops-orchestrator-finance
