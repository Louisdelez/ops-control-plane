[Unit]
Description=Resolve Ops orchestrator API keys from OpenBao
After=openbao-unseal.service
Requires=openbao-unseal.service
PartOf=openbao-unseal.service
Before=ops-orchestrator-provider-finance-daemon.service ops-orchestrator.service ops-orchestrator-hermes-facade.service
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-role-id
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-secret-id

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
RuntimeDirectory=ops-orchestrator-secrets
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=ops-orchestrator-openbao-role-id:/etc/credstore.encrypted/ops-orchestrator-openbao-role-id
LoadCredentialEncrypted=ops-orchestrator-openbao-secret-id:/etc/credstore.encrypted/ops-orchestrator-openbao-secret-id
ExecStart=/opt/ops-orchestrator/bin/ops-orchestrator-openbao-resolve
ExecStop=/opt/ops-orchestrator/bin/ops-orchestrator-openbao-resolve --clear
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/ops-orchestrator-secrets
TimeoutStartSec=15s
TimeoutStopSec=5s
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
