[Unit]
Description=Create an age-encrypted OpenBao Raft snapshot without plaintext persistence
Documentation=file:/usr/local/share/doc/ops-control-plane/runbooks/openbao-raft-backup.md
Requires=openbao-unseal.service
After=openbao-unseal.service
ConditionPathExists=/etc/openbao-backup/backup.toml
ConditionPathExists=/etc/openbao-backup/recovery.age-recipient
ConditionPathExists=/etc/credstore.encrypted/openbao-backup-role-id
ConditionPathExists=/etc/credstore.encrypted/openbao-backup-secret-id
OnSuccess=openbao-raft-backup-metric-success.service
OnFailure=openbao-raft-backup-metric-failure.service

[Service]
Type=oneshot
User=openbao-backup
Group=openbao-backup
UMask=0077
LoadCredentialEncrypted=openbao-backup-role-id:/etc/credstore.encrypted/openbao-backup-role-id
LoadCredentialEncrypted=openbao-backup-secret-id:/etc/credstore.encrypted/openbao-backup-secret-id
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/openbao-raft-backup/bin/openbao-raft-backup --config /etc/openbao-backup/backup.toml
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=127.0.0.1
ReadWritePaths=/var/backups/openbao
NoExecPaths=/var/backups/openbao
LimitNOFILE=128
TasksMax=32
MemoryMax=384M
