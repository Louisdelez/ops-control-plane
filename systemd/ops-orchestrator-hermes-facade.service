[Unit]
Description=Budgeted multi-provider API facade for Hermes
Documentation=file:/usr/share/doc/ops-orchestrator/orchestrator-v1.md
After=network-online.target ops-orchestrator-secrets.service ops-orchestrator.service
Requires=ops-orchestrator-secrets.service ops-orchestrator.service
Before=hermes-gateway.service
Wants=network-online.target
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-role-id
ConditionPathExists=/etc/credstore.encrypted/ops-orchestrator-openbao-secret-id
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=opsorchestrator
Group=opsorchestrator
ExecStart=/opt/ops-orchestrator/venv/bin/ops-orchestrator-hermes-facade --config /etc/ops-orchestrator/config.json --providers qwen-utility-api,alibaba-deepseek-ops-api,deepseek-ops-api --token-file %d/hermes-facade-token --host 127.0.0.1 --port 8643
EnvironmentFile=-/etc/ops-orchestrator/orchestrator.env
# The facade stays locally healthy with an empty provider pool.  Requests fail
# closed until Atlas provisions at least one provider key in OpenBao.
LoadCredential=qwen-api-key:/run/ops-orchestrator-secrets/current/qwen-api-key
SetCredential=qwen-api-key:\n
LoadCredential=deepseek-api-key:/run/ops-orchestrator-secrets/current/deepseek-api-key
SetCredential=deepseek-api-key:\n
LoadCredential=hermes-facade-token:/run/ops-orchestrator-secrets/current/hermes-facade-token
Environment=QWEN_API_KEY_FILE=%d/qwen-api-key
Environment=DEEPSEEK_API_KEY_FILE=%d/deepseek-api-key
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=20
UMask=0077

RuntimeDirectory=ops-orchestrator-hermes-facade
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
LimitCORE=0
LimitNOFILE=1024
TasksMax=64
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
OOMPolicy=stop

ReadOnlyPaths=/etc/ops-orchestrator
ReadWritePaths=/var/lib/ops-orchestrator
# The facade deliberately shares the Qwen/DeepSeek ledger trust domain with
# the main daemon, but its mount namespace cannot reach the finance socket.
InaccessiblePaths=/run/ops-orchestrator-finance

[Install]
WantedBy=multi-user.target
