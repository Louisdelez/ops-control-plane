[Unit]
Description=Dell Ops V1 deterministic read-only checks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ops-monitor
Group=ops-monitor
ExecStart=/usr/local/libexec/ops-v1 check --inventory /etc/ops-v1/inventory.json --probe --output /var/lib/ops-v1/checks/latest.json
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ops-v1/checks
SystemCallArchitectures=native
