[Unit]
Description=Generate the short deterministic Dell Ops daily report
After=prometheus.service node-exporter.service
Wants=prometheus.service node-exporter.service

[Service]
Type=oneshot
User=ops-monitor
Group=ops-readers
ExecStart=/usr/local/libexec/ops-daily-report
StateDirectory=ops-reports
StateDirectoryMode=0750
UMask=0027
LimitCORE=0
MemoryMax=96M
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/ops-reports

[Install]
WantedBy=multi-user.target
