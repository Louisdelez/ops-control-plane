[Unit]
Description=Deterministic thermal stop guard for Ollama
After=systemd-udev-settle.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/ops-thermal-guard
Restart=always
RestartSec=10s
RuntimeDirectory=ops-thermal-guard
RuntimeDirectoryMode=0750
Environment=OPS_THERMAL_STOP_C=90
Environment=OPS_THERMAL_INTERVAL_S=5
UMask=0027
LimitCORE=0
MemoryMax=64M
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/ops-thermal-guard

[Install]
WantedBy=multi-user.target
