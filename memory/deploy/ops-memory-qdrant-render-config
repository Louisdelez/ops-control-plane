#!/usr/bin/python3
"""Render a Qdrant config containing its API key only into systemd tmpfs."""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path


KEY_RE = re.compile(r"\A[A-Za-z0-9_-]{32,512}\Z")
EXPECTED_OUTPUT = Path("/run/ops-memory-qdrant/production.yaml")
EXPECTED_OUTPUT_OWNER = 0
MAX_TEMPLATE_BYTES = 65_536


def _read_regular(path: Path, maximum: int, *, private: bool) -> bytes:
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise RuntimeError("unsafe input")
    if private and info.st_mode & 0o077:
        raise RuntimeError("credential permissions are too broad")
    if not private and info.st_mode & 0o022:
        raise RuntimeError("template is writable by an untrusted group")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        if opened.st_dev != info.st_dev or opened.st_ino != info.st_ino:
            raise RuntimeError("input changed")
        value = os.read(descriptor, maximum + 1)
        if len(value) > maximum or os.read(descriptor, 1):
            raise RuntimeError("oversized input")
        return value
    finally:
        os.close(descriptor)


def render(template: Path, output: Path) -> None:
    credential_directory = os.environ.get("CREDENTIALS_DIRECTORY", "")
    if not credential_directory or not os.path.isabs(credential_directory):
        raise RuntimeError("credential directory unavailable")
    credential = Path(credential_directory) / "qdrant-api-key"
    key = _read_regular(credential, 512, private=True).rstrip(b"\r\n").decode("ascii", errors="strict")
    if not KEY_RE.fullmatch(key):
        raise RuntimeError("invalid credential")

    if output != EXPECTED_OUTPUT or output.parent.is_symlink():
        raise RuntimeError("unsafe output path")
    parent_info = output.parent.lstat()
    if (
        not stat.S_ISDIR(parent_info.st_mode)
        or parent_info.st_uid != EXPECTED_OUTPUT_OWNER
        or parent_info.st_mode & 0o022
    ):
        raise RuntimeError("unsafe output directory")
    text = _read_regular(template, MAX_TEMPLATE_BYTES, private=False).decode("utf-8", errors="strict")
    if re.search(r"(?m)^\s*api_key\s*:", text):
        raise RuntimeError("template already contains an API key")
    if text.count("\nservice:\n") != 1:
        raise RuntimeError("template service section is ambiguous")
    rendered = text.replace(
        "\nservice:\n",
        "\nservice:\n  api_key: " + json.dumps(key) + "\n",
        1,
    )
    key = ""
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".production.", dir=output.parent)
    try:
        os.fchmod(descriptor, 0o600)
        encoded = rendered.encode("utf-8")
        written = 0
        while written < len(encoded):
            written += os.write(descriptor, encoded[written:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary_name, output)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--template", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    try:
        render(args.template, args.output)
    except (OSError, RuntimeError, UnicodeError, ValueError):
        print("ops-memory: could not render protected Qdrant configuration", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
