{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ops",
  "version": "0.6.19",
  "identifier": "ch.ops-user.ops-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "home",
        "atlas",
        "terminals",
        "settings"
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
