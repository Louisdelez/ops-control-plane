[Unit]
Description=Read-only approval state projection
After=ops-broker.socket ops-native-approval.service
[Service]
User=root
Group=opsapprovals
ExecStart=/usr/bin/python3 /opt/ops-approvals/export_state.py
RuntimeDirectory=ops-approvals
RuntimeDirectoryMode=0750
UMask=0027
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/root /run/ops-native-approval /etc/ops-native /var/lib/openbao
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
MemoryMax=64M
LimitCORE=0
[Install]
WantedBy=multi-user.target
