class BootstrapError(RuntimeError):
    def __init__(self, code: str, message: str, *, phase: str | None = None) -> None:
        super().__init__(message)
        self.code = code
        self.phase = phase


def _bounded_failure_identifier(value: Any, fallback: str) -> str:
    """Return only a small protocol-safe identifier, never exception text."""

    if (
        isinstance(value, str)
        and len(value) <= 64
        and re.fullmatch(r"[a-z][a-z0-9_-]*", value) is not None
    ):
        return value
    return fallback


def _bootstrap_failure_diagnostic(
    failure: BaseException, transaction: dict[str, Any]
) -> tuple[str, str]:
    """Extract the two non-secret fields safe for audit and the GUI."""

    try:
        raw_code = failure.code  # type: ignore[attr-defined]
    except BaseException:
        raw_code = None
    code = _bounded_failure_identifier(raw_code, "bootstrap_failed")
    phase = _bounded_failure_identifier(
        transaction.get("phase"), "bootstrap-running"
    )
    return code, phase


class _NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args: Any, **kwargs: Any) -> None:  # type: ignore[override]
        raise BootstrapError("openbao_redirect", "OpenBao redirected a local request.")


def _harden_root_process() -> None:
    """Make every privileged bootstrap process non-dumpable with no core file."""

    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(4, 0, 0, 0, 0) != 0:  # PR_SET_DUMPABLE
        raise BootstrapError("process_hardening_failed", "The privileged process could not disable dumps.")


def _canonical(document: dict[str, Any]) -> bytes:
    return json.dumps(document, sort_keys=True, separators=(",", ":")).encode("utf-8")


def _write_all(descriptor: int, payload: bytes) -> None:
    view = memoryview(payload)
    while view:
        try:
            written = os.write(descriptor, view)
        except InterruptedError:
            continue
        if written <= 0:
            raise BootstrapError("gui_channel_closed", "The Atlas control channel closed.")
        view = view[written:]


def _emit_gui_event(
    event: str,
    phase: str,
    message: str,
    percent: int,
    status: str,
    **details: Any,
) -> None:
    """Emit one bounded, secret-free JSONL frame to the native Atlas process."""

    if (
        event not in {"progress", "result"}
        or not 0 <= percent <= 100
        or set(details) - GUI_EVENT_IDENTITY_FIELDS
        or any(
            not isinstance(value, (str, bool))
            and not (
                key == "recovery_from_release_id" and value is None
            )
            for key, value in details.items()
        )
    ):
        raise BootstrapError("internal_error", "An internal GUI event is invalid.")
    document: dict[str, Any] = {
        "schema_version": GUI_PROTOCOL_SCHEMA_VERSION,
        "event": event,
        "phase": phase,
        "message": message,
        "percent": percent,
        "status": status,
        "mutation_started": GUI_MUTATION_STARTED,
        "cancellation_allowed": not GUI_MUTATION_STARTED,
    }
    document.update(details)
    payload = _canonical(document) + b"\n"
    if len(payload) > GUI_EVENT_MAX_BYTES:
        raise BootstrapError("internal_error", "An internal GUI event is oversized.")
    _write_all(1, payload)


def _gui_channel_digest(invoker_uid: int) -> str:
    """Bind the protocol to the two anonymous pipes created by Atlas."""

    descriptors: list[dict[str, int]] = []
    for descriptor, expected_access in ((0, os.O_RDONLY), (1, os.O_WRONLY)):
        try:
            metadata = os.fstat(descriptor)
            access = fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE
        except OSError as exc:
            raise BootstrapError("gui_channel_invalid", "Atlas pipes are unavailable.") from exc
        if (
            not stat.S_ISFIFO(metadata.st_mode)
            or metadata.st_uid != invoker_uid
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
            or access != expected_access
            or os.isatty(descriptor)
        ):
            raise BootstrapError("gui_channel_invalid", "Atlas must use private anonymous pipes.")
        descriptors.append(
            {
                "fd": descriptor,
                "device": metadata.st_dev,
                "inode": metadata.st_ino,
                "mode": metadata.st_mode,
                "uid": metadata.st_uid,
            }
        )
    if (
        descriptors[0]["device"] == descriptors[1]["device"]
        and descriptors[0]["inode"] == descriptors[1]["inode"]
    ):
        raise BootstrapError("gui_channel_invalid", "Atlas must use two distinct pipes.")
    return hashlib.sha256(_canonical({"pipes": descriptors})).hexdigest()


def _gui_process_fields(pid: int) -> tuple[int, int]:
    try:
        raw = Path(f"/proc/{pid}/stat").read_bytes()
        if not raw or len(raw) > 16 * 1024:
            raise ValueError
        value = raw.decode("ascii", errors="strict")
    except (OSError, UnicodeError, ValueError) as exc:
        raise BootstrapError("gui_invoker_invalid", "The Atlas process identity is unavailable.") from exc
    end = value.rfind(")")
    fields = value[end + 2 :].split() if end > 1 else []
    # fields[1] is ppid (proc stat field 4), fields[19] is starttime (field 22).
    if (
        len(fields) < 20
        or not fields[1].isdigit()
        or not fields[19].isdigit()
    ):
        raise BootstrapError("gui_invoker_invalid", "The Atlas process identity is invalid.")
    return int(fields[1]), int(fields[19])


def _gui_process_is_ancestor(pid: int) -> bool:
    observed = os.getpid()
    visited: set[int] = set()
    for _ in range(64):
        if observed == pid:
            return True
        if observed <= 1 or observed in visited:
            return False
        visited.add(observed)
        try:
            observed, _ = _gui_process_fields(observed)
        except BootstrapError:
            return False
    return False


def _hash_open_descriptor(descriptor: int, maximum: int) -> tuple[str, int]:
    digest = hashlib.sha256()
    size = 0
    os.lseek(descriptor, 0, os.SEEK_SET)
    while size <= maximum:
        chunk = os.read(descriptor, min(1024 * 1024, maximum + 1 - size))
        if not chunk:
            break
        size += len(chunk)
        digest.update(chunk)
    if size > maximum:
        raise BootstrapError("gui_invoker_invalid", "The Atlas executable is oversized.")
    return digest.hexdigest(), size


def _read_gui_launcher_memfd(invoker_uid: int) -> bytes:
    """Capture the exact sealed helper image inherited by the Atlas child.

    Atlas maps its already-hashed memfd to child fd 2 with ``Stdio``.  That
    mapping happens only in the child spawn path, so no non-CLOEXEC descriptor
    is exposed to other Tauri threads.  Once captured, stderr is changed to
    ``/dev/null`` before pkexec/systemd-inhibit are invoked.
    """

    raw_path = str(__file__)
    matched = re.fullmatch(r"/proc/self/fd/([0-9]{1,9})", raw_path)
    if matched is None or int(matched.group(1)) != 2:
        raise BootstrapError(
            "sealed_helper_unsafe",
            "Atlas must launch the GUI helper from its sealed memory image.",
        )
    inherited = int(matched.group(1))
    descriptor = -1
    raw = bytearray()
    try:
        target = os.readlink(raw_path)
        inherited_info = os.fstat(inherited)
        descriptor = os.open(raw_path, os.O_RDONLY | os.O_CLOEXEC)
        before = os.fstat(descriptor)
        observed_seals = fcntl.fcntl(descriptor, fcntl.F_GET_SEALS)
        expected_seals = (
            fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_SEAL
        )
        if (
            target != "/memfd:atlas-bootstrap-helper (deleted)"
            or not stat.S_ISREG(before.st_mode)
            or before.st_uid != invoker_uid
            or stat.S_IMODE(before.st_mode) != 0o500
            or before.st_nlink != 0
            or before.st_size <= 0
            or before.st_size > 4 * 1024 * 1024
            or before.st_dev != inherited_info.st_dev
            or before.st_ino != inherited_info.st_ino
            or observed_seals != expected_seals
        ):
            raise BootstrapError(
                "sealed_helper_unsafe", "The Atlas helper memory image is not exact and sealed."
            )
        os.lseek(descriptor, 0, os.SEEK_SET)
        while len(raw) <= 4 * 1024 * 1024:
            chunk = os.read(descriptor, min(1024 * 1024, 4 * 1024 * 1024 + 1 - len(raw)))
            if not chunk:
                break
            raw.extend(chunk)
        after = os.fstat(descriptor)
        if (
            len(raw) != before.st_size
            or after.st_dev != before.st_dev
            or after.st_ino != before.st_ino
            or after.st_size != before.st_size
            or after.st_mtime_ns != before.st_mtime_ns
            or after.st_ctime_ns != before.st_ctime_ns
            or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != expected_seals
        ):
            raise BootstrapError(
                "sealed_helper_unsafe", "The Atlas helper memory image changed during capture."
            )
        captured = bytes(raw)
    except BootstrapError:
        raise
    except OSError as exc:
        raise BootstrapError(
            "sealed_helper_unsafe", "The Atlas helper memory image is unavailable."
        ) from exc
    finally:
        _wipe(raw)
        if descriptor >= 0:
            os.close(descriptor)

    null_descriptor = -1
    try:
        null_descriptor = os.open("/dev/null", os.O_WRONLY | os.O_CLOEXEC)
        os.dup2(null_descriptor, 2, inheritable=True)
    except OSError as exc:
        raise BootstrapError(
            "sealed_helper_unsafe", "The Atlas helper could not isolate diagnostics."
        ) from exc
    finally:
        if null_descriptor not in {-1, 2}:
            os.close(null_descriptor)
    return captured


def _current_gui_atlas_identity(
    pid: int,
    invoker_uid: int,
    expected_sha256: str | None = None,
) -> dict[str, Any]:
    if pid <= 1 or pid == os.getpid():
        raise BootstrapError("gui_invoker_invalid", "The Atlas process identity is invalid.")
    process_root = Path(f"/proc/{pid}")
    try:
        status_raw = (process_root / "status").read_text(encoding="ascii", errors="strict")
        loginuid = (process_root / "loginuid").read_text(encoding="ascii", errors="strict").strip()
    except (OSError, UnicodeError) as exc:
        raise BootstrapError("gui_invoker_invalid", "The Atlas process owner is unavailable.") from exc
    uid_match = re.search(r"(?m)^Uid:\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*$", status_raw)
    if (
        uid_match is None
        or any(int(value) != invoker_uid for value in uid_match.groups())
        or loginuid != str(invoker_uid)
    ):
        raise BootstrapError("gui_invoker_invalid", "The Atlas process owner differs.")
    _, start_time = _gui_process_fields(pid)
    executable_link = process_root / "exe"
    descriptor = -1
    observed_seals: int | None = None
    try:
        raw_executable_link = os.readlink(executable_link)
        descriptor = os.open(executable_link, os.O_RDONLY | os.O_CLOEXEC)
        opened = os.fstat(descriptor)
        if raw_executable_link == GUI_ATLAS_MEMFD_LINK:
            observed_seals = fcntl.fcntl(descriptor, fcntl.F_GET_SEALS)
        executable_sha256, observed_size = _hash_open_descriptor(
            descriptor, MAX_SOURCE_FILE_BYTES
        )
        after = os.fstat(descriptor)
    except BootstrapError:
        raise
    except OSError as exc:
        raise BootstrapError("gui_invoker_invalid", "The Atlas executable is unavailable.") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if raw_executable_link == GUI_ATLAS_MEMFD_LINK:
        path_id = "sealed-rpm-payload-memfd"
        required_seals = (
            fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_SEAL
        )
        path_identity_is_safe = (
            opened.st_uid == invoker_uid
            and stat.S_IMODE(opened.st_mode) == 0o500
            and opened.st_nlink == 0
            and observed_seals is not None
            and observed_seals & required_seals == required_seals
        )
    else:
        path_id = "installed"
        try:
            executable = executable_link.resolve(strict=True)
            path_metadata = os.lstat(GUI_ATLAS_INSTALLED_EXECUTABLE)
        except (OSError, RuntimeError) as exc:
            raise BootstrapError(
                "gui_invoker_invalid", "The installed Atlas executable is unavailable."
            ) from exc
        path_identity_is_safe = (
            executable == GUI_ATLAS_INSTALLED_EXECUTABLE
            and not raw_executable_link.endswith(" (deleted)")
            and stat.S_ISREG(path_metadata.st_mode)
            and not stat.S_ISLNK(path_metadata.st_mode)
            and path_metadata.st_uid == 0
            and path_metadata.st_gid == 0
            and stat.S_IMODE(path_metadata.st_mode) == 0o755
            and path_metadata.st_nlink == 1
            and opened.st_dev == path_metadata.st_dev
            and opened.st_ino == path_metadata.st_ino
        )
    if (
        not stat.S_ISREG(opened.st_mode)
        or not path_identity_is_safe
        or after.st_dev != opened.st_dev
        or after.st_ino != opened.st_ino
        or after.st_size != opened.st_size
        or after.st_mtime_ns != opened.st_mtime_ns
        or after.st_ctime_ns != opened.st_ctime_ns
        or observed_size != opened.st_size
        or (
            expected_sha256 is not None
            and (
                not SHA256_RE.fullmatch(expected_sha256)
                or not hmac.compare_digest(executable_sha256, expected_sha256)
            )
        )
    ):
        raise BootstrapError("gui_invoker_invalid", "The Atlas executable identity is unsafe.")
    return {
        "pid": pid,
        "start_time": start_time,
        "path_id": path_id,
        "device": opened.st_dev,
        "inode": opened.st_ino,
        "sha256": executable_sha256,
    }


def _encode_gui_atlas_binding(identity: dict[str, Any]) -> str:
    payload = base64.urlsafe_b64encode(_canonical(identity)).rstrip(b"=")
    return payload.decode("ascii")


def _decode_gui_atlas_binding(binding: str) -> dict[str, Any]:
    if not isinstance(binding, str) or not re.fullmatch(r"[A-Za-z0-9_-]{40,1024}", binding):
        raise BootstrapError("gui_invoker_invalid", "The Atlas process binding is invalid.")
    try:
        padding = "=" * (-len(binding) % 4)
        raw = base64.b64decode(binding + padding, altchars=b"-_", validate=True)
        identity = json.loads(raw)
    except (ValueError, UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("gui_invoker_invalid", "The Atlas process binding is invalid.") from exc
    expected = {"pid", "start_time", "path_id", "device", "inode", "sha256"}
    if (
        not isinstance(identity, dict)
        or set(identity) != expected
        or isinstance(identity.get("pid"), bool)
        or not isinstance(identity.get("pid"), int)
        or identity["pid"] <= 1
        or isinstance(identity.get("start_time"), bool)
        or not isinstance(identity.get("start_time"), int)
        or identity["start_time"] <= 0
        or identity.get("path_id") not in GUI_ATLAS_EXECUTABLES
        or any(
            isinstance(identity.get(key), bool)
            or not isinstance(identity.get(key), int)
            or identity[key] < 0
            for key in ("device", "inode")
        )
        or not isinstance(identity.get("sha256"), str)
        or not SHA256_RE.fullmatch(identity["sha256"])
    ):
        raise BootstrapError("gui_invoker_invalid", "The Atlas process binding fields differ.")
    return identity


def _new_gui_atlas_binding(invoker_uid: int) -> str:
    parent_pid = os.getppid()
    identity = _current_gui_atlas_identity(parent_pid, invoker_uid)
    return _encode_gui_atlas_binding(identity)


def _validate_gui_atlas_binding(
    invoker_uid: int,
    binding: str,
    expected_sha256: str | None = None,
) -> None:
    expected = _decode_gui_atlas_binding(binding)
    if not _gui_process_is_ancestor(expected["pid"]):
        raise BootstrapError("gui_invoker_invalid", "Atlas is not an ancestor of the helper.")
    observed = _current_gui_atlas_identity(
        expected["pid"], invoker_uid, expected_sha256
    )
    if not hmac.compare_digest(_canonical(observed), _canonical(expected)):
        raise BootstrapError("gui_invoker_invalid", "The Atlas process changed during authorization.")


def _read_gui_exact(size: int, *, deadline: float) -> bytearray:
    if size < 0 or size > GUI_CONTROL_LINE_MAX_BYTES * 2:
        raise BootstrapError("gui_input_invalid", "An Atlas input frame is oversized.")
    value = bytearray()
    while len(value) < size:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            _wipe(value)
            raise BootstrapError("gui_input_timeout", "Atlas did not complete the input frame.")
        try:
            ready, _, _ = select.select([0], [], [], remaining)
            if not ready:
                continue
            chunk = os.read(0, size - len(value))
        except (OSError, ValueError) as exc:
            _wipe(value)
            raise BootstrapError("gui_channel_invalid", "The Atlas input pipe failed.") from exc
        if not chunk:
            _wipe(value)
            raise BootstrapError("gui_channel_closed", "Atlas closed an incomplete input frame.")
        value.extend(chunk)
    return value


def _read_gui_u32(*, deadline: float, maximum: int) -> int:
    encoded = _read_gui_exact(4, deadline=deadline)
    try:
        value = int.from_bytes(encoded, "big")
    finally:
        _wipe(encoded)
    if value <= 0 or value > maximum:
        raise BootstrapError("gui_input_invalid", "An Atlas input length is invalid.")
    return value


def _validated_gui_secret(value: bytearray, *, kind: str) -> bytearray:
    decoded = ""
    try:
        decoded = bytes(value).decode("utf-8", errors="strict")
    except UnicodeError as exc:
        _wipe(value)
        raise BootstrapError("secret_invalid", "A GUI credential is invalid.") from exc
    valid = (
        14 <= len(decoded) <= 100
        and decoded == decoded.strip()
        and not any(ord(character) < 32 or ord(character) == 127 for character in decoded)
        and len(value) <= 400
    )
    if kind not in {"openbao", "zulip"}:
        valid = False
    if not valid:
        decoded = ""
        _wipe(value)
        raise BootstrapError("secret_invalid", "A GUI credential does not meet policy.")
    decoded = ""
    return value


def _read_gui_apply_request(
    release_id: str,
    helper_sha256: str,
    manifest_sha256: str,
    source_sha256: str,
    hermes_source_archive_sha256: str,
    *,
    operation_mode: str = "fresh",
    recovery_from_release_id: str | None = None,
) -> tuple[bytearray, bytearray]:
    deadline = time.monotonic() + 600.0
    magic = _read_gui_exact(len(b"ATLASBOOT1\n"), deadline=deadline)
    if hmac.compare_digest(magic, b"ATLASCTL1\n\x01"):
        _wipe(magic)
        _require_gui_channel_eof(deadline=time.monotonic() + 2.0)
        raise BootstrapError("cancelled", "Atlas cancelled before sending credentials.")
    if not hmac.compare_digest(magic, b"ATLASBOOT1\n"):
        _wipe(magic)
        raise BootstrapError("gui_input_invalid", "The Atlas apply framing is invalid.")
    _wipe(magic)
    metadata_raw: bytearray | None = None
    document: dict[str, Any] | None = None
    openbao: bytearray | None = None
    zulip: bytearray | None = None
    try:
        def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                if key in result:
                    raise ValueError("duplicate key")
                result[key] = value
            return result

        metadata_length = _read_gui_u32(deadline=deadline, maximum=1024)
        metadata_raw = _read_gui_exact(metadata_length, deadline=deadline)
        document = json.loads(bytes(metadata_raw), object_pairs_hook=reject_duplicates)
        expected_keys = {
            "schema_version", "confirmed_release_id", "confirmed_digest_suffix",
            "operation_mode",
        }
        if operation_mode == "corrective":
            if recovery_from_release_id != CORRECTIVE_PREDECESSOR["release_id"]:
                raise BootstrapError(
                    "confirmation_rejected", "The Atlas corrective predecessor differs."
                )
            confirmation_suffix = _corrective_suffix_for_identity(
                release_id=release_id,
                helper_sha256=helper_sha256,
                manifest_sha256=manifest_sha256,
                source_sha256=source_sha256,
                hermes_source_archive_sha256=hermes_source_archive_sha256,
            )
        elif operation_mode == "fresh" and recovery_from_release_id is None:
            confirmation_suffix = hashlib.sha256(
                (
                    f"{helper_sha256}:{manifest_sha256}:{source_sha256}:"
                    f"{hermes_source_archive_sha256}"
                ).encode("ascii")
            ).hexdigest()[:12]
        else:
            raise BootstrapError(
                "confirmation_rejected", "The Atlas operation mode differs."
            )
        if (
            not isinstance(document, dict)
            or set(document) != expected_keys
            or document.get("schema_version") != GUI_PROTOCOL_SCHEMA_VERSION
            or document.get("confirmed_release_id") != release_id
            or document.get("operation_mode") != operation_mode
            or not isinstance(document.get("confirmed_digest_suffix"), str)
            or not hmac.compare_digest(
                document["confirmed_digest_suffix"], confirmation_suffix
            )
        ):
            raise BootstrapError("confirmation_rejected", "The Atlas release confirmation differs.")
        openbao_length = _read_gui_u32(deadline=deadline, maximum=4096)
        openbao = _validated_gui_secret(
            _read_gui_exact(openbao_length, deadline=deadline), kind="openbao"
        )
        zulip_length = _read_gui_u32(deadline=deadline, maximum=4096)
        zulip = _validated_gui_secret(
            _read_gui_exact(zulip_length, deadline=deadline), kind="zulip"
        )
        if hmac.compare_digest(openbao, zulip):
            raise BootstrapError("secret_mismatch", "The two local passwords must differ.")
        return openbao, zulip
    except BootstrapError:
        _wipe(openbao)
        _wipe(zulip)
        raise
    except (ValueError, UnicodeError, json.JSONDecodeError, TypeError) as exc:
        _wipe(openbao)
        _wipe(zulip)
        raise BootstrapError("gui_input_invalid", "The Atlas apply request is invalid.") from exc
    finally:
        if isinstance(document, dict):
            document.clear()
        _wipe(metadata_raw)


def _require_gui_channel_eof(*, deadline: float) -> None:
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise BootstrapError(
                "gui_input_invalid", "Atlas did not close the control frame."
            )
        try:
            ready, _, _ = select.select([0], [], [], remaining)
            if ready:
                if os.read(0, 1):
                    raise BootstrapError(
                        "gui_input_invalid", "The Atlas control frame has trailing data."
                    )
                return
        except BootstrapError:
            raise
        except (OSError, ValueError) as exc:
            raise BootstrapError(
                "gui_channel_invalid", "The Atlas control channel failed."
            ) from exc


def _read_gui_mutation_commit_decision() -> None:
    decision = _read_gui_exact(
        len(b"ATLASCTL1\n\x02"), deadline=time.monotonic() + 30.0
    )
    try:
        if hmac.compare_digest(decision, b"ATLASCTL1\n\x01"):
            _require_gui_channel_eof(deadline=time.monotonic() + 2.0)
            raise BootstrapError("cancelled", "Atlas cancelled before mutation commit.")
        if not hmac.compare_digest(decision, b"ATLASCTL1\n\x02"):
            raise BootstrapError(
                "gui_input_invalid", "The Atlas mutation decision is invalid."
            )
        _require_gui_channel_eof(deadline=time.monotonic() + 2.0)
    finally:
        _wipe(decision)


def _gui_cancel_is_pending() -> bool:
    try:
        ready, _, _ = select.select([0], [], [], 0)
    except (OSError, ValueError) as exc:
        raise BootstrapError("gui_channel_invalid", "The Atlas input pipe failed.") from exc
    if not ready:
        return False
    # EOF before the mutation boundary is a safe cancellation.  Otherwise the
    # only accepted trailing frame is ATLASCTL1/CANCEL followed by EOF.
    try:
        first = os.read(0, 1)
    except OSError as exc:
        raise BootstrapError("gui_channel_invalid", "The Atlas input pipe failed.") from exc
    if not first:
        return True
    raw = bytearray(first)
    try:
        remainder = _read_gui_exact(
            len(b"ATLASCTL1\n\x01") - 1,
            deadline=time.monotonic() + 2.0,
        )
        raw.extend(remainder)
        _wipe(remainder)
        if not hmac.compare_digest(raw, b"ATLASCTL1\n\x01"):
            raise BootstrapError("gui_input_invalid", "The Atlas cancellation frame is invalid.")
        _require_gui_channel_eof(deadline=time.monotonic() + 2.0)
        return True
    except OSError as exc:
        raise BootstrapError("gui_channel_invalid", "The Atlas cancellation frame failed.") from exc
    finally:
        _wipe(raw)


def _gui_confirmation_suffix(preflight: dict[str, Any]) -> str:
    if preflight.get("operation_mode") == "corrective":
        if (
            preflight.get("recovery_from_release_id")
            != CORRECTIVE_PREDECESSOR["release_id"]
        ):
            raise BootstrapError(
                "gui_identity_invalid", "The corrective predecessor identity differs."
            )
        return _corrective_suffix_for_identity(
            release_id=preflight["release_id"],
            helper_sha256=preflight["bootstrap_helper_sha256"],
            manifest_sha256=preflight["manifest_sha256"],
            source_sha256=preflight["source_tree_sha256"],
            hermes_source_archive_sha256=preflight["hermes_source_archive_sha256"],
        )
    if preflight.get("operation_mode") != "fresh":
        raise BootstrapError(
            "gui_identity_invalid", "The recovery operation was not classified."
        )
    return hashlib.sha256(
        (
            f"{preflight['bootstrap_helper_sha256']}:"
            f"{preflight['manifest_sha256']}:"
            f"{preflight['source_tree_sha256']}:"
            f"{preflight['hermes_source_archive_sha256']}"
