def _publish_public_installed_proof(transaction: dict[str, Any]) -> None:
    if (
        transaction.get("recovery_guard_installing") is not False
        or transaction.get("recovery_guard_installed") is not False
    ):
        raise BootstrapError(
            "recovery_unsafe", "Recovery authority remains before proof publication."
        )
    expected = _expected_public_installed_proof(transaction)
    payload = _canonical(expected) + b"\n"
    if os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH):
        if _read_public_installed_proof() != expected:
            raise BootstrapError(
                "bootstrap_state_conflict", "The public installed proof conflicts."
            )
        return
    try:
        _exclusive_atomic_bytes(PUBLIC_INSTALLED_PROOF_PATH, payload, 0o644)
    except BootstrapError as exc:
        if exc.code != "bootstrap_consumed":
            raise
    if _read_public_installed_proof() != expected:
        raise BootstrapError(
            "bootstrap_state_conflict", "The public installed proof was not durable."
        )


def _remove_public_installed_proof(transaction: dict[str, Any]) -> None:
    if not os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH):
        return
    document = _read_public_installed_proof()
    consumed = _read_consumed_identity(transaction)
    if any(
        document.get(key) != expected
        for key, expected in (
            ("release_id", transaction.get("release_id")),
            ("source_tree_sha256", transaction.get("source_tree_sha256")),
            ("atlas_rpm_sha256", transaction.get("atlas_rpm_sha256")),
            (
                "hermes_source_archive_sha256",
                transaction.get("hermes_source_archive_sha256"),
            ),
            ("bootstrap_helper_sha256", consumed.get("bootstrap_helper_sha256")),
            ("manifest_sha256", consumed.get("manifest_sha256")),
        )
    ):
        raise BootstrapError(
            "rollback_failed", "The public installed proof conflicts with rollback."
        )
    PUBLIC_INSTALLED_PROOF_PATH.unlink()
    _fsync_directory(PUBLIC_INSTALLED_PROOF_PATH.parent)


def _tail_hash() -> str:
    if not AUDIT_PATH.exists():
        return "0" * 64
    raw = _read_stable_audit_file(AUDIT_PATH)
    # O_APPEND|O_CREAT can durably leave an empty inode if the writer dies
    # before its first byte.  It is the sole valid zero-record frontier.
    if not raw:
        return "0" * 64
    _raw, _complete, _records, _tail, partial = _read_audit_partial_frontier(
        AUDIT_PATH
    )
    if partial:
        # Use the same ASCII/canonical-prefix and inode checks as corrective
        # handoff.  Never truncate an arbitrary non-newline corruption.
        _reconcile_audit_partial_frontier()
        if not _complete:
            return "0" * 64
    _raw, _records, tail = _read_exact_audit(AUDIT_PATH)
    return tail


def append_audit(event: str, *, release_id: str, details: dict[str, Any] | None = None) -> str:
    if not re.fullmatch(r"[a-z][a-z0-9_-]{2,63}", event):
        raise BootstrapError("audit_invalid", "An internal bootstrap audit event is invalid.")
    previous = _tail_hash()
    record: dict[str, Any] = {
        "schema_version": 1,
        "timestamp": int(time.time()),
        "event": event,
        "release_id": release_id,
        "actor": "codex-supervised",
        "previous_sha256": previous,
    }
    if details:
        record["details"] = details
    record["record_sha256"] = hashlib.sha256(_canonical(record)).hexdigest()
    payload = _canonical(record) + b"\n"
    _append_exact_audit_payload(payload)
    return str(record["record_sha256"])


def _append_exact_audit_payload(payload: bytes) -> None:
    """Append one already canonical record and durably preserve its frontier."""

    if not payload or not payload.endswith(b"\n") or len(payload) > 64 * 1024:
        raise BootstrapError("audit_invalid", "An audit record payload is invalid.")
    descriptor = os.open(
        AUDIT_PATH,
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
        ):
            raise BootstrapError(
                "audit_invalid", "The bootstrap audit inode is unsafe."
            )
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError("write_failed", "The bootstrap audit write was incomplete.")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _fsync_directory(AUDIT_PATH.parent)


def _reconcile_complete_audit_frontier_allow_empty(
) -> tuple[list[dict[str, Any]], str]:
    """Return the committed chain after repairing one strict append prefix."""

    _raw, complete, records, tail, partial = _read_audit_partial_frontier(
        AUDIT_PATH
    )
    if partial:
        _reconcile_audit_partial_frontier()
        if not hmac.compare_digest(_read_stable_audit_file(AUDIT_PATH), complete):
            raise BootstrapError(
                "bootstrap_state_conflict", "The audit frontier was not reconciled."
            )
    return records, tail


def _ensure_bootstrap_consumed_audit_exact_once(
    transaction: dict[str, Any],
) -> str:
    """Repair or recognize the first fresh one-shot consumption record.

    Its timestamp and details come solely from the immutable consumed marker,
    so an empty inode or any prefix left by SIGKILL can be completed without
    inventing a second event.  Corrective successors carry a separately
    chained synthetic record and must never enter this fresh-only path.
    """

    if os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        raise BootstrapError(
            "corrective_mode_required",
            "A corrective audit can only resume through corrective recovery.",
        )
    consumed = _read_consumed_identity(transaction)
    _materialize_enrollment_state(transaction)
    expected = _audit_record(
        "bootstrap_consumed",
        consumed["release_id"],
        consumed["consumed_at"],
        "0" * 64,
        {
            "physical_uid": consumed["physical_uid"],
            "physical_session": consumed["physical_session"],
        },
    )
    expected_payload = _canonical(expected) + b"\n"
    if not os.path.lexists(AUDIT_PATH):
        _append_exact_audit_payload(expected_payload)
    else:
        _raw, _complete, records, _tail, partial = (
            _read_audit_partial_frontier(AUDIT_PATH)
        )
        if partial and not records and not expected_payload.startswith(partial):
            raise BootstrapError(
                "bootstrap_state_conflict",
                "The first audit append is not the consumed-record prefix.",
            )
        records, _tail = _reconcile_complete_audit_frontier_allow_empty()
        if not records:
            _append_exact_audit_payload(expected_payload)
    _raw, records, _tail = _read_exact_audit(AUDIT_PATH)
    consumed_records = [
        record for record in records if record.get("event") == "bootstrap_consumed"
    ]
    if (
        not records
        or records[0] != expected
        or len(consumed_records) != 1
        or consumed_records[0] != expected
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "The consumed audit identity differs."
        )
    return str(expected["record_sha256"])


def _append_rollback_audit_exact_once(transaction: dict[str, Any]) -> str:
    """Finish one rollback audit append without duplicating a committed tail."""

    release_id = transaction.get("release_id")
    if not isinstance(release_id, str) or not RELEASE_RE.fullmatch(release_id):
        raise BootstrapError("audit_invalid", "The rollback audit identity is invalid.")
    details = {"password_recovery_persists": True}
    records, _tail = _reconcile_complete_audit_frontier_allow_empty()
    same_identity = [
        (index, record)
        for index, record in enumerate(records)
        if record.get("event") == "bootstrap_rolled_back"
        and record.get("release_id") == release_id
    ]
    if same_identity:
        index, record = same_identity[0]
        if (
            len(same_identity) != 1
            or index != len(records) - 1
            or record.get("details") != details
        ):
            raise BootstrapError(
                "audit_invalid", "The rollback audit frontier conflicts."
            )
        digest = record.get("record_sha256")
        if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
            raise BootstrapError(
                "audit_invalid", "The rollback audit digest is invalid."
            )
        return digest
    return append_audit(
        "bootstrap_rolled_back", release_id=release_id, details=details
    )


def _exact_keys(value: Any, expected: set[str], location: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != expected:
        raise BootstrapError("manifest_invalid", f"The reviewed {location} fields differ.")
    return value


def _read_bounded_regular(path: Path, maximum: int) -> bytes:
    try:
        before = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError("file_unavailable", "A reviewed bootstrap input is unavailable.") from exc
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode) or opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino or opened.st_size > maximum
        ):
            raise BootstrapError("file_unsafe", "A reviewed bootstrap input is unsafe.")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        if (
            len(raw) > maximum or len(raw) != opened.st_size
            or after.st_dev != opened.st_dev or after.st_ino != opened.st_ino
            or after.st_size != opened.st_size or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns
        ):
            raise BootstrapError("file_changed", "A reviewed bootstrap input changed while read.")
        return raw
    finally:
        os.close(descriptor)


def _reviewed_manifest() -> tuple[dict[str, Any], str]:
    """Parse the versioned root trust anchor before mutable source code."""

    _validate_root_directory(TRUST_ANCHOR_ROOT.parent, 0o755)
    _validate_root_directory(TRUST_ANCHOR_ROOT, 0o555)
    raw = _read_exact_root_file(
        SOURCE_MANIFEST, MAX_MANIFEST_BYTES, 0o444
    )
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("manifest_invalid", "The installed release manifest is invalid.") from exc
    document = _exact_keys(
        document,
        {
            "schema_version", "release_id", "architecture", "trust_anchor",
            "bootstrap", "supply_chain", "host", "cutover", "source",
            "artifacts", "components", "runtime", "rollback",
        },
        "manifest",
    )
    if (
        document.get("schema_version") != 1
        or document.get("architecture") != "x86_64"
        or not isinstance(document.get("release_id"), str)
        or not RELEASE_RE.fullmatch(document["release_id"])
        or document.get("release_id") != CORRECTIVE_TARGET_RELEASE_ID
    ):
        raise BootstrapError("manifest_invalid", "The installed release identity is invalid.")
    trust_anchor = _exact_keys(
        document.get("trust_anchor"),
        {
            "version_directory", "manifest_path", "bootstrap_helper_path",
            "launcher_path", "manifest_mode", "bootstrap_helper_mode",
            "launcher_mode", "launcher_sha256", "enrollment",
        },
        "trust anchor",
    )
    expected_trust_anchor = {
        "version_directory": str(TRUST_ANCHOR_ROOT),
        "manifest_path": str(SOURCE_MANIFEST),
        "bootstrap_helper_path": str(TRUST_ANCHOR_BOOTSTRAP_HELPER),
        "launcher_path": str(TRUST_ANCHOR_LAUNCHER),
        "manifest_mode": "0444",
        "bootstrap_helper_mode": "0555",
        "launcher_mode": "0555",
        "enrollment": "physical-polkit-tofu-v1",
    }
    if (
        any(
            trust_anchor.get(key) != value
            for key, value in expected_trust_anchor.items()
        )
        or not isinstance(trust_anchor.get("launcher_sha256"), str)
        or not SHA256_RE.fullmatch(trust_anchor["launcher_sha256"])
    ):
        raise BootstrapError(
            "manifest_invalid", "The versioned root trust anchor differs."
        )
    source = _exact_keys(
        document.get("source"), {"root", "roots", "tree_algorithm", "tree_sha256"}, "source"
    )
    if (
        source.get("root") != str(EXPECTED_SOURCE_ROOT)
        or source.get("tree_algorithm") != "sha256-tree-v1"
        or source.get("roots") != list(SOURCE_ROOTS)
        or not isinstance(source.get("tree_sha256"), str)
        or not SHA256_RE.fullmatch(source["tree_sha256"])
    ):
        raise BootstrapError("manifest_invalid", "The installed source contract is invalid.")
    bootstrap = _exact_keys(
        document.get("bootstrap"),
        {
