def _enter_gui_mutation_boundary(
    invoker_uid: int,
    atlas_binding: str,
    channel_digest: str,
    session: str,
    expected_atlas_sha256: str,
) -> None:
    global GUI_MUTATION_STARTED
    if (
        _validate_local_gui_session(
            invoker_uid,
            atlas_binding,
            channel_digest,
            expected_atlas_sha256=expected_atlas_sha256,
        )
        != session
    ):
        raise BootstrapError(
            "physical_session_required",
            "The physical GUI session changed before mutation.",
        )
    if _gui_cancel_is_pending():
        raise BootstrapError("cancelled", "Atlas cancelled before mutation.")
    if not GUI_RESULT_IDENTITY:
        raise BootstrapError(
            "gui_identity_invalid", "The sealed root release identity is unavailable."
        )
    _emit_gui_event(
        "progress",
        "mutation-commit-ready",
        "Transaction prête; décision finale Atlas requise.",
        19,
        "ready-to-commit",
        **GUI_RESULT_IDENTITY,
    )
    # This blocking read is the linearization point shared with Atlas. Atlas
    # sends either CANCEL or ACK while holding its lifecycle mutex, then closes
    # stdin. No mutation is permitted on EOF, timeout, malformed input or a
    # cancellation that won the race.
    _read_gui_mutation_commit_decision()
    GUI_MUTATION_STARTED = True
    _emit_gui_event(
        "progress",
        "mutation-started",
        "Transaction démarrée; le rollback automatique est armé.",
        20,
        "mutation-started",
    )


