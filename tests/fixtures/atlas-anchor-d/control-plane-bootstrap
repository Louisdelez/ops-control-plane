    }
    recovery = operation in {
        "gui-recovery-preflight", "gui-recovery-apply",
        "recovery-preflight", "recovery-apply",
    }
    fresh = operation in {"gui-preflight", "gui-apply", "preflight", "apply"}
    if not corrective and not fresh and not recovery:
        return
    if recovery:
        GUI_RESULT_IDENTITY = {
            "operation_mode": "recovery",
            "recovery_from_release_id": None,
        }
        return
    GUI_RESULT_IDENTITY = {
        "operation_mode": "corrective" if corrective else "fresh"
