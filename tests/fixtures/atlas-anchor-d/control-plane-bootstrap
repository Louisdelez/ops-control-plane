def _validated_completion_proof(transaction: dict[str, Any]) -> dict[str, Any]:
    _validate_transaction_document(transaction)
    proof = transaction.get("proof")
    expected_fields = {
        "schema_version", "release_id", "source_tree_sha256", "atlas_rpm_sha256",
        "hermes_source_archive_sha256",
        "status", "provider_accounts_configured", "provider_keys_configured",
        "provider_routes_available", "provider_network_probe", "finance_status",
        "broker_status", "broker_policy_sha256", "zulip_approver_reconciled",
        "bootstrap_consumed", "password_recovery_persists_on_rollback",
        "completed_at", "audit_tail_sha256",
    }
    if not isinstance(proof, dict):
        raise BootstrapError(
            "recovery_unsafe", "The private bootstrap completion proof is absent."
        )
    counts = (
        proof.get("provider_accounts_configured"),
        proof.get("provider_keys_configured"),
        proof.get("provider_routes_available"),
    )
    if (
        transaction.get("status") != "completed"
        or set(proof) != expected_fields
        or proof.get("schema_version") != 1
        or proof.get("release_id") != transaction.get("release_id")
        or proof.get("source_tree_sha256") != transaction.get("source_tree_sha256")
        or proof.get("atlas_rpm_sha256") != transaction.get("atlas_rpm_sha256")
        or proof.get("hermes_source_archive_sha256")
        != transaction.get("hermes_source_archive_sha256")
        or proof.get("status") != "healthy-degraded"
        or any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in counts)
        or proof.get("provider_keys_configured") != 0
        or proof.get("provider_routes_available") != 0
        or proof.get("provider_network_probe") is not False
        or proof.get("finance_status") != "ok"
        or proof.get("broker_status") != "ok"
        or not isinstance(proof.get("broker_policy_sha256"), str)
        or not SHA256_RE.fullmatch(proof["broker_policy_sha256"])
        or proof.get("zulip_approver_reconciled") is not True
        or proof.get("bootstrap_consumed") is not True
        or proof.get("password_recovery_persists_on_rollback") is not True
        or isinstance(proof.get("completed_at"), bool)
        or not isinstance(proof.get("completed_at"), int)
        or proof["completed_at"] <= 0
        or transaction.get("completed_at") != proof.get("completed_at")
        or not isinstance(proof.get("audit_tail_sha256"), str)
        or not SHA256_RE.fullmatch(proof["audit_tail_sha256"])
    ):
        raise BootstrapError(
            "recovery_unsafe", "The private bootstrap completion proof is invalid."
        )
    return proof


