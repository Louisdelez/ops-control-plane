        )


def _validate_corrective_predecessor_recovery_units() -> None:
    missing = RECOVERY_PRIMARY_UNITS
    for unit in missing:
        if _strict_systemctl_properties(unit) != {
            "LoadState": "not-found",
            "ActiveState": "inactive",
            "UnitFileState": "",
            "FragmentPath": "",
            "DropInPaths": "",
        }:
            raise BootstrapError(
                "corrective_predecessor_invalid",
                "An absent predecessor recovery unit is unexpectedly loaded.",
            )
    janitor = _strict_systemctl_properties(RECOVERY_JANITOR_UNIT)
    if janitor != {
        "LoadState": "loaded",
        "ActiveState": "inactive",
        "UnitFileState": "disabled",
        "FragmentPath": str(RECOVERY_ASSETS[4]),
        "DropInPaths": str(SYSTEMD_GLOBAL_SERVICE_DROPIN),
    }:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The predecessor recovery janitor identity differs.",
        )
    global_dropin = _read_exact_root_file(
        SYSTEMD_GLOBAL_SERVICE_DROPIN, 256 * 1024, 0o644
    )
    if hashlib.sha256(global_dropin).hexdigest() != SYSTEMD_GLOBAL_SERVICE_DROPIN_SHA256:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The global systemd service drop-in differs.",
        )


def _review_corrective_predecessor(
    manifest: dict[str, Any],
) -> dict[str, Any]:
    """Verify the sole .10 rollback eligible for the .11 repair."""

    if manifest.get("release_id") != CORRECTIVE_TARGET_RELEASE_ID:
        raise BootstrapError(
            "corrective_target_invalid", "The corrective target release differs."
        )
    _validate_corrective_authority()
    if os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        raise BootstrapError(
            "corrective_consumed", "The single corrective capability is already consumed."
        )
    if os.path.lexists(CORRECTIVE_STATE_ROOT) or os.path.lexists(CORRECTIVE_HISTORY_ROOT):
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "Unconsumed corrective state or history already exists.",
        )
    _validate_root_directory(STATE_ROOT, 0o700)
    if os.lstat(STATE_ROOT).st_dev != os.lstat(STATE_ROOT.parent).st_dev:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The predecessor state cannot be archived by an atomic rename.",
        )
    try:
        names = {entry.name for entry in os.scandir(STATE_ROOT)}
    except OSError as exc:
        raise BootstrapError(
            "bootstrap_state_conflict", "The predecessor state cannot be enumerated."
        ) from exc
    if names != {TRANSACTION_PATH.name, AUDIT_PATH.name}:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The predecessor state contains unreviewed evidence or secrets.",
        )
    transaction_raw = _read_exact_root_file(TRANSACTION_PATH, 128 * 1024, 0o600)
    transaction = _exact_json_document(transaction_raw)
    _corrective_predecessor_is_terminal(transaction)
    observed_services = {
        unit: _strict_corrective_service_state(unit)
        for unit in RECOVERY_DEPENDENT_UNITS
    }
    if observed_services != transaction["service_state_before"]:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The restored service state differs from the predecessor snapshot.",
        )
    marker_raw = _read_exact_root_file(CONSUMED_PATH, 128 * 1024, 0o600)
    marker = _exact_json_document(marker_raw)
    _read_corrective_predecessor_consumed_identity_at(CONSUMED_PATH, transaction)
    _corrective_predecessor_initial_is_exact(
        marker["initial_transaction"], transaction
    )
    if any(marker.get(key) != value for key, value in CORRECTIVE_PREDECESSOR.items()):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor marker identity differs."
        )
    audit_raw, audit_records, audit_tail = _read_exact_audit(AUDIT_PATH)
    if (
        len(audit_records) != 2
        or [record.get("event") for record in audit_records]
        != ["bootstrap_consumed", "bootstrap_rolled_back"]
        or any(
            record.get("release_id") != CORRECTIVE_PREDECESSOR["release_id"]
            for record in audit_records
        )
        or audit_records[0].get("details") != {
            "physical_uid": marker["physical_uid"],
            "physical_session": marker["physical_session"],
        }
        or audit_records[1].get("details")
        != {"password_recovery_persists": True}
        or not (
            marker["initial_transaction"]["updated_at"]
            <= marker["consumed_at"]
            <= audit_records[0]["timestamp"]
            <= audit_records[1]["timestamp"]
            <= transaction["rolled_back_at"]
            <= transaction["updated_at"]
        )
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor audit history differs."
        )
    staged = _direct_root_child(
        transaction.get("staged_release"),
        DEPLOYMENT_RELEASES_ROOT,
        location="predecessor staged release",
    )
    if staged.name != CORRECTIVE_PREDECESSOR["release_id"]:
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor staged release differs."
        )
    _validate_root_directory(staged, 0o500)
    staged_marker = _read_json(staged / ".deployment-release.json", 16 * 1024)
    if staged_marker != {
        "schema_version": 1,
        "release_id": CORRECTIVE_PREDECESSOR["release_id"],
        "source_tree_sha256": CORRECTIVE_PREDECESSOR["source_tree_sha256"],
        "atlas_rpm_sha256": CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"],
    }:
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor staged marker differs."
        )
    staged_tree = staged / "tree"
    staged_digest, _ = _independent_source_digest(
        staged_tree, require_root_owned=True
    )
    staged_helper = staged_tree / "deploy/control-plane/bin/control-plane-bootstrap"
    staged_manifest = staged_tree / "deploy/control-plane/release-manifest.v1.json"
    staged_rpm = staged / "artifacts" / Path(
        manifest["artifacts"]["atlas_rpm"]["source_path"]
    ).name
    if (
        staged_digest != CORRECTIVE_PREDECESSOR["source_tree_sha256"]
        or _independent_regular_sha256(staged_helper, 4 * 1024 * 1024)
        != CORRECTIVE_PREDECESSOR["bootstrap_helper_sha256"]
        or _independent_regular_sha256(staged_rpm)
        != CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"]
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor staged bytes differ."
        )
    staged_manifest_document = _exact_json_document(
        _read_exact_root_file(staged_manifest, MAX_MANIFEST_BYTES, 0o400)
    )
    if (
        hashlib.sha256(
            _canonical(staged_manifest_document) + b"\n"
        ).hexdigest() != CORRECTIVE_PREDECESSOR_STAGED_MANIFEST_SHA256
        or
        staged_manifest_document.get("release_id")
        != CORRECTIVE_PREDECESSOR["release_id"]
        or staged_manifest_document.get("source", {}).get("tree_sha256")
        != CORRECTIVE_PREDECESSOR["source_tree_sha256"]
        or staged_manifest_document.get("artifacts", {}).get("atlas_rpm", {}).get("sha256")
        != CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"]
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor staged manifest differs."
        )
    expected_residual = {INSTALLED_HELPER, RECOVERY_ASSETS[4]}
    if any(
        os.path.lexists(path) != (path in expected_residual)
        for path in RECOVERY_ASSETS
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor recovery residue differs."
        )
    installed_helper_raw = _read_exact_root_file(
        INSTALLED_HELPER, 4 * 1024 * 1024, 0o700
    )
    janitor_raw = _read_exact_root_file(RECOVERY_ASSETS[4], 256 * 1024, 0o644)
    _validate_corrective_predecessor_recovery_units()
    if (
        hashlib.sha256(installed_helper_raw).hexdigest()
        != CORRECTIVE_PREDECESSOR["bootstrap_helper_sha256"]
        or not hmac.compare_digest(
            janitor_raw,
            _read_exact_root_file(
                staged_tree / "deploy/control-plane/systemd" / RECOVERY_JANITOR_UNIT,
                256 * 1024,
                0o444,
            ),
        )
        or any(os.path.lexists(link) for link in RECOVERY_ENABLEMENT_LINKS)
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid", "The predecessor recovery residue is not inert."
        )
    forbidden = (
        PUBLIC_INSTALLED_PROOF_PATH, PROOF_PATH, APPROVER_PATH,
        ROOT_TOKEN_ESCROW, OPENBAO_UNDO_ESCROW, USERPASS_PASSWORD_ESCROW,
        _escrow_staging_path(ROOT_TOKEN_ESCROW),
        _escrow_staging_path(OPENBAO_UNDO_ESCROW),
        _escrow_staging_path(USERPASS_PASSWORD_ESCROW),
        OPENBAO_RECOVERY_SOCKET,
        LIVE_TRANSACTION_PATH, DEPLOYMENT_CURRENT_PATH,
    )
    if any(os.path.lexists(path) for path in forbidden):
        raise BootstrapError(
            "corrective_predecessor_invalid", "Unexpected installed state or secret evidence exists."
        )
    return {
        "marker": marker,
        "marker_raw": marker_raw,
        "marker_sha256": hashlib.sha256(marker_raw).hexdigest(),
        "transaction": transaction,
        "transaction_raw": transaction_raw,
        "transaction_sha256": hashlib.sha256(transaction_raw).hexdigest(),
        "audit_raw": audit_raw,
        "audit_sha256": hashlib.sha256(audit_raw).hexdigest(),
        "audit_tail_sha256": audit_tail,
        "staged_release": str(staged),
    }


def _validate_corrective_scaffold_file(
    path: Path, expected: bytes, mode: int
) -> None:
    observed = _read_exact_root_file(path, 4 * 1024 * 1024, mode)
    if not hmac.compare_digest(observed, expected):
        raise BootstrapError(
            "corrective_scaffold_conflict", "A corrective recovery scaffold file differs."
        )
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _fsync_directory(path.parent)


def _publish_corrective_scaffold_file(
    path: Path, expected: bytes, mode: int
) -> None:
    if not os.path.lexists(path):
        try:
            _exclusive_atomic_bytes(path, expected, mode)
        except BootstrapError:
            if not os.path.lexists(path):
                raise
    _validate_corrective_scaffold_file(path, expected, mode)


def _publish_corrective_scaffold_link(link: Path, target: Path) -> None:
    if not os.path.lexists(link):
        try:
            os.symlink(str(target), link)
            _fsync_directory(link.parent)
        except FileExistsError:
            pass
    _validate_enablement_link(link, target)
    _fsync_directory(link.parent)


def _validate_corrective_scaffold(
    helper_sha256: str, *, require_active_path: bool
) -> None:
    if not SHA256_RE.fullmatch(helper_sha256):
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective helper identity is invalid."
        )
    helper_raw = _read_exact_root_file(
        CORRECTIVE_RECOVERY_HELPER, 4 * 1024 * 1024, 0o700
    )
    descriptor = os.open(
        CORRECTIVE_RECOVERY_HELPER,
        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _fsync_directory(CORRECTIVE_RECOVERY_HELPER.parent)
    if not hmac.compare_digest(
        hashlib.sha256(helper_raw).hexdigest(),
        helper_sha256,
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective recovery helper differs."
        )
    _validate_corrective_scaffold_file(
        CORRECTIVE_RECOVERY_UNIT, CORRECTIVE_RECOVERY_UNIT_BYTES, 0o644
    )
    _validate_corrective_scaffold_file(
        CORRECTIVE_RECOVERY_PATH, CORRECTIVE_RECOVERY_PATH_BYTES, 0o644
    )
    _validate_enablement_link(
        CORRECTIVE_RECOVERY_SERVICE_LINK, CORRECTIVE_RECOVERY_UNIT
    )
    _validate_enablement_link(
        CORRECTIVE_RECOVERY_PATH_LINK, CORRECTIVE_RECOVERY_PATH
    )
    for directory in {
        CORRECTIVE_RECOVERY_SERVICE_LINK.parent,
        CORRECTIVE_RECOVERY_PATH_LINK.parent,
        CORRECTIVE_RECOVERY_UNIT.parent,
        CORRECTIVE_RECOVERY_HELPER.parent,
    }:
        _fsync_directory(directory)
    if (
        not _systemctl_state(CORRECTIVE_RECOVERY_UNIT_NAME, "is-enabled")
        or not _systemctl_state(CORRECTIVE_RECOVERY_PATH_NAME, "is-enabled")
        or (
            require_active_path
            and not _systemctl_state(CORRECTIVE_RECOVERY_PATH_NAME, "is-active")
        )
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective recovery scaffold is not armed."
        )
    for unit, fragment in (
        (CORRECTIVE_RECOVERY_UNIT_NAME, CORRECTIVE_RECOVERY_UNIT),
        (CORRECTIVE_RECOVERY_PATH_NAME, CORRECTIVE_RECOVERY_PATH),
    ):
        properties = _strict_systemctl_properties(unit)
        expected_dropins = (
            str(SYSTEMD_GLOBAL_SERVICE_DROPIN)
            if unit == CORRECTIVE_RECOVERY_UNIT_NAME
            else ""
        )
        if (
            properties["LoadState"] != "loaded"
            or properties["UnitFileState"] != "enabled"
            or properties["FragmentPath"] != str(fragment)
            or properties["DropInPaths"] != expected_dropins
            or (
                unit == CORRECTIVE_RECOVERY_PATH_NAME
                and require_active_path
                and properties["ActiveState"] != "active"
            )
            or (
                unit == CORRECTIVE_RECOVERY_UNIT_NAME
                and not os.path.lexists(CORRECTIVE_CONSUMED_PATH)
                and properties["ActiveState"] != "inactive"
            )
            or (
                unit == CORRECTIVE_RECOVERY_UNIT_NAME
                and os.path.lexists(CORRECTIVE_CONSUMED_PATH)
                # Type=oneshot + RemainAfterExit deliberately becomes
                # active/exited after a successful handoff.  That is durable
                # completion evidence, not a live current-boot waiter.  A GUI
                # resume owns the deployment flock and must have restarted a
                # new activating process before it may mutate any handoff.
                and properties["ActiveState"] != "activating"
            )
        ):
            raise BootstrapError(
                "corrective_scaffold_conflict",
                "PID 1 did not load the exact corrective recovery scaffold.",
            )
    global_dropin = _read_exact_root_file(
        SYSTEMD_GLOBAL_SERVICE_DROPIN, 256 * 1024, 0o644
    )
    if hashlib.sha256(global_dropin).hexdigest() != SYSTEMD_GLOBAL_SERVICE_DROPIN_SHA256:
        raise BootstrapError(
            "corrective_scaffold_conflict", "The global systemd service drop-in differs."
        )
    if (
        not os.path.lexists(CORRECTIVE_CONSUMED_PATH)
        and _systemctl_state(CORRECTIVE_RECOVERY_UNIT_NAME, "is-active")
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict",
            "The corrective recovery service is active without its marker.",
        )


def _install_corrective_scaffold(
    helper_bytes: bytes, helper_sha256: str
) -> None:
    """Install the reviewed but marker-gated recovery anchor before consumption."""

    if (
        len(helper_bytes) > 4 * 1024 * 1024
        or not hmac.compare_digest(
            hashlib.sha256(helper_bytes).hexdigest(), helper_sha256
        )
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective helper payload differs."
        )
    for directory, mode in (
        (CORRECTIVE_RECOVERY_HELPER.parent, 0o755),
        (CORRECTIVE_RECOVERY_UNIT.parent, 0o755),
        (CORRECTIVE_RECOVERY_SERVICE_LINK.parent, 0o755),
    ):
        _validate_root_directory(directory, mode)
    _publish_corrective_scaffold_file(
        CORRECTIVE_RECOVERY_HELPER, helper_bytes, 0o700
    )
    _publish_corrective_scaffold_file(
        CORRECTIVE_RECOVERY_UNIT, CORRECTIVE_RECOVERY_UNIT_BYTES, 0o644
    )
    _publish_corrective_scaffold_file(
        CORRECTIVE_RECOVERY_PATH, CORRECTIVE_RECOVERY_PATH_BYTES, 0o644
    )
    _publish_corrective_scaffold_link(
        CORRECTIVE_RECOVERY_SERVICE_LINK, CORRECTIVE_RECOVERY_UNIT
    )
    _publish_corrective_scaffold_link(
        CORRECTIVE_RECOVERY_PATH_LINK, CORRECTIVE_RECOVERY_PATH
    )
    verified = subprocess.run(
        [
            "/usr/bin/systemd-analyze", "verify",
            str(CORRECTIVE_RECOVERY_UNIT), str(CORRECTIVE_RECOVERY_PATH),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
        pass_fds=_deployment_pass_fds(),
    )
    if verified.returncode != 0:
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective systemd scaffold is invalid."
        )
    commands = [
        ["/usr/bin/systemctl", "daemon-reload"],
        [
            "/usr/bin/systemctl", "reset-failed",
            CORRECTIVE_RECOVERY_UNIT_NAME, CORRECTIVE_RECOVERY_PATH_NAME,
        ],
        ["/usr/bin/systemctl", "restart", CORRECTIVE_RECOVERY_PATH_NAME],
    ]
    if os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        commands.append(
            [
                "/usr/bin/systemctl", "restart", "--no-block",
                CORRECTIVE_RECOVERY_UNIT_NAME,
            ]
        )
    for command in commands:
        completed = subprocess.run(
            command,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=60,
            pass_fds=_deployment_pass_fds(),
        )
        if completed.returncode != 0:
            raise BootstrapError(
                "corrective_scaffold_conflict", "The corrective recovery watcher could not arm."
            )
    if os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        _wait_corrective_recovery_job()
    _validate_corrective_scaffold(helper_sha256, require_active_path=True)


def _corrective_recovery_process_is_exact(pid: int) -> bool:
    """Bind the live watcher PID to the reviewed root helper invocation."""

    process_root = Path(f"/proc/{pid}")
    try:
        cmdline_raw = (process_root / "cmdline").read_bytes()
        status = (process_root / "status").read_text(
            encoding="ascii", errors="strict"
        )
        cgroup = (process_root / "cgroup").read_text(
            encoding="ascii", errors="strict"
        )
        python_info = os.stat("/usr/bin/python3")
        executable_info = os.stat(process_root / "exe")
    except (OSError, UnicodeError):
        return False
    expected_cmdline = b"\0".join(
        (
            b"/usr/bin/python3",
            b"-I",
            str(CORRECTIVE_RECOVERY_HELPER).encode("utf-8"),
            b"--corrective-recover",
            b"",
        )
    )
    uid_match = re.search(
        r"(?m)^Uid:\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*$", status
    )
    expected_cgroup = f"/system.slice/{CORRECTIVE_RECOVERY_UNIT_NAME}"
    return (
        len(cmdline_raw) <= 4096
        and hmac.compare_digest(cmdline_raw, expected_cmdline)
        and uid_match is not None
        and all(int(value) == 0 for value in uid_match.groups())
        and any(line.endswith(expected_cgroup) for line in cgroup.splitlines())
        and stat.S_ISREG(python_info.st_mode)
        and python_info.st_uid == 0
        and stat.S_IMODE(python_info.st_mode) & 0o022 == 0
        and executable_info.st_dev == python_info.st_dev
        and executable_info.st_ino == python_info.st_ino
    )


def _corrective_recovery_job_state() -> str:
    """Return starting/live only for the exact PID 1 corrective job."""

    names = (
        "LoadState", "ActiveState", "UnitFileState", "FragmentPath",
        "DropInPaths", "SubState", "MainPID",
    )
    completed = subprocess.run(
        [
            "/usr/bin/systemctl", "show", CORRECTIVE_RECOVERY_UNIT_NAME,
            *(f"--property={name}" for name in names),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    try:
        if len(completed.stdout) > 4096:
            raise ValueError("oversized property response")
        properties = dict(
            line.split("=", 1)
            for line in completed.stdout.decode(
                "utf-8", errors="strict"
            ).splitlines()
            if "=" in line
        )
    except (UnicodeError, ValueError) as exc:
        raise BootstrapError(
            "corrective_scaffold_conflict",
            "The corrective recovery process identity is invalid.",
        ) from exc
    expected = {
        "LoadState": "loaded",
        "UnitFileState": "enabled",
        "FragmentPath": str(CORRECTIVE_RECOVERY_UNIT),
        "DropInPaths": str(SYSTEMD_GLOBAL_SERVICE_DROPIN),
    }
    if (
        completed.returncode != 0
        or set(properties) != set(names)
        or any(properties.get(key) != value for key, value in expected.items())
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict",
            "PID 1 did not load the exact corrective recovery process.",
        )
    active = properties["ActiveState"]
    sub = properties["SubState"]
    raw_pid = properties["MainPID"]
    if (
        active == "activating"
        and sub == "start"
        and raw_pid.isdigit()
        and int(raw_pid) > 1
        and _corrective_recovery_process_is_exact(int(raw_pid))
    ):
        return "live"
    if (
        active == "deactivating"
        and sub in {"stop", "stop-sigterm", "stop-sigkill", "final-sigterm"}
        and raw_pid.isdigit()
        and int(raw_pid) > 1
        and _corrective_recovery_process_is_exact(int(raw_pid))
    ):
        # restart --no-block must first stop a prior exact waiter.  Treat that
        # old PID only as a bounded transition; it is never sufficient proof
        # that the replacement watcher is armed.
        return "starting"
    if (
        active in {"inactive", "deactivating", "activating"}
        and sub in {"dead", "stop", "stop-sigterm", "start-pre", "start"}
        and raw_pid in {"", "0"}
    ):
        return "starting"
    raise BootstrapError(
        "corrective_scaffold_conflict",
        "The corrective recovery service has no exact live waiter.",
    )


def _wait_corrective_recovery_job(timeout: float = 5.0) -> None:
    """Wait briefly for an exact root process which is blocked on our flock."""

    deadline = time.monotonic() + timeout
    while True:
        state = _corrective_recovery_job_state()
        if state == "live":
            return
        if state != "starting" or time.monotonic() >= deadline:
            raise BootstrapError(
                "corrective_scaffold_conflict",
                "The corrective recovery job did not become active.",
            )
        time.sleep(0.05)


def _activate_corrective_recovery_service(helper_sha256: str) -> None:
    """Prove PID 1 owns a live recovery job before post-marker renames."""

    completed = subprocess.run(
        [
            "/usr/bin/systemctl", "restart", "--no-block",
            CORRECTIVE_RECOVERY_UNIT_NAME,
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
        pass_fds=_deployment_pass_fds(),
    )
    if completed.returncode != 0:
        raise BootstrapError(
            "corrective_scaffold_conflict",
            "PID 1 could not arm the corrective recovery job.",
        )
    _wait_corrective_recovery_job()
    _validate_corrective_scaffold(helper_sha256, require_active_path=True)


def _corrective_suffix_for_identity(
    *,
    release_id: str,
    helper_sha256: str,
    manifest_sha256: str,
    source_sha256: str,
    hermes_source_archive_sha256: str,
) -> str:
    values = (
        "corrective-v1",
        CORRECTIVE_PREDECESSOR["release_id"],
        CORRECTIVE_PREDECESSOR["source_tree_sha256"],
        CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"],
        CORRECTIVE_PREDECESSOR["bootstrap_helper_sha256"],
        CORRECTIVE_PREDECESSOR["manifest_sha256"],
        release_id,
        helper_sha256,
        manifest_sha256,
        source_sha256,
        hermes_source_archive_sha256,
    )
    return hashlib.sha256(":".join(values).encode("ascii")).hexdigest()[:12]


