def _ask_secret(prompt: str, *, minimum: int) -> bytearray:
    completed = subprocess.run(
        [
            "/usr/bin/systemd-ask-password", "--echo=no", "--timeout=300",
            "--id=ops-control-plane-bootstrap", prompt,
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        timeout=310,
    )
    if completed.returncode != 0 or len(completed.stdout) > 4096:
        raise BootstrapError("secret_prompt_failed", "The native hidden prompt was cancelled or failed.")
    value = bytearray(completed.stdout)
    while value.endswith((b"\r", b"\n")):
        value.pop()
    try:
        decoded = value.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        _wipe(value)
        raise BootstrapError("secret_invalid", "A hidden input is invalid.") from exc
    if (
        len(decoded) < minimum
        or len(decoded) > 100
        or decoded != decoded.strip()
        or any(ord(character) < 32 or ord(character) == 127 for character in decoded)
    ):
        _wipe(value)
        raise BootstrapError("secret_invalid", "A hidden input does not meet the local password policy.")
    return value


def _confirmed_secrets() -> tuple[bytearray, bytearray]:
    openbao = _ask_secret("Nouveau mot de passe OpenBao pour ops-user :", minimum=14)
    openbao_again = _ask_secret("Confirmez le mot de passe OpenBao :", minimum=14)
    if not hmac.compare_digest(openbao, openbao_again):
        _wipe(openbao)
        _wipe(openbao_again)
        raise BootstrapError("secret_mismatch", "The OpenBao password confirmation differs.")
    _wipe(openbao_again)
    zulip = _ask_secret("Nouveau mot de passe propriétaire Zulip :", minimum=14)
    zulip_again = _ask_secret("Confirmez le mot de passe Zulip :", minimum=14)
    if not hmac.compare_digest(zulip, zulip_again) or hmac.compare_digest(openbao, zulip):
        _wipe(openbao)
        _wipe(zulip)
        _wipe(zulip_again)
        raise BootstrapError("secret_mismatch", "Passwords differ or reuse the same secret.")
    _wipe(zulip_again)
    return openbao, zulip


def _explicit_confirmation(
    release_id: str,
    helper_sha256: str,
    manifest_sha256: str,
    source_sha256: str,
    hermes_source_archive_sha256: str,
) -> None:
    # Full identifiers are displayed immediately above.  Bind the short human
    # action to all reviewed digests without requiring a long retype.
    confirmation_digest = hashlib.sha256(
        (
            f"{helper_sha256}:{manifest_sha256}:{source_sha256}:"
            f"{hermes_source_archive_sha256}"
        ).encode("ascii")
    ).hexdigest()[:12]
    phrase = f"DEPLOY {release_id} {confirmation_digest}"
    try:
        descriptor = os.open("/dev/tty", os.O_RDWR | os.O_CLOEXEC | os.O_NOCTTY)
        info = os.fstat(descriptor)
        if not stat.S_ISCHR(info.st_mode):
            raise BootstrapError("physical_session_required", "A physical terminal is required.")
        if os.tcgetpgrp(descriptor) != os.getpgrp():
            raise BootstrapError("physical_session_required", "The bootstrap is not the foreground terminal process.")
        os.write(descriptor, f"Tapez exactement « {phrase} » pour commencer : ".encode("utf-8"))
        raw = b""
        while len(raw) <= 512 and not raw.endswith(b"\n"):
            chunk = os.read(descriptor, 1)
            if not chunk:
                break
            raw += chunk
    except OSError as exc:
        raise BootstrapError("physical_session_required", "A physical terminal is required.") from exc
    finally:
        if "descriptor" in locals():
            os.close(descriptor)
    if raw.rstrip(b"\r\n") != phrase.encode("ascii"):
        raise BootstrapError("confirmation_rejected", "The physical confirmation did not match.")


def _acquire_lock(*, allow_busy: bool = False) -> int | None:
    # Share the deployment worker's volatile lock inode. Creating it in /run is
    # preflight-only/non-persistent; O_EXCL on the marker is the final arbiter.
    lock_path = Path("/run/lock/ops-control-plane-deployment.lock")
    descriptor = os.open(
        lock_path, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600
    )
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        os.close(descriptor)
        if exc.errno in {errno.EACCES, errno.EAGAIN}:
            if allow_busy:
                return None
            raise BootstrapError("bootstrap_busy", "Another bootstrap or deployment is running.") from exc
        raise
    return descriptor


def _new_transaction(
    manifest: dict[str, Any], preflight: dict[str, Any], *,
    strict_service_state: bool = False,
) -> dict[str, Any]:
    if strict_service_state:
        service_state_before = {
            unit: _strict_corrective_service_state(unit)
            for unit in RECOVERY_DEPENDENT_UNITS
        }
    else:
        service_state_before = {
            unit: {
                "active": _systemctl_state(unit, "is-active"),
                "enabled": _systemctl_state(unit, "is-enabled"),
            }
            for unit in RECOVERY_DEPENDENT_UNITS
        }
    # A Type=oneshot unit and an idle-exiting socket proxy cannot be restored
    # to a stable `active` state.  Test the same single snapshot that is
    # committed to the marker, eliminating a check/snapshot race at the final
    # pre-consumption boundary.
    if any(
        service_state_before[unit]["active"]
        for unit in RECOVERY_PRESTATE_UNRESTORABLE_UNITS
    ):
        raise BootstrapError(
            "maintenance_busy",
            "A non-restorable control-plane service is still active.",
        )
    transaction: dict[str, Any] = {
        "schema_version": 1,
        "status": "running",
        "phase": "consumed",
        "release_id": manifest["release_id"],
        "source_tree_sha256": manifest["source"]["tree_sha256"],
        "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
        "credentials_before": dict(preflight["credential_groups_present"]),
        "service_state_before": service_state_before,
        "broker_state_before": {
            unit: dict(service_state_before[unit])
            for unit in ("ops-broker.socket", "ops-broker.service")
        },
        "deployment_backup": None,
        "staged_release": None,
        "openbao_backup": None,
        "openbao_backup_sha256": None,
        "openbao_restore_required": False,
        "root_token_escrowed": False,
        "root_generation_pending": False,
        "root_generation_started_at": None,
        "root_generation_remints": 0,
        "root_remint_required": False,
        "root_final_share_windows": [],
        "root_attempt_closed": False,
        "root_reconciliation_complete": False,
        "recovery_guard_installing": False,
        "recovery_guard_installed": False,
        "recovery_activation_units": [],
        "openbao_runtime_dir_created": False,
        "approver_state_created": False,
        "openbao_undo_escrowed": False,
        "openbao_undo_write_started": False,
        "openbao_undo_complete": False,
        "openbao_poststate_recorded": False,
        "openbao_undo_started": False,
        "openbao_provisioning_started": False,
        "password_recovery_started": False,
        "password_recovery_persists": False,
        "userpass_password_escrowed": False,
        "userpass_finalized": False,
        "proof": None,
        "completed_at": None,
        "rolled_back_at": None,
        "updated_at": int(time.time()),
    }
    _validate_transaction_document(transaction)
    return transaction


def _materialize_enrollment_state(transaction: dict[str, Any]) -> None:
    """Materialize the state referenced by the atomic one-shot marker/WAL."""

    if not os.path.lexists(STATE_ROOT):
        STATE_ROOT.mkdir(mode=0o700, exist_ok=False)
        os.chmod(STATE_ROOT, 0o700)
        _fsync_directory(STATE_ROOT.parent)
    else:
        info = os.lstat(STATE_ROOT)
        if (
            not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
            or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise BootstrapError("bootstrap_state_conflict", "Bootstrap enrollment state is unsafe.")
    if not os.path.lexists(TRANSACTION_PATH):
        try:
            _exclusive_atomic_bytes(
                TRANSACTION_PATH, _canonical(transaction) + b"\n", 0o600
            )
        except BootstrapError:
            if not os.path.lexists(TRANSACTION_PATH):
                raise
        observed = _read_standard_transaction_frontier(promote_staging=True)
        if observed is None:
            raise BootstrapError(
                "bootstrap_state_conflict", "Bootstrap enrollment WAL is absent."
            )
        _validate_transaction_document(observed)
        if observed != transaction:
            raise BootstrapError(
                "bootstrap_state_conflict", "Bootstrap enrollment WAL differs."
            )
    else:
        observed = _read_standard_transaction_frontier(promote_staging=True)
        if observed is None:
            raise BootstrapError(
                "bootstrap_state_conflict", "Bootstrap enrollment WAL is absent."
            )
        _validate_transaction_document(observed)
        if observed != transaction:
            raise BootstrapError("bootstrap_state_conflict", "Bootstrap enrollment WAL differs.")


def consume_exception(
    manifest: dict[str, Any],
    session: str,
    invoker_uid: int,
    helper_sha256: str,
    manifest_sha256: str,
    transaction: dict[str, Any],
) -> None:
    _validate_transaction_document(transaction)
    document = {
        "schema_version": 1,
        "consumed": True,
        "consumed_at": int(time.time()),
        "actor": "codex-supervised",
        "physical_uid": invoker_uid,
        "physical_session": session,
        "release_id": manifest["release_id"],
        "source_tree_sha256": manifest["source"]["tree_sha256"],
        "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
        "bootstrap_helper_sha256": helper_sha256,
        "manifest_sha256": manifest_sha256,
        # The O_EXCL marker is also the complete initial enrollment WAL. A
        # crash on either side of STATE_ROOT/transaction.json creation can
        # resume this exact reviewed transaction without a second authority.
        "initial_transaction": transaction,
    }
    payload = _canonical(document) + b"\n"
    _exclusive_atomic_bytes(CONSUMED_PATH, payload, 0o600)
    _ensure_bootstrap_consumed_audit_exact_once(transaction)


def _write_openbao_config(payload: bytes) -> None:
    try:
        openbao_gid = grp.getgrnam("openbao").gr_gid
    except KeyError as exc:
        raise BootstrapError("openbao_config_failed", "OpenBao configuration ownership could not be restored.") from exc
    _atomic_bytes(OPENBAO_CONFIG, payload, 0o640, uid=0, gid=openbao_gid)
    restorecon = Path("/usr/sbin/restorecon")
    if restorecon.is_file():
        completed = subprocess.run(
            [str(restorecon), "-F", str(OPENBAO_CONFIG)],
            check=False,
            pass_fds=_deployment_pass_fds(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if completed.returncode != 0:
            raise BootstrapError("openbao_config_failed", "OpenBao configuration relabeling failed.")


def _prepare_recovery_socket_directory(transaction: dict[str, Any]) -> None:
    directory = OPENBAO_RECOVERY_SOCKET.parent
    openbao_user = pwd.getpwnam("openbao")
    openbao_group = grp.getgrnam("openbao")
    try:
        metadata = os.lstat(directory)
    except OSError as exc:
        raise BootstrapError("openbao_config_failed", "The OpenBao state directory is unavailable.") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != openbao_user.pw_uid or metadata.st_gid != openbao_group.gr_gid
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise BootstrapError("openbao_config_failed", "The OpenBao runtime directory is unsafe.")
    _set_transaction(transaction, openbao_runtime_dir_created=False)


def _cleanup_recovery_socket_directory(transaction: dict[str, Any]) -> None:
    if os.path.lexists(OPENBAO_RECOVERY_SOCKET):
        metadata = os.lstat(OPENBAO_RECOVERY_SOCKET)
        openbao_user = pwd.getpwnam("openbao")
        openbao_group = grp.getgrnam("openbao")
        if (
            not stat.S_ISSOCK(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != openbao_user.pw_uid or metadata.st_gid != openbao_group.gr_gid
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise BootstrapError("openbao_breakglass_open", "The temporary OpenBao socket is unsafe.")
        OPENBAO_RECOVERY_SOCKET.unlink()
        _fsync_directory(OPENBAO_RECOVERY_SOCKET.parent)
    _fsync_directory(OPENBAO_RECOVERY_SOCKET.parent)


def _restart_openbao(worker: dict[str, Any]) -> None:
    worker["run_command"](
        "bootstrap-restart-openbao", ["/usr/bin/systemctl", "restart", "openbao.service"], timeout=180
    )
    worker["run_command"](
        "bootstrap-start-openbao-unseal", ["/usr/bin/systemctl", "start", "openbao-unseal.service"], timeout=120
    )
    _wait_openbao()


def _standard_transaction_staging_path(
    current_raw: bytes, successor_raw: bytes
) -> Path:
    current_sha256 = hashlib.sha256(current_raw).hexdigest()
    successor_sha256 = hashlib.sha256(successor_raw).hexdigest()
    return STATE_ROOT / (
        f"{TRANSACTION_STAGING_PREFIX}{current_sha256}-{successor_sha256}"
    )


def _standard_transaction_staging_candidates() -> list[Path]:
    try:
        names = [entry.name for entry in os.scandir(STATE_ROOT)]
    except OSError as exc:
        raise BootstrapError(
            "bootstrap_state_conflict", "Bootstrap enrollment state is unreadable."
        ) from exc
    candidates: list[Path] = []
    pattern = re.compile(
        re.escape(TRANSACTION_STAGING_PREFIX) + r"[0-9a-f]{64}-[0-9a-f]{64}"
    )
    for name in names:
        if name.startswith(TRANSACTION_STAGING_PREFIX):
            if not pattern.fullmatch(name):
                raise BootstrapError(
                    "bootstrap_state_conflict",
                    "A bootstrap WAL staging name is malformed.",
                )
            candidates.append(STATE_ROOT / name)
    if len(candidates) > 1:
        raise BootstrapError(
            "bootstrap_state_conflict", "Multiple bootstrap WAL staging inodes exist."
        )
    return candidates


def _read_standard_transaction_frontier(
    *, promote_staging: bool
) -> dict[str, Any] | None:
    """Validate the hash-bound standard WAL staging frontier."""

    _validate_root_directory(STATE_ROOT, 0o700)
    candidates = _standard_transaction_staging_candidates()
    if not os.path.lexists(TRANSACTION_PATH):
        if candidates:
            raise BootstrapError(
                "bootstrap_state_conflict",
                "A bootstrap WAL staging inode exists without its predecessor.",
            )
        return None
    current_raw = _read_exact_root_file(TRANSACTION_PATH, 256 * 1024, 0o600)
    current = _exact_json_document(current_raw)
    _validate_transaction_document(current)
    if not candidates:
        return current
    staging_path = candidates[0]
    match = re.fullmatch(
        re.escape(TRANSACTION_STAGING_PREFIX)
        + r"([0-9a-f]{64})-([0-9a-f]{64})",
        staging_path.name,
    )
    if match is None or not hmac.compare_digest(
        match.group(1), hashlib.sha256(current_raw).hexdigest()
    ):
        raise BootstrapError(
            "bootstrap_state_conflict",
            "The bootstrap WAL staging predecessor differs.",
        )
    successor_raw = _read_exact_root_file(staging_path, 256 * 1024, 0o600)
    if not hmac.compare_digest(
        match.group(2), hashlib.sha256(successor_raw).hexdigest()
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "The bootstrap WAL staging payload differs."
        )
    successor = _exact_json_document(successor_raw)
    _validate_transaction_document(successor)
    immutable = {
        "schema_version", "release_id", "source_tree_sha256",
        "atlas_rpm_sha256", "hermes_source_archive_sha256",
        "credentials_before", "service_state_before",
        "broker_state_before",
    }
    if (
        any(successor.get(key) != current.get(key) for key in immutable)
        or successor["updated_at"] < current["updated_at"]
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "The bootstrap WAL staging identity differs."
        )
    if promote_staging:
        try:
            os.replace(staging_path, TRANSACTION_PATH)
            _fsync_directory(STATE_ROOT)
        except OSError as exc:
            raise BootstrapError(
                "write_failed", "The staged bootstrap WAL could not be committed."
            ) from exc
    return successor


def _set_transaction(transaction: dict[str, Any], **changes: Any) -> None:
    unexpected = set(changes) - set(transaction)
    if unexpected:
        raise BootstrapError("state_invalid", "A bootstrap transaction update is not declared.")
    current = _read_standard_transaction_frontier(promote_staging=True)
    if current is None or current != transaction:
        raise BootstrapError(
            "bootstrap_state_conflict", "The in-memory bootstrap WAL is stale."
        )
    successor = dict(transaction)
    successor.update(changes)
    successor["updated_at"] = max(
        int(time.time()), int(transaction["updated_at"])
    )
    _validate_transaction_document(successor)
    current_raw = _canonical(current) + b"\n"
    successor_raw = _canonical(successor) + b"\n"
    _replace_durable_wal(
        TRANSACTION_PATH,
        _standard_transaction_staging_path(current_raw, successor_raw),
        successor_raw,
    )
    transaction.clear()
    transaction.update(successor)


def _direct_root_child(raw: Any, root: Path, *, location: str) -> Path:
    if not isinstance(raw, str) or not raw.startswith("/") or "\x00" in raw:
        raise BootstrapError("recovery_unsafe", f"The saved {location} is invalid.")
    path = Path(raw)
    try:
        relative = path.relative_to(root)
    except ValueError as exc:
        raise BootstrapError("recovery_unsafe", f"The saved {location} is outside its root.") from exc
    if len(relative.parts) != 1 or relative.parts[0] in {"", ".", ".."}:
        raise BootstrapError("recovery_unsafe", f"The saved {location} is not a direct child.")
    return path


def _validate_corrective_predecessor_transaction_document(
    transaction: dict[str, Any],
) -> None:
    """Validate the exact legacy WAL schema emitted by corrective release .10."""

    # The sole reviewed predecessor predates the vendored Hermes source archive
    # identity. Adapt a copy to the current validator so every other field and
    # invariant stays identical, while refusing both that later field and every
    # other schema extension in the legacy evidence itself.
    if "hermes_source_archive_sha256" in transaction:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The predecessor transaction fields differ from the legacy schema.",
        )
    adapted = dict(transaction)
    adapted["hermes_source_archive_sha256"] = "0" * 64
    try:
        _validate_transaction_document(adapted)
    except BootstrapError as exc:
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The predecessor transaction fields differ from the legacy schema.",
        ) from exc


def _validate_transaction_document(transaction: dict[str, Any]) -> None:
    expected = {
        "schema_version", "status", "phase", "release_id", "source_tree_sha256",
        "atlas_rpm_sha256", "hermes_source_archive_sha256",
        "credentials_before", "broker_state_before",
        "service_state_before",
        "deployment_backup", "staged_release", "openbao_backup",
        "openbao_backup_sha256", "openbao_restore_required", "root_token_escrowed",
        "root_generation_pending", "root_generation_started_at",
        "root_generation_remints", "root_remint_required", "root_final_share_windows",
        "root_attempt_closed", "root_reconciliation_complete",
        "recovery_guard_installing", "recovery_guard_installed",
        "recovery_activation_units",
        "openbao_runtime_dir_created", "approver_state_created",
        "openbao_undo_escrowed", "openbao_undo_write_started",
        "openbao_undo_complete", "openbao_poststate_recorded",
        "openbao_undo_started", "openbao_provisioning_started",
        "password_recovery_started", "password_recovery_persists",
        "userpass_password_escrowed", "userpass_finalized",
        "proof", "completed_at", "rolled_back_at",
        "updated_at",
    }
    if set(transaction) != expected:
        raise BootstrapError("state_invalid", "The bootstrap transaction fields differ.")
    if (
        transaction.get("schema_version") != 1
        or transaction.get("status") not in {
            "running", "activation-pending", "completed", "rolled-back", "rollback-failed"
        }
        or not isinstance(transaction.get("release_id"), str)
        or not RELEASE_RE.fullmatch(transaction["release_id"])
        or not isinstance(transaction.get("source_tree_sha256"), str)
        or not SHA256_RE.fullmatch(transaction["source_tree_sha256"])
        or not isinstance(transaction.get("atlas_rpm_sha256"), str)
        or not SHA256_RE.fullmatch(transaction["atlas_rpm_sha256"])
        or not isinstance(transaction.get("hermes_source_archive_sha256"), str)
        or not SHA256_RE.fullmatch(transaction["hermes_source_archive_sha256"])
        or not isinstance(transaction.get("updated_at"), int)
    ):
        raise BootstrapError("state_invalid", "The bootstrap transaction identity is invalid.")
    for key in (
        "openbao_restore_required", "root_token_escrowed", "root_generation_pending",
        "root_remint_required",
        "root_attempt_closed",
        "root_reconciliation_complete",
        "recovery_guard_installing", "recovery_guard_installed",
        "openbao_runtime_dir_created", "approver_state_created",
        "openbao_undo_escrowed", "openbao_undo_write_started",
        "openbao_undo_complete", "openbao_poststate_recorded",
        "openbao_undo_started", "openbao_provisioning_started",
        "password_recovery_started", "password_recovery_persists",
        "userpass_password_escrowed", "userpass_finalized",
    ):
        if not isinstance(transaction.get(key), bool):
            raise BootstrapError("state_invalid", "A bootstrap transaction flag is invalid.")
    service_state = transaction.get("service_state_before")
    if not isinstance(service_state, dict) or set(service_state) != set(RECOVERY_DEPENDENT_UNITS):
        raise BootstrapError("state_invalid", "The initial service state is invalid.")
    for unit in RECOVERY_DEPENDENT_UNITS:
        state = service_state.get(unit)
        if (
            not isinstance(state, dict)
            or set(state) != {"active", "enabled"}
            or not all(isinstance(state.get(key), bool) for key in ("active", "enabled"))
        ):
            raise BootstrapError("state_invalid", "An initial service state is invalid.")
    if any(
        service_state[unit]["active"]
        for unit in RECOVERY_PRESTATE_UNRESTORABLE_UNITS
    ):
        raise BootstrapError(
            "state_invalid", "An initial non-restorable service state is invalid."
        )
    broker_state = transaction.get("broker_state_before")
    if (
        not isinstance(broker_state, dict)
        or set(broker_state) != {"ops-broker.socket", "ops-broker.service"}
        or any(broker_state[unit] != service_state[unit] for unit in broker_state)
    ):
        raise BootstrapError("state_invalid", "The initial broker state is inconsistent.")
    activation_units = transaction.get("recovery_activation_units")
    if (
        not isinstance(activation_units, list)
        or len(activation_units) > len(RECOVERY_DEPENDENT_UNITS)
        or any(not isinstance(unit, str) or unit not in RECOVERY_DEPENDENT_UNITS for unit in activation_units)
        or len(set(activation_units)) != len(activation_units)
    ):
        raise BootstrapError("state_invalid", "The deferred recovery activation set is invalid.")
    remints = transaction.get("root_generation_remints")
    windows = transaction.get("root_final_share_windows")
    if (
        isinstance(remints, bool) or not isinstance(remints, int) or remints not in {0, 1}
        or not isinstance(windows, list) or len(windows) > 2
    ):
        raise BootstrapError("state_invalid", "The root generation retry state is invalid.")
    for window in windows:
        if (
            not isinstance(window, dict) or set(window) != {"start", "end"}
            or isinstance(window.get("start"), bool) or not isinstance(window.get("start"), int)
            or isinstance(window.get("end"), bool) or not isinstance(window.get("end"), int)
            or window["start"] <= 0 or not window["start"] <= window["end"] <= window["start"] + 10
        ):
            raise BootstrapError("state_invalid", "A root generation response window is invalid.")


def _discover_deployment_backup(transaction: dict[str, Any]) -> Path | None:
    raw = transaction.get("deployment_backup")
    if isinstance(raw, str):
        return _direct_root_child(raw, DEPLOYMENT_BACKUP_ROOT, location="deployment backup")
    if raw is not None or not DEPLOYMENT_CURRENT_PATH.exists():
        return None
    current = _read_json(DEPLOYMENT_CURRENT_PATH, 32 * 1024)
    if set(current) != {
        "schema_version", "release_id", "status", "transaction_id", "backup_path", "activated_at"
    } or current.get("schema_version") != 1 or current.get("release_id") != transaction["release_id"]:
        raise BootstrapError("recovery_unsafe", "The deployment recovery pointer differs from bootstrap.")
    if current.get("status") not in {"deploying", "rollback-failed"}:
        return None
    transaction_id = current.get("transaction_id")
    if not isinstance(transaction_id, str) or not RELEASE_RE.fullmatch(transaction_id):
        raise BootstrapError("recovery_unsafe", "The deployment transaction identifier is invalid.")
    backup = _direct_root_child(current.get("backup_path"), DEPLOYMENT_BACKUP_ROOT, location="deployment backup")
    if backup.name != transaction_id:
        raise BootstrapError("recovery_unsafe", "The deployment pointer is inconsistent.")
    _set_transaction(transaction, deployment_backup=str(backup), phase="deployment-backup-discovered")
    return backup


def _verified_staged_worker(transaction: dict[str, Any]) -> dict[str, Any]:
    release = _direct_root_child(
        transaction.get("staged_release"), DEPLOYMENT_RELEASES_ROOT, location="staged release"
    )
    if release.name != transaction["release_id"]:
        raise BootstrapError("recovery_unsafe", "The staged release identifier differs.")
    metadata = os.lstat(release)
    if (
        not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022
    ):
        raise BootstrapError("recovery_unsafe", "The staged release root is unsafe.")
    marker = _read_json(release / ".deployment-release.json", 16 * 1024)
    expected_marker = {
        "schema_version": 1,
        "release_id": transaction["release_id"],
        "source_tree_sha256": transaction["source_tree_sha256"],
        "atlas_rpm_sha256": transaction["atlas_rpm_sha256"],
        "hermes_source_archive_sha256": transaction["hermes_source_archive_sha256"],
    }
    if marker != expected_marker:
        raise BootstrapError("recovery_unsafe", "The staged release marker differs.")
    tree = release / "tree"
    digest, worker_bytes = _independent_source_digest(tree, require_root_owned=True)
    if not hmac.compare_digest(digest, transaction["source_tree_sha256"]):
        raise BootstrapError("recovery_unsafe", "The staged release digest differs.")
    if not hmac.compare_digest(
        _independent_regular_sha256(
            release / "artifacts" / HERMES_SOURCE_ARCHIVE_NAME
        ),
        transaction["hermes_source_archive_sha256"],
    ):
        raise BootstrapError(
            "recovery_unsafe", "The staged Hermes archive digest differs."
        )
    return _load_verified_worker(worker_bytes)


def _install_recovery_guard(release: Path, worker: dict[str, Any], transaction: dict[str, Any]) -> None:
    """Persist and arm only the bounded recovery infrastructure enrollment."""

    source = release / "tree"
    _set_transaction(
        transaction,
        recovery_guard_installing=True,
        phase="recovery-guard-installing",
    )
    worker["run_command"](
        "prepare-bootstrap-recovery-paths",
        [
            "/usr/bin/install", "-d", "-m", "0755", "-o", "root", "-g", "root",
            "/usr/local/libexec",
        ],
        timeout=60,
    )
    worker["run_command"](
        "install-bootstrap-helper",
        [
            "/usr/bin/install", "-m", "0700", "-o", "root", "-g", "root",
            str(source / "deploy/control-plane/bin/control-plane-bootstrap"), str(INSTALLED_HELPER),
        ],
        timeout=60,
    )
    for unit in RECOVERY_UNITS:
        worker["run_command"](
            f"install-{unit}",
            [
                "/usr/bin/install", "-m", "0644", "-o", "root", "-g", "root",
                str(source / "deploy/control-plane/systemd" / unit), str(Path("/etc/systemd/system") / unit),
            ],
            timeout=60,
        )
    worker["run_command"](
        "verify-bootstrap-recovery-units",
        [
            "/usr/bin/systemd-analyze", "verify",
            "/etc/systemd/system/ops-control-plane-bootstrap-guard.service",
            "/etc/systemd/system/ops-control-plane-bootstrap-recovery.service",
            "/etc/systemd/system/ops-control-plane-bootstrap-recovery-activate.service",
        ],
        timeout=60,
    )
    # The executable recovery core is durable before any boot link or service
    # barrier can refer to it.
    _fsync_recovery_core(source, ())
    worker["run_command"]("bootstrap-core-daemon-reload", ["/usr/bin/systemctl", "daemon-reload"], timeout=60)
    # Publish and flush the main recovery trigger first.  A crash from this
    # point is recoverable at boot even if the janitor or later barriers have
    # not yet been installed.
    worker["run_command"](
        "enable-bootstrap-recovery",
        ["/usr/bin/systemctl", "enable", "ops-control-plane-bootstrap-recovery.service"],
        timeout=60,
    )
    if not _systemctl_state("ops-control-plane-bootstrap-recovery.service", "is-enabled"):
        raise BootstrapError("recovery_guard_failed", "The bootstrap recovery trigger was not armed.")
    _fsync_recovery_core(source, ("ops-control-plane-bootstrap-recovery.service",))
    worker["run_command"](
        "enable-bootstrap-recovery-janitor",
        ["/usr/bin/systemctl", "enable", RECOVERY_JANITOR_UNIT],
        timeout=60,
    )
    if not _systemctl_state(RECOVERY_JANITOR_UNIT, "is-enabled"):
        raise BootstrapError("recovery_guard_failed", "The bootstrap recovery janitor was not armed.")
    _fsync_recovery_core(
        source,
        ("ops-control-plane-bootstrap-recovery.service", RECOVERY_JANITOR_UNIT),
    )
    # Only after a durable boot recovery path exists may OpenBao and managed
    # services acquire references to that recovery core.
    worker["run_command"](
        "prepare-bootstrap-openbao-guard-path",
        [
            "/usr/bin/install", "-d", "-m", "0755", "-o", "root", "-g", "root",
            "/etc/systemd/system/openbao.service.d",
        ],
        timeout=60,
    )
    worker["run_command"](
        "install-bootstrap-openbao-guard",
        [
            "/usr/bin/install", "-m", "0644", "-o", "root", "-g", "root",
            str(source / "deploy/control-plane/systemd/openbao.service.d/90-control-plane-bootstrap-guard.conf"),
            "/etc/systemd/system/openbao.service.d/90-control-plane-bootstrap-guard.conf",
        ],
        timeout=60,
    )
    for unit in RECOVERY_DEPENDENT_UNITS:
        dropin = Path("/etc/systemd/system") / f"{unit}.d/90-control-plane-bootstrap-recovery.conf"
        worker["run_command"](
            f"prepare-bootstrap-barrier-{unit}",
            [
                "/usr/bin/install", "-d", "-m", "0755", "-o", "root", "-g", "root",
                str(dropin.parent),
            ],
            timeout=60,
        )
        _atomic_bytes(dropin, RECOVERY_BARRIER_DROPIN, mode=0o644)
    worker["run_command"]("bootstrap-daemon-reload", ["/usr/bin/systemctl", "daemon-reload"], timeout=60)
    worker["run_command"](
        "enable-bootstrap-openbao-guard",
        ["/usr/bin/systemctl", "enable", "ops-control-plane-bootstrap-guard.service"],
        timeout=60,
    )
    if not all(_systemctl_state(unit, "is-enabled") for unit in RECOVERY_ENABLED_UNITS):
        raise BootstrapError("recovery_guard_failed", "The bootstrap recovery units were not armed.")
    _fsync_recovery_anchor(source)
    # Arm the dependency-free current-boot waiter before the WAL says the
    # recovery guard is complete.  A crash on either side is now covered:
    # the transient supervisor handles this boot, while the already-fsynced
    # enabled recovery unit handles a reboot.
    _start_standard_recovery_supervisor(transaction)
    _wait_standard_recovery_supervisor()
    _set_transaction(
        transaction,
        recovery_guard_installing=False,
        recovery_guard_installed=True,
        phase="recovery-armed",
    )


def _fsync_recovery_core(source: Path, enabled_units: tuple[str, ...]) -> None:
    """Flush the executable recovery core and selected published boot links."""

    if any(unit not in RECOVERY_ENABLED_UNITS for unit in enabled_units):
        raise BootstrapError("recovery_guard_failed", "An unknown recovery link was requested.")
    installed_sources = {
        INSTALLED_HELPER: source / "deploy/control-plane/bin/control-plane-bootstrap",
        **{
            Path("/etc/systemd/system") / unit: source / "deploy/control-plane/systemd" / unit
            for unit in RECOVERY_UNITS
        },
    }
    expected_modes = {INSTALLED_HELPER: 0o700}
    for installed, reviewed in installed_sources.items():
        metadata = os.lstat(installed)
        expected_mode = expected_modes.get(installed, 0o644)
        if (
            not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != expected_mode
            or not hmac.compare_digest(
                _independent_regular_sha256(installed, maximum=4 * 1024 * 1024),
                _independent_regular_sha256(reviewed, maximum=4 * 1024 * 1024),
            )
        ):
            raise BootstrapError("recovery_guard_failed", "A recovery anchor differs from review.")
        descriptor = os.open(installed, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        _fsync_directory(installed.parent)
    link_by_unit = {
        expected_target.name: (link, expected_target)
        for link, expected_target in RECOVERY_ENABLEMENT_LINKS.items()
    }
    for unit in enabled_units:
        link, expected_target = link_by_unit[unit]
        _validate_enablement_link(link, expected_target)
        _fsync_directory(link.parent)
    _fsync_directory(Path("/etc/systemd/system"))
    _fsync_directory(Path("/usr/local/libexec"))


def _fsync_recovery_anchor(source: Path) -> None:
    """Verify and durably flush every recovery asset and enablement link."""

    _fsync_recovery_core(source, RECOVERY_ENABLED_UNITS)
    guard = Path(
        "/etc/systemd/system/openbao.service.d/90-control-plane-bootstrap-guard.conf"
    )
    reviewed_guard = (
        source
        / "deploy/control-plane/systemd/openbao.service.d/90-control-plane-bootstrap-guard.conf"
    )
    metadata = os.lstat(guard)
    if (
        not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o644
        or not hmac.compare_digest(
            _independent_regular_sha256(guard, maximum=4 * 1024 * 1024),
            _independent_regular_sha256(reviewed_guard, maximum=4 * 1024 * 1024),
        )
    ):
        raise BootstrapError("recovery_guard_failed", "The OpenBao recovery guard differs from review.")
    descriptor = os.open(guard, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _fsync_directory(guard.parent)
    for barrier in RECOVERY_BARRIER_ASSETS:
        metadata = os.lstat(barrier)
        if (
            not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o644
            or _read_root_file(barrier, 4096, private=False) != RECOVERY_BARRIER_DROPIN
        ):
            raise BootstrapError("recovery_guard_failed", "A recovery barrier differs from review.")
        descriptor = os.open(barrier, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        _fsync_directory(barrier.parent)
    _fsync_directory(Path("/etc/systemd/system"))


def _validate_enablement_link(link: Path, expected_target: Path) -> None:
    """Accept systemd's relative or absolute link only when it resolves exact."""

    metadata = os.lstat(link)
    raw_target = os.readlink(link) if stat.S_ISLNK(metadata.st_mode) else ""
    resolved_target = Path(raw_target) if raw_target.startswith("/") else link.parent / raw_target
    if (
        not stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or resolved_target.resolve(strict=True) != expected_target.resolve(strict=True)
    ):
        raise BootstrapError("recovery_guard_failed", "A recovery enablement link differs.")


def _remove_recovery_barriers() -> None:
    for path in RECOVERY_BARRIER_ASSETS:
        if not os.path.lexists(path):
            continue
        metadata = os.lstat(path)
        if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0:
            raise BootstrapError("recovery_guard_failed", "A bootstrap barrier is unsafe to remove.")
        path.unlink()
        _fsync_directory(path.parent)
        try:
            path.parent.rmdir()
            _fsync_directory(path.parent.parent)
        except OSError as exc:
            if exc.errno not in {errno.ENOTEMPTY, errno.ENOENT}:
                raise
    completed = subprocess.run(
        ["/usr/bin/systemctl", "daemon-reload"], check=False, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60,
        pass_fds=_deployment_pass_fds(),
    )
    if completed.returncode != 0:
        raise BootstrapError("recovery_guard_failed", "systemd could not unload recovery barriers.")


def _cleanup_recovery_guard(transaction: dict[str, Any]) -> None:
    assets_present = any(os.path.lexists(path) for path in RECOVERY_ASSETS)
    was_armed = transaction.get("recovery_guard_installed") is True
    if not (
        transaction.get("recovery_guard_installed") is True
        or transaction.get("recovery_guard_installing") is True
        or assets_present
    ):
        if transaction.get("status") == "completed":
            _publish_public_installed_proof(transaction)
        elif transaction.get("status") == "rolled-back":
            _remove_public_installed_proof(transaction)
        elif os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH):
            raise BootstrapError(
                "bootstrap_state_conflict",
                "A public installed proof exists before a terminal commit.",
            )
        return
    # Keep the independently enabled activation unit as a cleanup janitor
    # until every authoritative guard/barrier asset is durably absent.  If
    # power is lost after either primary trigger is disabled, the janitor is
    # still pulled by multi-user.target and replays this function.
    _remove_recovery_barriers()
    for unit, unit_path in zip(
        RECOVERY_PRIMARY_UNITS, RECOVERY_ASSETS[2:4], strict=True
    ):
        if unit_path.exists():
            completed = subprocess.run(
                ["/usr/bin/systemctl", "disable", unit], check=False, stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60,
                pass_fds=_deployment_pass_fds(),
            )
        else:
            completed = None
        if (completed is not None and completed.returncode != 0) or _systemctl_state(unit, "is-enabled"):
            raise BootstrapError("recovery_guard_failed", "A bootstrap recovery unit could not self-disable.")
    enablement_items = list(RECOVERY_ENABLEMENT_LINKS.items())
    for link, _target in enablement_items[:2]:
        if os.path.lexists(link):
            raise BootstrapError("recovery_guard_failed", "A primary recovery enablement link remains.")
        if link.parent.exists():
            _fsync_directory(link.parent)
    janitor_link, janitor_target = enablement_items[2]
    if os.path.lexists(janitor_link):
        _validate_enablement_link(janitor_link, janitor_target)
        _fsync_directory(janitor_link.parent)
    elif was_armed:
        raise BootstrapError("recovery_guard_failed", "The cleanup janitor anchor disappeared.")
    removable_assets = RECOVERY_ASSETS[1:4]
    for path in removable_assets:
        if os.path.lexists(path):
            metadata = os.lstat(path)
            if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0:
                raise BootstrapError("recovery_guard_failed", "A bootstrap recovery asset is unsafe to remove.")
            path.unlink()
            _fsync_directory(path.parent)
    completed = subprocess.run(
        ["/usr/bin/systemctl", "daemon-reload"], check=False, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60,
        pass_fds=_deployment_pass_fds(),
    )
    if completed.returncode != 0:
        raise BootstrapError("recovery_guard_failed", "systemd could not unload the bootstrap guard.")
    if any(os.path.lexists(path) for path in (*removable_assets, *RECOVERY_BARRIER_ASSETS)):
        raise BootstrapError("recovery_guard_failed", "A bootstrap recovery authority remains.")
    # This WAL transition is durable before removing the last boot trigger.
    # The janitor unit and root-only helper intentionally remain as inert,
    # hash-reviewed files after self-disable; deleting the last cleanup code
    # cannot itself be made power-loss replayable without another anchor.
    _set_transaction(
        transaction,
        recovery_guard_installing=False,
        recovery_guard_installed=False,
    )
    # The public marker is created only after the health proof and completed
    # WAL already exist, all primary rollback barriers are gone, and the WAL
    # records that root recovery authority is inert.  The independently
    # enabled janitor remains available until this publication is durable.
    if transaction.get("status") == "completed":
        _publish_public_installed_proof(transaction)
        # The terminal WAL is the durable proof that no further recovery is
        # needed.  Publish it before disabling the final janitor trigger; no
        # transaction write may follow removal of that last boot anchor.
        _set_transaction(transaction, phase="completed")
    elif transaction.get("status") == "rolled-back":
        _remove_public_installed_proof(transaction)
    elif os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH):
        raise BootstrapError(
            "bootstrap_state_conflict",
            "A public installed proof exists before a terminal commit.",
        )
    janitor_path = RECOVERY_ASSETS[4]
    if janitor_path.exists():
        completed = subprocess.run(
            ["/usr/bin/systemctl", "disable", RECOVERY_JANITOR_UNIT],
            check=False, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=60, pass_fds=_deployment_pass_fds(),
        )
        if completed.returncode != 0:
            raise BootstrapError("recovery_guard_failed", "The cleanup janitor could not self-disable.")
    if _systemctl_state(RECOVERY_JANITOR_UNIT, "is-enabled"):
        raise BootstrapError("recovery_guard_failed", "The cleanup janitor remains enabled.")
    if os.path.lexists(janitor_link):
        raise BootstrapError("recovery_guard_failed", "The cleanup janitor enablement link remains.")
    if janitor_link.parent.exists():
        _fsync_directory(janitor_link.parent)


def _decode_root_token(encoded: str, otp: str) -> str:
    if not encoded or len(encoded) > 4096 or not otp or len(otp) > 4096:
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid root generation material.")
    try:
        raw = bytearray(base64.b64decode(encoded + "=" * (-len(encoded) % 4), validate=True))
        pad = bytearray(otp.encode("ascii", errors="strict"))
    except (UnicodeError, ValueError) as exc:
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid root generation material.") from exc
    try:
        if len(raw) != len(pad):
            raise BootstrapError("openbao_invalid", "OpenBao returned mismatched root generation material.")
        decoded = bytes(left ^ right for left, right in zip(raw, pad, strict=True)).decode("ascii", errors="strict")
        if not TOKEN_RE.fullmatch(decoded):
            raise BootstrapError("openbao_invalid", "OpenBao returned an invalid generated root token.")
        return decoded
    finally:
        _wipe(raw)
        _wipe(pad)


def _complete_root_attempt(
    transaction: dict[str, Any], nonce: str, otp_bytes: bytearray, progress: int,
    *, retry_final_share: bool = False,
) -> str:
    """Submit only the remaining shares for the nonce-bound escrowed attempt."""

    if progress not in {0, 1} or not NONCE_RE.fullmatch(nonce):
        raise BootstrapError("openbao_invalid", "OpenBao root-attempt progress is invalid.")
    completed_document: dict[str, Any] | None = None
    shares: list[bytearray] = []
    try:
        for index, name in enumerate(RECOVERY_CREDENTIALS, 1):
            if index <= progress:
                continue
            share = _decrypt_credential(name, Path("/etc/credstore.encrypted") / name)
            shares.append(share)
            if index == len(RECOVERY_CREDENTIALS):
                windows = list(transaction["root_final_share_windows"])
                if retry_final_share:
                    # A nonce-bound GET still reporting progress=1 proves the
                    # prior recorded final-share window did not mint a token.
                    # Replace that window instead of spending another retry.
                    if not windows:
                        raise BootstrapError(
                            "root_generation_ambiguous",
                            "A root final-share retry lacks its durable window.",
                        )
                    windows.pop()
                if len(windows) >= 2:
                    raise BootstrapError(
                        "root_generation_ambiguous",
                        "The bounded root generation retry budget is exhausted.",
                    )
                request_started = int(time.time())
                windows.append({"start": request_started, "end": request_started + 10})
                changes: dict[str, Any] = {
                    "root_final_share_windows": windows,
                    "phase": "root-final-share-starting",
                }
                # A remint consumes its one permitted token-producing retry
                # only at the final-share boundary, not while initializing a
                # harmless progress=0 attempt.
                if transaction.get("root_remint_required") is True:
                    if transaction.get("root_generation_remints") not in {0, 1}:
                        raise BootstrapError(
                            "root_generation_ambiguous",
                            "The bounded root generation retry budget is exhausted.",
                        )
                    if transaction.get("root_generation_remints") == 0:
                        changes["root_generation_remints"] = 1
                _set_transaction(transaction, **changes)
            _, response = openbao_recovery_request(
                "PUT",
                "/v1/sys/generate-root/update",
                payload={"key": share.decode("ascii", errors="strict"), "nonce": nonce},
                allowed_statuses=frozenset({200}),
            )
            if (
                not isinstance(response, dict)
                or response.get("nonce") != nonce
                or response.get("required") != 2
                or response.get("progress") != index
                or response.get("started") is not True
                or response.get("complete") != (index == len(RECOVERY_CREDENTIALS))
            ):
                raise BootstrapError("openbao_invalid", "OpenBao returned invalid root generation progress.")
            completed_document = response
            encoded_progress = (
                response.get("encoded_token") or response.get("encoded_root_token")
                if response.get("complete") is True
                else None
            )
            if encoded_progress is not None and not isinstance(encoded_progress, str):
                raise BootstrapError("openbao_invalid", "OpenBao returned invalid encoded root material.")
            _escrow_root_material(
                nonce=nonce,
                otp=otp_bytes,
                encoded_token=encoded_progress,
                progress=index,
                started_at=transaction["root_generation_started_at"],
                create=False,
            )
            progress = index
        if not isinstance(completed_document, dict) or completed_document.get("complete") is not True:
            raise BootstrapError("openbao_invalid", "OpenBao did not complete root generation.")
        encoded = completed_document.get("encoded_token") or completed_document.get("encoded_root_token")
        if not isinstance(encoded, str):
            raise BootstrapError("openbao_invalid", "OpenBao omitted the encoded generated token.")
        openbao_recovery_request(
            "DELETE", "/v1/sys/generate-root/attempt",
            allowed_statuses=frozenset({200, 204, 400, 404}),
        )
        _, closed = openbao_recovery_request(
            "GET", "/v1/sys/generate-root/attempt", allowed_statuses=frozenset({200})
        )
        if not isinstance(closed, dict) or closed.get("started") is not False:
            raise BootstrapError("openbao_invalid", "OpenBao root-attempt closure was not confirmed.")
        _set_transaction(transaction, root_attempt_closed=True, phase="root-attempt-closed")
        return encoded
    finally:
        for share in shares:
            _wipe(share)


def generate_root_material(transaction: dict[str, Any]) -> tuple[str, bytearray]:
    # Never cancel an operator's pre-existing attempt.  The private UDS proves
    # exclusivity for the new attempt and its nonce is escrowed before a share
    # is submitted.
    _, existing = openbao_recovery_request(
        "GET", "/v1/sys/generate-root/attempt", allowed_statuses=frozenset({200})
    )
    if not isinstance(existing, dict) or not isinstance(existing.get("started"), bool):
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid root-attempt state.")
    if existing.get("started") is True:
        raise BootstrapError("openbao_attempt_conflict", "An existing OpenBao root attempt is active.")
    started_at = transaction.get("root_generation_started_at")
    if not isinstance(started_at, int) or started_at <= 0:
        started_at = int(time.time())
    _set_transaction(
        transaction,
        root_generation_pending=True,
        root_generation_started_at=started_at,
        root_attempt_closed=False,
        root_reconciliation_complete=False,
        phase="root-generation-starting",
    )
    _, attempt = openbao_recovery_request(
        "POST", "/v1/sys/generate-root/attempt", payload={}, allowed_statuses=frozenset({200})
    )
    if not isinstance(attempt, dict):
        raise BootstrapError("openbao_invalid", "OpenBao did not initialize root generation.")
    nonce = attempt.get("nonce")
    otp = attempt.get("otp")
    if (
        not isinstance(nonce, str)
        or not NONCE_RE.fullmatch(nonce)
        or not isinstance(otp, str)
        or not 16 <= len(otp) <= 4096
        or attempt.get("required") != 2
        or attempt.get("started") is not True
        or attempt.get("progress") != 0
        or attempt.get("complete") is not False
    ):
        raise BootstrapError("openbao_invalid", "OpenBao returned an unsafe root generation attempt.")
    otp_bytes = bytearray(otp.encode("ascii", errors="strict"))
    _escrow_root_material(
        nonce=nonce,
        otp=otp_bytes,
        encoded_token=None,
        progress=0,
        started_at=transaction["root_generation_started_at"],
        create=not os.path.lexists(ROOT_TOKEN_ESCROW),
    )
    _set_transaction(transaction, root_token_escrowed=True, phase="root-generation-escrowed")
    try:
        encoded = _complete_root_attempt(transaction, nonce, otp_bytes, 0)
        return encoded, otp_bytes
    finally:
        otp = ""
        nonce = ""
        if transaction.get("root_attempt_closed") is not True:
            _wipe(otp_bytes)


def _escrow_staging_path(path: Path) -> Path:
    if path not in {ROOT_TOKEN_ESCROW, OPENBAO_UNDO_ESCROW, USERPASS_PASSWORD_ESCROW}:
        raise BootstrapError("escrow_conflict", "An unreviewed escrow path was requested.")
    return path.with_name(f".{path.name}.staging")


def _reject_unexpected_escrow_staging() -> None:
    """Keep the secret staging namespace closed and deterministic."""

    if not STATE_ROOT.exists():
        return
    allowed = {
        _escrow_staging_path(ROOT_TOKEN_ESCROW),
        _escrow_staging_path(OPENBAO_UNDO_ESCROW),
        _escrow_staging_path(USERPASS_PASSWORD_ESCROW),
    }
    prefixes = tuple(f".{path.name}." for path in (
        ROOT_TOKEN_ESCROW, OPENBAO_UNDO_ESCROW, USERPASS_PASSWORD_ESCROW
    ))
    for candidate in STATE_ROOT.iterdir():
        if candidate.name.startswith(prefixes) and candidate not in allowed:
            raise BootstrapError("escrow_conflict", "An unexpected secret staging file exists.")


def _escrow_root_material(
    *,
    nonce: str,
    otp: bytearray,
    encoded_token: str | None,
    progress: int,
    started_at: int,
    create: bool,
) -> None:
    if (
        not NONCE_RE.fullmatch(nonce) or not 0 <= progress <= 2
        or not isinstance(started_at, int) or started_at <= 0
        or (encoded_token is not None and (not isinstance(encoded_token, str) or len(encoded_token) > 4096))
    ):
        raise BootstrapError("escrow_failed", "The root-token escrow material is invalid.")
    material = bytearray(
        _canonical(
            {
                "schema_version": 1,
                "nonce": nonce,
                "otp": otp.decode("ascii", errors="strict"),
                "encoded_token": encoded_token,
                "progress": progress,
                "started_at": started_at,
            }
        )
    )
    desired = json.loads(material)
    try:
        _reconcile_root_escrow_staging()
        if os.path.lexists(ROOT_TOKEN_ESCROW):
            existing = _root_escrow_document_raw(ROOT_TOKEN_ESCROW)
            if existing == desired:
                return
            if create:
                raise BootstrapError(
                    "escrow_conflict", "The root-token recovery escrow state conflicts."
                )
        elif not create:
            raise BootstrapError(
                "escrow_conflict", "The root-token recovery escrow state conflicts."
            )
        staging = _escrow_staging_path(ROOT_TOKEN_ESCROW)
        if os.path.lexists(staging):
            raise BootstrapError("escrow_conflict", "A root-token staging escrow remains.")
        completed = subprocess.run(
            [
                "/usr/bin/systemd-creds", "encrypt", "--with-key=host+tpm2",
                "--name=ops-control-plane-bootstrap-root-token", "-",
                str(staging),
            ],
            check=False,
            input=material,
            pass_fds=_deployment_pass_fds(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if completed.returncode != 0:
            raise BootstrapError("escrow_failed", "The temporary root token could not be crash-protected.")
        os.chmod(staging, 0o400)
        _validate_encrypted_file(staging)
        verified = _decrypt_credential(
            "ops-control-plane-bootstrap-root-token", staging, 16 * 1024
        )
        try:
            if not hmac.compare_digest(verified, material):
                raise BootstrapError("escrow_failed", "The root-token escrow verification differs.")
        finally:
            _wipe(verified)
        descriptor = os.open(
            staging,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
        )
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(staging, ROOT_TOKEN_ESCROW)
        _fsync_directory(ROOT_TOKEN_ESCROW.parent)
    finally:
        _wipe(material)
        # Do not delete a completed deterministic staging slot on failure: it
        # may be the only durable copy of a progress=2 response. Recovery
        # validates and promotes it monotonically.


def _root_escrow_document_raw(path: Path) -> dict[str, Any]:
    raw = _decrypt_credential("ops-control-plane-bootstrap-root-token", path, 16 * 1024)
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("escrow_failed", "The root recovery escrow is invalid.") from exc
    finally:
        _wipe(raw)
    if (
        not isinstance(document, dict)
        or set(document) != {"schema_version", "nonce", "otp", "encoded_token", "progress", "started_at"}
        or document.get("schema_version") != 1
        or not isinstance(document.get("nonce"), str)
        or not NONCE_RE.fullmatch(document["nonce"])
        or not isinstance(document.get("otp"), str)
        or not 16 <= len(document["otp"]) <= 4096
        or document.get("progress") not in {0, 1, 2}
        or not isinstance(document.get("started_at"), int)
        or document["started_at"] <= 0
        or (
            document.get("progress") in {0, 1}
            and document.get("encoded_token") is not None
        )
        or (
            document.get("progress") == 2
            and (
                not isinstance(document.get("encoded_token"), str)
                or not 1 <= len(document["encoded_token"]) <= 4096
            )
        )
    ):
        raise BootstrapError("escrow_failed", "The root recovery escrow is invalid.")
    return document


def _reconcile_root_escrow_staging() -> None:
    """Promote only a same-attempt, monotonic deterministic root staging slot."""

    _reject_unexpected_escrow_staging()
    staging_path = _escrow_staging_path(ROOT_TOKEN_ESCROW)
    if not os.path.lexists(staging_path):
        return
    staged = _root_escrow_document_raw(staging_path)
    if not os.path.lexists(ROOT_TOKEN_ESCROW):
        os.replace(staging_path, ROOT_TOKEN_ESCROW)
        _fsync_directory(ROOT_TOKEN_ESCROW.parent)
        return
    current = _root_escrow_document_raw(ROOT_TOKEN_ESCROW)
    identity = ("nonce", "otp", "started_at")
    if any(staged[key] != current[key] for key in identity):
        raise BootstrapError("escrow_conflict", "The staged root-token attempt differs.")
    staged_progress = staged["progress"]
    current_progress = current["progress"]
    if staged_progress < current_progress:
        staging_path.unlink()
        _fsync_directory(staging_path.parent)
        return
    if staged_progress == current_progress:
        if staged != current:
            raise BootstrapError("escrow_conflict", "Equal root-token escrow progress differs.")
        staging_path.unlink()
        _fsync_directory(staging_path.parent)
        return
    if staged_progress != current_progress + 1:
        raise BootstrapError("escrow_conflict", "Root-token escrow progress is non-monotonic.")
    os.replace(staging_path, ROOT_TOKEN_ESCROW)
    _fsync_directory(ROOT_TOKEN_ESCROW.parent)


def _root_escrow_document() -> dict[str, Any]:
    _reconcile_root_escrow_staging()
    return _root_escrow_document_raw(ROOT_TOKEN_ESCROW)


def _proc_text(path: Path, maximum: int) -> str:
    try:
        raw = path.read_bytes()
        if not raw or len(raw) > maximum:
            raise ValueError
        return raw.decode("ascii", errors="strict")
    except (OSError, UnicodeError, ValueError) as exc:
        raise BootstrapError("recovery_unsafe", "A live bootstrap process record is invalid.") from exc


def _process_start_time(pid: int) -> int:
    value = _proc_text(Path(f"/proc/{pid}/stat"), 16 * 1024)
    end = value.rfind(")")
    fields = value[end + 2 :].split() if end > 1 else []
    if len(fields) < 20 or not fields[19].isdigit():
        raise BootstrapError("recovery_unsafe", "A live bootstrap process identity is invalid.")
    return int(fields[19])


def _boot_id() -> str:
    value = _proc_text(Path("/proc/sys/kernel/random/boot_id"), 128).strip()
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value):
        raise BootstrapError("recovery_unsafe", "The kernel boot identity is invalid.")
    return value


def _write_live_transaction(
    transaction: dict[str, Any], helper_sha256: str, *, mode: str = "bootstrap"
) -> None:
    if mode not in {"bootstrap", "recovery"}:
        raise BootstrapError("recovery_unsafe", "The live transaction mode is invalid.")
    if os.path.lexists(LIVE_TRANSACTION_PATH):
        raise BootstrapError("bootstrap_busy", "A live bootstrap process marker already exists.")
    _atomic_json(
        LIVE_TRANSACTION_PATH,
        {
            "schema_version": 1,
            "mode": mode,
            "pid": os.getpid(),
            "process_start_time": _process_start_time(os.getpid()),
            "boot_id": _boot_id(),
            "release_id": transaction["release_id"],
            "source_tree_sha256": transaction["source_tree_sha256"],
            "bootstrap_helper_sha256": helper_sha256,
        },
    )


def _remove_live_transaction(*, only_current: bool = True) -> None:
    if not os.path.lexists(LIVE_TRANSACTION_PATH):
        return
    document = _read_json(LIVE_TRANSACTION_PATH, 16 * 1024)
    if only_current and (
        document.get("pid") != os.getpid()
        or document.get("process_start_time") != _process_start_time(os.getpid())
    ):
        raise BootstrapError("recovery_unsafe", "A foreign live bootstrap marker was not removed.")
    LIVE_TRANSACTION_PATH.unlink()
    _fsync_directory(LIVE_TRANSACTION_PATH.parent)


def _live_bootstrap_is_verified(transaction: dict[str, Any]) -> bool:
    if not os.path.lexists(LIVE_TRANSACTION_PATH):
        return False
    try:
        document = _read_json(LIVE_TRANSACTION_PATH, 16 * 1024)
        if set(document) != {
            "schema_version", "mode", "pid", "process_start_time", "boot_id", "release_id",
            "source_tree_sha256", "bootstrap_helper_sha256",
        }:
            return False
        pid = document.get("pid")
        if (
            document.get("schema_version") != 1
            or document.get("mode") not in {"bootstrap", "recovery"}
            or isinstance(pid, bool) or not isinstance(pid, int) or pid <= 1
            or document.get("boot_id") != _boot_id()
            or document.get("release_id") != transaction.get("release_id")
            or document.get("source_tree_sha256") != transaction.get("source_tree_sha256")
            or not isinstance(document.get("bootstrap_helper_sha256"), str)
            or not SHA256_RE.fullmatch(document["bootstrap_helper_sha256"])
            or document.get("process_start_time") != _process_start_time(pid)
        ):
            return False
        status = _proc_text(Path(f"/proc/{pid}/status"), 64 * 1024)
        uid_line = next((line for line in status.splitlines() if line.startswith("Uid:")), "")
        if uid_line.split()[1:] != ["0", "0", "0", "0"]:
            return False
        if document["mode"] == "recovery":
            consumed = _read_json(CONSUMED_PATH, 128 * 1024)
            expected_sha = consumed.get("bootstrap_helper_sha256")
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            return (
                isinstance(expected_sha, str)
                and hmac.compare_digest(expected_sha, document["bootstrap_helper_sha256"])
                and hmac.compare_digest(
                    _independent_regular_sha256(INSTALLED_HELPER, maximum=4 * 1024 * 1024),
                    expected_sha,
                )
                and len(cmdline) >= 3
                and os.fsdecode(cmdline[1]) == str(INSTALLED_HELPER)
                and os.fsdecode(cmdline[2]) in {"--recover", "--recover-activate"}
            )
        expected_seals = (
            fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL
        )
        for raw_fd in os.listdir(f"/proc/{pid}/fd"):
            if not raw_fd.isdigit():
                continue
            candidate = Path(f"/proc/{pid}/fd/{raw_fd}")
            try:
                target = os.readlink(candidate)
                if "memfd:ops-control-plane-bootstrap" not in target:
                    continue
                descriptor = os.open(candidate, os.O_RDONLY | os.O_CLOEXEC)
                try:
                    info = os.fstat(descriptor)
                    if (
                        not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                        or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) & expected_seals != expected_seals
                        or info.st_size > 4 * 1024 * 1024
                    ):
                        continue
                    digest = hashlib.sha256()
                    while True:
                        chunk = os.read(descriptor, 1024 * 1024)
                        if not chunk:
                            break
                        digest.update(chunk)
                    if hmac.compare_digest(
                        digest.hexdigest(), document["bootstrap_helper_sha256"]
                    ):
                        return True
                finally:
                    os.close(descriptor)
            except OSError:
                continue
    except (BootstrapError, OSError):
        return False
    return False


def _write_encrypted_document(
    path: Path,
    credential_name: str,
    document: dict[str, Any],
    *,
    create: bool,
) -> None:
    material = bytearray(_canonical(document))
    if len(material) > 2 * 1024 * 1024:
        _wipe(material)
        raise BootstrapError("escrow_failed", "An encrypted rollback document is oversized.")
    temporary = _escrow_staging_path(path)
    try:
        _reject_unexpected_escrow_staging()
        if os.path.lexists(temporary):
            staged = _decrypt_credential(credential_name, temporary, 2 * 1024 * 1024)
            try:
                if not hmac.compare_digest(staged, material):
                    raise BootstrapError(
                        "escrow_conflict", "An encrypted staging document differs."
                    )
            finally:
                _wipe(staged)
            if create and os.path.lexists(path):
                current = _decrypt_credential(credential_name, path, 2 * 1024 * 1024)
                try:
                    if not hmac.compare_digest(current, material):
                        raise BootstrapError(
                            "escrow_conflict", "A final encrypted document already differs."
                        )
                finally:
                    _wipe(current)
                _validated_staging_unlink(temporary)
                return
            os.replace(temporary, path)
            _fsync_directory(path.parent)
            return
        if create == os.path.lexists(path):
            raise BootstrapError("escrow_conflict", "An encrypted rollback document conflicts.")
        completed = subprocess.run(
            [
                "/usr/bin/systemd-creds", "encrypt", "--with-key=host+tpm2",
                f"--name={credential_name}", "-", str(temporary),
            ],
            check=False, input=material, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=60,
            pass_fds=_deployment_pass_fds(),
        )
        if completed.returncode != 0:
            raise BootstrapError("escrow_failed", "An encrypted rollback document could not be created.")
        os.chmod(temporary, 0o400)
        _validate_encrypted_file(temporary, maximum=2 * 1024 * 1024)
        verified = _decrypt_credential(credential_name, temporary, 2 * 1024 * 1024)
        try:
            if not hmac.compare_digest(verified, material):
                raise BootstrapError("escrow_failed", "Encrypted rollback verification differs.")
        finally:
            _wipe(verified)
        descriptor = os.open(temporary, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        _wipe(material)
        # The deterministic slot is deliberately retained if encryption was
        # interrupted after writing it. Transaction-aware recovery either
        # promotes or durably removes the validated ciphertext.


def _read_encrypted_document(path: Path, credential_name: str) -> dict[str, Any]:
    raw = _decrypt_credential(credential_name, path, 2 * 1024 * 1024)
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("escrow_failed", "An encrypted rollback document is invalid.") from exc
    finally:
        _wipe(raw)
    if not isinstance(document, dict):
        raise BootstrapError("escrow_failed", "An encrypted rollback document is invalid.")
    return document


def _validated_userpass_document(
    document: dict[str, Any], transaction: dict[str, Any]
) -> bytearray:
    if (
        set(document) != {"schema_version", "release_id", "password_base64"}
        or document.get("schema_version") != 1
        or document.get("release_id") != transaction.get("release_id")
        or not isinstance(document.get("password_base64"), str)
        or len(document["password_base64"]) > 1024
    ):
        raise BootstrapError("escrow_failed", "The userpass recovery escrow differs.")
    try:
        password = bytearray(base64.b64decode(document["password_base64"], validate=True))
        decoded = password.decode("utf-8", errors="strict")
    except (UnicodeError, ValueError) as exc:
        if "password" in locals():
            _wipe(password)
        raise BootstrapError("escrow_failed", "The userpass recovery escrow is invalid.") from exc
    if (
        not 14 <= len(decoded) <= 100
        or decoded != decoded.strip()
        or any(ord(character) < 32 or ord(character) == 127 for character in decoded)
    ):
        _wipe(password)
        raise BootstrapError("escrow_failed", "The userpass recovery escrow is invalid.")
    decoded = ""
    return password


def _undo_document_shape_is_valid(
    document: dict[str, Any], transaction: dict[str, Any]
) -> bool:
    return (
        set(document) == {
            "schema_version", "release_id", "captured_at", "roles",
            "policies", "kv", "poststate",
        }
        and document.get("schema_version") == 1
        and document.get("release_id") == transaction.get("release_id")
        and isinstance(document.get("captured_at"), int)
        and set(document.get("roles", {})) == set(OPENBAO_UNDO_ROLES)
        and set(document.get("policies", {})) == set(OPENBAO_UNDO_POLICIES)
        and set(document.get("kv", {})) == set(OPENBAO_UNDO_KV)
        and (
            document.get("poststate") is None
            or (
                isinstance(document.get("poststate"), dict)
                and set(document["poststate"]) == {"roles", "policies", "kv"}
            )
        )
    )


def _validated_staging_unlink(path: Path) -> None:
    metadata = os.lstat(path)
    if (
        not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o400
    ):
        raise BootstrapError("escrow_conflict", "A secret staging slot is unsafe.")
    path.unlink()
    _fsync_directory(path.parent)


def _validate_escrow_staging_frontier_readonly(
    transaction: dict[str, Any]
) -> list[Path]:
    """Validate only the three named encrypted staging slots without mutation."""

    _reject_unexpected_escrow_staging()
    present: list[Path] = []
    root_staging = _escrow_staging_path(ROOT_TOKEN_ESCROW)
    if os.path.lexists(root_staging):
        staged_root = _root_escrow_document_raw(root_staging)
        if transaction.get("root_generation_pending") is not True:
            raise BootstrapError(
                "escrow_conflict", "Root-token staging lacks durable generation intent."
            )
        if os.path.lexists(ROOT_TOKEN_ESCROW):
            current_root = _root_escrow_document_raw(ROOT_TOKEN_ESCROW)
            identity = ("nonce", "otp", "started_at")
            if any(staged_root[key] != current_root[key] for key in identity):
                raise BootstrapError(
                    "escrow_conflict", "The staged root-token attempt differs."
                )
            staged_progress = staged_root["progress"]
            current_progress = current_root["progress"]
            if (
                staged_progress < current_progress
                or (
                    staged_progress == current_progress
                    and staged_root == current_root
                )
                or staged_progress == current_progress + 1
            ):
                pass
            else:
                raise BootstrapError(
                    "escrow_conflict", "Root-token staging is non-monotonic."
                )
        present.append(root_staging)

    userpass_staging = _escrow_staging_path(USERPASS_PASSWORD_ESCROW)
    if os.path.lexists(userpass_staging):
        staged_userpass = _read_encrypted_document(
            userpass_staging, "ops-control-plane-bootstrap-userpass-password"
        )
        staged_password = _validated_userpass_document(
            staged_userpass, transaction
        )
        _wipe(staged_password)
        if os.path.lexists(USERPASS_PASSWORD_ESCROW):
            current_userpass = _read_encrypted_document(
                USERPASS_PASSWORD_ESCROW,
                "ops-control-plane-bootstrap-userpass-password",
            )
            current_password = _validated_userpass_document(
                current_userpass, transaction
            )
            _wipe(current_password)
            if staged_userpass != current_userpass:
                raise BootstrapError(
                    "escrow_conflict", "Userpass staging differs from escrow."
                )
        present.append(userpass_staging)

    undo_staging = _escrow_staging_path(OPENBAO_UNDO_ESCROW)
    if os.path.lexists(undo_staging):
        staged_undo = _read_encrypted_document(
            undo_staging, "ops-control-plane-bootstrap-openbao-undo"
        )
        if not _undo_document_shape_is_valid(staged_undo, transaction):
            raise BootstrapError(
                "escrow_conflict", "OpenBao undo staging differs."
            )
        if os.path.lexists(OPENBAO_UNDO_ESCROW):
            current_undo = _read_encrypted_document(
                OPENBAO_UNDO_ESCROW, "ops-control-plane-bootstrap-openbao-undo"
            )
            if not _undo_document_shape_is_valid(current_undo, transaction):
                raise BootstrapError(
                    "escrow_conflict", "The current OpenBao undo escrow differs."
                )
            same_prestate = all(
                staged_undo[key] == current_undo[key]
                for key in (
                    "schema_version", "release_id", "captured_at", "roles",
                    "policies", "kv",
                )
            )
            if staged_undo != current_undo and (
                not same_prestate
                or current_undo.get("poststate") is not None
                or not isinstance(staged_undo.get("poststate"), dict)
                or transaction.get("openbao_undo_escrowed") is not True
                or transaction.get("openbao_provisioning_started") is not True
            ):
                raise BootstrapError(
                    "escrow_conflict", "OpenBao undo staging is not monotonic."
                )
        elif not (
            transaction.get("openbao_undo_write_started") is True
            or transaction.get("openbao_undo_escrowed") is True
            or transaction.get("openbao_provisioning_started") is False
        ):
            raise BootstrapError(
                "escrow_conflict", "OpenBao undo staging lacks durable intent."
            )
        present.append(undo_staging)
    return present


def _reconcile_nonroot_escrow_staging(transaction: dict[str, Any]) -> None:
    """Resolve deterministic userpass/undo staging slots under the WAL."""

    _reject_unexpected_escrow_staging()
    userpass_staging = _escrow_staging_path(USERPASS_PASSWORD_ESCROW)
    if os.path.lexists(userpass_staging):
        staged = _read_encrypted_document(
            userpass_staging, "ops-control-plane-bootstrap-userpass-password"
        )
        staged_password = _validated_userpass_document(staged, transaction)
        _wipe(staged_password)
        if os.path.lexists(USERPASS_PASSWORD_ESCROW):
            current = _read_encrypted_document(
                USERPASS_PASSWORD_ESCROW,
                "ops-control-plane-bootstrap-userpass-password",
            )
            current_password = _validated_userpass_document(current, transaction)
            _wipe(current_password)
            if staged != current:
                raise BootstrapError("escrow_conflict", "Userpass staging differs from escrow.")
            _validated_staging_unlink(userpass_staging)
        elif (
            transaction.get("password_recovery_started") is True
            or transaction.get("userpass_password_escrowed") is True
        ):
            os.replace(userpass_staging, USERPASS_PASSWORD_ESCROW)
            _fsync_directory(USERPASS_PASSWORD_ESCROW.parent)
        else:
            # Encryption had not returned, so no userpass PUT could follow.
            _validated_staging_unlink(userpass_staging)

    undo_staging = _escrow_staging_path(OPENBAO_UNDO_ESCROW)
    if not os.path.lexists(undo_staging):
        return
    staged_undo = _read_encrypted_document(
        undo_staging, "ops-control-plane-bootstrap-openbao-undo"
    )
    if not _undo_document_shape_is_valid(staged_undo, transaction):
        raise BootstrapError("escrow_conflict", "OpenBao undo staging differs.")
    if os.path.lexists(OPENBAO_UNDO_ESCROW):
        current_undo = _read_encrypted_document(
            OPENBAO_UNDO_ESCROW, "ops-control-plane-bootstrap-openbao-undo"
        )
        if not _undo_document_shape_is_valid(current_undo, transaction):
            raise BootstrapError("escrow_conflict", "The current OpenBao undo escrow differs.")
        if staged_undo == current_undo:
            _validated_staging_unlink(undo_staging)
            return
        same_prestate = all(
            staged_undo[key] == current_undo[key]
            for key in ("schema_version", "release_id", "captured_at", "roles", "policies", "kv")
        )
        if (
            not same_prestate
            or current_undo.get("poststate") is not None
            or not isinstance(staged_undo.get("poststate"), dict)
            or transaction.get("openbao_undo_escrowed") is not True
            or transaction.get("openbao_provisioning_started") is not True
        ):
            raise BootstrapError("escrow_conflict", "OpenBao undo staging is not monotonic.")
        os.replace(undo_staging, OPENBAO_UNDO_ESCROW)
        _fsync_directory(OPENBAO_UNDO_ESCROW.parent)
        return
    if (
        transaction.get("openbao_undo_write_started") is True
        or transaction.get("openbao_undo_escrowed") is True
    ):
        os.replace(undo_staging, OPENBAO_UNDO_ESCROW)
        _fsync_directory(OPENBAO_UNDO_ESCROW.parent)
        return
    if transaction.get("openbao_provisioning_started") is True:
        raise BootstrapError("rollback_failed", "Provisioning has only an uncommitted undo slot.")
    _validated_staging_unlink(undo_staging)


def _escrow_userpass_password(
    password: bytearray, transaction: dict[str, Any]
) -> None:
    """Persist the physical recovery input only as host+TPM ciphertext."""

    try:
        decoded = password.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        raise BootstrapError("userpass_failed", "The recovered password is invalid.") from exc
    if (
        not 14 <= len(decoded) <= 100
        or decoded != decoded.strip()
        or any(ord(character) < 32 or ord(character) == 127 for character in decoded)
    ):
        raise BootstrapError("userpass_failed", "The recovered password is invalid.")
    encoded = base64.b64encode(bytes(password)).decode("ascii")
    try:
        _write_encrypted_document(
            USERPASS_PASSWORD_ESCROW,
            "ops-control-plane-bootstrap-userpass-password",
            {
                "schema_version": 1,
                "release_id": transaction["release_id"],
                "password_base64": encoded,
            },
            create=True,
        )
        # A crash after the ciphertext rename but before this WAL is handled
        # by _finalize_recovered_userpass, which treats the reviewed escrow as
        # authoritative intent and materializes these flags before replay.
        _set_transaction(
            transaction,
            phase="password-recovery-escrowed",
            password_recovery_started=True,
            password_recovery_persists=True,
            userpass_password_escrowed=True,
        )
    finally:
        decoded = ""
        encoded = ""


def _userpass_password_from_escrow(transaction: dict[str, Any]) -> bytearray:
    document = _read_encrypted_document(
        USERPASS_PASSWORD_ESCROW,
        "ops-control-plane-bootstrap-userpass-password",
    )
    return _validated_userpass_document(document, transaction)


def _apply_short_lived_userpass(password: bytearray, root_token: str) -> None:
    """Replay the account reset and prove login with a <=2 minute token."""

    human_token: str | None = None
    decoded = password.decode("utf-8", errors="strict")
    try:
        openbao_request(
            "PUT",
            "/v1/auth/userpass/users/ops-user",
            payload={
                "password": decoded,
                "token_policies": ["token-self", "human-admin"],
                "token_ttl": "2m",
                "token_max_ttl": "2m",
            },
            token=root_token,
            allowed_statuses=frozenset({200, 204}),
        )
        _, login = openbao_request(
            "POST",
            "/v1/auth/userpass/login/ops-user",
            payload={"password": decoded},
            allowed_statuses=frozenset({200}),
        )
        auth = login.get("auth") if isinstance(login, dict) else None
        human_token = auth.get("client_token") if isinstance(auth, dict) else None
        if not isinstance(human_token, str) or not TOKEN_RE.fullmatch(human_token):
            raise BootstrapError("userpass_failed", "The recovered human login failed.")
        _, lookup = openbao_request("GET", "/v1/auth/token/lookup-self", token=human_token)
        data = lookup.get("data") if isinstance(lookup, dict) else None
        policies = data.get("policies") if isinstance(data, dict) else None
        ttl = data.get("ttl") if isinstance(data, dict) else None
        if (
            not isinstance(policies, list)
            or not {"token-self", "human-admin"}.issubset(set(policies))
            or isinstance(ttl, bool)
            or not isinstance(ttl, int)
            or not 0 < ttl <= 120
        ):
            raise BootstrapError("userpass_failed", "The recovered human account is unsafe.")
    finally:
        decoded = ""
        if human_token is not None:
            _revoke_token(human_token)


def _root_token_from_escrow() -> str:
    document = _root_escrow_document()
    if not isinstance(document.get("encoded_token"), str) or document.get("progress") != 2:
        raise BootstrapError("escrow_pending", "The root recovery escrow is not complete.")
    return _decode_root_token(document["encoded_token"], document["otp"])


def _remove_escrow() -> None:
    _reconcile_root_escrow_staging()
    ROOT_TOKEN_ESCROW.unlink(missing_ok=True)
    _fsync_directory(ROOT_TOKEN_ESCROW.parent)


def _recover_or_cancel_root_generation(
    worker: dict[str, Any], transaction: dict[str, Any]
) -> None:
    """Resolve only the nonce-bound attempt recorded by this transaction."""

    if transaction.get("root_generation_pending") is not True:
        return
    _reconcile_root_escrow_staging()
    escrow = _root_escrow_document() if ROOT_TOKEN_ESCROW.exists() else None
    if (
        escrow is not None
        and escrow.get("started_at") != transaction.get("root_generation_started_at")
    ):
        raise BootstrapError("escrow_conflict", "The root escrow transaction epoch differs.")
    if (
        isinstance(escrow, dict)
        and escrow.get("progress") == 2
        and isinstance(escrow.get("encoded_token"), str)
        and transaction.get("root_attempt_closed") is True
    ):
        return
    original = _read_root_file(Path(transaction["openbao_backup"]), 256 * 1024, private=True)
    installed = _read_root_file(OPENBAO_CONFIG, 256 * 1024, private=False)
    opened_here = TEMPORARY_UNIX_LISTENER not in installed
    if opened_here:
        _set_transaction(transaction, openbao_restore_required=True, phase="root-generation-recovery")
        _prepare_recovery_socket_directory(transaction)
        _write_openbao_config(original.rstrip() + b"\n" + TEMPORARY_UNIX_LISTENER)
        _restart_openbao(worker)
    else:
        _wait_openbao()
    try:
        _, attempt = openbao_recovery_request(
            "GET", "/v1/sys/generate-root/attempt", allowed_statuses=frozenset({200})
        )
        if not isinstance(attempt, dict) or not isinstance(attempt.get("started"), bool):
            raise BootstrapError("openbao_invalid", "OpenBao returned invalid recovery-attempt state.")
        if attempt.get("started") is False:
            if escrow is not None and escrow.get("progress") == 1:
                # OpenBao clears a completed attempt before emitting the final
                # response. Generate a new nonce-bound root token, preserving
                # the original cutoff; it can enumerate and revoke the orphan
                # accessor before revoking itself.
                if (
                    transaction.get("root_remint_required") is True
                    and transaction.get("root_generation_remints") != 0
                ):
                    raise BootstrapError(
                        "root_generation_ambiguous",
                        "A second root generation response was lost; manual recovery is required.",
                    )
                _set_transaction(
                    transaction,
                    root_remint_required=True,
                    root_token_escrowed=False,
                    phase="root-generation-remint-required",
                )
                _remove_escrow()
                _, replacement_otp = generate_root_material(transaction)
                _wipe(replacement_otp)
                return
            if escrow is not None and escrow.get("progress") == 2:
                _set_transaction(transaction, root_attempt_closed=True, phase="root-attempt-closed")
                return
            if transaction.get("root_remint_required") is True:
                if escrow is not None:
                    _set_transaction(transaction, root_token_escrowed=False)
                    _remove_escrow()
                _, replacement_otp = generate_root_material(transaction)
                _wipe(replacement_otp)
                return
            if escrow is None or escrow.get("progress") != 2:
                _remove_escrow()
                _set_transaction(
                    transaction,
                    root_generation_pending=False,
                    root_token_escrowed=False,
                    root_remint_required=False,
                    root_attempt_closed=True,
                    phase="root-generation-cancelled",
                )
            return
        if attempt.get("required") != 2 or attempt.get("progress") not in {0, 1, 2}:
            raise BootstrapError("openbao_invalid", "OpenBao root-attempt progress is invalid.")
        if escrow is None:
            # POST may have committed while its response was lost. With zero
            # submitted shares no token exists, so the private, newly-created
            # attempt can be cancelled safely.
            if attempt.get("progress") != 0:
                raise BootstrapError("openbao_invalid", "Unescrowed root shares were submitted.")
        elif attempt.get("nonce") != escrow["nonce"]:
            raise BootstrapError("openbao_invalid", "OpenBao root-attempt nonce differs from escrow.")
        complete = attempt.get("complete") is True
        encoded = attempt.get("encoded_token") or attempt.get("encoded_root_token")
        if complete:
            if escrow is None or not isinstance(encoded, str):
                raise BootstrapError("openbao_invalid", "Completed root material is unavailable.")
            otp = bytearray(escrow["otp"].encode("ascii", errors="strict"))
            try:
                _escrow_root_material(
                    nonce=escrow["nonce"], otp=otp, encoded_token=encoded,
                    progress=2, started_at=escrow["started_at"], create=False,
                )
            finally:
                _wipe(otp)
            openbao_recovery_request(
                "DELETE", "/v1/sys/generate-root/attempt",
                allowed_statuses=frozenset({200, 204, 400, 404}),
            )
            _, closed = openbao_recovery_request(
                "GET", "/v1/sys/generate-root/attempt", allowed_statuses=frozenset({200})
            )
            if not isinstance(closed, dict) or closed.get("started") is not False:
                raise BootstrapError("openbao_invalid", "Recovered root-attempt closure was not confirmed.")
            _set_transaction(transaction, root_attempt_closed=True, phase="root-attempt-closed")
            return

        if escrow is None:
            # No share was accepted.  Cancel the harmless unescrowed attempt;
            # a required remint is then initialized again from clean state.
            openbao_recovery_request(
                "DELETE", "/v1/sys/generate-root/attempt",
                allowed_statuses=frozenset({200, 204, 400, 404}),
            )
            _, closed = openbao_recovery_request(
                "GET", "/v1/sys/generate-root/attempt", allowed_statuses=frozenset({200})
            )
            if not isinstance(closed, dict) or closed.get("started") is not False:
                raise BootstrapError("openbao_invalid", "Unescrowed root-attempt closure failed.")
            if transaction.get("root_remint_required") is True:
                _, replacement_otp = generate_root_material(transaction)
                _wipe(replacement_otp)
                return
            _set_transaction(
                transaction,
                root_generation_pending=False,
                root_token_escrowed=False,
                root_remint_required=False,
                root_attempt_closed=True,
                phase="root-generation-cancelled",
            )
            return

        attempt_progress = attempt.get("progress")
        escrow_progress = escrow.get("progress")
        if (
            not isinstance(escrow_progress, int)
            or attempt_progress < escrow_progress
            or attempt_progress > escrow_progress + 1
        ):
            raise BootstrapError("openbao_invalid", "OpenBao root-attempt progress drifted.")
        otp = bytearray(escrow["otp"].encode("ascii", errors="strict"))
        try:
            if attempt_progress != escrow_progress:
                _escrow_root_material(
                    nonce=escrow["nonce"], otp=otp, encoded_token=None,
                    progress=attempt_progress, started_at=escrow["started_at"], create=False,
                )
            prior_windows = list(transaction["root_final_share_windows"])
            current_window_floor = 1 if transaction.get("root_remint_required") is True else 0
            _complete_root_attempt(
                transaction,
                escrow["nonce"],
                otp,
                attempt_progress,
                retry_final_share=(
                    attempt_progress == 1 and len(prior_windows) > current_window_floor
                ),
            )
        finally:
            _wipe(otp)
    finally:
        _write_openbao_config(original)
        _restart_openbao(worker)
        _set_transaction(transaction, openbao_restore_required=False)
        _cleanup_recovery_socket_directory(transaction)


def _revoke_token(token: str) -> None:
    status, _ = openbao_request(
        "GET", "/v1/auth/token/lookup-self", token=token,
        allowed_statuses=frozenset({200, 400, 403}),
    )
    if status in {400, 403}:
        return
    openbao_request(
        "POST", "/v1/auth/token/revoke-self", token=token,
        allowed_statuses=frozenset({200, 204, 400, 403}),
    )
    status, _ = openbao_request(
        "GET", "/v1/auth/token/lookup-self", token=token,
        allowed_statuses=frozenset({400, 403}),
    )
    if status not in {400, 403}:
        raise BootstrapError("token_revocation_failed", "OpenBao token revocation was not confirmed.")


def _reconcile_generated_root_tokens(
    token: str, windows: list[dict[str, int]]
) -> None:
    """Revoke orphaned generate-root tokens from this bounded transaction."""

    if (
        not windows or len(windows) > 2
        or any(
            not isinstance(window, dict) or set(window) != {"start", "end"}
            or not isinstance(window.get("start"), int)
            or not isinstance(window.get("end"), int)
            or window["start"] <= 0
            or not window["start"] <= window["end"] <= window["start"] + 10
            for window in windows
        )
    ):
        raise BootstrapError("token_reconciliation_failed", "Root generation windows are invalid.")
    deadline = time.monotonic() + 60
    _, own_lookup = openbao_request("GET", "/v1/auth/token/lookup-self", token=token)
    own_data = own_lookup.get("data") if isinstance(own_lookup, dict) else None
    own_accessor = own_data.get("accessor") if isinstance(own_data, dict) else None
    if (
        not isinstance(own_accessor, str) or not TOKEN_RE.fullmatch(own_accessor)
        or own_data.get("policies") != ["root"]
        or own_data.get("display_name") != "root"
        or own_data.get("path") != "auth/token/root"
        or own_data.get("orphan") is not True
        or own_data.get("ttl") != 0
        or not isinstance(own_data.get("creation_time"), int)
        or not any(
            window["start"] <= own_data["creation_time"] <= window["end"]
            for window in windows
        )
    ):
        raise BootstrapError("token_reconciliation_failed", "The current root accessor is invalid.")
    _, listing = openbao_request("LIST", "/v1/auth/token/accessors", token=token)
    listing_data = listing.get("data") if isinstance(listing, dict) else None
    keys = listing_data.get("keys") if isinstance(listing_data, dict) else None
    if not isinstance(keys, list) or len(keys) > 256:
        raise BootstrapError("token_reconciliation_failed", "The token accessor list is invalid.")
    candidates: list[str] = []
    for accessor in keys:
        if time.monotonic() > deadline:
            raise BootstrapError("token_reconciliation_failed", "Root accessor reconciliation timed out.")
        if not isinstance(accessor, str) or not TOKEN_RE.fullmatch(accessor):
            raise BootstrapError("token_reconciliation_failed", "A token accessor is invalid.")
        lookup_status, lookup = openbao_request(
            "POST", "/v1/auth/token/lookup-accessor",
            payload={"accessor": accessor}, token=token,
            allowed_statuses=frozenset({200, 400}),
        )
        if lookup_status == 400:
            continue
        data = lookup.get("data") if isinstance(lookup, dict) else None
        if not isinstance(data, dict):
            raise BootstrapError("token_reconciliation_failed", "A token accessor lookup is invalid.")
        created = data.get("creation_time")
        policies = data.get("policies")
        profile_matches = (
            isinstance(created, int)
            and any(window["start"] <= created <= window["end"] for window in windows)
            and policies == ["root"]
            and data.get("display_name") == "root"
            and data.get("path") == "auth/token/root"
            and data.get("orphan") is True
            and data.get("ttl") == 0
        )
        if profile_matches and accessor != own_accessor:
            candidates.append(accessor)
    for accessor in sorted(candidates):
        openbao_request(
            "POST", "/v1/auth/token/revoke-accessor",
            payload={"accessor": accessor}, token=token,
            allowed_statuses=frozenset({200, 204, 400}),
        )
        # A 400 revoke response is ambiguous (already absent or rejected).
        # Re-read every candidate and require authoritative absence before the
        # reconciliation WAL can become terminal.
        revoked_status, _ = openbao_request(
            "POST", "/v1/auth/token/lookup-accessor",
            payload={"accessor": accessor}, token=token,
            allowed_statuses=frozenset({200, 400}),
        )
        if revoked_status != 400:
            raise BootstrapError(
                "token_reconciliation_failed",
                "A generated root token accessor remains after revocation.",
            )


def _finalize_root_token(transaction: dict[str, Any]) -> None:
    """Reconcile, revoke and erase the generated root token idempotently."""

    _reconcile_root_escrow_staging()
    if (
        transaction.get("root_generation_pending") is False
        and transaction.get("root_token_escrowed") is False
        and transaction.get("root_reconciliation_complete") is True
    ):
        # A crash after the fsynced revocation WAL but before unlink leaves an
        # encrypted, already-revoked token blob.  The WAL is authoritative and
        # makes this cleanup safe without trying to use stale authority.
        if os.path.lexists(ROOT_TOKEN_ESCROW):
            _remove_escrow()
        return
    if not ROOT_TOKEN_ESCROW.exists():
        if transaction.get("root_generation_pending") is True:
            raise BootstrapError("escrow_failed", "The pending root token has no escrow.")
        return
    token = _root_token_from_escrow()
    try:
        status, _ = openbao_request(
            "GET", "/v1/auth/token/lookup-self", token=token,
            allowed_statuses=frozenset({200, 400, 403}),
        )
        if status in {400, 403} and transaction.get("root_reconciliation_complete") is not True:
            raise BootstrapError(
                "token_reconciliation_failed",
                "The root token disappeared before accessor reconciliation was committed.",
            )
        if status == 200:
            if transaction.get("root_reconciliation_complete") is not True:
                _reconcile_generated_root_tokens(
                    token, list(transaction["root_final_share_windows"])
                )
                _set_transaction(
                    transaction,
                    root_reconciliation_complete=True,
                    phase="root-tokens-reconciled",
                )
            _revoke_token(token)
    finally:
        token = ""
    # Persist the terminal authority state before deleting its encrypted
    # recovery material.  If power is lost after revoke-self, the committed
    # reconciliation flag permits this exact transition to be replayed.
    _set_transaction(
        transaction,
        root_generation_pending=False,
        root_token_escrowed=False,
        root_remint_required=False,
        root_attempt_closed=True,
        root_reconciliation_complete=True,
        phase="root-token-revoked",
    )
    _remove_escrow()


def _response_data(document: dict[str, Any] | None, location: str) -> dict[str, Any]:
    data = document.get("data") if isinstance(document, dict) else None
    if not isinstance(data, dict):
        raise BootstrapError("openbao_invalid", f"OpenBao returned invalid {location} data.")
    return data


def _role_accessors(token: str, role: str, *, allow_absent: bool) -> list[str] | None:
    status, document = openbao_request(
        "LIST", f"/v1/auth/approle/role/{role}/secret-id", token=token,
        allowed_statuses=frozenset({200, 404}),
    )
    if status == 404:
        return None if allow_absent else []
    keys = _response_data(document, "AppRole accessor").get("keys")
    if not isinstance(keys, list) or len(keys) > 4096:
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid AppRole accessors.")
    if any(not isinstance(value, str) or not TOKEN_RE.fullmatch(value) for value in keys):
        raise BootstrapError("openbao_invalid", "OpenBao returned an invalid AppRole accessor.")
    return sorted(set(keys))


def _capture_openbao_managed_state(token: str) -> dict[str, Any]:
    """Capture the exact managed server state without exposing response bodies."""

    roles: dict[str, Any] = {}
    for role in OPENBAO_UNDO_ROLES:
        status, document = openbao_request(
            "GET", f"/v1/auth/approle/role/{role}", token=token,
            allowed_statuses=frozenset({200, 404}),
        )
        roles[role] = (
            None
            if status == 404
            else {
                "configuration": _response_data(document, "AppRole"),
                "accessors": _role_accessors(token, role, allow_absent=False),
            }
        )
    policies: dict[str, Any] = {}
    for policy in OPENBAO_UNDO_POLICIES:
        status, document = openbao_request(
            "GET", f"/v1/sys/policies/acl/{policy}", token=token,
            allowed_statuses=frozenset({200, 404}),
        )
        if status == 404:
            policies[policy] = None
        else:
            rules = _response_data(document, "policy").get("policy")
            if not isinstance(rules, str) or not 1 <= len(rules) <= 64 * 1024:
                raise BootstrapError("openbao_invalid", "OpenBao returned an invalid ACL policy.")
            policies[policy] = rules
    kv: dict[str, Any] = {}
    for name, (data_path, metadata_path, _) in OPENBAO_UNDO_KV.items():
        status, document = openbao_request(
            "GET", data_path, token=token, allowed_statuses=frozenset({200, 404})
        )
        if status == 404:
            metadata_status, _ = openbao_request(
                "GET", metadata_path, token=token, allowed_statuses=frozenset({200, 404})
            )
            if metadata_status == 200:
                raise BootstrapError(
                    "openbao_state_conflict",
                    "A managed KV path has pre-existing hidden version history.",
                )
            kv[name] = None
            continue
        envelope = _response_data(document, "KV")
        values = envelope.get("data")
        metadata = envelope.get("metadata")
        version = metadata.get("version") if isinstance(metadata, dict) else None
        if not isinstance(values, dict) or not isinstance(version, int) or version < 1:
            raise BootstrapError("openbao_invalid", "OpenBao returned invalid KV state.")
        kv[name] = {"data": values, "version": version}
    return {"roles": roles, "policies": policies, "kv": kv}


def _snapshot_openbao_undo(transaction: dict[str, Any]) -> None:
    if os.path.lexists(OPENBAO_UNDO_ESCROW):
        raise BootstrapError("escrow_conflict", "An OpenBao undo escrow already exists.")
    token = _root_token_from_escrow()
    try:
        for role in OPENBAO_FORBIDDEN_LEGACY_ROLES:
            status, _ = openbao_request(
                "GET", f"/v1/auth/approle/role/{role}", token=token,
                allowed_statuses=frozenset({200, 404}),
            )
            if status != 404:
                raise BootstrapError(
                    "openbao_state_conflict", "A retired OpenBao AppRole is still present."
                )
        roles: dict[str, Any] = {}
        for role in OPENBAO_UNDO_ROLES:
            status, document = openbao_request(
                "GET", f"/v1/auth/approle/role/{role}", token=token,
                allowed_statuses=frozenset({200, 404}),
            )
            if status == 404:
                roles[role] = None
            else:
                roles[role] = {
                    "configuration": _response_data(document, "AppRole"),
                    "accessors": _role_accessors(token, role, allow_absent=False),
                }
        policies: dict[str, Any] = {}
        for policy in OPENBAO_UNDO_POLICIES:
            status, document = openbao_request(
                "GET", f"/v1/sys/policies/acl/{policy}", token=token,
                allowed_statuses=frozenset({200, 404}),
            )
            if status == 404:
                policies[policy] = None
            else:
                data = _response_data(document, "policy")
                rules = data.get("policy")
                if not isinstance(rules, str) or not 1 <= len(rules) <= 64 * 1024:
                    raise BootstrapError("openbao_invalid", "OpenBao returned an invalid ACL policy.")
                policies[policy] = rules
        kv: dict[str, Any] = {}
        for name, (data_path, metadata_path, _) in OPENBAO_UNDO_KV.items():
            status, document = openbao_request(
                "GET", data_path, token=token, allowed_statuses=frozenset({200, 404})
            )
            if status == 404:
                metadata_status, _ = openbao_request(
                    "GET", metadata_path, token=token,
                    allowed_statuses=frozenset({200, 404}),
                )
                if metadata_status == 200:
                    # A soft-deleted/destroyed current version can return 404
                    # while older KV v2 history still exists. Treating it as a
                    # new object would make rollback DELETE that prior history.
                    raise BootstrapError(
                        "openbao_state_conflict",
                        "A managed KV path has pre-existing hidden version history.",
                    )
                kv[name] = None
            else:
                envelope = _response_data(document, "KV")
                values = envelope.get("data")
                metadata = envelope.get("metadata")
                version = metadata.get("version") if isinstance(metadata, dict) else None
                if not isinstance(values, dict) or not isinstance(version, int) or version < 1:
                    raise BootstrapError("openbao_invalid", "OpenBao returned invalid KV state.")
                kv[name] = {"data": values, "version": version}
        undo = {
            "schema_version": 1,
            "release_id": transaction["release_id"],
            "captured_at": int(time.time()),
            "roles": roles,
            "policies": policies,
            "kv": kv,
            "poststate": None,
        }
        _set_transaction(
            transaction,
            openbao_undo_write_started=True,
            phase="openbao-undo-escrow-starting",
        )
        _write_encrypted_document(
            OPENBAO_UNDO_ESCROW,
            "ops-control-plane-bootstrap-openbao-undo",
            undo,
            create=True,
        )
        _set_transaction(
            transaction,
            openbao_undo_escrowed=True,
            openbao_undo_write_started=False,
            openbao_undo_complete=False,
            phase="openbao-undo-escrowed",
        )
    finally:
        token = ""


def _record_openbao_poststate(transaction: dict[str, Any]) -> None:
    """Bind rollback to the exact state left by this exclusive transaction."""

    if transaction.get("openbao_poststate_recorded") is True:
        return
    if transaction.get("openbao_undo_escrowed") is not True:
        raise BootstrapError("rollback_failed", "OpenBao poststate has no undo escrow.")
    undo = _read_encrypted_document(
        OPENBAO_UNDO_ESCROW, "ops-control-plane-bootstrap-openbao-undo"
    )
    if set(undo) != {
        "schema_version", "release_id", "captured_at", "roles", "policies", "kv", "poststate"
    } or undo.get("release_id") != transaction["release_id"]:
        raise BootstrapError("rollback_failed", "The OpenBao undo escrow differs.")
    token = _root_token_from_escrow()
    try:
        observed = _capture_openbao_managed_state(token)
        prior_poststate = undo.get("poststate")
        if prior_poststate is not None and prior_poststate != observed:
            raise BootstrapError(
                "rollback_conflict", "Managed OpenBao state changed after its poststate was recorded."
            )
        if prior_poststate is None:
            undo["poststate"] = observed
            _write_encrypted_document(
                OPENBAO_UNDO_ESCROW,
                "ops-control-plane-bootstrap-openbao-undo",
                undo,
                create=False,
            )
        _set_transaction(
            transaction,
            openbao_poststate_recorded=True,
            phase="openbao-poststate-recorded",
        )
    finally:
        token = ""


def _undo_openbao_state(transaction: dict[str, Any]) -> None:
    if transaction.get("openbao_undo_complete") is True:
        OPENBAO_UNDO_ESCROW.unlink(missing_ok=True)
        _fsync_directory(OPENBAO_UNDO_ESCROW.parent)
        return
    if transaction.get("openbao_undo_escrowed") is not True:
        if transaction.get("openbao_provisioning_started") is True:
            raise BootstrapError("rollback_failed", "OpenBao provisioning has no undo escrow.")
        if os.path.lexists(OPENBAO_UNDO_ESCROW):
            metadata = os.lstat(OPENBAO_UNDO_ESCROW)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or stat.S_ISLNK(metadata.st_mode)
                or metadata.st_uid != 0
                or stat.S_IMODE(metadata.st_mode) != 0o400
            ):
                raise BootstrapError("rollback_failed", "The unused OpenBao undo escrow is unsafe.")
            unused = _read_encrypted_document(
                OPENBAO_UNDO_ESCROW, "ops-control-plane-bootstrap-openbao-undo"
            )
            if (
                set(unused) != {
                    "schema_version", "release_id", "captured_at", "roles",
                    "policies", "kv", "poststate",
                }
                or unused.get("schema_version") != 1
                or unused.get("release_id") != transaction["release_id"]
                or unused.get("poststate") is not None
                or set(unused.get("roles", {})) != set(OPENBAO_UNDO_ROLES)
                or set(unused.get("policies", {})) != set(OPENBAO_UNDO_POLICIES)
                or set(unused.get("kv", {})) != set(OPENBAO_UNDO_KV)
            ):
                raise BootstrapError("rollback_failed", "The unused OpenBao undo escrow differs.")
            OPENBAO_UNDO_ESCROW.unlink()
            _fsync_directory(OPENBAO_UNDO_ESCROW.parent)
        _set_transaction(
            transaction,
            openbao_undo_write_started=False,
            openbao_undo_complete=True,
            phase="openbao-undo-unused",
        )
        return
    undo = _read_encrypted_document(
        OPENBAO_UNDO_ESCROW, "ops-control-plane-bootstrap-openbao-undo"
    )
    if (
        set(undo) != {
            "schema_version", "release_id", "captured_at", "roles", "policies", "kv", "poststate"
        }
        or undo.get("schema_version") != 1
        or undo.get("release_id") != transaction["release_id"]
        or set(undo.get("roles", {})) != set(OPENBAO_UNDO_ROLES)
        or set(undo.get("policies", {})) != set(OPENBAO_UNDO_POLICIES)
        or set(undo.get("kv", {})) != set(OPENBAO_UNDO_KV)
    ):
        raise BootstrapError("rollback_failed", "The OpenBao undo escrow differs.")
    token = _root_token_from_escrow()
    try:
        if transaction.get("openbao_provisioning_started") is True:
            poststate = undo.get("poststate")
            if (
                transaction.get("openbao_poststate_recorded") is not True
                or not isinstance(poststate, dict)
                or set(poststate) != {"roles", "policies", "kv"}
            ):
                raise BootstrapError("rollback_failed", "OpenBao poststate was not recorded.")
            if transaction.get("openbao_undo_started") is not True:
                if _capture_openbao_managed_state(token) != poststate:
                    raise BootstrapError(
                        "rollback_conflict",
                        "Managed OpenBao state changed after provisioning; rollback is fail-closed.",
                    )
                _set_transaction(
                    transaction,
                    openbao_undo_started=True,
                    phase="openbao-undo-started",
                )
        for role in OPENBAO_UNDO_ROLES:
            before = undo["roles"][role]
            role_path = f"/v1/auth/approle/role/{role}"
            if before is None:
                openbao_request(
                    "DELETE", role_path, token=token,
                    allowed_statuses=frozenset({200, 204, 404}),
                )
                role_status, _ = openbao_request(
                    "GET", role_path, token=token,
                    allowed_statuses=frozenset({200, 404}),
                )
                if role_status != 404:
                    raise BootstrapError("rollback_failed", "A newly-created AppRole remains.")
                continue
            if not isinstance(before, dict) or set(before) != {"configuration", "accessors"}:
                raise BootstrapError("rollback_failed", "Saved AppRole state is invalid.")
            expected_accessors = before["accessors"]
            if not isinstance(expected_accessors, list):
                raise BootstrapError("rollback_failed", "Saved AppRole accessors are invalid.")
            current_accessors = _role_accessors(token, role, allow_absent=True)
            if current_accessors is None:
                current_accessors = []
            for accessor in sorted(set(current_accessors) - set(expected_accessors)):
                openbao_request(
                    "POST", f"{role_path}/secret-id-accessor/destroy",
                    payload={"secret_id_accessor": accessor}, token=token,
                    allowed_statuses=frozenset({200, 204, 400, 404}),
                )
            configuration = before["configuration"]
            if not isinstance(configuration, dict):
                raise BootstrapError("rollback_failed", "Saved AppRole configuration is invalid.")
            openbao_request(
                "POST", role_path, payload=configuration, token=token,
                allowed_statuses=frozenset({200, 204}),
            )
            _, restored_role = openbao_request("GET", role_path, token=token)
            if _response_data(restored_role, "restored AppRole") != configuration:
                raise BootstrapError("rollback_failed", "An AppRole configuration was not restored.")
            restored_accessors = _role_accessors(token, role, allow_absent=False)
            if set(restored_accessors or []) != set(expected_accessors):
                raise BootstrapError("rollback_failed", "AppRole SecretIDs were not restored exactly.")
        for policy in OPENBAO_UNDO_POLICIES:
            before_policy = undo["policies"][policy]
            policy_path = f"/v1/sys/policies/acl/{policy}"
            if before_policy is None:
                openbao_request(
                    "DELETE", policy_path, token=token,
                    allowed_statuses=frozenset({200, 204, 404}),
                )
            elif isinstance(before_policy, str):
                openbao_request(
                    "PUT", policy_path, payload={"policy": before_policy}, token=token,
                    allowed_statuses=frozenset({200, 204}),
                )
            else:
                raise BootstrapError("rollback_failed", "Saved ACL policy is invalid.")
            policy_status, restored_policy = openbao_request(
                "GET", policy_path, token=token,
                allowed_statuses=frozenset({200, 404}),
            )
            if before_policy is None:
                if policy_status != 404:
                    raise BootstrapError("rollback_failed", "A newly-created ACL policy remains.")
            elif (
                policy_status != 200
                or _response_data(restored_policy, "restored policy").get("policy") != before_policy
            ):
                raise BootstrapError("rollback_failed", "An ACL policy was not restored.")
        for name, (data_path, metadata_path, destroy_path) in OPENBAO_UNDO_KV.items():
            before_kv = undo["kv"][name]
            status, current_document = openbao_request(
                "GET", data_path, token=token, allowed_statuses=frozenset({200, 404})
            )
            if before_kv is None:
                openbao_request(
                    "DELETE", metadata_path, token=token,
                    allowed_statuses=frozenset({200, 204, 404}),
                )
                data_status, _ = openbao_request(
                    "GET", data_path, token=token, allowed_statuses=frozenset({200, 404})
                )
                metadata_status, _ = openbao_request(
                    "GET", metadata_path, token=token, allowed_statuses=frozenset({200, 404})
                )
                if data_status != 404 or metadata_status != 404:
                    raise BootstrapError("rollback_failed", "A newly-created KV object remains.")
                continue
            if not isinstance(before_kv, dict) or set(before_kv) != {"data", "version"}:
                raise BootstrapError("rollback_failed", "Saved KV state is invalid.")
            before_values = before_kv["data"]
            before_version = before_kv["version"]
            if (
                not isinstance(before_values, dict)
                or isinstance(before_version, bool)
                or not isinstance(before_version, int)
                or before_version < 1
            ):
                raise BootstrapError("rollback_failed", "Saved KV state is invalid.")
            current_values: dict[str, Any] | None = None
            if status == 200:
                current_envelope = _response_data(current_document, "KV")
                current_values = current_envelope.get("data")
            metadata_status, metadata_document = openbao_request(
                "GET", metadata_path, token=token, allowed_statuses=frozenset({200, 404})
            )
            metadata_data = (
                _response_data(metadata_document, "KV metadata") if metadata_status == 200 else None
            )
            current_version = (
                metadata_data.get("current_version") if isinstance(metadata_data, dict) else None
            )
            if (
                isinstance(current_version, bool)
                or not isinstance(current_version, int)
                or current_version < before_version
                or current_version - before_version > 64
            ):
                raise BootstrapError("rollback_failed", "Current KV version is outside rollback bounds.")
            restored_version = current_version
            transaction_versions: list[int] = []
            if current_version != before_version or current_values != before_values:
                _, write_document = openbao_request(
                    "POST", data_path,
                    payload={"data": before_values, "options": {"cas": current_version}},
                    token=token, allowed_statuses=frozenset({200}),
                )
                write_data = _response_data(write_document, "restored KV write")
                restored_version = write_data.get("version")
                if restored_version != current_version + 1:
                    raise BootstrapError("rollback_failed", "The restored KV version is invalid.")
                transaction_versions = list(range(before_version + 1, current_version + 1))
                if transaction_versions:
                    openbao_request(
                        "POST", destroy_path, payload={"versions": transaction_versions}, token=token,
                        allowed_statuses=frozenset({200, 204}),
                    )
            restored_status, restored_document = openbao_request(
                "GET", data_path, token=token, allowed_statuses=frozenset({200, 404})
            )
            if (
                restored_status != 200
                or _response_data(restored_document, "restored KV").get("data") != before_values
            ):
                raise BootstrapError("rollback_failed", "A KV object was not restored.")
            _, restored_metadata_document = openbao_request(
                "GET", metadata_path, token=token, allowed_statuses=frozenset({200})
            )
            restored_metadata = _response_data(restored_metadata_document, "restored KV metadata")
            versions = restored_metadata.get("versions")
            if (
                restored_metadata.get("current_version") != restored_version
                or not isinstance(versions, dict)
            ):
                raise BootstrapError("rollback_failed", "Restored KV metadata is invalid.")
            for version in transaction_versions:
                record = versions.get(str(version))
                if not isinstance(record, dict) or record.get("destroyed") is not True:
                    raise BootstrapError(
                        "rollback_failed", "A transaction KV secret version remains recoverable."
                    )
    finally:
        token = ""
    _set_transaction(
        transaction,
        openbao_undo_escrowed=False,
        openbao_undo_write_started=False,
        openbao_undo_complete=True,
        openbao_undo_started=False,
        openbao_provisioning_started=False,
        phase="openbao-undone",
    )
    OPENBAO_UNDO_ESCROW.unlink(missing_ok=True)
    _fsync_directory(OPENBAO_UNDO_ESCROW.parent)


def recover_openbao_password(
    password: bytearray,
    worker: dict[str, Any],
    transaction: dict[str, Any],
) -> None:
    original = _read_root_file(Path(transaction["openbao_backup"]), 256 * 1024, private=True)
    if (
        original.count(TRUE_TOGGLE) != 1 or FALSE_TOGGLE in original
        or TEMPORARY_UNIX_LISTENER in original
    ):
        raise BootstrapError("openbao_config_drift", "The saved OpenBao listener is invalid.")
    temporary = original.rstrip() + b"\n" + TEMPORARY_UNIX_LISTENER
    _set_transaction(transaction, phase="openbao-breakglass", openbao_restore_required=True)
    _prepare_recovery_socket_directory(transaction)
    _write_openbao_config(temporary)
    _restart_openbao(worker)
    token: str | None = None
    encoded_token: str | None = None
    otp: bytearray | None = None
    try:
        encoded_token, otp = generate_root_material(transaction)
    finally:
        _write_openbao_config(original)
        _restart_openbao(worker)
        _set_transaction(transaction, openbao_restore_required=False)
        _cleanup_recovery_socket_directory(transaction)
    if os.path.lexists(OPENBAO_RECOVERY_SOCKET) or encoded_token is None or otp is None:
        raise BootstrapError("openbao_breakglass_open", "The legacy root-generation endpoint was not closed.")
    token = _decode_root_token(encoded_token, otp.decode("ascii", errors="strict"))
    _wipe(otp)
    otp = None
    encoded_token = None
    operation_error: BaseException | None = None
    try:
        # The password ciphertext is durable before the first ambiguous PUT.
        # Recovery can therefore replay both the reset and login proof after a
        # lost response or power failure, while any orphan login token expires
        # within two minutes.
        _escrow_userpass_password(password, transaction)
        _apply_short_lived_userpass(password, token)
    except BaseException as exc:
        operation_error = exc
    finally:
        # Keep the generated root token encrypted (never plaintext on disk)
        # until the whole transaction commits. It is the crash-recovery
        # authority used to compensate OpenBao state created by provisioners.
        token = None
        _set_transaction(
            transaction,
            phase="password-recovered" if operation_error is None else "password-recovery-failed",
        )
    if operation_error is not None:
        if isinstance(operation_error, BootstrapError):
            raise operation_error
        raise BootstrapError("userpass_failed", "OpenBao account recovery failed.") from operation_error


def _finalize_recovered_userpass(transaction: dict[str, Any]) -> None:
    escrow_exists = os.path.lexists(USERPASS_PASSWORD_ESCROW)
    if transaction.get("password_recovery_started") is not True and not escrow_exists:
        return
    if transaction.get("userpass_finalized") is True:
        if escrow_exists:
            _validate_encrypted_file(USERPASS_PASSWORD_ESCROW, maximum=2 * 1024 * 1024)
            USERPASS_PASSWORD_ESCROW.unlink()
            _fsync_directory(USERPASS_PASSWORD_ESCROW.parent)
        if transaction.get("userpass_password_escrowed") is True:
            _set_transaction(
                transaction,
                userpass_password_escrowed=False,
                phase="userpass-finalized",
            )
        return
    if not escrow_exists:
        raise BootstrapError(
            "escrow_failed", "The unfinished userpass recovery has no password escrow."
        )
    password = _userpass_password_from_escrow(transaction)
    # The ciphertext rename may have survived while the following WAL update
    # did not. Repair that single pre-PUT crash boundary before replay.
    if (
        transaction.get("password_recovery_started") is not True
        or transaction.get("userpass_password_escrowed") is not True
    ):
        _set_transaction(
            transaction,
            phase="password-recovery-replay",
            password_recovery_started=True,
            password_recovery_persists=True,
            userpass_password_escrowed=True,
        )
    token = _root_token_from_escrow()
    try:
        _apply_short_lived_userpass(password, token)
        openbao_request(
            "PUT", "/v1/auth/userpass/users/ops-user",
            payload={
                "token_policies": ["token-self", "human-admin"],
                "token_ttl": "1h",
                "token_max_ttl": "8h",
            },
            token=token,
            allowed_statuses=frozenset({200, 204}),
        )
        _, document = openbao_request(
            "GET", "/v1/auth/userpass/users/ops-user", token=token,
            allowed_statuses=frozenset({200}),
        )
        data = _response_data(document, "userpass")
        if (
            set(data.get("token_policies", [])) != {"token-self", "human-admin"}
            or data.get("token_ttl") != 3600
            or data.get("token_max_ttl") != 28800
        ):
            raise BootstrapError("userpass_failed", "The recovered human token bounds differ.")
        _set_transaction(transaction, userpass_finalized=True, phase="userpass-finalized")
    finally:
        _wipe(password)
        token = ""
    _validate_encrypted_file(USERPASS_PASSWORD_ESCROW, maximum=2 * 1024 * 1024)
    USERPASS_PASSWORD_ESCROW.unlink()
    _fsync_directory(USERPASS_PASSWORD_ESCROW.parent)
    _set_transaction(
        transaction,
        userpass_password_escrowed=False,
        phase="userpass-finalized",
    )


def _run_with_password(
    worker: dict[str, Any], name: str, argv: list[str], password: bytearray, timeout: int,
    *, deployment_lock_fd: int | None = None, pass_lock_argument: bool = False,
) -> None:
    read_fd, write_fd = os.pipe2(os.O_CLOEXEC)
    process: subprocess.Popen[bytes] | None = None
    try:
        os.set_inheritable(read_fd, True)
        view = memoryview(password)
        while view:
            written = os.write(write_fd, view)
            if written <= 0:
                raise BootstrapError("secret_pipe_failed", "A secret pipe write was incomplete.")
            view = view[written:]
        os.close(write_fd)
        write_fd = -1
        started = time.monotonic()
        command = [*argv, "--password-fd", str(read_fd)]
        inherited = [read_fd]
        if deployment_lock_fd is not None:
            inherited.append(deployment_lock_fd)
            if pass_lock_argument:
                command.extend(["--deployment-lock-fd", str(deployment_lock_fd)])
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            pass_fds=tuple(inherited),
            start_new_session=True,
            env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        )
        return_code = process.wait(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        append_audit("step_failed", release_id=_read_json(CONSUMED_PATH)["release_id"], details={"step": name, "reason": "timeout"})
        raise BootstrapError("step_timeout", f"Bootstrap step timed out: {name}") from exc
    except BaseException:
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        raise
    finally:
        os.close(read_fd)
        if write_fd >= 0:
            os.close(write_fd)
    duration = int((time.monotonic() - started) * 1000)
    if return_code != 0:
        append_audit("step_failed", release_id=_read_json(CONSUMED_PATH)["release_id"], details={"step": name, "return_code": return_code})
        raise BootstrapError("step_failed", f"Bootstrap step failed: {name}")
    append_audit("step_succeeded", release_id=_read_json(CONSUMED_PATH)["release_id"], details={"step": name, "duration_ms": duration})


def _provision_realm(worker: dict[str, Any], password: bytearray, deployment_lock_fd: int) -> int:
    password_read_fd, password_write_fd = os.pipe2(os.O_CLOEXEC)
    result_read_fd, result_write_fd = os.pipe2(os.O_CLOEXEC)
    process: subprocess.Popen[bytes] | None = None
    return_code: int | None = None
    raw = b""
    try:
        os.set_inheritable(password_read_fd, True)
        os.set_inheritable(result_write_fd, True)
        view = memoryview(password)
        while view:
            written = os.write(password_write_fd, view)
            if written <= 0:
                raise BootstrapError("secret_pipe_failed", "The Zulip password pipe write was incomplete.")
            view = view[written:]
        os.close(password_write_fd)
        password_write_fd = -1
        process = subprocess.Popen(
            [
                "/opt/ops-control-plane/deploy/zulip-local/bin/provision-zulip.py",
                "--admin-password-fd", str(password_read_fd),
                "--approver-id-fd", str(result_write_fd),
                "--deployment-lock-fd", str(deployment_lock_fd),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            pass_fds=(password_read_fd, result_write_fd, deployment_lock_fd),
            start_new_session=True,
            env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        )
        try:
            return_code = process.wait(timeout=300)
        except subprocess.TimeoutExpired as exc:
            if process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                    process.wait(timeout=5)
                except (ProcessLookupError, subprocess.TimeoutExpired):
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.wait()
            raise BootstrapError(
                "zulip_provision_failed", "Zulip owner reconciliation timed out."
            ) from exc
        os.close(result_write_fd)
        result_write_fd = -1
        raw = os.read(result_read_fd, 64)
    except BaseException:
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        raise
    finally:
        for descriptor in (password_read_fd, password_write_fd, result_read_fd, result_write_fd):
            if descriptor >= 0:
                try:
                    os.close(descriptor)
                except OSError:
                    pass
    if return_code != 0 or not re.fullmatch(rb"[1-9][0-9]{0,18}", raw):
        raise BootstrapError("zulip_provision_failed", "Zulip owner/bot/channel reconciliation failed.")
    return int(raw)


def _write_approver_state(manifest: dict[str, Any], user_id: int) -> None:
    if os.path.lexists(APPROVER_PATH):
        observed = _exact_json_document(
            _read_exact_root_file(APPROVER_PATH, 16 * 1024, 0o600)
        )
        if (
            set(observed) == {
                "schema_version", "release_id", "source_tree_sha256",
                "realm_url", "zulip_user_id", "actor_id", "recorded_at",
            }
            and observed.get("schema_version") == 1
            and observed.get("release_id") == manifest["release_id"]
            and observed.get("source_tree_sha256")
            == manifest["source"]["tree_sha256"]
            and observed.get("realm_url") == "https://zulip.ops.local:8443"
            and observed.get("zulip_user_id") == user_id
            and observed.get("actor_id") == f"zulip:{user_id}"
            and not isinstance(observed.get("recorded_at"), bool)
            and isinstance(observed.get("recorded_at"), int)
            and observed["recorded_at"] > 0
        ):
            return
        raise BootstrapError(
            "bootstrap_state_conflict", "The durable approver identity differs."
        )
    document = {
        "schema_version": 1,
        "release_id": manifest["release_id"],
        "source_tree_sha256": manifest["source"]["tree_sha256"],
        "realm_url": "https://zulip.ops.local:8443",
        "zulip_user_id": user_id,
        "actor_id": f"zulip:{user_id}",
        "recorded_at": int(time.time()),
    }
    _publish_exact_once(
        APPROVER_PATH, _canonical(document) + b"\n", 0o600
    )


def _install_and_activate(
    worker: dict[str, Any],
    release: Path,
    manifest: dict[str, Any],
    metadata: dict[str, Any],
    openbao_password: bytearray,
    zulip_password: bytearray,
    credential_groups: dict[str, bool],
    transaction: dict[str, Any],
    deployment_lock_fd: int,
) -> int:
    source = release / "tree"
    worker["disable_local_inference"](metadata)
    worker["ensure_docker"](Path(metadata["backup_path"]), metadata)
    worker["run_command"](
        "bootstrap-install-broker",
        [str(source / "scripts/install-broker.sh"), "--enable-api", "--replace-managed-configs"],
        timeout=1800,
    )
    worker["run_command"](
        "bootstrap-install-orchestrator",
        [str(source / "scripts/install-orchestrator.sh"), "--replace-api-config"],
        timeout=1800,
    )
    atlas = release / "artifacts" / Path(manifest["artifacts"]["atlas_rpm"]["source_path"]).name
    metadata["atlas_installation_attempted"] = True
    worker["atomic_json"](
        Path(metadata["backup_path"]) / "transaction.json", metadata
    )
    worker["run_command"](
        "bootstrap-install-atlas",
        [
            "/usr/bin/dnf", "--assumeyes", "--disablerepo=*", "--setopt=install_weak_deps=False",
            "install", str(atlas),
        ],
        timeout=900,
    )
    worker["run_command"]("bootstrap-verify-atlas", ["/usr/bin/rpm", "-V", "modeles-ia"], timeout=60)
    hermes_archive = release / "artifacts" / Path(
        manifest["artifacts"]["hermes_source_archive"]["source_path"]
    ).name
    worker["run_command"](
        "bootstrap-install-hermes",
        [
            str(source / "scripts/install-hermes.sh"),
            "--archive",
            str(hermes_archive),
        ],
        timeout=3600,
    )
    worker["run_command"]("bootstrap-install-bridge-dormant", [str(source / "scripts/install-zulip-bridge.sh")], timeout=1800)
    worker["run_command"](
        "bootstrap-install-zulip-dormant",
        [str(source / "deploy/zulip-local/bin/install.sh"), "--install"],
        timeout=300,
    )
    if not credential_groups["zulip_local"]:
        _run_with_password(
            worker,
            "bootstrap-provision-zulip-local-openbao",
            ["/opt/ops-control-plane/deploy/zulip-local/bin/provision-openbao.py", "--initialize-server-secrets"],
            openbao_password,
            600,
            deployment_lock_fd=deployment_lock_fd,
            pass_lock_argument=True,
        )
    if not credential_groups["orchestrator"]:
        _run_with_password(
            worker,
            "bootstrap-provision-orchestrator-openbao",
            ["/usr/local/sbin/provision-orchestrator-openbao", "--bootstrap-empty"],
            openbao_password,
            600,
            deployment_lock_fd=deployment_lock_fd,
        )
    if not credential_groups["hermes"]:
        _run_with_password(
            worker,
            "bootstrap-provision-hermes-openbao",
            ["/usr/local/sbin/provision-hermes-openbao"],
            openbao_password,
            600,
            deployment_lock_fd=deployment_lock_fd,
        )
    worker["run_command"](
        "bootstrap-enable-zulip-units",
        [str(source / "deploy/zulip-local/bin/install.sh"), "--install", "--enable"],
        timeout=300,
    )
    worker["run_command"]("bootstrap-start-zulip-secrets", ["/usr/bin/systemctl", "start", "zulip-local-secrets.service"], timeout=120)
    worker["require_docker_networks_absent"]()
    worker["validate_docker_route_baseline"]()
    worker["run_command"](
        "bootstrap-initialize-zulip",
        ["/opt/ops-control-plane/deploy/zulip-local/bin/init.sh", "--start"],
        timeout=2400,
    )
    approver_id = _provision_realm(worker, zulip_password, deployment_lock_fd)
    # STATE_ROOT is proven new for this one-shot transaction. Persist rollback
    # intent before the atomic file write so a crash cannot strand an
    # untracked approver identity.
    _set_transaction(
        transaction,
        approver_state_created=True,
        phase="approver-write-starting",
    )
    _write_approver_state(manifest, approver_id)
    _set_transaction(transaction, phase="approver-recorded")
    worker["run_command"]("bootstrap-reconcile-broker-approver", [str(INSTALLED_RECONCILER), "apply"], timeout=60)
    worker["run_command"]("bootstrap-reload-broker-policy", ["/usr/bin/systemctl", "stop", "ops-broker.service"], timeout=60)
    worker["run_command"]("bootstrap-enable-broker-socket", ["/usr/bin/systemctl", "enable", "--now", "ops-broker.socket"], timeout=60)
    if not credential_groups["zulip_bridge"]:
        _run_with_password(
            worker,
            "bootstrap-provision-zulip-bridge-openbao",
            ["/usr/local/sbin/provision-zulip-openbao"],
            openbao_password,
            600,
            deployment_lock_fd=deployment_lock_fd,
        )
    worker["run_command"]("bootstrap-activate-zulip-bridge", [str(source / "scripts/install-zulip-bridge.sh"), "--activate"], timeout=1800)
    worker["run_command"](
        "bootstrap-enable-zulip",
        [
            "/usr/bin/systemctl", "enable", "--now", "zulip-local.service",
            "zulip-local-health.timer", "zulip-local-backup.timer",
        ],
        timeout=300,
    )
    worker["run_command"](
        "bootstrap-enable-orchestrator-degraded",
        [
            "/usr/bin/systemctl", "enable", "--now", "ops-orchestrator.service",
            "ops-orchestrator-metrics.timer",
        ],
        timeout=300,
    )
    # The facade returns 503 and Hermes has no useful upstream before a provider
    # key exists.  Keep both dormant; the reviewed key-manager reload path owns
    # their later activation.
    worker["run_command"](
        "bootstrap-keep-provider-consumers-dormant",
        [
            "/usr/bin/systemctl", "disable", "--now",
            "ops-orchestrator-provider-finance.timer",
            "ops-orchestrator-hermes-facade.service", "hermes-gateway.service",
        ],
        timeout=180,
    )
    return approver_id


def _bounded_json_command(argv: list[str], *, timeout: int) -> dict[str, Any]:
    """Capture one fixed local JSON probe without inheriting secrets or children."""

    process = subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        start_new_session=True,
        env={
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
        },
    )
    try:
        stdout, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=5)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
        raise BootstrapError("health_failed", "A bounded local health probe timed out.") from exc
    if process.returncode != 0 or not 2 <= len(stdout) <= MAX_API_RESPONSE:
        raise BootstrapError("health_failed", "A bounded local health probe failed.")
    try:
        document = json.loads(stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("health_failed", "A local health probe returned invalid JSON.") from exc
    if not isinstance(document, dict):
        raise BootstrapError("health_failed", "A local health probe returned an invalid document.")
    return document


def _unix_health(path: Path, request_path: str) -> dict[str, Any]:
    expected_identity = {
        (Path("/run/ops-orchestrator/api.sock"), "/v1/health"):
            ("opsorchestrator", "opsorchestrator-api", 0o660),
        (Path("/run/ops-broker/api.sock"), "/healthz"):
            ("opsbroker", "opsbroker-api", 0o660),
    }
    identity = expected_identity.get((path, request_path))
    if identity is None:
        raise BootstrapError("health_failed", "A local health probe escaped its allowlist.")
    try:
        metadata = os.lstat(path)
    except OSError as exc:
        raise BootstrapError("health_failed", "A required local API socket is unavailable.") from exc
    try:
        expected_uid = pwd.getpwnam(identity[0]).pw_uid
        expected_gid = grp.getgrnam(identity[1]).gr_gid
    except KeyError as exc:
        raise BootstrapError("health_failed", "A local API socket identity is absent.") from exc
    if (
        not stat.S_ISSOCK(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != expected_uid
        or metadata.st_gid != expected_gid
        or stat.S_IMODE(metadata.st_mode) != identity[2]
    ):
        raise BootstrapError("health_failed", "A required local API socket is unsafe.")
    connection = _UnixHTTPConnection(path)
    try:
        connection.request(
            "GET",
            request_path,
            headers={"Accept": "application/json", "Host": "localhost", "Connection": "close"},
        )
        response = connection.getresponse()
        raw = response.read(MAX_API_RESPONSE + 1)
        status = response.status
    except (OSError, http.client.HTTPException) as exc:
        raise BootstrapError("health_failed", "A required local API is unavailable.") from exc
    finally:
        connection.close()
    if status != 200 or not 2 <= len(raw) <= MAX_API_RESPONSE:
        raise BootstrapError("health_failed", "A required local API health response failed.")
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("health_failed", "A local API returned invalid JSON.") from exc
    if not isinstance(document, dict):
        raise BootstrapError("health_failed", "A local API health document is invalid.")
    return document


def _provider_credential_paths(manifest: dict[str, Any]) -> tuple[tuple[str, str], ...]:
    """Derive the exact 21 inference KV v2 routes from the sealed release."""

    release = DEPLOYMENT_RELEASES_ROOT / manifest["release_id"]
    registry_path = release / "tree/catalog/provider-integrations.v1.json"
    raw = _read_root_file(registry_path, 2 * 1024 * 1024, private=False)
    expected = manifest["components"]["provider_integrations"]
    if not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), expected["sha256"]):
        raise BootstrapError("health_failed", "The staged provider registry digest differs.")
    try:
        registry = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("health_failed", "The staged provider registry is invalid.") from exc
    accounts = registry.get("provider_accounts") if isinstance(registry, dict) else None
    if not isinstance(accounts, list) or len(accounts) != expected["provider_accounts"]:
        raise BootstrapError("health_failed", "The staged provider registry count differs.")
    paths: set[tuple[str, str]] = set()
    for account in accounts:
        credentials = account.get("credentials") if isinstance(account, dict) else None
        inference = credentials.get("inference") if isinstance(credentials, dict) else None
        reference = inference.get("credential_ref") if isinstance(inference, dict) else None
        if not isinstance(reference, str) or not re.fullmatch(
            r"kv-infra-shared/data/llm/(?:qwen|deepseek|providers/[a-z0-9-]{2,32})",
            reference,
        ):
            raise BootstrapError("health_failed", "A provider credential route is invalid.")
        data_path = f"/v1/{reference}"
        metadata_path = data_path.replace("/data/", "/metadata/", 1)
        paths.add((data_path, metadata_path))
    if len(paths) != expected["provider_accounts"]:
        raise BootstrapError("health_failed", "Provider credential routes are not one-to-one.")
    return tuple(sorted(paths))


def _validate_alertmanager_query_socket() -> None:
    path = Path("/run/zulip-alertmanager-query/api.sock")
    try:
        metadata = os.lstat(path)
        expected_gid = grp.getgrnam("zulipbridge").gr_gid
    except (OSError, KeyError) as exc:
        raise BootstrapError(
            "health_failed", "The local Alertmanager query socket is unavailable."
        ) from exc
    if (
        not stat.S_ISSOCK(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != expected_gid
        or stat.S_IMODE(metadata.st_mode) != 0o660
    ):
        raise BootstrapError(
            "health_failed", "The local Alertmanager query socket is unsafe."
        )


def _bootstrap_health(
    worker: dict[str, Any], manifest: dict[str, Any], approver_id: int,
    metadata: dict[str, Any],
) -> dict[str, Any]:
    if worker["local_inference_status"]() not in {"disabled", "absent"}:
        raise BootstrapError("health_failed", "Local model inference remains enabled.")
    worker["validate_docker_installation"](require_active=True)
    worker["validate_zulip_precommit_restart_state"](metadata)
    # Exercise the reboot-sensitive boundary while every container is still
    # restart=no. Docker must not revive it by itself; the reviewed systemd
    # unit then converges Compose explicitly under the suppression marker.
    worker["run_command"](
        "bootstrap-restart-docker-with-stack",
        ["/usr/bin/systemctl", "restart", "docker.service"],
        timeout=300,
    )
    worker["run_command"](
        "bootstrap-restart-zulip-after-docker",
        ["/usr/bin/systemctl", "restart", "zulip-local.service"],
        timeout=600,
    )
    worker["validate_docker_installation"](require_active=True)
    worker["validate_zulip_precommit_restart_state"](metadata)
    worker["reload_firewalld_with_docker_barrier"]()
    worker["validate_docker_runtime_network"]()
    for unit in BOOTSTRAP_ACTIVE_SERVICES:
        if not _systemctl_state(unit, "is-active"):
            raise BootstrapError("health_failed", f"A required bootstrap unit is inactive: {unit}")
    for unit in BOOTSTRAP_DORMANT_SERVICES:
        if _systemctl_state(unit, "is-active") or _systemctl_state(unit, "is-enabled"):
            raise BootstrapError("health_failed", f"A provider-dependent unit is not dormant: {unit}")
    for unit in BROKER_MAINTENANCE_UNITS[:2]:
        if (
            not _systemctl_state(unit, "is-active")
            or not _systemctl_state(unit, "is-enabled")
        ):
            raise BootstrapError(
                "health_failed", f"A broker maintenance timer is not armed: {unit}"
            )
    for unit in BROKER_MAINTENANCE_UNITS[2:]:
        if _systemctl_state(unit, "is-active"):
            raise BootstrapError(
                "health_failed", f"A broker maintenance oneshot did not quiesce: {unit}"
            )
    for unit in ZULIP_TRIGGERED_SERVICES:
        if _systemctl_state(unit, "is-active"):
            raise BootstrapError(
                "health_failed", f"A triggered Zulip oneshot did not quiesce: {unit}"
            )
    for name in manifest["runtime"]["encrypted_credentials"]:
        _validate_encrypted_file(Path("/etc/credstore.encrypted") / name)
    worker["run_command"](
        "bootstrap-health-zulip", ["/opt/ops-control-plane/deploy/zulip-local/bin/health.sh", "--quiet"], timeout=120
    )
    if not _systemctl_state("zulip-alertmanager-query.socket", "is-enabled"):
        raise BootstrapError(
            "health_failed", "The local Alertmanager query socket is not enabled."
        )
    _validate_alertmanager_query_socket()
    worker["run_command"](
        "bootstrap-health-alertmanager-query",
        [
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--max-filesize",
            str(MAX_API_RESPONSE),
            "--noproxy",
            "*",
            "--proto",
            "=http",
            "--unix-socket",
            "/run/zulip-alertmanager-query/api.sock",
            "--output",
            "/dev/null",
            "http://localhost/api/v2/alerts",
        ],
        timeout=10,
    )
    orchestrator_health = _unix_health(Path("/run/ops-orchestrator/api.sock"), "/v1/health")
    if set(orchestrator_health) != {
        "status", "database", "mode", "provider_availability_scope",
        "provider_network_probe", "providers", "limits", "catalogue",
    }:
        raise BootstrapError("health_failed", "The orchestrator health schema differs.")
    expected_catalogue = manifest["components"]["model_catalogue"]
    if (
        orchestrator_health.get("status") != "degraded"
        or orchestrator_health.get("database") != "ok"
        or orchestrator_health.get("mode") != "api-first"
        or orchestrator_health.get("provider_availability_scope")
        != "configuration-and-secret-only"
        or orchestrator_health.get("provider_network_probe") is not False
        or orchestrator_health.get("catalogue")
        != {
            "schema_version": expected_catalogue["schema_version"],
            "revision": expected_catalogue["revision"],
            "cards": expected_catalogue["cards"],
            "provider_accounts": expected_catalogue["provider_accounts"],
        }
    ):
        raise BootstrapError("health_failed", "The zero-key orchestrator state differs.")
    limits = orchestrator_health.get("limits")
    if (
        not isinstance(limits, dict)
        or set(limits) != {"max_iterations", "max_provider_calls", "max_context_tokens"}
        or any(isinstance(value, bool) or not isinstance(value, int) or value <= 0 for value in limits.values())
    ):
        raise BootstrapError("health_failed", "The orchestrator health limits are invalid.")
    providers = orchestrator_health.get("providers")
    if not isinstance(providers, list) or not providers:
        raise BootstrapError("health_failed", "The orchestrator provider inventory is absent.")
    provider_ids: set[str] = set()
    provider_accounts: set[str] = set()
    available_accounts: set[str] = set()
    provider_inventory: list[dict[str, Any]] = []
    for provider in providers:
        if not isinstance(provider, dict) or set(provider) != {
            "id", "provider_account_id", "role", "location", "available", "reason",
        }:
            raise BootstrapError("health_failed", "An orchestrator provider record is invalid.")
        provider_id = provider.get("id")
        account_id = provider.get("provider_account_id")
        if (
            not isinstance(provider_id, str) or not RELEASE_RE.fullmatch(provider_id)
            or (
                account_id is not None
                and (not isinstance(account_id, str) or not RELEASE_RE.fullmatch(account_id))
            )
            or not isinstance(provider.get("role"), str)
            or provider.get("location") != "remote"
            or not isinstance(provider.get("available"), bool)
            or not isinstance(provider.get("reason"), str)
            or not 1 <= len(provider["reason"]) <= 512
        ):
            raise BootstrapError("health_failed", "An orchestrator provider record differs.")
        provider_ids.add(provider_id)
        if isinstance(account_id, str):
            provider_accounts.add(account_id)
        if provider["available"] is True:
            available_accounts.add(account_id or provider_id)
        provider_inventory.append(
            {
                "id": provider_id,
                "provider_account_id": account_id,
                "role": provider["role"],
                "location": provider["location"],
            }
        )
    expected_deployments = expected_catalogue["runtime"]["provider_deployments"]
    inventory_digest = hashlib.sha256(
        json.dumps(
            sorted(provider_inventory, key=lambda item: item["id"]),
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()
    if (
        len(providers) != expected_deployments
        or len(provider_ids) != expected_deployments
        or inventory_digest != expected_catalogue["runtime"]["provider_inventory_sha256"]
        or available_accounts
    ):
        raise BootstrapError("health_failed", "Provider credentials are unexpectedly available.")

    finance_health = _bounded_json_command(
        [
            "/usr/bin/runuser", "-u", "opsorchestrator", "--", "/usr/bin/curl",
            "--silent", "--show-error", "--fail", "--max-time", "5",
            "--max-filesize", str(MAX_API_RESPONSE), "--noproxy", "*", "--proto", "=http",
            "--unix-socket", "/run/ops-orchestrator-finance/api.sock",
            "http://localhost/v1/health",
        ],
        timeout=10,
    )
    if finance_health != {
        "status": "ok",
        "registry_revision": manifest["components"]["provider_integrations"]["revision"],
        "direct_connectors": ["deepseek", "moonshot", "stepfun"],
        "credential_scope": "finance_direct_only",
    }:
        raise BootstrapError("health_failed", "The finance isolation health differs.")

    broker_health = _unix_health(Path("/run/ops-broker/api.sock"), "/healthz")
    if broker_health != {"status": "ok"}:
        raise BootstrapError("health_failed", "The broker health response differs.")
    policy_proof = _bounded_json_command([str(INSTALLED_RECONCILER), "verify"], timeout=60)
    if (
        set(policy_proof) != {"ok", "policy_sha256"}
        or policy_proof.get("ok") is not True
        or not isinstance(policy_proof.get("policy_sha256"), str)
        or not SHA256_RE.fullmatch(policy_proof["policy_sha256"])
    ):
        raise BootstrapError("health_failed", "The broker approver proof differs.")
    approver = _read_json(APPROVER_PATH, 16 * 1024)
    if approver.get("zulip_user_id") != approver_id or approver.get("actor_id") != f"zulip:{approver_id}":
        raise BootstrapError("health_failed", "The durable Zulip/broker approver identity differs.")
    root_token = _root_token_from_escrow()
    try:
        _, bot_document = openbao_request(
            "GET", "/v1/kv-infra-shared/data/zulip/bot", token=root_token,
            allowed_statuses=frozenset({200}),
        )
        bot_envelope = _response_data(bot_document, "Zulip bridge KV")
        bot_values = bot_envelope.get("data")
        if (
            not isinstance(bot_values, dict)
            or bot_values.get("approver_user_ids") != str(approver_id)
            or str(bot_values.get("bot_user_id", "")) == str(approver_id)
        ):
            raise BootstrapError("health_failed", "The bridge approver identity differs.")
        provider_paths = _provider_credential_paths(manifest)
        provider_credentials_present = 0
        provider_allowlist = frozenset(
            path for pair in provider_paths for path in pair
        )
        for data_path, metadata_path in provider_paths:
            data_status, _ = openbao_request(
                "GET", data_path, token=root_token,
                allowed_statuses=frozenset({200, 404}),
                additional_paths=provider_allowlist,
            )
            metadata_status, _ = openbao_request(
                "GET", metadata_path, token=root_token,
                allowed_statuses=frozenset({200, 404}),
                additional_paths=provider_allowlist,
            )
            if data_status != 404 or metadata_status != 404:
                provider_credentials_present += 1
                raise BootstrapError(
                    "health_failed", "A provider credential exists in the zero-key release."
                )
    finally:
        root_token = ""
    atlas = manifest["artifacts"]["atlas_rpm"]
    expected = f"{atlas['name']}-{atlas['version']}-{atlas['release']}.{atlas['architecture']}"
    if worker["atlas_installed_identity"]() != expected or not worker["atlas_installation_is_pristine"]():
        raise BootstrapError("health_failed", "The installed Atlas RPM differs from the release.")
    return {
        "provider_accounts_configured": len(provider_accounts),
        "provider_keys_configured": provider_credentials_present,
        "provider_routes_available": len(available_accounts),
        "provider_network_probe": orchestrator_health["provider_network_probe"],
        "finance_status": finance_health["status"],
        "broker_status": broker_health["status"],
        "broker_policy_sha256": policy_proof["policy_sha256"],
        "zulip_approver_reconciled": True,
    }


def restore_openbao_from_transaction(
    worker: dict[str, Any] | None,
    transaction: dict[str, Any],
    *,
    restart: bool = True,
) -> None:
    if transaction.get("openbao_restore_required") is not True:
        return
    backup_raw = transaction.get("openbao_backup")
    backup_sha = transaction.get("openbao_backup_sha256")
    if not isinstance(backup_raw, str) or not isinstance(backup_sha, str) or not SHA256_RE.fullmatch(backup_sha):
        raise BootstrapError("recovery_failed", "The saved OpenBao rollback reference is invalid.")
    backup = Path(backup_raw)
    raw = _read_root_file(backup, 256 * 1024, private=True)
    if hashlib.sha256(raw).hexdigest() != backup_sha or raw.count(TRUE_TOGGLE) != 1:
        raise BootstrapError("recovery_failed", "The saved OpenBao configuration differs.")
    _write_openbao_config(raw)
    if restart:
        if worker is None:
            raise BootstrapError("recovery_failed", "The recovery worker is unavailable.")
        _restart_openbao(worker)
    _set_transaction(transaction, openbao_restore_required=False, phase="openbao-restored")
    _cleanup_recovery_socket_directory(transaction)


def _restore_broker_state(
    worker: dict[str, Any], transaction: dict[str, Any], *, verify_active: bool = True
) -> None:
    state = transaction.get("service_state_before")
    if not isinstance(state, dict):
        return
    for unit in PREBACKUP_QUIESCED_UNITS:
        item = state.get(unit)
        if not isinstance(item, dict):
            continue
        if item.get("enabled") is True:
            worker["run_command"](f"bootstrap-restore-enable-{unit}", ["/usr/bin/systemctl", "enable", unit], timeout=60)
        else:
            worker["run_command"](f"bootstrap-restore-disable-{unit}", ["/usr/bin/systemctl", "disable", unit], timeout=60)
        if unit in DYNAMIC_SERVICE_UNITS:
            # Socket activation owns the proxy lifecycle.  Never start it
            # directly without an accepted socket file descriptor.
            if _systemctl_state(unit, "is-active"):
                worker["run_command"](
                    f"bootstrap-restore-stop-{unit}",
                    ["/usr/bin/systemctl", "stop", unit],
                    timeout=60,
                )
        elif item.get("active") is True:
            worker["run_command"](f"bootstrap-restore-start-{unit}", ["/usr/bin/systemctl", "start", unit], timeout=60)
        elif _systemctl_state(unit, "is-active"):
            worker["run_command"](
                f"bootstrap-restore-stop-{unit}", ["/usr/bin/systemctl", "stop", unit], timeout=60
            )
    if verify_active:
        for unit in PREBACKUP_QUIESCED_UNITS:
            item = state[unit]
            if (
                (unit not in DYNAMIC_SERVICE_UNITS
                 and _systemctl_state(unit, "is-active") is not item["active"])
                or _systemctl_state(unit, "is-enabled") is not item["enabled"]
            ):
                raise BootstrapError("rollback_failed", "The broker state was not restored exactly.")


def _quiesce_broker(worker: dict[str, Any]) -> None:
    worker["run_command"](
        "bootstrap-quiesce-broker-timers",
        [
            "/usr/bin/systemctl", "stop",
            "ops-broker-audit-verify.timer", "ops-broker-backup.timer",
        ],
        timeout=120,
    )
    worker["run_command"](
        "bootstrap-quiesce-broker-services",
        [
            "/usr/bin/systemctl", "stop", "ops-broker.socket", "ops-broker.service",
            *BROKER_MAINTENANCE_UNITS[2:],
            "zulip-alertmanager-query.socket",
            *DYNAMIC_SERVICE_UNITS,
        ],
        timeout=120,
    )
    if any(
        _systemctl_state(unit, "is-active")
        for unit in PREBACKUP_QUIESCED_UNITS
    ):
        raise BootstrapError("broker_busy", "The broker could not be quiesced for its snapshot.")


def _quiesce_broker_with_recovery_intent(
    worker: dict[str, Any], transaction: dict[str, Any]
) -> None:
    """Write the recovery intent before the first broker stop operation."""

    # `recovery-armed` is deliberately a GUI-resumable pre-production phase.
    # Moving away from it must therefore be durable before systemctl can stop
    # even one unit; otherwise a process death after the stop would make the
    # supervisor mistake a mutated host for a safe credential-resume frontier.
    _set_transaction(transaction, phase="broker-quiescing")
    _quiesce_broker(worker)
    _set_transaction(transaction, phase="broker-quiesced")


def _mark_rollback_failed_preserving_frontier(
    transaction: dict[str, Any]
) -> None:
    """Record failure without erasing whether service mutation had begun."""

    _set_transaction(transaction, status="rollback-failed")


def _defer_barriered_starts(
    worker: dict[str, Any], operation: Callable[[list[str]], None]
) -> list[str]:
    original_run_command = worker["run_command"]
    original_verify_service_state = worker.get("verify_service_state")
    deferred: list[str] = []

    def recovery_run_command(name: str, argv: list[str], *, timeout: int) -> None:
        if argv[:2] == ["/usr/bin/systemctl", "start"]:
            units = argv[2:]
            if units and all(unit in RECOVERY_DEPENDENT_UNITS for unit in units):
                deferred.extend(unit for unit in units if unit not in deferred)
                return
        original_run_command(name, list(argv), timeout=timeout)

    worker["run_command"] = recovery_run_command
    if callable(original_verify_service_state):
        def recovery_verify_service_state(snapshot: dict[str, Any]) -> None:
            if set(snapshot) != set(worker["SERVICE_NAMES"]):
                raise BootstrapError("recovery_unsafe", "Saved service state is invalid.")
            for unit in worker["SERVICE_NAMES"]:
                state = snapshot[unit]
                if _systemctl_state(unit, "is-enabled") is not state["enabled"]:
                    raise BootstrapError("recovery_failed", "A service enablement was not restored.")
                if (
                    unit not in DYNAMIC_SERVICE_UNITS
                    and state["active"] is False
                    and _systemctl_state(unit, "is-active")
                ):
                    raise BootstrapError("recovery_failed", "An inactive service remained active.")
        worker["verify_service_state"] = recovery_verify_service_state
    try:
        operation(deferred)
    finally:
        worker["run_command"] = original_run_command
        if callable(original_verify_service_state):
            worker["verify_service_state"] = original_verify_service_state
    return deferred


def _planned_recovery_activations(
    worker: dict[str, Any],
    transaction: dict[str, Any],
    deployment_metadata: dict[str, Any] | None,
) -> list[str]:
    initial = transaction.get("service_state_before")
    if not isinstance(initial, dict) or set(initial) != set(RECOVERY_DEPENDENT_UNITS):
        raise BootstrapError("recovery_unsafe", "Saved initial service state is invalid.")
    active: set[str] = set()
    for unit in RECOVERY_DEPENDENT_UNITS:
        state = initial.get(unit)
        if (
            not isinstance(state, dict)
            or set(state) != {"active", "enabled"}
            or not all(isinstance(state.get(key), bool) for key in ("active", "enabled"))
        ):
            raise BootstrapError("recovery_unsafe", "Saved initial service state is invalid.")
        if state["active"] is True and unit not in DYNAMIC_SERVICE_UNITS:
            active.add(unit)
    if deployment_metadata is not None:
        service_state = deployment_metadata.get("service_state")
        if not isinstance(service_state, dict):
            raise BootstrapError("recovery_unsafe", "Saved service state is invalid.")
        for unit in worker["SERVICE_NAMES"]:
            state = service_state.get(unit)
            if (
                not isinstance(state, dict)
                or set(state) != {"active", "enabled"}
                or not all(isinstance(state[key], bool) for key in ("active", "enabled"))
            ):
                raise BootstrapError("recovery_unsafe", "Saved service state is invalid.")
            # The inner backup is taken after broker quiescence but before any
            # other managed mutation. A non-broker drift means the exact
            # initial state can no longer be attributed safely.
            if unit not in PREBACKUP_QUIESCED_UNITS and state != initial.get(unit):
                raise BootstrapError("recovery_unsafe", "Saved service snapshots differ.")
    broker_state = transaction.get("broker_state_before")
    if not isinstance(broker_state, dict):
        raise BootstrapError("recovery_unsafe", "Saved broker state is invalid.")
    for unit in ("ops-broker.socket", "ops-broker.service"):
        state = broker_state.get(unit)
        if (
            not isinstance(state, dict)
            or set(state) != {"active", "enabled"}
            or not all(isinstance(state[key], bool) for key in ("active", "enabled"))
        ):
            raise BootstrapError("recovery_unsafe", "Saved broker state is invalid.")
        if state != initial[unit]:
            raise BootstrapError("recovery_unsafe", "Saved broker snapshots differ.")
    return [unit for unit in RECOVERY_DEPENDENT_UNITS if unit in active]


def _queue_recovery_unit_jobs(
    worker: dict[str, Any], transaction: dict[str, Any]
) -> None:
    """Queue the exact saved active/inactive state before recovery exits.

    Managed boot jobs wait for recovery.service. The activation verifier is
    ordered after every managed unit, so these no-block jobs avoid an ordering
    deadlock while still letting the second stage prove the final state.
    """

    units = transaction.get("recovery_activation_units")
    if (
        not isinstance(units, list)
        or units != [unit for unit in RECOVERY_DEPENDENT_UNITS if unit in units]
        or len(set(units)) != len(units)
    ):
        raise BootstrapError("recovery_unsafe", "The activation queue is invalid.")
    active = set(units)
    for unit in RECOVERY_DEPENDENT_UNITS:
        if unit in DYNAMIC_SERVICE_UNITS:
            continue
        loaded = worker["_unit_is_loaded"](unit)
        if unit in active and not loaded:
            raise BootstrapError("recovery_failed", "A prior active service is unavailable.")
        if not loaded:
            continue
        action = "start" if unit in active else "stop"
        worker["run_command"](
            f"recovery-queue-{action}-{unit}",
            ["/usr/bin/systemctl", "--no-block", action, unit],
            timeout=60,
        )


def _preproduction_rollback_is_unchanged(transaction: dict[str, Any]) -> bool:
    """Prove a failed enrollment has not yet changed a managed service."""

    if not _transaction_matches_safe_enrollment_frontier(
        transaction,
        release_id=transaction.get("release_id"),
        source_tree_sha256=transaction.get("source_tree_sha256"),
        atlas_rpm_sha256=transaction.get("atlas_rpm_sha256"),
        hermes_source_archive_sha256=transaction.get("hermes_source_archive_sha256"),
    ):
        return False
    expected = transaction.get("service_state_before")
    if not isinstance(expected, dict) or set(expected) != set(
        RECOVERY_DEPENDENT_UNITS
    ):
        raise BootstrapError(
            "recovery_unsafe", "The pre-production service snapshot is invalid."
        )
    observed = {
        unit: _strict_corrective_service_state(unit)
        for unit in RECOVERY_DEPENDENT_UNITS
    }
    if observed != expected:
        # Do not create a new outage in an attempt to repair unexplained
        # external drift before a current-boot recovery supervisor exists.
        raise BootstrapError(
            "recovery_unsafe",
            "A managed service changed before production rollback began.",
        )
    return True


def _preproduction_recovery_frontier_is_unchanged(
    transaction: dict[str, Any]
) -> bool:
    """Validate a pre-production pending rollback during boot ordering.

    recovery.service intentionally runs before the managed services, so an
    initially-active unit may still be inactive while its queued boot job is
    blocked.  Enablement must remain exact, and no unit that was initially
    inactive may have become active; the WAL/filesystem predicate still proves
    that no production mutation or backup was begun.
    """

    if not _transaction_matches_safe_enrollment_frontier(
        transaction,
        release_id=transaction.get("release_id"),
        source_tree_sha256=transaction.get("source_tree_sha256"),
        atlas_rpm_sha256=transaction.get("atlas_rpm_sha256"),
        hermes_source_archive_sha256=transaction.get("hermes_source_archive_sha256"),
    ):
        return False
    expected = transaction.get("service_state_before")
    if not isinstance(expected, dict) or set(expected) != set(
        RECOVERY_DEPENDENT_UNITS
    ):
        raise BootstrapError(
            "recovery_unsafe", "The pre-production service snapshot is invalid."
        )
    for unit in RECOVERY_DEPENDENT_UNITS:
        observed = _strict_corrective_service_state(unit)
        prior = expected.get(unit)
        if (
            not isinstance(prior, dict)
            or set(prior) != {"active", "enabled"}
            or observed["enabled"] is not prior["enabled"]
            or (prior["active"] is False and observed["active"] is not False)
        ):
            raise BootstrapError(
                "recovery_unsafe",
                "A managed service changed before rollback finalization.",
            )
    return True


def _preproduction_corrector_frontier_is_unchanged(
    transaction: dict[str, Any]
) -> bool:
    """Use exact current-boot state, or the bounded boot-ordering variant."""

    if _strict_systemctl_state("multi-user.target", "is-active"):
        return _preproduction_rollback_is_unchanged(transaction)
    return _preproduction_recovery_frontier_is_unchanged(transaction)


def _validate_recovery_scaffold_transition(
    states: dict[Path, str],
    link_states: dict[Path, bool],
    *,
    predecessor_declared: bool,
    successor_declared: bool,
    cleanup_flags: tuple[bool, bool] | None = None,
) -> None:
    """Validate one exact installation frontier or terminal cleanup frontier.

    ``cleanup_flags`` is absent while the enrollment WAL is non-terminal.  In
    that mode only the forward, write-before-mutation installation order is
    accepted.  Once the pre-production rollback WAL is terminal, the two
    booleans bind validation to the durable
    ``(recovery_guard_installing, recovery_guard_installed)`` values and the
    inverse cleanup automaton is used instead.  Keeping those languages
    disjoint prevents a terminal retry from silently treating a partly
    removed guard as a fresh installation prefix.
    """

    if set(states) != set(RECOVERY_ASSETS) or any(
        state not in {"missing", "old", "new"} for state in states.values()
    ):
        raise BootstrapError(
            "recovery_unsafe", "The recovery scaffold state set differs."
        )
    if set(link_states) != set(RECOVERY_ENABLEMENT_LINKS):
        raise BootstrapError(
            "recovery_unsafe", "The recovery enablement state set differs."
        )
    if any(
        state == "old" and path not in {INSTALLED_HELPER, RECOVERY_ASSETS[4]}
        for path, state in states.items()
    ):
        raise BootstrapError(
            "recovery_unsafe", "An undeclared predecessor asset remains."
        )
    if not successor_declared and any(
        state == "new" for state in states.values()
    ):
        raise BootstrapError(
            "recovery_unsafe", "A recovery asset exists before release staging."
        )
    if not predecessor_declared and any(
        state == "old" for state in states.values()
    ):
        raise BootstrapError(
            "recovery_unsafe", "An undeclared predecessor recovery asset exists."
        )

    if cleanup_flags is not None:
        _validate_recovery_scaffold_cleanup_transition(
            states,
            link_states,
            predecessor_declared=predecessor_declared,
            successor_declared=successor_declared,
            recovery_guard_installing=cleanup_flags[0],
            recovery_guard_installed=cleanup_flags[1],
        )
        return

    core = (
        INSTALLED_HELPER,
        RECOVERY_ASSETS[2],
        RECOVERY_ASSETS[3],
        RECOVERY_ASSETS[4],
    )
    # The helper/guard/main-recovery files are an installation prefix.  The
    # janitor is also the deliberately retained last cleanup anchor, so its
    # exact reviewed file may survive while either primary unit is absent and
    # a later retry rebuilds that prefix.
    install_prefix = core[:3]
    new_prefix = [
        index
        for index, path in enumerate(install_prefix)
        if states[path] == "new"
    ]
    if new_prefix and any(
        states[install_prefix[index]] != "new"
        for index in range(max(new_prefix) + 1)
    ):
        raise BootstrapError(
            "recovery_unsafe", "The recovery core transition is out of order."
        )
    if states[INSTALLED_HELPER] == "old" and any(
        state == "new" for state in states.values()
    ):
        raise BootstrapError(
            "recovery_unsafe", "The predecessor helper outlived a successor asset."
        )
    if states[RECOVERY_ASSETS[4]] == "old" and any(
        states[path] == "new"
        for path in (RECOVERY_ASSETS[1], *RECOVERY_BARRIER_ASSETS)
    ):
        raise BootstrapError(
            "recovery_unsafe", "The predecessor janitor outlived the recovery core."
        )
    guard_link, recovery_link, janitor_link = tuple(RECOVERY_ENABLEMENT_LINKS)
    all_core_new = all(states[path] == "new" for path in core)
    if link_states[recovery_link] and not all_core_new:
        raise BootstrapError(
            "recovery_unsafe", "Recovery was enabled before its core was complete."
        )
    if link_states[janitor_link] and not (
        all_core_new and link_states[recovery_link]
    ):
        raise BootstrapError(
            "recovery_unsafe", "The recovery janitor transition is out of order."
        )
    if states[RECOVERY_ASSETS[1]] == "new" and not (
        link_states[recovery_link] and link_states[janitor_link]
    ):
        raise BootstrapError(
            "recovery_unsafe", "The OpenBao guard preceded the recovery triggers."
        )
    new_barriers = [
        index
        for index, path in enumerate(RECOVERY_BARRIER_ASSETS)
        if states[path] == "new"
    ]
    if new_barriers and (
        states[RECOVERY_ASSETS[1]] != "new"
        or any(
            states[RECOVERY_BARRIER_ASSETS[index]] != "new"
            for index in range(max(new_barriers) + 1)
        )
    ):
        raise BootstrapError(
            "recovery_unsafe", "The recovery barrier transition is out of order."
        )
    if link_states[guard_link] and (
        states[RECOVERY_ASSETS[1]] != "new"
        or not all(states[path] == "new" for path in RECOVERY_BARRIER_ASSETS)
    ):
        raise BootstrapError(
            "recovery_unsafe", "The OpenBao guard was enabled before all barriers."
        )
    if (
        predecessor_declared
        and not successor_declared
        and (
            states[INSTALLED_HELPER] != "old"
            or states[RECOVERY_ASSETS[4]] != "old"
        )
    ):
        raise BootstrapError(
            "recovery_unsafe", "The unstaged predecessor residue is incomplete."
        )


def _validate_recovery_scaffold_cleanup_transition(
    states: dict[Path, str],
    link_states: dict[Path, bool],
    *,
    predecessor_declared: bool,
    successor_declared: bool,
    recovery_guard_installing: bool,
    recovery_guard_installed: bool,
) -> None:
    """Recognize only crash frontiers produced by ``_cleanup_recovery_guard``.

    The accepted set is generated from the small, reviewed forward installer
    and then replaying the cleanup mutations in their real order: barrier
    files from the start of the tuple, guard/recovery links, guard and primary
    unit files, the WAL flag transition, and finally the janitor link.  This
    makes missing-prefix/new-suffix barrier states recoverable without
    admitting arbitrary subsets.
    """

    if not isinstance(recovery_guard_installing, bool) or not isinstance(
        recovery_guard_installed, bool
    ) or (recovery_guard_installing and recovery_guard_installed):
        raise BootstrapError(
            "recovery_unsafe", "The terminal recovery guard flags differ."
        )

    asset_order = tuple(RECOVERY_ASSETS)
    link_order = tuple(RECOVERY_ENABLEMENT_LINKS)
    guard_link, recovery_link, janitor_link = link_order
    helper, guard_file, guard_unit, recovery_unit, janitor_unit = asset_order[:5]

    def fingerprint(
        candidate_states: dict[Path, str],
        candidate_links: dict[Path, bool],
    ) -> tuple[tuple[str, ...], tuple[bool, ...]]:
        return (
            tuple(candidate_states[path] for path in asset_order),
            tuple(candidate_links[path] for path in link_order),
        )

    def installation_frontiers() -> tuple[
        set[tuple[tuple[str, ...], tuple[bool, ...]]],
        set[tuple[tuple[str, ...], tuple[bool, ...]]],
    ]:
        all_frontiers: set[tuple[tuple[str, ...], tuple[bool, ...]]] = set()
        fully_armed: set[tuple[tuple[str, ...], tuple[bool, ...]]] = set()

        blank_states = {path: "missing" for path in asset_order}
        blank_links = {path: False for path in link_order}
        bases: list[dict[Path, str]] = []
        if predecessor_declared:
            predecessor = dict(blank_states)
            predecessor[helper] = "old"
            predecessor[janitor_unit] = "old"
            bases.append(predecessor)
        else:
            bases.append(dict(blank_states))

        # A completed earlier cleanup deliberately retains only the reviewed
        # helper and janitor files.  A retry may start rebuilding from that
        # exact successor residue, but from no other arbitrary subset.
        if successor_declared:
            retained = dict(blank_states)
            retained[helper] = "new"
            retained[janitor_unit] = "new"
            bases.append(retained)

        for base in bases:
            candidate_states = dict(base)
            candidate_links = dict(blank_links)

            def remember() -> None:
                all_frontiers.add(fingerprint(candidate_states, candidate_links))

            remember()
            if not successor_declared:
                continue
            for path in (helper, guard_unit, recovery_unit, janitor_unit):
                candidate_states[path] = "new"
                remember()
            candidate_links[recovery_link] = True
            remember()
            candidate_links[janitor_link] = True
            remember()
            candidate_states[guard_file] = "new"
            remember()
            for barrier in RECOVERY_BARRIER_ASSETS:
                candidate_states[barrier] = "new"
                remember()
            candidate_links[guard_link] = True
            remember()
            fully_armed.add(fingerprint(candidate_states, candidate_links))
        return all_frontiers, fully_armed

    all_install, full_install = installation_frontiers()
    origins = full_install if recovery_guard_installed else all_install
    before_flag: set[tuple[tuple[str, ...], tuple[bool, ...]]] = set()
    after_flag: set[tuple[tuple[str, ...], tuple[bool, ...]]] = set()

    for origin_states_raw, origin_links_raw in origins:
        candidate_states = dict(zip(asset_order, origin_states_raw, strict=True))
        candidate_links = dict(zip(link_order, origin_links_raw, strict=True))

        def remember_before() -> None:
            before_flag.add(fingerprint(candidate_states, candidate_links))

        remember_before()
        for barrier in RECOVERY_BARRIER_ASSETS:
            if candidate_states[barrier] == "new":
                candidate_states[barrier] = "missing"
                remember_before()
        for link in (guard_link, recovery_link):
            if candidate_links[link]:
                candidate_links[link] = False
                remember_before()
        for path in (guard_file, guard_unit, recovery_unit):
            if candidate_states[path] == "new":
                candidate_states[path] = "missing"
                remember_before()

        # `_set_transaction(...guard flags false)` is the durable boundary
        # before proof reconciliation and removal of the final janitor link.
        after_flag.add(fingerprint(candidate_states, candidate_links))
        if candidate_links[janitor_link]:
            candidate_links[janitor_link] = False
            after_flag.add(fingerprint(candidate_states, candidate_links))

    current = fingerprint(states, link_states)
    accepted = (
        after_flag
        if not recovery_guard_installing and not recovery_guard_installed
        else before_flag
    )
    if current not in accepted:
        raise BootstrapError(
            "recovery_unsafe", "The terminal recovery cleanup is out of order."
        )


def _validate_preproduction_recovery_scaffold_readonly(
    transaction: dict[str, Any]
) -> None:
    """Authenticate an ordered fresh or .10 -> .11 recovery transition.

    GNU install replaces the four recovery-core files one at a time.  A
    corrective enrollment can therefore legitimately retain the exact .10
    helper and janitor while an exact prefix of the .11 core has already been
    published.  Only those two reviewed predecessor residues are accepted;
    every later asset/link must form the exact installation-order prefix.
    """

    def reviewed_tree(
        staged_value: Any,
        *,
        release_id: str,
        source_sha256: str,
        atlas_rpm_sha256: str,
        hermes_source_archive_sha256: str | None,
        location: str,
    ) -> Path:
        release = _direct_root_child(
            staged_value, DEPLOYMENT_RELEASES_ROOT, location=location
        )
        if release.name != release_id:
            raise BootstrapError(
                "recovery_unsafe", "A recovery scaffold release differs."
            )
        _validate_root_directory(release, 0o500)
        marker = _read_json(release / ".deployment-release.json", 16 * 1024)
        expected_marker = {
            "schema_version": 1,
            "release_id": release_id,
            "source_tree_sha256": source_sha256,
            "atlas_rpm_sha256": atlas_rpm_sha256,
        }
        if hermes_source_archive_sha256 is not None:
            expected_marker["hermes_source_archive_sha256"] = (
                hermes_source_archive_sha256
            )
        if marker != expected_marker:
            raise BootstrapError(
                "recovery_unsafe", "A recovery scaffold release marker differs."
            )
        tree = release / "tree"
        digest, _worker = _independent_source_digest(
            tree, require_root_owned=True
        )
        if not hmac.compare_digest(digest, source_sha256):
            raise BootstrapError(
                "recovery_unsafe", "A recovery scaffold source tree differs."
            )
        if hermes_source_archive_sha256 is not None and not hmac.compare_digest(
            _independent_regular_sha256(
                release / "artifacts" / HERMES_SOURCE_ARCHIVE_NAME
            ),
            hermes_source_archive_sha256,
        ):
            raise BootstrapError(
                "recovery_unsafe", "A recovery scaffold Hermes archive differs."
            )
        return tree

    successor_tree: Path | None = None
    staged = transaction.get("staged_release")
    if staged is not None:
        successor_tree = reviewed_tree(
            staged,
            release_id=str(transaction.get("release_id")),
            source_sha256=str(transaction.get("source_tree_sha256")),
            atlas_rpm_sha256=str(transaction.get("atlas_rpm_sha256")),
            hermes_source_archive_sha256=str(
                transaction.get("hermes_source_archive_sha256")
            ),
            location="staged release",
        )

    predecessor_tree: Path | None = None
    if os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        marker = _read_corrective_marker()
        corrective_transaction = _read_corrective_transaction_readonly(marker)
        if corrective_transaction.get("status") != "completed":
            raise BootstrapError(
                "recovery_unsafe",
                "The corrective archive handoff is not complete.",
            )
        history = Path(marker["history_path"])
        _validate_completed_corrective_history_inventory(history)
        if not _archived_state_matches(history / "state", marker):
            raise BootstrapError(
                "recovery_unsafe", "The corrective predecessor archive differs."
            )
        archived_transaction = _exact_json_document(
            _read_exact_root_file(
                history / "state/transaction.json", 256 * 1024, 0o600
            )
        )
        _corrective_predecessor_is_terminal(archived_transaction)
        predecessor_tree = reviewed_tree(
            archived_transaction.get("staged_release"),
            release_id=CORRECTIVE_PREDECESSOR["release_id"],
            source_sha256=CORRECTIVE_PREDECESSOR["source_tree_sha256"],
            atlas_rpm_sha256=CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"],
            hermes_source_archive_sha256=None,
            location="predecessor staged release",
        )

    source_paths = {
        INSTALLED_HELPER: "deploy/control-plane/bin/control-plane-bootstrap",
        RECOVERY_ASSETS[1]: (
            "deploy/control-plane/systemd/openbao.service.d/"
            "90-control-plane-bootstrap-guard.conf"
        ),
        **{
            Path("/etc/systemd/system") / unit:
                f"deploy/control-plane/systemd/{unit}"
            for unit in RECOVERY_UNITS
        },
    }

    def source_payload(tree: Path | None, path: Path) -> bytes | None:
        relative = source_paths.get(path)
        if tree is None or relative is None:
            return None
        mode, _size, _digest, payload = _hash_regular_source(
            tree / relative,
            capture=True,
            require_root_owned=True,
        )
        expected_mode = 0o755 if path == INSTALLED_HELPER else 0o644
        if mode != expected_mode or payload is None:
            raise BootstrapError(
                "recovery_unsafe", "A reviewed recovery source mode differs."
            )
        return payload

    successor_payloads = {
        path: source_payload(successor_tree, path) for path in source_paths
    }
    predecessor_payloads = {
        path: source_payload(predecessor_tree, path)
        for path in (INSTALLED_HELPER, RECOVERY_ASSETS[4])
    }
    states: dict[Path, str] = {}
    for path in RECOVERY_ASSETS:
        if not os.path.lexists(path):
            states[path] = "missing"
            continue
        mode = 0o700 if path == INSTALLED_HELPER else 0o644
        observed = _read_exact_root_file(
            path, 4 * 1024 * 1024 if path == INSTALLED_HELPER else 256 * 1024, mode
        )
        if path in RECOVERY_BARRIER_ASSETS:
            successor = (
                RECOVERY_BARRIER_DROPIN if successor_tree is not None else None
            )
        else:
            successor = successor_payloads.get(path)
        predecessor = predecessor_payloads.get(path)
        if successor is not None and hmac.compare_digest(observed, successor):
            states[path] = "new"
        elif predecessor is not None and hmac.compare_digest(
            observed, predecessor
        ):
            states[path] = "old"
        else:
            raise BootstrapError(
                "recovery_unsafe", "A pre-production recovery asset differs."
            )

    link_states: dict[Path, bool] = {}
    for link, target in RECOVERY_ENABLEMENT_LINKS.items():
        present = os.path.lexists(link)
        link_states[link] = present
        if present:
            _validate_enablement_link(link, target)
    _validate_recovery_scaffold_transition(
        states,
        link_states,
        predecessor_declared=predecessor_tree is not None,
        successor_declared=successor_tree is not None,
        cleanup_flags=(
            (
                transaction.get("recovery_guard_installing"),
                transaction.get("recovery_guard_installed"),
            )
            if transaction.get("status") == "rolled-back"
            and transaction.get("phase") == "rolled-back"
            else None
        ),
    )


def _finalize_rollback_transaction(
    transaction: dict[str, Any], *, preproduction: bool = False
) -> None:
    """Commit the terminal audit before making the rollback WAL terminal."""

    _set_transaction(
        transaction,
        phase=(
            PREPRODUCTION_ROLLBACK_AUDIT_PHASE
            if preproduction
            else "rollback-audit-pending"
        ),
    )
    _append_rollback_audit_exact_once(transaction)
    _set_transaction(
        transaction,
        status="rolled-back",
        phase="rolled-back",
        recovery_activation_units=[],
        rolled_back_at=int(time.time()),
    )


def rollback_bootstrap(
    worker: dict[str, Any],
    transaction: dict[str, Any],
    *,
    deferred_activations: list[str] | None = None,
) -> None:
    release_id = str(transaction.get("release_id", "unknown"))
    # Never leave Atlas-visible success state while rollback is in progress.
    # A malformed or foreign marker is rejected rather than unlinked.
    _remove_public_installed_proof(transaction)
    if _preproduction_rollback_is_unchanged(transaction):
        # Nothing outside the inert recovery scaffold and staged evidence has
        # changed.  Stopping the broker here would itself create the first
        # production mutation before a complete current-boot watcher exists.
        _finalize_rollback_transaction(transaction, preproduction=True)
        _cleanup_recovery_guard(transaction)
        return
    # Rollback can itself be the first operation that stops a production
    # service (for example after a pre-production install failure).  Use the
    # same write-ahead intent so a partial rollback cannot be mistaken for a
    # GUI-safe frontier.
    _quiesce_broker_with_recovery_intent(worker, transaction)
    _reconcile_nonroot_escrow_staging(transaction)
    _recover_or_cancel_root_generation(worker, transaction)
    restore_openbao_from_transaction(worker, transaction)
    _finalize_recovered_userpass(transaction)
    if (
        transaction.get("openbao_provisioning_started") is True
        and transaction.get("openbao_poststate_recorded") is not True
    ):
        _record_openbao_poststate(transaction)
    _undo_openbao_state(transaction)
    # capture_backup publishes CURRENT before it quiesces anything.  It can
    # then fail before returning the path to this outer WAL, so always recover
    # the correlated pointer rather than trusting only deployment_backup.
    backup = _discover_deployment_backup(transaction)
    deployment_metadata: dict[str, Any] | None = None
    if backup is not None:
        deployment_metadata = worker["read_json"](
            backup / "transaction.json", maximum=128 * 1024, require_root_owned=True
        )
        worker["rollback_transaction"](backup, deployment_metadata)
    credentials_before = transaction.get("credentials_before", {})
    if isinstance(credentials_before, dict):
        for group, names in CREDENTIAL_GROUPS.items():
            if credentials_before.get(group) is False:
                for name in names:
                    (Path("/etc/credstore.encrypted") / name).unlink(missing_ok=True)
        _fsync_directory(Path("/etc/credstore.encrypted"))
    if APPROVER_PATH.exists() and transaction.get("approver_state_created") is True:
        APPROVER_PATH.unlink()
        _fsync_directory(APPROVER_PATH.parent)
    if os.path.lexists(PROOF_PATH):
        metadata = os.lstat(PROOF_PATH)
        if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0:
            raise BootstrapError("rollback_failed", "The bootstrap proof is unsafe to invalidate.")
        PROOF_PATH.unlink()
        _fsync_directory(PROOF_PATH.parent)
    _restore_broker_state(
        worker, transaction, verify_active=deferred_activations is None
    )
    if deployment_metadata is not None:
        worker["atomic_json"](
            worker["CURRENT_PATH"],
            {
                "schema_version": 1,
                "release_id": transaction["release_id"],
                "status": "rolled-back",
                "transaction_id": deployment_metadata["transaction_id"],
                "backup_path": str(backup),
                "activated_at": int(time.time()),
            },
        )
    # The inner worker sync precedes outer credential deletion and broker
    # enablement restoration. Flush those final /etc,/var mutations before
    # either root authority is revoked or a terminal rollback phase is stored.
    worker["_sync_rollback_filesystems"]()
    # Retain the encrypted root authority until every compensating file,
    # identity and OpenBao operation has completed.  A failed rollback can
    # then be retried without leaving provisioned server state behind.
    _finalize_root_token(transaction)
    if deferred_activations is not None:
        ordered = [unit for unit in RECOVERY_DEPENDENT_UNITS if unit in deferred_activations]
        _set_transaction(
            transaction,
            status="activation-pending",
            phase="rollback-activation-pending",
            recovery_activation_units=ordered,
        )
        append_audit(
            "bootstrap_rollback_files_restored",
            release_id=release_id,
            details={"deferred_unit_count": len(ordered)},
        )
        return
    _finalize_rollback_transaction(transaction)
    _cleanup_recovery_guard(transaction)


def _finish_committed_cleanup(transaction: dict[str, Any]) -> None:
    if transaction.get("status") != "completed" or not isinstance(transaction.get("proof"), dict):
        raise BootstrapError("recovery_unsafe", "The bootstrap commit record is incomplete.")
    # The five fresh Zulip containers deliberately use restart=no until the
    # outer bootstrap WAL is durably committed. Arm their steady-state restart
    # policy only here. This finalizer accepts a partially updated set and is
    # replayed by recovery for status=completed.
    deployment_backup = _discover_deployment_backup(transaction)
    if deployment_backup is None:
        raise BootstrapError(
            "recovery_unsafe", "The committed Docker transaction backup is absent."
        )
    worker = _verified_staged_worker(transaction)
    if ACTIVE_DEPLOYMENT_LOCK_FD is None:
        raise BootstrapError("recovery_unsafe", "The deployment lock is absent.")
    worker["INHERITED_LOCK_FD"] = ACTIVE_DEPLOYMENT_LOCK_FD
    metadata = worker["read_json"](
        deployment_backup / "transaction.json",
        maximum=128 * 1024,
        require_root_owned=True,
    )
    if (
        metadata.get("release_id") != transaction["release_id"]
        or metadata.get("transaction_id") != deployment_backup.name
    ):
        raise BootstrapError(
            "recovery_unsafe", "The committed Docker transaction identity differs."
        )
    worker["commit_zulip_container_restart_policies"](metadata)
    worker["_sync_rollback_filesystems"]()
    _reconcile_nonroot_escrow_staging(transaction)
    # This is normally complete before the commit record. Replaying it here
    # also closes a crash after the finalized WAL but before ciphertext unlink.
    _finalize_recovered_userpass(transaction)
    if transaction.get("openbao_undo_escrowed") is True:
        _set_transaction(
            transaction,
            openbao_undo_escrowed=False,
            openbao_undo_write_started=False,
            openbao_undo_complete=True,
            openbao_provisioning_started=False,
            phase="commit-undo-released",
        )
    if transaction.get("openbao_undo_complete") is True:
        OPENBAO_UNDO_ESCROW.unlink(missing_ok=True)
        _fsync_directory(OPENBAO_UNDO_ESCROW.parent)
    _finalize_root_token(transaction)
    _publish_exact_once(
        PROOF_PATH, _canonical(transaction["proof"]) + b"\n", 0o600
    )
    _cleanup_recovery_guard(transaction)


def apply_bootstrap(
    worker_bytes: bytes, manifest: dict[str, Any], preflight: dict[str, Any],
    session: str, invoker_uid: int, openbao_password: bytearray, zulip_password: bytearray,
    deployment_lock_fd: int,
    mutation_boundary: Callable[[], None] | None = None,
    progress_callback: Callable[[str, int, str], None] | None = None,
    corrective_context: dict[str, Any] | None = None,
    recovery_classification_required: bool = False,
) -> dict[str, Any]:
    global ACTIVE_DEPLOYMENT_LOCK_FD
    ACTIVE_DEPLOYMENT_LOCK_FD = deployment_lock_fd
    # Revalidate under the exclusive lock immediately before the irreversible
    # one-shot marker.  Any later source race is caught again by stage_release.
    second_manifest, second_digest, second_manifest_sha, second_worker_bytes = load_reviewed_release(
        preflight["bootstrap_helper_sha256"]
    )
    if second_manifest != manifest or second_digest != preflight["source_tree_sha256"]:
        raise BootstrapError("checksum_mismatch", "The release changed after confirmation.")
    if not hmac.compare_digest(second_manifest_sha, preflight["manifest_sha256"]):
        raise BootstrapError("checksum_mismatch", "The release manifest changed after confirmation.")
    if not hmac.compare_digest(hashlib.sha256(second_worker_bytes).digest(), hashlib.sha256(worker_bytes).digest()):
        raise BootstrapError("checksum_mismatch", "The deployment worker changed after confirmation.")
    corrective_mode = preflight.get("operation_mode") == "corrective"
    if recovery_classification_required:
        (
            classified_mode,
            second_corrective_context,
            resume_transaction,
        ) = _classify_gui_recovery_mode(
            second_manifest,
            second_digest,
            second_manifest_sha,
            preflight["bootstrap_helper_sha256"],
        )
        if classified_mode != preflight.get("operation_mode"):
            raise BootstrapError(
                "preflight_changed", "The reviewed recovery mode changed."
            )
        corrective_mode = classified_mode == "corrective"
    elif corrective_mode:
        second_corrective_context = _review_corrective_retry(
            second_manifest,
            second_digest,
            second_manifest_sha,
            preflight["bootstrap_helper_sha256"],
        )
        resume_transaction = second_corrective_context["enrollment_resume"]
    else:
        if corrective_context is not None:
            raise BootstrapError(
                "preflight_changed", "The bootstrap operation mode changed."
            )
        second_corrective_context = None
        resume_transaction = _review_enrollment_resume(
            second_manifest,
            second_digest,
            second_manifest_sha,
            preflight["bootstrap_helper_sha256"],
        )
    if (resume_transaction is not None) is not (preflight.get("enrollment_resume") is True):
        raise BootstrapError("preflight_changed", "The enrollment state changed after confirmation.")
    repeated = bootstrap_preflight(
        second_manifest,
        second_digest,
        second_manifest_sha,
        enrollment_resume=resume_transaction,
        corrective_context=second_corrective_context,
    )
    if any(repeated.get(key) != preflight.get(key) for key in repeated):
        raise BootstrapError("preflight_changed", "The host preflight changed after confirmation.")
    rollback_finalize_resume = preflight.get("rollback_finalize_resume") is True
    if rollback_finalize_resume:
        if openbao_password or zulip_password:
            raise BootstrapError(
                "secret_invalid",
                "Rollback finalization must not receive credential material.",
            )
    elif not openbao_password or not zulip_password:
        raise BootstrapError(
            "secret_invalid", "Installation credentials are absent."
        )
    # This callback is the GUI protocol's authoritative cancellation boundary.
    # It emits and flushes `mutation-started` only after every repeated
    # read-only check, and immediately before the one-shot WAL or resume write.
    if mutation_boundary is not None:
        mutation_boundary()

    if resume_transaction is not None and not corrective_mode:
        # The one-shot marker is already durable, but its first O_APPEND audit
        # may have been interrupted at any byte.  Repair/recognize that exact
        # marker-bound record before any resumed WAL, audit, live-marker or
        # service mutation.
        _ensure_bootstrap_consumed_audit_exact_once(resume_transaction)

    def progress(phase: str, percent: int, message: str) -> None:
        if progress_callback is not None:
            progress_callback(phase, percent, message)

    if rollback_finalize_resume:
        terminal_candidate = (
            _preproduction_terminal_rollback_candidate(
                resume_transaction,
                release_id=manifest["release_id"],
                source_tree_sha256=preflight["source_tree_sha256"],
                atlas_rpm_sha256=preflight["atlas_rpm_sha256"],
                hermes_source_archive_sha256=preflight["hermes_source_archive_sha256"],
            )
            if resume_transaction is not None
            else None
        )
        pending = (
            resume_transaction is not None
            and resume_transaction.get("phase")
            == PREPRODUCTION_ROLLBACK_AUDIT_PHASE
        )
        unchanged_candidate = resume_transaction if pending else terminal_candidate
        if (
            resume_transaction is None
            or unchanged_candidate is None
            or not _preproduction_rollback_is_unchanged(unchanged_candidate)
        ):
            raise BootstrapError(
                "preflight_changed",
                "The reviewed pre-production rollback frontier changed.",
            )
        if os.path.lexists(LIVE_TRANSACTION_PATH):
            if _live_bootstrap_is_verified(resume_transaction):
                raise BootstrapError(
                    "bootstrap_busy", "The rollback finalizer is already active."
                )
            _remove_live_transaction(only_current=False)
        # This dedicated resume consumes no secret and cannot enter staging,
        # broker quiescence, OpenBao recovery or deployment installation.
        progress(
            "rollback-finalizing", 50,
            "Finalisation idempotente du rollback préproduction.",
        )
        if pending:
            _finalize_rollback_transaction(
                resume_transaction, preproduction=True
            )
        else:
            # Terminal WAL already follows the exact rollback audit.  Verify
            # idempotence without rewriting either before replaying cleanup.
            _append_rollback_audit_exact_once(resume_transaction)
        _cleanup_recovery_guard(resume_transaction)
        progress(
            "rollback-finalized", 98,
            "Rollback préproduction finalisé sans mot de passe.",
        )
        return {
            "status": "rolled-back",
            "release_id": manifest["release_id"],
            "bootstrap_consumed": True,
        }

    if corrective_mode:
        assert second_corrective_context is not None
        helper_bytes = _read_exact_root_file(
            TRUST_ANCHOR_BOOTSTRAP_HELPER, 4 * 1024 * 1024, 0o555
        )
        if not hmac.compare_digest(
            hashlib.sha256(helper_bytes).hexdigest(),
            preflight["bootstrap_helper_sha256"],
        ):
            raise BootstrapError(
                "checksum_mismatch", "The corrective helper changed before anchoring."
            )
        if second_corrective_context["kind"] == "new":
            predecessor_transaction = second_corrective_context["predecessor"][
                "transaction"
            ]
            _install_corrective_scaffold(
                helper_bytes, preflight["bootstrap_helper_sha256"]
            )
            # Re-read every service through the strict tri-state systemctl
            # parser after the scaffold is durably armed.  In particular an
            # absent/masked/query-failed unit must not collapse to the same
            # False value as an inactive/disabled predecessor snapshot.
            successor_transaction = _new_transaction(
                manifest, preflight, strict_service_state=True
            )
            if any(
                successor_transaction[key] != predecessor_transaction[key]
                for key in (
                    "credentials_before", "service_state_before",
                    "broker_state_before",
                )
            ):
                raise BootstrapError(
                    "preflight_changed",
                    "The restored predecessor snapshot changed before consumption.",
                )
            marker = _new_corrective_marker(
                manifest,
                session,
                invoker_uid,
                preflight["bootstrap_helper_sha256"],
                preflight["manifest_sha256"],
                second_corrective_context["predecessor"],
                successor_transaction,
            )
            transaction = _consume_corrective_exception(
                marker, preflight["bootstrap_helper_sha256"]
            )
        else:
            marker = second_corrective_context["marker"]
            # A previous process may have consumed the marker while the path
            # watcher was stopped or failed.  Reconcile the exact inert
            # scaffold, reset failures, restart the watcher, and prove it is
            # active before touching either the predecessor archive or the
            # successor WAL.  This closes the process-crash-without-reboot
            # window for every resumed GUI attempt.
            _install_corrective_scaffold(
                helper_bytes, preflight["bootstrap_helper_sha256"]
            )
            transaction = _reconcile_corrective_handoff(marker)
        resume_transaction = _review_enrollment_resume(
            second_manifest,
            second_digest,
            second_manifest_sha,
            preflight["bootstrap_helper_sha256"],
            allow_corrective_successor=True,
        )
        if resume_transaction is None:
            raise BootstrapError(
                "corrective_state_invalid", "The corrective successor WAL is unavailable."
            )
        transaction = resume_transaction
        if os.path.lexists(LIVE_TRANSACTION_PATH):
            if _live_bootstrap_is_verified(transaction):
                raise BootstrapError(
                    "bootstrap_busy", "The matching corrective successor is still active."
                )
            _remove_live_transaction(only_current=False)
        _set_transaction(
            transaction,
            status="running",
            phase="enrollment-resuming",
            recovery_activation_units=[],
        )
    elif resume_transaction is None:
        transaction = _new_transaction(manifest, preflight)
        consume_exception(
            manifest,
            session,
            invoker_uid,
            preflight["bootstrap_helper_sha256"],
            preflight["manifest_sha256"],
            transaction,
        )
    else:
        transaction = resume_transaction
        if os.path.lexists(LIVE_TRANSACTION_PATH):
            if _live_bootstrap_is_verified(transaction):
                raise BootstrapError("bootstrap_busy", "The matching bootstrap is still active.")
            _remove_live_transaction(only_current=False)
        _set_transaction(
            transaction,
            status="running",
            phase="enrollment-resuming",
            recovery_activation_units=[],
        )
    _write_live_transaction(transaction, preflight["bootstrap_helper_sha256"])
    worker = _load_verified_worker(second_worker_bytes)
    # Every mutating descendant inherits the same open-file-description lock.
    # If this parent is killed, recovery cannot race a still-running installer.
    worker["INHERITED_LOCK_FD"] = deployment_lock_fd
    try:
        worker["validate_manifest"](manifest)
    except BaseException as exc:
        raise BootstrapError(
            str(getattr(exc, "code", "manifest_invalid")),
            "The confirmed deployment worker rejected the release.",
        ) from exc
    release: Path | None = None
    backup: Path | None = None
    metadata: dict[str, Any] | None = None
    try:
        guard_already_armed = (
            resume_transaction is not None
            and transaction.get("recovery_guard_installed") is True
            and transaction.get("recovery_guard_installing") is False
        )
        if (
            resume_transaction is not None
            and transaction.get("recovery_guard_installing") is True
            and transaction.get("recovery_guard_installed") is False
        ):
            # Enrollment is allowed to resume only before a production
            # mutation. Remove only a partially installed guard under the same
            # lock and rebuild it from the revalidated staged release. A fully
            # armed guard is never removed during resume, including the narrow
            # crash boundary after broker quiescence and before backup WAL.
            _cleanup_recovery_guard(transaction)
        for directory in (worker["STATE_ROOT"], worker["RELEASES_ROOT"], worker["BACKUP_ROOT"]):
            directory.mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chmod(directory, 0o700)
        release = worker["stage_release"](manifest)
        # STATE_ROOT, RELEASES_ROOT and BACKUP_ROOT may all be new on the
        # initial enrollment.  Persist both the staged tree and every newly
        # created parent/mount before the WAL claims that recovery can load
        # the staged worker, and before systemd recovery is armed.
        worker["_sync_rollback_filesystems"]()
        _set_transaction(transaction, phase="release-staged", staged_release=str(release))
        progress("release-staged", 28, "Release transactionnelle préparée.")
        if guard_already_armed:
            _fsync_recovery_anchor(release / "tree")
            _set_transaction(transaction, phase="recovery-armed")
        else:
            _install_recovery_guard(release, worker, transaction)
        # A prior supervisor may have completed after a safe preproduction
        # interruption.  Reuse an exact live transient unit or create and
        # attest a new one on every resume before broker maintenance begins.
        _start_standard_recovery_supervisor(transaction)
        _wait_standard_recovery_supervisor()
        progress("rollback-armed", 34, "Reprise et rollback automatiques armés.")
        _quiesce_broker_with_recovery_intent(worker, transaction)
        progress("services-quiesced", 38, "Services locaux placés en maintenance.")
        backup, metadata = worker["capture_backup"](manifest)
        metadata["backup_path"] = str(backup)
        worker["atomic_json"](backup / "transaction.json", metadata)
        openbao_backup = backup / "openbao.hcl"
        original_openbao = _read_root_file(OPENBAO_CONFIG, 256 * 1024, private=False)
        _atomic_bytes(openbao_backup, original_openbao, mode=0o600)
        _set_transaction(
            transaction,
            phase="snapshotted",
            deployment_backup=str(backup),
            openbao_backup=str(openbao_backup),
            openbao_backup_sha256=hashlib.sha256(original_openbao).hexdigest(),
        )
        progress("backup-complete", 45, "Sauvegarde locale vérifiée et synchronisée.")
        recover_openbao_password(openbao_password, worker, transaction)
        progress("openbao-access", 55, "Accès administrateur OpenBao récupéré.")
        _snapshot_openbao_undo(transaction)
        metadata["phase"] = "installing"
        worker["atomic_json"](backup / "transaction.json", metadata)
        _set_transaction(
            transaction,
            phase="installing",
            openbao_provisioning_started=True,
        )
        approver_id = _install_and_activate(
            worker, release, manifest, metadata, openbao_password, zulip_password,
            dict(preflight["credential_groups_present"]), transaction, deployment_lock_fd,
        )
        progress("services-installed", 80, "Atlas, Zulip et services IA installés.")
        _record_openbao_poststate(transaction)
        _set_transaction(transaction, phase="health-check")
        health_evidence = _bootstrap_health(
            worker, manifest, approver_id, metadata
        )
        progress("health-verified", 92, "Contrôles de santé et d’isolation réussis.")
        # Commit installed files, package state, container volumes and systemd
        # enablements before publishing either healthy record.
        worker["_sync_rollback_filesystems"]()
        metadata["phase"] = "healthy"
        worker["atomic_json"](backup / "transaction.json", metadata)
        worker["atomic_json"](
            worker["CURRENT_PATH"],
            {
                "schema_version": 1,
                "release_id": manifest["release_id"],
                "status": "healthy-degraded",
                "transaction_id": metadata["transaction_id"],
                "backup_path": str(backup),
                "activated_at": int(time.time()),
            },
        )
        if (
            transaction.get("openbao_undo_escrowed") is not True
            or not OPENBAO_UNDO_ESCROW.exists()
            or transaction.get("root_token_escrowed") is not True
            or not ROOT_TOKEN_ESCROW.exists()
        ):
            raise BootstrapError("escrow_failed", "A commit rollback escrow is absent.")
        _finalize_recovered_userpass(transaction)
        tail = append_audit(
            "bootstrap_health_passed",
            release_id=manifest["release_id"],
            details={
                "status": "healthy-degraded",
                "provider_keys": health_evidence["provider_keys_configured"],
                "provider_routes_available": health_evidence["provider_routes_available"],
                "zulip_approver_reconciled": health_evidence["zulip_approver_reconciled"],
                "broker_policy_sha256": health_evidence["broker_policy_sha256"],
                "password_recovery_persists": True,
            },
        )
        proof = {
            "schema_version": 1,
            "release_id": manifest["release_id"],
            "source_tree_sha256": manifest["source"]["tree_sha256"],
            "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
            "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
            "status": "healthy-degraded",
            "provider_accounts_configured": health_evidence["provider_accounts_configured"],
            "provider_keys_configured": health_evidence["provider_keys_configured"],
            "provider_routes_available": health_evidence["provider_routes_available"],
            "provider_network_probe": health_evidence["provider_network_probe"],
            "finance_status": health_evidence["finance_status"],
            "broker_status": health_evidence["broker_status"],
            "broker_policy_sha256": health_evidence["broker_policy_sha256"],
            "zulip_approver_reconciled": health_evidence["zulip_approver_reconciled"],
            "bootstrap_consumed": True,
            "password_recovery_persists_on_rollback": True,
            "completed_at": int(time.time()),
            "audit_tail_sha256": tail,
        }
        _set_transaction(
            transaction,
            status="completed",
            phase="cleanup-pending",
            proof=proof,
            completed_at=proof["completed_at"],
        )
        _finish_committed_cleanup(transaction)
        progress("cleanup-complete", 98, "Commit durable et autorité one-shot désactivée.")
        return {"status": "healthy-degraded", "release_id": manifest["release_id"], "bootstrap_consumed": True}
    except BaseException as exc:
        if transaction.get("status") in {"completed", "rolled-back"}:
            # A fsynced terminal status is the commit boundary for either
            # direction.  Failure while self-disabling a remaining janitor is
            # cleanup-only: recovery replays it, and must never downgrade a
            # proven rollback to rollback-failed or attempt compensation a
            # second time.
            raise BootstrapError(
                "cleanup_pending",
                "Bootstrap reached a terminal state; durable recovery will finish local cleanup.",
            ) from exc
        failure_code, failure_phase = _bootstrap_failure_diagnostic(exc, transaction)
        failure_audit_error: BaseException | None = None
        try:
            # This record deliberately contains no exception message.  The
            # worker code and transaction phase are bounded identifiers, so a
            # credential accidentally included in an exception can reach
            # neither the durable audit nor Atlas.
            append_audit(
                "bootstrap_failure_detected",
                release_id=manifest["release_id"],
                details={"code": failure_code, "phase": failure_phase},
            )
        except BaseException as inner:
            # Audit failure must never prevent the compensating rollback.
            failure_audit_error = inner
        rollback_error: BaseException | None = None
        try:
            rollback_bootstrap(worker, transaction)
        except BaseException as inner:
            rollback_error = inner
            if transaction.get("phase") not in {
                "rollback-audit-pending",
                PREPRODUCTION_ROLLBACK_AUDIT_PHASE,
            }:
                # Preserve the write-ahead origin phase.  In particular
                # broker-quiescing/broker-quiesced must never be collapsed to
                # the GUI-safe legacy rollback-failed enrollment frontier.
                _mark_rollback_failed_preserving_frontier(transaction)
                append_audit(
                    "bootstrap_rollback_failed", release_id=manifest["release_id"]
                )
        if rollback_error is not None:
            raise BootstrapError(
                "rollback_failed",
                "Bootstrap failed and automatic rollback also failed.",
                phase="rollback-failed",
            ) from exc
        if failure_audit_error is not None:
            raise BootstrapError(
                "audit_failed",
                "Bootstrap failed and rolled back, but its failure audit could not be recorded.",
                phase=failure_phase,
            ) from failure_audit_error
        raise BootstrapError(
            failure_code,
            "Bootstrap failed; the prior service/file state was restored.",
            phase=failure_phase,
        ) from exc
def recovery_entry(*, openbao_only: bool) -> int:
    if os.geteuid() != 0:
        return 77
    global ACTIVE_DEPLOYMENT_LOCK_FD
    lock: int | None = None
    try:
        helper_info = os.lstat(INSTALLED_HELPER)
        current_info = os.stat(Path(__file__))
        if (
            not stat.S_ISREG(helper_info.st_mode)
            or stat.S_ISLNK(helper_info.st_mode)
            or helper_info.st_uid != 0
            or stat.S_IMODE(helper_info.st_mode) & 0o022
            or current_info.st_dev != helper_info.st_dev
            or current_info.st_ino != helper_info.st_ino
        ):
            raise BootstrapError("recovery_unsafe", "The installed recovery helper is unsafe.")
        if not os.path.lexists(STATE_ROOT):
            # O_EXCL may have consumed the one-shot just before power loss.
            # No production mutation can precede the transaction WAL.
            return 0
        transaction = _read_standard_transaction_frontier(
            promote_staging=False
        )
        if transaction is None:
            return 0
        lock = _acquire_lock(allow_busy=True)
        if lock is None:
            # A controlled OpenBao restart while the bootstrap owns the exact
            # deployment lock must not make the guard close its live UDS.  A
            # crash releases the OFD and the next guard invocation restores it.
            if _live_bootstrap_is_verified(transaction):
                return 0
            raise BootstrapError(
                "recovery_busy", "Full recovery cannot bypass an unverified lock holder."
            )
        ACTIVE_DEPLOYMENT_LOCK_FD = lock
        transaction = _read_standard_transaction_frontier(
            promote_staging=True
        )
        if transaction is None:
            raise BootstrapError(
                "recovery_unsafe", "The bootstrap WAL disappeared during recovery."
            )
        if not os.path.lexists(CORRECTIVE_CONSUMED_PATH):
            _ensure_bootstrap_consumed_audit_exact_once(transaction)
        if transaction.get("phase") == PREPRODUCTION_ROLLBACK_AUDIT_PHASE:
            if openbao_only:
                # The OpenBao guard has a deliberately narrower filesystem
                # sandbox.  Full recovery, ordered later in this boot, owns
                # terminal audit reconciliation and scaffold cleanup.
                return 0
            if not _preproduction_recovery_frontier_is_unchanged(transaction):
                raise BootstrapError(
                    "recovery_unsafe",
                    "The pre-production rollback frontier changed during recovery.",
                )
            _validate_preproduction_recovery_scaffold_readonly(transaction)
            _finalize_rollback_transaction(transaction, preproduction=True)
            _cleanup_recovery_guard(transaction)
            return 0
        if openbao_only:
            # This flag is authoritative even after a prior rollback failure.
            # An incomplete root attempt needs the private UDS during the full
            # recovery unit. Keep it available across this one OpenBao start.
            if (
                transaction.get("openbao_restore_required") is True
                and transaction.get("root_generation_pending") is not True
            ):
                restore_openbao_from_transaction(None, transaction, restart=False)
            return 0
        if os.path.lexists(LIVE_TRANSACTION_PATH):
            if _live_bootstrap_is_verified(transaction):
                raise BootstrapError("recovery_busy", "A matching bootstrap is still active.")
            _remove_live_transaction(only_current=False)
        consumed = _read_json(CONSUMED_PATH, 128 * 1024)
        helper_sha256 = consumed.get("bootstrap_helper_sha256")
        if not isinstance(helper_sha256, str) or not SHA256_RE.fullmatch(helper_sha256):
            raise BootstrapError("recovery_unsafe", "The enrolled helper identity is invalid.")
        _write_live_transaction(transaction, helper_sha256, mode="recovery")
        _reconcile_nonroot_escrow_staging(transaction)
        status = transaction["status"]
        if status == "completed":
            _finish_committed_cleanup(transaction)
            return 0
        if status == "rolled-back":
            _cleanup_recovery_guard(transaction)
            return 0
        if status == "activation-pending":
            worker = _verified_staged_worker(transaction)
            worker["INHERITED_LOCK_FD"] = lock
            _queue_recovery_unit_jobs(worker, transaction)
            # A successful return triggers the verifier ordered after every
            # queued managed-unit job. Reboots replay this volatile queue.
            return 0
        if status not in {"running", "rollback-failed"}:
            raise BootstrapError("recovery_unsafe", "The bootstrap recovery state is invalid.")
        worker = (
            _verified_staged_worker(transaction)
            if isinstance(transaction.get("staged_release"), str)
            else None
        )
        if worker is not None:
            worker["INHERITED_LOCK_FD"] = lock
        deployment_backup = _discover_deployment_backup(transaction)
        if deployment_backup is None:
            if transaction.get("openbao_restore_required") is True:
                raise BootstrapError("recovery_failed", "OpenBao recovery lacks its durable backup.")
            planned = (
                _planned_recovery_activations(worker, transaction, None)
                if worker is not None else []
            )
            existing_plan = transaction.get("recovery_activation_units")
            if existing_plan not in ([], planned):
                raise BootstrapError("recovery_unsafe", "Saved activation plan differs.")
            _set_transaction(
                transaction,
                phase="rollback-activation-planned",
                recovery_activation_units=planned,
            )
            observed = (
                _defer_barriered_starts(
                    worker,
                    lambda _deferred: _restore_broker_state(
                        worker, transaction, verify_active=False
                    ),
                )
                if worker is not None
                else []
            )
            if any(unit not in planned for unit in observed):
                raise BootstrapError("recovery_unsafe", "A deferred broker start escaped its plan.")
            if worker is not None:
                worker["_sync_rollback_filesystems"]()
            _set_transaction(
                transaction,
                status="activation-pending",
                phase="rollback-restored-activation-pending",
                recovery_activation_units=planned,
            )
            if worker is not None:
                _queue_recovery_unit_jobs(worker, transaction)
            append_audit(
                "bootstrap_rollback_files_restored",
                release_id=str(transaction.get("release_id", "unknown")),
                details={"production_mutation_started": False, "deferred_unit_count": len(planned)},
            )
            return 0
        if worker is None:
            raise BootstrapError("recovery_unsafe", "The staged recovery worker is absent.")
        metadata = worker["read_json"](
            deployment_backup / "transaction.json",
            maximum=128 * 1024,
            require_root_owned=True,
        )
        if (
            metadata.get("release_id") != transaction["release_id"]
            or metadata.get("transaction_id") != deployment_backup.name
        ):
            raise BootstrapError("recovery_unsafe", "The deployment backup identity differs.")
        planned = _planned_recovery_activations(worker, transaction, metadata)
        existing_plan = transaction.get("recovery_activation_units")
        if existing_plan not in ([], planned):
            raise BootstrapError("recovery_unsafe", "Saved activation plan differs.")
        _set_transaction(
            transaction,
            phase="rollback-activation-planned",
            recovery_activation_units=planned,
        )
        _recover_or_cancel_root_generation(worker, transaction)
        restore_openbao_from_transaction(worker, transaction, restart=True)

        # recovery.service is ordered before the managed units. Record starts
        # durably instead of queuing volatile jobs that cannot execute until
        # this unit exits. OnSuccess runs the second stage after this unit.
        observed = _defer_barriered_starts(
            worker,
            lambda _pending: rollback_bootstrap(
                worker, transaction, deferred_activations=planned
            ),
        )
        if any(unit not in planned for unit in observed):
            raise BootstrapError("recovery_failed", "A deferred activation escaped its WAL.")
        _queue_recovery_unit_jobs(worker, transaction)
        return 0
    except BaseException:
        try:
            if lock is not None and os.path.lexists(STATE_ROOT):
                transaction = _read_standard_transaction_frontier(
                    promote_staging=True
                )
                if transaction is None:
                    raise BootstrapError("recovery_unsafe", "The bootstrap WAL is absent.")
                if transaction.get("status") in {"running", "rollback-failed"}:
                    _mark_rollback_failed_preserving_frontier(transaction)
        except BaseException:
            pass
        return 1
    finally:
        try:
            if os.path.lexists(LIVE_TRANSACTION_PATH):
                marker = _read_json(LIVE_TRANSACTION_PATH, 16 * 1024)
                if marker.get("pid") == os.getpid() and marker.get("mode") == "recovery":
                    _remove_live_transaction(only_current=True)
        except BaseException:
            pass
        if lock is not None:
            os.close(lock)
        ACTIVE_DEPLOYMENT_LOCK_FD = None


def recovery_activation_entry() -> int:
    """Second recovery stage: restore and prove prior active service state."""

    if os.geteuid() != 0:
        return 77
    global ACTIVE_DEPLOYMENT_LOCK_FD
    lock: int | None = None
    try:
        helper_info = os.lstat(INSTALLED_HELPER)
        current_info = os.stat(Path(__file__))
        if (
            not stat.S_ISREG(helper_info.st_mode) or stat.S_ISLNK(helper_info.st_mode)
            or helper_info.st_uid != 0 or stat.S_IMODE(helper_info.st_mode) & 0o022
            or current_info.st_dev != helper_info.st_dev
            or current_info.st_ino != helper_info.st_ino
        ):
            raise BootstrapError("recovery_unsafe", "The installed recovery helper is unsafe.")
        transaction = _read_standard_transaction_frontier(
            promote_staging=False
        )
        if transaction is None:
            raise BootstrapError("recovery_unsafe", "The bootstrap WAL is absent.")
        lock = _acquire_lock(allow_busy=True)
        if lock is None:
            if _live_bootstrap_is_verified(transaction):
                return 0
            raise BootstrapError(
                "recovery_busy", "Recovery activation cannot bypass an unverified lock holder."
            )
        ACTIVE_DEPLOYMENT_LOCK_FD = lock
        transaction = _read_standard_transaction_frontier(
            promote_staging=True
        )
        if transaction is None:
            raise BootstrapError("recovery_unsafe", "The bootstrap WAL is absent.")
        if transaction["status"] in {"completed", "rolled-back"}:
            _cleanup_recovery_guard(transaction)
            return 0
        if transaction["status"] != "activation-pending":
            raise BootstrapError("recovery_unsafe", "Recovery activation was not durably requested.")
        worker = _verified_staged_worker(transaction)
        worker["INHERITED_LOCK_FD"] = lock
        units = list(transaction["recovery_activation_units"])
        initial = transaction.get("service_state_before")
        if not isinstance(initial, dict) or set(initial) != set(RECOVERY_DEPENDENT_UNITS):
            raise BootstrapError("recovery_unsafe", "Saved initial service state is invalid.")
        expected_states: dict[str, dict[str, bool]] = {
            unit: dict(initial[unit]) for unit in RECOVERY_DEPENDENT_UNITS
            if isinstance(initial.get(unit), dict)
        }
        if len(expected_states) != len(RECOVERY_DEPENDENT_UNITS):
            raise BootstrapError("recovery_unsafe", "Saved initial service state is invalid.")
        backup = _discover_deployment_backup(transaction)
        if backup is not None:
            metadata = worker["read_json"](
                backup / "transaction.json", maximum=128 * 1024, require_root_owned=True
            )
            service_state = metadata.get("service_state")
            if not isinstance(service_state, dict):
                raise BootstrapError("recovery_unsafe", "Saved service state is invalid.")
            for unit in worker["SERVICE_NAMES"]:
                state = service_state.get(unit)
                if (
                    not isinstance(state, dict)
                    or set(state) != {"active", "enabled"}
                    or not all(isinstance(state[key], bool) for key in ("active", "enabled"))
                ):
                    raise BootstrapError("recovery_unsafe", "Saved service state is invalid.")
                if (
                    unit not in PREBACKUP_QUIESCED_UNITS
                    and state != expected_states.get(unit)
                ):
                    raise BootstrapError("recovery_unsafe", "Saved service snapshots differ.")
        broker_state = transaction.get("broker_state_before")
        if not isinstance(broker_state, dict):
            raise BootstrapError("recovery_unsafe", "Saved broker state is invalid.")
        for unit in ("ops-broker.socket", "ops-broker.service"):
            state = broker_state.get(unit)
            if (
                not isinstance(state, dict)
                or set(state) != {"active", "enabled"}
                or not all(isinstance(state[key], bool) for key in ("active", "enabled"))
            ):
                raise BootstrapError("recovery_unsafe", "Saved broker state is invalid.")
            if state != expected_states.get(unit):
                raise BootstrapError("recovery_unsafe", "Saved broker snapshots differ.")
        expected_active = [
            unit for unit in RECOVERY_DEPENDENT_UNITS
            if (
                unit not in DYNAMIC_SERVICE_UNITS
                and expected_states.get(unit, {}).get("active") is True
            )
        ]
        if units != expected_active:
            raise BootstrapError("recovery_unsafe", "Deferred activation set differs from the snapshot.")
        # recovery.service queued the exact start/stop jobs without blocking.
        # systemd orders this verifier after those jobs, so it can now prove
        # the complete active/enabled matrix before rollback becomes terminal.
        for unit in units:
            if not _systemctl_state(unit, "is-active"):
                raise BootstrapError(
                    "recovery_failed", "A prior active service was not restored."
                )
        for unit, state in expected_states.items():
            if (
                (unit not in DYNAMIC_SERVICE_UNITS
                 and _systemctl_state(unit, "is-active") is not state["active"])
                or _systemctl_state(unit, "is-enabled") is not state["enabled"]
            ):
                raise BootstrapError(
                    "recovery_failed", "A service activation state was not restored exactly."
                )
        _finalize_rollback_transaction(transaction)
        _cleanup_recovery_guard(transaction)
        return 0
    except BaseException:
        try:
            if lock is not None and os.path.lexists(STATE_ROOT):
                transaction = _read_standard_transaction_frontier(
                    promote_staging=True
                )
                if transaction is None:
                    raise BootstrapError("recovery_unsafe", "The bootstrap WAL is absent.")
                if (
                    transaction.get("status") == "activation-pending"
                    and transaction.get("phase") != "rollback-audit-pending"
                ):
                    _set_transaction(
                        transaction, status="activation-pending", phase="rollback-activation-failed"
                    )
        except BaseException:
            pass
        return 1
    finally:
        if lock is not None:
            os.close(lock)
        ACTIVE_DEPLOYMENT_LOCK_FD = None


def _verify_enrolled_self(expected_sha256: str) -> bytes:
    expected_path = Path(ENROLLED_HELPER_PREFIX + expected_sha256)
    try:
        actual_path = Path(__file__).resolve(strict=True)
        before = os.lstat(actual_path)
        descriptor = os.open(actual_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError("enrollment_invalid", "The ephemeral bootstrap helper is unavailable.") from exc
    try:
        metadata = os.fstat(descriptor)
        raw = b""
        while len(raw) <= 4 * 1024 * 1024:
            chunk = os.read(descriptor, min(1024 * 1024, 4 * 1024 * 1024 + 1 - len(raw)))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(descriptor)
    if (
        actual_path != expected_path or not SHA256_RE.fullmatch(expected_sha256)
        or not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700
        or metadata.st_nlink != 1 or before.st_nlink != 1
        or metadata.st_dev != before.st_dev or metadata.st_ino != before.st_ino
        or len(raw) != metadata.st_size or len(raw) > 4 * 1024 * 1024
        or not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), expected_sha256)
    ):
        raise BootstrapError("enrollment_invalid", "The ephemeral bootstrap helper is not root-owned and exact.")
    return raw


def _remove_enrolled_helper_exact(expected_sha256: str, *, required: bool) -> bool:
    """Remove only a captured, root-owned enrolled helper with the exact digest."""

    if not SHA256_RE.fullmatch(expected_sha256):
        raise BootstrapError("enrollment_invalid", "The enrolled helper identity is invalid.")
    expected_path = Path(ENROLLED_HELPER_PREFIX + expected_sha256)
    try:
        before = os.lstat(expected_path)
        descriptor = os.open(expected_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError:
        if not required:
            return False
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper is missing.")
    except OSError as exc:
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper is unsafe.") from exc
    try:
        opened = os.fstat(descriptor)
        chunks: list[bytes] = []
        remaining = 4 * 1024 * 1024 + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after_fd = os.fstat(descriptor)
        after_path = os.lstat(expected_path)
    except OSError as exc:
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper changed.") from exc
    finally:
        os.close(descriptor)
    identities = (before, opened, after_fd, after_path)
    if (
        any(not stat.S_ISREG(item.st_mode) for item in identities)
        or any(item.st_uid != 0 or item.st_gid != 0 for item in identities)
        or any(stat.S_IMODE(item.st_mode) != 0o700 for item in identities)
        or any(item.st_nlink != 1 for item in identities)
        or any(
            item.st_dev != opened.st_dev or item.st_ino != opened.st_ino
            for item in identities
        )
        or after_fd.st_size != opened.st_size
        or after_fd.st_mtime_ns != opened.st_mtime_ns
        or after_fd.st_ctime_ns != opened.st_ctime_ns
        or len(raw) != opened.st_size or len(raw) > 4 * 1024 * 1024
        or not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), expected_sha256)
    ):
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper is not root-owned and exact.")
    try:
        expected_path.unlink()
        _fsync_directory(expected_path.parent)
    except FileNotFoundError:
        if not required:
            return False
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper changed before removal.")
    except OSError as exc:
        raise BootstrapError("enrollment_invalid", "The ephemeral enrolled helper could not self-remove.") from exc
    return True


def _cleanup_stale_enrolled_helpers(current_sha256: str) -> None:
    """Reconcile only known pre-seal residues from reviewed failed releases."""

    for stale_sha256 in sorted(STALE_ENROLLED_HELPER_SHA256S):
        if stale_sha256 != current_sha256:
            _remove_enrolled_helper_exact(stale_sha256, required=False)


def _seal_and_exec(
    operation: str,
    source_root: Path,
    invoker_uid: int,
    session: str,
    helper_sha256: str,
    enrolled_raw: bytes,
    *,
    gui_atlas_binding: str | None = None,
    gui_channel_digest: str | None = None,
) -> None:
    if not hasattr(os, "memfd_create"):
        raise BootstrapError("sealed_helper_unavailable", "This kernel lacks sealed memory files.")
    if (
        len(enrolled_raw) > 4 * 1024 * 1024
        or not hmac.compare_digest(hashlib.sha256(enrolled_raw).hexdigest(), helper_sha256)
    ):
        raise BootstrapError("enrollment_invalid", "The captured bootstrap helper differs.")
    descriptor = os.memfd_create("ops-control-plane-bootstrap", os.MFD_ALLOW_SEALING)
    try:
        os.fchmod(descriptor, 0o500)
        view = memoryview(enrolled_raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError("sealed_helper_unavailable", "The root-owned helper staging failed.")
            view = view[written:]
        os.lseek(descriptor, 0, os.SEEK_SET)
        seals = fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL
        fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, seals)
        os.set_inheritable(descriptor, True)
        path = f"/proc/self/fd/{descriptor}"
        arguments = [
            "/usr/bin/python3", "-I", path, "--bootstrap-sealed", operation,
            str(source_root), str(invoker_uid), session, helper_sha256,
        ]
        if gui_atlas_binding is not None or gui_channel_digest is not None:
            if gui_atlas_binding is None or gui_channel_digest is None:
                raise BootstrapError("invocation_invalid", "The GUI binding is incomplete.")
            arguments = [
                "/usr/bin/python3", "-I", path, "--bootstrap-sealed-gui", operation,
                str(source_root), str(invoker_uid), session, helper_sha256,
                gui_atlas_binding, gui_channel_digest,
            ]
        os.execve(
            "/usr/bin/python3",
            arguments,
            {
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
                "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PYTHONDONTWRITEBYTECODE": "1",
            },
        )
    finally:
        os.close(descriptor)


def _verify_sealed_self() -> None:
    descriptor = os.open(Path(__file__), os.O_RDONLY | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        expected = fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL
        observed = fcntl.fcntl(descriptor, fcntl.F_GET_SEALS)
        if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o277 or observed & expected != expected:
            raise BootstrapError("sealed_helper_unsafe", "The bootstrap helper is not root-owned and sealed.")
    finally:
        os.close(descriptor)


def public_entry(arguments: list[str]) -> int:
    global GUI_PROTOCOL_ACTIVE, GUI_MUTATION_STARTED
    if len(arguments) == 1 and arguments[0] in {
        "gui-preflight", "gui-apply",
        "gui-corrective-preflight", "gui-corrective-apply",
        "gui-recovery-preflight", "gui-recovery-apply",
    }:
        GUI_PROTOCOL_ACTIVE = True
        public_operation = arguments[0]
        _set_gui_operation_context(public_operation)
        operation = public_operation.removeprefix("gui-")
        if os.geteuid() == 0 or os.getuid() == 0 or os.geteuid() != os.getuid():
            raise BootstrapError(
                "physical_auth_required",
                "Atlas must start the GUI bootstrap as the local user.",
            )
        invoker_uid = os.getuid()
        channel_digest = _gui_channel_digest(invoker_uid)
        atlas_binding = _new_gui_atlas_binding(invoker_uid)
        # Unlike the terminal compatibility entry point, Atlas supplies an
        # already-hashed immutable memory image. Never resolve or reopen the
        # user-writable repository pathname in this GUI launcher stage.
        source_root = EXPECTED_SOURCE_ROOT
        raw = _read_gui_launcher_memfd(invoker_uid)
        helper_sha256 = hashlib.sha256(raw).hexdigest()
        enrolled_path = ENROLLED_HELPER_PREFIX + helper_sha256
        if not _command_available("/usr/bin/systemd-inhibit"):
            raise BootstrapError("host_incomplete", "The local suspend inhibitor is unavailable.")
        _emit_gui_event(
            "progress", "authentication", "Authentification système requise.",
            2, "waiting-for-polkit",
            **GUI_RESULT_IDENTITY,
        )
        installed = subprocess.run(
            [
                "/usr/bin/pkexec", "/usr/bin/install",
                "--owner=root", "--group=root", "--mode=0700", "/dev/stdin", enrolled_path,
            ],
            check=False,
            input=raw,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=180,
        )
        raw = b""
        if installed.returncode != 0:
            raise BootstrapError(
                "enrollment_failed",
                "Physical authentication or ephemeral enrollment failed.",
            )
        _emit_gui_event(
            "progress", "enrollment", "Helper éphémère authentifié.",
            4, "authenticated",
            **GUI_RESULT_IDENTITY,
        )
        os.execve(
            "/usr/bin/systemd-inhibit",
            [
                "/usr/bin/systemd-inhibit",
                "--what=idle:sleep:shutdown",
                "--who=Atlas control-plane bootstrap",
                "--why=One-shot transactional local deployment",
                "--mode=block",
                "/usr/bin/pkexec",
                enrolled_path,
                "--bootstrap-elevated-gui",
                operation,
                helper_sha256,
                atlas_binding,
                channel_digest,
            ],
            {"PATH": "/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        )
    if len(arguments) == 1 and arguments[0] in {"preflight", "apply"}:
        operation = arguments[0]
        if os.geteuid() == 0:
            raise BootstrapError("physical_auth_required", "Start the bootstrap as ops-user; direct root execution is refused.")
        source_root = Path(__file__).resolve().parents[3]
        if source_root != EXPECTED_SOURCE_ROOT:
            raise BootstrapError("source_invalid", "The bootstrap source path is not reviewed.")
        source_path = Path(__file__).resolve(strict=True)
        raw = _read_bounded_regular(source_path, 4 * 1024 * 1024)
        helper_sha256 = hashlib.sha256(raw).hexdigest()
        enrolled_path = ENROLLED_HELPER_PREFIX + helper_sha256
        if not _command_available("/usr/bin/systemd-inhibit"):
            raise BootstrapError("host_incomplete", "The local suspend inhibitor is unavailable.")
        print(f"Enrôlement éphémère local — helper SHA-256: {helper_sha256}", flush=True)
        installed = subprocess.run(
            [
                "/usr/bin/pkexec", "/usr/bin/install",
                "--owner=root", "--group=root", "--mode=0700", "/dev/stdin", enrolled_path,
            ],
            check=False,
            input=raw,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=180,
        )
        if installed.returncode != 0:
            raise BootstrapError("enrollment_failed", "Physical authentication or ephemeral enrollment failed.")
        os.execve(
            "/usr/bin/systemd-inhibit",
            [
                "/usr/bin/systemd-inhibit",
                "--what=idle:sleep:shutdown",
                "--who=Atlas control-plane bootstrap",
                "--why=One-shot transactional local deployment",
                "--mode=block",
                "/usr/bin/pkexec",
                enrolled_path,
                "--bootstrap-elevated",
                operation,
                helper_sha256,
            ],
            {"PATH": "/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        )
    if len(arguments) == 3 and arguments[0] == "--bootstrap-elevated" and os.geteuid() == 0:
        _harden_root_process()
        operation, helper_sha256 = arguments[1:]
        if operation not in {"preflight", "apply"}:
            raise BootstrapError("invocation_invalid", "The enrolled bootstrap operation is invalid.")
        # This single root-owned FD capture is the only input copied into the
        # sealed memfd; no second path open can race an enrolled replacement.
        enrolled_raw = _verify_enrolled_self(helper_sha256)
        try:
            raw_uid = os.environ.get("PKEXEC_UID", "")
            if not raw_uid.isdigit():
                raise BootstrapError("physical_auth_required", "pkexec did not identify the physical invoker.")
            invoker_uid = int(raw_uid)
            session = _validate_local_session(invoker_uid)
            _cleanup_stale_enrolled_helpers(helper_sha256)
            _seal_and_exec(
                operation, EXPECTED_SOURCE_ROOT, invoker_uid, session,
                helper_sha256, enrolled_raw,
            )
        finally:
            # A successful exec never returns. Every pre-seal failure removes
            # the one exact root-owned helper whose bytes were captured above.
            _remove_enrolled_helper_exact(helper_sha256, required=False)
    if (
        len(arguments) == 5
        and arguments[0] == "--bootstrap-elevated-gui"
        and os.geteuid() == 0
    ):
        GUI_PROTOCOL_ACTIVE = True
        _harden_root_process()
        operation, helper_sha256, atlas_binding, channel_digest = arguments[1:]
        _set_gui_operation_context(operation)
        if operation not in {
            "preflight", "apply", "corrective-preflight", "corrective-apply",
            "recovery-preflight", "recovery-apply",
        } or not SHA256_RE.fullmatch(helper_sha256):
            raise BootstrapError("invocation_invalid", "The enrolled GUI operation is invalid.")
        enrolled_raw = _verify_enrolled_self(helper_sha256)
        try:
            raw_uid = os.environ.get("PKEXEC_UID", "")
            if not raw_uid.isdigit():
                raise BootstrapError(
                    "physical_auth_required", "pkexec did not identify the physical invoker."
                )
            invoker_uid = int(raw_uid)
            session = _validate_local_gui_session(
                invoker_uid, atlas_binding, channel_digest
            )
            _emit_gui_event(
                "progress", "authorization", "Session locale et Atlas vérifiés.",
                6, "authorized",
                **GUI_RESULT_IDENTITY,
            )
            _cleanup_stale_enrolled_helpers(helper_sha256)
            _seal_and_exec(
                operation,
                EXPECTED_SOURCE_ROOT,
                invoker_uid,
                session,
                helper_sha256,
                enrolled_raw,
                gui_atlas_binding=atlas_binding,
                gui_channel_digest=channel_digest,
            )
        finally:
            _remove_enrolled_helper_exact(helper_sha256, required=False)
    if len(arguments) == 6 and arguments[0] == "--bootstrap-sealed" and os.geteuid() == 0:
        _harden_root_process()
        _verify_sealed_self()
        operation, raw_root, raw_uid, session, helper_sha256 = arguments[1:]
        if (
            operation not in {"preflight", "apply"} or Path(raw_root) != EXPECTED_SOURCE_ROOT
            or not raw_uid.isdigit() or not SHA256_RE.fullmatch(helper_sha256)
        ):
            raise BootstrapError("invocation_invalid", "The sealed bootstrap invocation is invalid.")
        _remove_enrolled_helper_exact(helper_sha256, required=True)
        invoker_uid = int(raw_uid)
        if _validate_local_session(invoker_uid) != session:
            raise BootstrapError("physical_session_required", "The physical session changed before confirmation.")
        manifest, digest, manifest_sha, worker_bytes = load_reviewed_release(helper_sha256)
        enrollment_resume = _review_enrollment_resume(
            manifest, digest, manifest_sha, helper_sha256
        )
        preflight = bootstrap_preflight(
            manifest, digest, manifest_sha, enrollment_resume=enrollment_resume
        )
        preflight["bootstrap_helper_sha256"] = helper_sha256
        _display_release(preflight)
        if operation == "preflight":
            print(json.dumps({"ok": True, "status": "preflight-passed", **preflight}, sort_keys=True))
            return 0
        openbao_password: bytearray | None = None
        zulip_password: bytearray | None = None
        lock = -1
        try:
            if preflight.get("rollback_finalize_resume") is True:
                openbao_password, zulip_password = bytearray(), bytearray()
            else:
                openbao_password, zulip_password = _confirmed_secrets()
            _explicit_confirmation(
                manifest["release_id"], helper_sha256, manifest_sha, digest,
                preflight["hermes_source_archive_sha256"],
            )
            lock = _acquire_lock()
            result = apply_bootstrap(
                worker_bytes, manifest, preflight, session, invoker_uid,
                openbao_password, zulip_password, lock,
            )
            print(json.dumps({"ok": True, **result}, sort_keys=True))
            return 0
        finally:
            _wipe(openbao_password)
            _wipe(zulip_password)
            if os.path.lexists(LIVE_TRANSACTION_PATH):
                _remove_live_transaction(only_current=True)
            if lock >= 0:
                os.close(lock)
    if (
        len(arguments) == 8
        and arguments[0] == "--bootstrap-sealed-gui"
        and os.geteuid() == 0
    ):
        GUI_PROTOCOL_ACTIVE = True
        _harden_root_process()
        _verify_sealed_self()
        (
            operation,
            raw_root,
            raw_uid,
            session,
            helper_sha256,
            atlas_binding,
            channel_digest,
        ) = arguments[1:]
        _set_gui_operation_context(operation)
        if (
            operation not in {
                "preflight", "apply", "corrective-preflight", "corrective-apply",
                "recovery-preflight", "recovery-apply",
            }
            or Path(raw_root) != EXPECTED_SOURCE_ROOT
            or not raw_uid.isdigit()
            or not SHA256_RE.fullmatch(helper_sha256)
            or not SHA256_RE.fullmatch(channel_digest)
        ):
            raise BootstrapError("invocation_invalid", "The sealed GUI invocation is invalid.")
        _remove_enrolled_helper_exact(helper_sha256, required=True)
        invoker_uid = int(raw_uid)
        if (
            _validate_local_gui_session(invoker_uid, atlas_binding, channel_digest)
            != session
        ):
            raise BootstrapError(
                "physical_session_required",
                "The physical GUI session changed before confirmation.",
            )
        _emit_gui_event(
            "progress", "preflight", "Vérification complète de la release locale.",
            7, "running",
            **GUI_RESULT_IDENTITY,
        )
        neutral_recovery = operation.startswith("recovery-")
        corrective_mode = operation.startswith("corrective-")
        requested_operation = operation
        if corrective_mode:
            requested_operation = operation.removeprefix("corrective-")
        elif neutral_recovery:
            requested_operation = operation.removeprefix("recovery-")
        manifest, digest, manifest_sha, worker_bytes = load_reviewed_release(helper_sha256)
        reviewed_atlas_sha256 = manifest["bootstrap"]["gui_protocol"][
            "atlas_payload_sha256"
        ]
        # The early ancestry checks bind a stable process to the local seat and
        # anonymous pipes.  Only the sealed root stage can bind those same
        # executable bytes to the digest reviewed in the release manifest.
        _validate_gui_atlas_binding(
            invoker_uid, atlas_binding, reviewed_atlas_sha256
        )
        if neutral_recovery:
            (
                classified_mode,
                corrective_context,
                enrollment_resume,
            ) = _classify_gui_recovery_mode(
                manifest, digest, manifest_sha, helper_sha256
            )
            corrective_mode = classified_mode == "corrective"
        else:
            corrective_context = (
                _review_corrective_retry(
                    manifest, digest, manifest_sha, helper_sha256
                )
                if corrective_mode
                else None
            )
            enrollment_resume = (
                corrective_context["enrollment_resume"]
                if corrective_context is not None
                else _review_enrollment_resume(
                    manifest, digest, manifest_sha, helper_sha256
                )
            )
        preflight = bootstrap_preflight(
            manifest,
            digest,
            manifest_sha,
            enrollment_resume=enrollment_resume,
            corrective_context=corrective_context,
        )
        preflight["bootstrap_helper_sha256"] = helper_sha256
        if neutral_recovery:
            # Keep the minimal recovery identity on every classification or
            # preflight error.  The sole mode transition occurs only once a
            # complete full identity is ready for the next release event.
            _freeze_gui_recovery_classification(classified_mode)
        _emit_gui_release(preflight)
        if requested_operation == "preflight":
            if _gui_cancel_is_pending():
                raise BootstrapError("cancelled", "Atlas cancelled the preflight.")
            _emit_gui_event(
                "result",
                (
                    "recovery-preflight-complete"
                    if neutral_recovery
                    else (
                        "corrective-preflight-complete"
                        if corrective_mode
                        else "preflight-complete"
                    )
                ),
                "Préflight terminé; aucune mutation effectuée.",
                100,
                (
                    "recovery-preflight-passed"
                    if neutral_recovery
                    else (
                        "corrective-preflight-passed"
                        if corrective_mode
                        else "preflight-passed"
                    )
                ),
                **GUI_RESULT_IDENTITY,
            )
            return 0
        if _gui_cancel_is_pending():
            raise BootstrapError("cancelled", "Atlas cancelled before credential readiness.")
        rollback_finalize_resume = preflight.get("rollback_finalize_resume") is True
        # These are the sole readiness attestations accepted by Tauri.  The
        # rollback-only branch deliberately never opens a credential frame.
        if rollback_finalize_resume:
            _emit_gui_rollback_finalize_readiness(preflight)
        else:
            _emit_gui_secret_readiness(preflight)
        openbao_password: bytearray | None = None
        zulip_password: bytearray | None = None
        lock = -1
        try:
            if rollback_finalize_resume:
                openbao_password, zulip_password = bytearray(), bytearray()
            else:
                openbao_password, zulip_password = _read_gui_apply_request(
                    manifest["release_id"],
                    helper_sha256,
                    manifest_sha,
                    digest,
                    preflight["hermes_source_archive_sha256"],
                    operation_mode=preflight["operation_mode"],
                    recovery_from_release_id=preflight.get("recovery_from_release_id"),
                )
            if _gui_cancel_is_pending():
                raise BootstrapError("cancelled", "Atlas cancelled before mutation.")
            if not rollback_finalize_resume:
                _emit_gui_event(
                    "progress", "confirmation", "Confirmation et mots de passe validés en mémoire.",
                    12, "confirmed",
                )
            lock = _acquire_lock()

            result = apply_bootstrap(
                worker_bytes,
                manifest,
                preflight,
                session,
                invoker_uid,
                openbao_password,
                zulip_password,
                lock,
                mutation_boundary=lambda: _enter_gui_mutation_boundary(
                    invoker_uid,
                    atlas_binding,
                    channel_digest,
                    session,
                    reviewed_atlas_sha256,
                ),
                progress_callback=lambda phase, percent, message: _emit_gui_event(
                    "progress", phase, message, percent, "running"
                ),
                corrective_context=corrective_context,
                recovery_classification_required=neutral_recovery,
            )
            if rollback_finalize_resume:
                _emit_gui_event(
                    "result",
                    "rollback-finalized",
                    "Rollback préproduction finalisé; aucune installation lancée.",
                    100,
                    "rolled-back",
                    **GUI_RESULT_IDENTITY,
                    atlas_available=False,
                )
            else:
                _emit_gui_event(
                    "result",
                    "complete",
                    "Installation terminée et contrôlée.",
                    100,
                    "succeeded",
                    **GUI_RESULT_IDENTITY,
                    zulip_url="https://zulip.ops.local:8443",
                    atlas_available=True,
                )
            return 0
        finally:
            _wipe(openbao_password)
            _wipe(zulip_password)
            if os.path.lexists(LIVE_TRANSACTION_PATH):
                _remove_live_transaction(only_current=True)
            if lock >= 0:
                os.close(lock)
    if arguments == ["--restore-openbao"]:
        _harden_root_process()
        return recovery_entry(openbao_only=True)
    if arguments == ["--recover"]:
        _harden_root_process()
        return recovery_entry(openbao_only=False)
    if arguments == ["--recover-activate"]:
        _harden_root_process()
        return recovery_activation_entry()
    if arguments == ["--recover-supervise"]:
        _harden_root_process()
        if Path(__file__) != INSTALLED_HELPER:
            raise BootstrapError(
                "invocation_invalid",
                "Recovery supervision must use its reviewed helper path.",
            )
        return standard_recovery_supervisor_entry()
    if arguments == ["--corrective-recover"]:
        _harden_root_process()
        if Path(__file__) != CORRECTIVE_RECOVERY_HELPER:
            raise BootstrapError(
                "invocation_invalid", "Corrective recovery must use its reviewed helper path."
            )
        return corrective_recovery_entry()
    raise BootstrapError(
        "usage",
        "Usage: control-plane-bootstrap preflight|apply|gui-preflight|gui-apply|"
        "gui-corrective-preflight|gui-corrective-apply|"
        "gui-recovery-preflight|gui-recovery-apply",
    )


def main() -> int:
    global GUI_PROTOCOL_ACTIVE, GUI_RESULT_IDENTITY
    GUI_RESULT_IDENTITY = {}
    GUI_PROTOCOL_ACTIVE = any(
        value in {
            "gui-preflight", "gui-apply", "gui-corrective-preflight",
            "gui-corrective-apply", "gui-recovery-preflight",
            "gui-recovery-apply", "--bootstrap-elevated-gui",
            "--bootstrap-sealed-gui",
        }
        for value in sys.argv[1:2]
    )
    if sys.argv[1:2]:
        if sys.argv[1] in {
            "gui-preflight", "gui-apply", "gui-corrective-preflight",
            "gui-corrective-apply", "gui-recovery-preflight",
            "gui-recovery-apply",
        }:
            _set_gui_operation_context(sys.argv[1])
        elif (
            sys.argv[1] in {"--bootstrap-elevated-gui", "--bootstrap-sealed-gui"}
            and len(sys.argv) > 2
        ):
            _set_gui_operation_context(sys.argv[2])
    try:
        return public_entry(sys.argv[1:])
    except BootstrapError as exc:
        if GUI_PROTOCOL_ACTIVE:
            try:
                status = "cancelled" if exc.code == "cancelled" else "failed"
                error_code = _bounded_failure_identifier(exc.code, "internal_error")
                failure_phase = _bounded_failure_identifier(exc.phase, status)
                _emit_gui_event(
                    "result",
                    failure_phase,
                    "Opération annulée." if status == "cancelled" else "Échec sécurisé.",
                    100,
                    status,
                    error_code=error_code,
                    **GUI_RESULT_IDENTITY,
                )
            except BaseException:
                pass
            return 130 if exc.code == "cancelled" else (64 if exc.code == "usage" else 1)
        print(json.dumps({"ok": False, "status": "failed", "error": exc.code}, sort_keys=True), file=sys.stderr)
        return 1 if exc.code != "usage" else 64
    except (KeyboardInterrupt, EOFError):
        if GUI_PROTOCOL_ACTIVE:
            try:
                _emit_gui_event(
                    "result", "cancelled", "Opération annulée.", 100, "cancelled",
                    error_code="cancelled", **GUI_RESULT_IDENTITY,
                )
            except BaseException:
                pass
            return 130
        print('{"error":"cancelled","ok":false,"status":"failed"}', file=sys.stderr)
        return 130
    except BaseException:
        if GUI_PROTOCOL_ACTIVE:
            try:
                _emit_gui_event(
                    "result", "failed", "Échec interne sécurisé.", 100, "failed",
                    error_code="internal_error", **GUI_RESULT_IDENTITY,
                )
            except BaseException:
                pass
            return 1
        print('{"error":"internal_error","ok":false,"status":"failed"}', file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
