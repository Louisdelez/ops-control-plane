def _source_excluded(relative: PurePosixPath) -> bool:
    return (
        any(part in EXCLUDED_DIRECTORY_NAMES for part in relative.parts)
        or relative.name.endswith(EXCLUDED_FILE_SUFFIXES)
    )


def _hash_regular_source(
    path: Path,
    *,
    capture: bool = False,
    require_root_owned: bool = False,
) -> tuple[int, int, str, bytes | None]:
    """Hash one source file without following links and detect an in-place race."""

    try:
        before = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError("source_invalid", "A release source file became unavailable.") from exc
    digest = hashlib.sha256()
    chunks: list[bytes] = []
    total = 0
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or opened.st_size > MAX_SOURCE_FILE_BYTES
            or (require_root_owned and opened.st_uid != 0)
            or (require_root_owned and stat.S_IMODE(opened.st_mode) & 0o022)
        ):
            raise BootstrapError("source_invalid", "A release source file is unsafe.")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_SOURCE_FILE_BYTES:
                raise BootstrapError("source_invalid", "A release source file exceeds its bound.")
            digest.update(chunk)
            if capture:
                chunks.append(chunk)
        after = os.fstat(descriptor)
        if (
            after.st_dev != opened.st_dev
            or after.st_ino != opened.st_ino
            or after.st_size != opened.st_size
            or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns
            or total != opened.st_size
        ):
            raise BootstrapError("source_changed", "The release source changed while it was verified.")
        mode = 0o755 if opened.st_mode & 0o111 else 0o644
        return mode, total, digest.hexdigest(), b"".join(chunks) if capture else None
    finally:
        os.close(descriptor)


def _independent_source_digest(
    source_root: Path = EXPECTED_SOURCE_ROOT,
    *,
    require_root_owned: bool = False,
) -> tuple[str, bytes]:
    """Reimplement sha256-tree-v1 without importing any mutable source code."""

    seen: set[PurePosixPath] = set()
    entries: list[tuple[PurePosixPath, int, int, str]] = []
    worker_bytes: bytes | None = None
    total = 0
    for raw_root in sorted(SOURCE_ROOTS):
        relative_root = PurePosixPath(raw_root)
        if relative_root.is_absolute() or any(part in {"", ".", ".."} for part in relative_root.parts):
            raise BootstrapError("manifest_invalid", "A reviewed source root is invalid.")
        absolute_root = source_root.joinpath(*relative_root.parts)
        try:
            root_metadata = os.lstat(absolute_root)
        except OSError as exc:
            raise BootstrapError("source_invalid", "A reviewed source root is missing.") from exc
        if (
            stat.S_ISLNK(root_metadata.st_mode)
            or (require_root_owned and root_metadata.st_uid != 0)
            or (require_root_owned and stat.S_IMODE(root_metadata.st_mode) & 0o022)
        ):
            raise BootstrapError("source_invalid", "A reviewed source root is symlinked.")
        candidates: list[tuple[Path, PurePosixPath]] = []
        if stat.S_ISREG(root_metadata.st_mode):
            candidates.append((absolute_root, relative_root))
        elif stat.S_ISDIR(root_metadata.st_mode):
            for directory, directory_names, file_names in os.walk(
                absolute_root, topdown=True, followlinks=False
            ):
                directory_path = Path(directory)
                relative_directory = PurePosixPath(directory_path.relative_to(source_root).as_posix())
                directory_metadata = os.lstat(directory_path)
                if (
                    directory_metadata.st_uid != 0
                    or stat.S_IMODE(directory_metadata.st_mode) & 0o022
                ) and require_root_owned:
                    raise BootstrapError("source_invalid", "A staged release directory is unsafe.")
                kept: list[str] = []
                for name in sorted(directory_names):
                    child_relative = relative_directory / name
                    child = directory_path / name
                    child_metadata = os.lstat(child)
                    if stat.S_ISLNK(child_metadata.st_mode) or not stat.S_ISDIR(child_metadata.st_mode):
                        raise BootstrapError("source_invalid", "The release source contains an unsafe directory entry.")
                    if not _source_excluded(child_relative):
                        kept.append(name)
                directory_names[:] = kept
                for name in sorted(file_names):
                    child_relative = relative_directory / name
                    if _source_excluded(child_relative):
                        continue
                    child = directory_path / name
                    child_metadata = os.lstat(child)
                    if stat.S_ISLNK(child_metadata.st_mode) or not stat.S_ISREG(child_metadata.st_mode):
                        raise BootstrapError("source_invalid", "The release source contains an unsafe file.")
                    candidates.append((child, child_relative))
        else:
            raise BootstrapError("source_invalid", "A reviewed source root has an unsupported type.")
        for source, relative in candidates:
            if relative in seen or _source_excluded(relative):
                continue
            if any(ord(character) < 32 or ord(character) == 127 for character in relative.as_posix()):
                raise BootstrapError("source_invalid", "A release source path contains control characters.")
            seen.add(relative)
            is_worker = relative.as_posix() == "deploy/control-plane/bin/control-plane-deployment-worker"
            mode, size, file_sha, captured = _hash_regular_source(
                source,
                capture=is_worker,
                require_root_owned=require_root_owned,
            )
            total += size
            if total > MAX_SOURCE_TREE_BYTES:
                raise BootstrapError("source_invalid", "The release source tree exceeds its bound.")
            entries.append((relative, mode, size, file_sha))
            if is_worker:
                worker_bytes = captured
    if not entries or not worker_bytes:
        raise BootstrapError("source_invalid", "The reviewed deployment worker is absent.")
    digest = hashlib.sha256()
    for relative, mode, size, file_sha in sorted(entries, key=lambda item: item[0].as_posix()):
        digest.update(f"{relative.as_posix()}\0{mode:o}\0{size}\0{file_sha}\n".encode("utf-8"))
    return digest.hexdigest(), worker_bytes


def _independent_regular_sha256(path: Path, maximum: int = MAX_SOURCE_FILE_BYTES) -> str:
    try:
        before = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError("artifact_invalid", "A reviewed artifact is unavailable.") from exc
    digest = hashlib.sha256()
    total = 0
    try:
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or opened.st_size > maximum:
            raise BootstrapError("artifact_invalid", "A reviewed artifact is unsafe.")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > maximum:
                raise BootstrapError("artifact_invalid", "A reviewed artifact exceeds its bound.")
            digest.update(chunk)
        after = os.fstat(descriptor)
        if (
            opened.st_dev != before.st_dev or opened.st_ino != before.st_ino
            or after.st_dev != opened.st_dev or after.st_ino != opened.st_ino
            or after.st_size != opened.st_size or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns or total != opened.st_size
        ):
            raise BootstrapError("artifact_changed", "A reviewed artifact changed while it was verified.")
        return digest.hexdigest()
    finally:
        os.close(descriptor)


def _load_verified_worker(raw: bytes) -> dict[str, Any]:
    namespace: dict[str, Any] = {
        "__name__": "_ops_control_plane_deployment_worker_verified_",
        "__file__": str(SOURCE_WORKER),
    }
    try:
        exec(compile(raw, str(SOURCE_WORKER), "exec", dont_inherit=True), namespace)
    except BaseException as exc:
        raise BootstrapError("source_invalid", "The verified deployment worker could not be loaded.") from exc
    return namespace


def _validate_atlas_memfd(
    atlas: dict[str, Any], gui_protocol: dict[str, Any]
) -> None:
    raw = _read_bounded_regular(Path(atlas["source_path"]), MAX_SOURCE_FILE_BYTES)
    if not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), atlas["sha256"]):
        raise BootstrapError("checksum_mismatch", "The Atlas RPM changed during preflight.")
    descriptor = os.memfd_create("atlas-reviewed-rpm", os.MFD_ALLOW_SEALING)
    try:
        os.fchmod(descriptor, 0o400)
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError("artifact_invalid", "The Atlas memfd copy was incomplete.")
            view = view[written:]
        raw = b""
        os.lseek(descriptor, 0, os.SEEK_SET)
        fcntl.fcntl(
            descriptor,
            fcntl.F_ADD_SEALS,
            fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL,
        )
        os.set_inheritable(descriptor, True)
        completed = subprocess.run(
            [
                "/usr/bin/rpm", "-qp", "--qf", "%{NAME} %{VERSION} %{RELEASE} %{ARCH}",
                f"/proc/self/fd/{descriptor}",
            ],
            check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, close_fds=True, pass_fds=(descriptor,), timeout=15,
        )
        expected = f"{atlas['name']} {atlas['version']} {atlas['release']} {atlas['architecture']}".encode()
        if completed.returncode != 0 or completed.stdout.strip() != expected:
            raise BootstrapError("artifact_invalid", "The Atlas RPM identity differs from review.")
        payload_query = subprocess.run(
            [
                "/usr/bin/rpm", "-qp", "--qf",
                "[%{FILENAMES}\\t%{FILEDIGESTS}\\t%{FILEMODES:octal}\\t"
                "%{FILEUSERNAME}\\t%{FILEGROUPNAME}\\n]",
                f"/proc/self/fd/{descriptor}",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            pass_fds=(descriptor,),
            timeout=15,
        )
        if payload_query.returncode != 0 or len(payload_query.stdout) > 64 * 1024:
            raise BootstrapError(
                "artifact_invalid", "The Atlas RPM payload inventory is unavailable."
            )
        expected_member = gui_protocol.get("atlas_payload_member")
        expected_payload_sha256 = gui_protocol.get("atlas_payload_sha256")
        matches = []
        for line in payload_query.stdout.splitlines():
            fields = line.split(b"\t")
            if len(fields) == 5 and fields[0] == str(expected_member).encode("utf-8"):
                matches.append(fields)
        expected_payload = [
            str(expected_member).encode("utf-8"),
            str(expected_payload_sha256).encode("ascii"),
            b"100755",
            b"root",
            b"root",
        ]
        if (
            expected_member != atlas.get("payload_executable_path")
            or expected_payload_sha256 != atlas.get("payload_executable_sha256")
            or matches != [expected_payload]
        ):
            raise BootstrapError(
                "artifact_invalid", "The Atlas RPM executable payload differs from review."
            )
    finally:
        raw = b""
        os.close(descriptor)


def load_reviewed_release(
    expected_helper_sha256: str,
) -> tuple[dict[str, Any], str, str, bytes]:
    source_helper = TRUST_ANCHOR_BOOTSTRAP_HELPER
    if (
        not SHA256_RE.fullmatch(expected_helper_sha256)
        or not hmac.compare_digest(
            _independent_regular_sha256(source_helper, maximum=4 * 1024 * 1024),
            expected_helper_sha256,
        )
    ):
        raise BootstrapError("checksum_mismatch", "The enrolled helper differs from the source tree.")
    manifest, manifest_sha = _reviewed_manifest()
    if not hmac.compare_digest(
        manifest["bootstrap"]["helper_sha256"], expected_helper_sha256
    ):
        raise BootstrapError(
            "checksum_mismatch", "The manifest bootstrap helper digest differs."
        )
    digest, worker_bytes = _independent_source_digest()
    if not hmac.compare_digest(digest, manifest["source"]["tree_sha256"]):
        raise BootstrapError("checksum_mismatch", "The source tree differs from the root-owned release manifest.")
    atlas = manifest["artifacts"]["atlas_rpm"]
    if not hmac.compare_digest(_independent_regular_sha256(Path(atlas["source_path"])), atlas["sha256"]):
        raise BootstrapError("checksum_mismatch", "The Atlas RPM differs from the root-owned release manifest.")
    hermes_archive = manifest["artifacts"]["hermes_source_archive"]
    if not hmac.compare_digest(
        _independent_regular_sha256(Path(hermes_archive["source_path"])),
        hermes_archive["sha256"],
    ):
        raise BootstrapError(
            "checksum_mismatch",
            "The Hermes source archive differs from the root-owned release manifest.",
        )
    # The worker is returned strictly as captured data.  No mutable source is
    # compiled before the physical human has seen and confirmed all digests and
    # the durable one-shot enrollment WAL has been committed.
    return manifest, digest, manifest_sha, worker_bytes


def _transaction_matches_safe_enrollment_frontier(
    transaction: dict[str, Any],
    *,
    release_id: str,
    source_tree_sha256: str,
    atlas_rpm_sha256: str,
    hermes_source_archive_sha256: str,
) -> bool:
    """The shared field/filesystem predicate for GUI-only preproduction resume."""

    safe_phases = {
        "consumed", "enrollment-resuming", "release-staged",
        "recovery-guard-installing", "recovery-armed", "rollback-failed",
        PREPRODUCTION_ROLLBACK_AUDIT_PHASE,
    }
    return not (
        transaction.get("status") not in {"running", "rollback-failed"}
        or transaction.get("phase") not in safe_phases
        or transaction.get("release_id") != release_id
        or transaction.get("source_tree_sha256") != source_tree_sha256
        or transaction.get("atlas_rpm_sha256") != atlas_rpm_sha256
        or transaction.get("hermes_source_archive_sha256")
        != hermes_source_archive_sha256
        or transaction.get("deployment_backup") is not None
        or transaction.get("openbao_backup") is not None
        or transaction.get("openbao_backup_sha256") is not None
        or transaction.get("openbao_restore_required") is not False
        or transaction.get("root_token_escrowed") is not False
        or transaction.get("root_generation_pending") is not False
        or transaction.get("root_generation_started_at") is not None
        or transaction.get("root_generation_remints") != 0
        or transaction.get("root_remint_required") is not False
        or transaction.get("root_final_share_windows") != []
        or transaction.get("root_attempt_closed") is not False
        or transaction.get("root_reconciliation_complete") is not False
        or transaction.get("openbao_runtime_dir_created") is not False
        or transaction.get("approver_state_created") is not False
        or transaction.get("openbao_undo_escrowed") is not False
        or transaction.get("openbao_undo_write_started") is not False
        or transaction.get("openbao_undo_complete") is not False
        or transaction.get("openbao_poststate_recorded") is not False
        or transaction.get("openbao_undo_started") is not False
        or transaction.get("openbao_provisioning_started") is not False
        or transaction.get("password_recovery_started") is not False
        or transaction.get("password_recovery_persists") is not False
        or transaction.get("userpass_password_escrowed") is not False
        or transaction.get("userpass_finalized") is not False
        or any(
            os.path.lexists(path)
            for path in (
                ROOT_TOKEN_ESCROW,
                OPENBAO_UNDO_ESCROW,
                USERPASS_PASSWORD_ESCROW,
                _escrow_staging_path(ROOT_TOKEN_ESCROW),
                _escrow_staging_path(OPENBAO_UNDO_ESCROW),
                _escrow_staging_path(USERPASS_PASSWORD_ESCROW),
            )
        )
        or transaction.get("recovery_activation_units") != []
        or transaction.get("proof") is not None
        or transaction.get("completed_at") is not None
        or transaction.get("rolled_back_at") is not None
        or transaction.get("credentials_before")
        != {name: False for name in CREDENTIAL_GROUPS}
    )


def _preproduction_terminal_rollback_candidate(
    transaction: dict[str, Any],
    *,
    release_id: str,
    source_tree_sha256: str,
    atlas_rpm_sha256: str,
    hermes_source_archive_sha256: str,
) -> dict[str, Any] | None:
    """Map only a terminal no-production frontier back to its audit intent."""

    rolled_back_at = transaction.get("rolled_back_at")
    updated_at = transaction.get("updated_at")
    if (
        transaction.get("status") != "rolled-back"
        or transaction.get("phase") != "rolled-back"
        or isinstance(rolled_back_at, bool)
        or not isinstance(rolled_back_at, int)
        or rolled_back_at <= 0
        or isinstance(updated_at, bool)
        or not isinstance(updated_at, int)
        or updated_at < rolled_back_at
    ):
        return None
    candidate = dict(transaction)
    candidate.update(
        status="rollback-failed",
        phase=PREPRODUCTION_ROLLBACK_AUDIT_PHASE,
        rolled_back_at=None,
    )
    if not _transaction_matches_safe_enrollment_frontier(
        candidate,
        release_id=release_id,
        source_tree_sha256=source_tree_sha256,
        atlas_rpm_sha256=atlas_rpm_sha256,
        hermes_source_archive_sha256=hermes_source_archive_sha256,
    ):
        return None
    return candidate


def _review_enrollment_resume(
    manifest: dict[str, Any],
    source_digest: str,
    manifest_digest: str,
    helper_sha256: str,
    *,
    allow_corrective_successor: bool = False,
) -> dict[str, Any] | None:
    """Recognize only a pre-production enrollment interrupted after consent."""

    if os.path.lexists(CORRECTIVE_CONSUMED_PATH) and not allow_corrective_successor:
        raise BootstrapError(
            "corrective_mode_required",
            "A corrective successor can only resume through the corrective operation.",
        )

    marker_present = os.path.lexists(CONSUMED_PATH)
    state_present = os.path.lexists(STATE_ROOT)
    transaction_present = os.path.lexists(TRANSACTION_PATH)
    if not marker_present and not state_present and not transaction_present:
        return None
    if not marker_present or (transaction_present and not state_present):
        raise BootstrapError("bootstrap_state_conflict", "Bootstrap enrollment state is incomplete.")
    if state_present:
        state_info = os.lstat(STATE_ROOT)
        if (
            not stat.S_ISDIR(state_info.st_mode) or stat.S_ISLNK(state_info.st_mode)
            or state_info.st_uid != 0 or stat.S_IMODE(state_info.st_mode) != 0o700
        ):
            raise BootstrapError("bootstrap_state_conflict", "Bootstrap enrollment state is unsafe.")
    consumed = _read_json(CONSUMED_PATH, 128 * 1024)
    expected_fields = {
        "schema_version", "consumed", "consumed_at", "actor", "physical_uid",
        "physical_session", "release_id", "source_tree_sha256", "atlas_rpm_sha256",
        "hermes_source_archive_sha256",
        "bootstrap_helper_sha256", "manifest_sha256", "initial_transaction",
    }
    try:
        louis_uid = pwd.getpwnam("ops-user").pw_uid
    except KeyError as exc:
        raise BootstrapError("bootstrap_state_conflict", "The physical owner account is absent.") from exc
    if (
        set(consumed) != expected_fields
        or consumed.get("schema_version") != 1
        or consumed.get("consumed") is not True
        or consumed.get("actor") != "codex-supervised"
        or consumed.get("physical_uid") != louis_uid
        or not isinstance(consumed.get("physical_session"), str)
        or not isinstance(consumed.get("consumed_at"), int)
        or consumed.get("release_id") != manifest["release_id"]
        or consumed.get("source_tree_sha256") != source_digest
        or consumed.get("atlas_rpm_sha256") != manifest["artifacts"]["atlas_rpm"]["sha256"]
        or consumed.get("hermes_source_archive_sha256")
        != manifest["artifacts"]["hermes_source_archive"]["sha256"]
        or consumed.get("bootstrap_helper_sha256") != helper_sha256
        or consumed.get("manifest_sha256") != manifest_digest
    ):
        raise BootstrapError("bootstrap_consumed", "The consumed bootstrap identity differs.")
    initial_transaction = consumed.get("initial_transaction")
    if not isinstance(initial_transaction, dict):
        raise BootstrapError("bootstrap_state_conflict", "The enrollment WAL is absent.")
    _validate_transaction_document(initial_transaction)
    if (
        initial_transaction.get("phase") != "consumed"
        or initial_transaction.get("status") != "running"
        or initial_transaction.get("release_id") != manifest["release_id"]
        or initial_transaction.get("source_tree_sha256") != source_digest
        or initial_transaction.get("atlas_rpm_sha256")
        != manifest["artifacts"]["atlas_rpm"]["sha256"]
        or initial_transaction.get("hermes_source_archive_sha256")
        != manifest["artifacts"]["hermes_source_archive"]["sha256"]
    ):
        raise BootstrapError("bootstrap_state_conflict", "The enrollment WAL identity differs.")
    transaction = (
        _read_standard_transaction_frontier(promote_staging=False)
        if state_present
        else None
    ) or dict(initial_transaction)
    _validate_transaction_document(transaction)
    safe_enrollment = _transaction_matches_safe_enrollment_frontier(
        transaction,
        release_id=manifest["release_id"],
        source_tree_sha256=source_digest,
        atlas_rpm_sha256=manifest["artifacts"]["atlas_rpm"]["sha256"],
        hermes_source_archive_sha256=manifest["artifacts"]["hermes_source_archive"]["sha256"],
    )
    terminal_rollback = _preproduction_terminal_rollback_candidate(
        transaction,
        release_id=manifest["release_id"],
        source_tree_sha256=source_digest,
        atlas_rpm_sha256=manifest["artifacts"]["atlas_rpm"]["sha256"],
        hermes_source_archive_sha256=manifest["artifacts"]["hermes_source_archive"]["sha256"],
    )
    if not safe_enrollment and terminal_rollback is None:
        raise BootstrapError(
            "bootstrap_consumed",
            "The one-shot bootstrap is past its safe enrollment-resume boundary.",
        )
    staged = transaction.get("staged_release")
    if staged is not None:
        release = _direct_root_child(staged, DEPLOYMENT_RELEASES_ROOT, location="staged release")
        if release.name != manifest["release_id"]:
            raise BootstrapError("recovery_unsafe", "The staged enrollment release differs.")
        marker = _read_json(release / ".deployment-release.json", 16 * 1024)
        if marker != {
            "schema_version": 1,
            "release_id": manifest["release_id"],
            "source_tree_sha256": source_digest,
            "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
            "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
        }:
            raise BootstrapError("recovery_unsafe", "The staged enrollment marker differs.")
        staged_digest, _ = _independent_source_digest(
            release / "tree", require_root_owned=True
        )
        if not hmac.compare_digest(staged_digest, source_digest):
            raise BootstrapError("recovery_unsafe", "The staged enrollment tree differs.")
        staged_atlas = release / "artifacts" / Path(
            manifest["artifacts"]["atlas_rpm"]["source_path"]
        ).name
        staged_hermes = release / "artifacts" / HERMES_SOURCE_ARCHIVE_NAME
        if not hmac.compare_digest(
            _independent_regular_sha256(staged_atlas),
            manifest["artifacts"]["atlas_rpm"]["sha256"],
        ):
            raise BootstrapError("recovery_unsafe", "The staged enrollment RPM differs.")
        if not hmac.compare_digest(
            _independent_regular_sha256(staged_hermes),
            manifest["artifacts"]["hermes_source_archive"]["sha256"],
        ):
            raise BootstrapError(
                "recovery_unsafe", "The staged Hermes archive differs."
            )
    return transaction


def _systemctl_state(unit: str, operation: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", operation, "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    return completed.returncode == 0


def _strict_systemctl_state(unit: str, operation: str) -> bool:
    if operation not in {"is-active", "is-enabled"}:
        raise BootstrapError(
            "corrective_predecessor_invalid", "An unsupported systemd query was requested."
        )
    completed = subprocess.run(
        ["/usr/bin/systemctl", operation, unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    output = completed.stdout.strip()
    if operation == "is-active":
        if completed.returncode == 0 and output == b"active":
            return True
        if completed.returncode == 3 and output == b"inactive":
            return False
    else:
        enabled_states = {
            b"enabled", b"enabled-runtime", b"linked", b"linked-runtime",
            b"alias", b"static", b"indirect", b"generated", b"transient",
        }
        if completed.returncode == 0 and output in enabled_states:
            return True
        if completed.returncode == 1 and output == b"disabled":
            return False
    raise BootstrapError(
        "corrective_predecessor_invalid", "A strict systemd state query failed."
    )


def _strict_systemctl_properties(unit: str) -> dict[str, str]:
    completed = subprocess.run(
        [
            "/usr/bin/systemctl", "show", unit,
            "--property=LoadState", "--property=ActiveState",
            "--property=UnitFileState", "--property=FragmentPath",
            "--property=DropInPaths",
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    try:
        lines = completed.stdout.decode("utf-8", errors="strict").splitlines()
        properties = dict(line.split("=", 1) for line in lines if "=" in line)
    except (UnicodeError, ValueError) as exc:
        raise BootstrapError(
            "corrective_scaffold_conflict", "The loaded systemd identity is invalid."
        ) from exc
    expected = {
        "LoadState", "ActiveState", "UnitFileState", "FragmentPath", "DropInPaths"
    }
    if completed.returncode != 0 or set(properties) != expected:
        raise BootstrapError(
            "corrective_scaffold_conflict", "The loaded systemd identity is unavailable."
        )
    return properties


def _strict_corrective_service_state(unit: str) -> dict[str, bool]:
    """Return the exact .10 service bit pair without hiding not-found/error."""

    properties = _strict_systemctl_properties(unit)
    if unit in CORRECTIVE_PREDECESSOR_ABSENT_DEPENDENT_UNITS:
        if properties != {
            "LoadState": "not-found",
            "ActiveState": "inactive",
            "UnitFileState": "",
            "FragmentPath": "",
            "DropInPaths": "",
        }:
            raise BootstrapError(
                "corrective_predecessor_invalid",
                "An expected-absent predecessor unit has a different PID 1 identity.",
            )
        return {"active": False, "enabled": False}
    enabled_states = {
        "enabled", "enabled-runtime", "linked", "linked-runtime", "alias",
        "static", "indirect", "generated", "transient",
    }
    fragment = properties["FragmentPath"]
    if (
        properties["LoadState"] != "loaded"
        or properties["ActiveState"] not in {"active", "inactive"}
        or properties["UnitFileState"] not in enabled_states | {"disabled"}
        or not fragment.startswith(("/etc/systemd/system/", "/usr/lib/systemd/system/"))
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "A loaded predecessor unit has a different PID 1 identity.",
        )
    return {
        "active": properties["ActiveState"] == "active",
        "enabled": properties["UnitFileState"] in enabled_states,
    }


def _calling_session_id(invoker_uid: int) -> str:
    try:
        loginuid = Path("/proc/self/loginuid").read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as exc:
        raise BootstrapError("physical_session_required", "The caller login identity is unavailable.") from exc
    if loginuid != str(invoker_uid):
        raise BootstrapError("physical_session_required", "The caller login identity differs from pkexec.")
    result = subprocess.run(
        ["/usr/bin/loginctl", "show-user", "ops-user", "--property=Display", "--value"],
        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, timeout=10,
    )
    if result.returncode != 0 or len(result.stdout) > 128:
        raise BootstrapError("physical_session_required", "The local display session is unavailable.")
    session = result.stdout.decode("ascii", errors="strict").strip()
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", session):
        raise BootstrapError("physical_session_required", "The local display session is invalid.")
    return session


def _validate_active_local_session(invoker_uid: int) -> str:
    try:
        account = pwd.getpwuid(invoker_uid)
    except KeyError as exc:
        raise BootstrapError("physical_session_required", "The invoking local account is unknown.") from exc
    if account.pw_name != "ops-user" or invoker_uid == 0:
        raise BootstrapError("physical_session_required", "Only the physical account ops-user may bootstrap.")
    session = _calling_session_id(invoker_uid)
    properties: dict[str, str] = {}
    for name in ("User", "Name", "Active", "Remote", "Class", "Type", "Seat"):
        result = subprocess.run(
            ["/usr/bin/loginctl", "show-session", session, f"--property={name}", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        if result.returncode != 0 or len(result.stdout) > 128:
            raise BootstrapError("physical_session_required", "The caller session state is unavailable.")
        properties[name] = result.stdout.decode("ascii", errors="strict").strip()
    if (
        properties.get("User") == str(invoker_uid)
        and properties.get("Name") == "ops-user"
        and properties.get("Active") == "yes"
        and properties.get("Remote") == "no"
        and properties.get("Class") == "user"
        and properties.get("Type") in {"tty", "x11", "wayland"}
        and properties.get("Seat") == "seat0"
    ):
        return session
    raise BootstrapError("physical_session_required", "No active non-remote seat0 session belongs to ops-user.")


def _validate_local_session(invoker_uid: int) -> str:
    session = _validate_active_local_session(invoker_uid)
    _validate_local_terminal_owner(invoker_uid)
    return session


def _validate_local_gui_session(
    invoker_uid: int,
    atlas_binding: str,
    channel_digest: str,
    *,
    expected_atlas_sha256: str | None = None,
) -> str:
    if not SHA256_RE.fullmatch(channel_digest):
        raise BootstrapError("gui_channel_invalid", "The Atlas pipe binding is invalid.")
    observed_channel = _gui_channel_digest(invoker_uid)
    if not hmac.compare_digest(observed_channel, channel_digest):
        raise BootstrapError("gui_channel_invalid", "The Atlas pipes changed during authorization.")
    session = _validate_active_local_session(invoker_uid)
    _validate_gui_atlas_binding(
        invoker_uid, atlas_binding, expected_atlas_sha256
    )
    return session


def _resolved_pts_index(terminal_fd: int) -> str:
    """Resolve an inherited tty FD through procfs without trusting ttyname aliases."""

    try:
        terminal_metadata = os.fstat(terminal_fd)
        terminal = Path(f"/proc/self/fd/{terminal_fd}").resolve(strict=True)
        terminal_path_metadata = os.lstat(terminal)
    except (OSError, RuntimeError) as exc:
        raise BootstrapError("physical_session_required", "A local foreground terminal is required.") from exc
    match = re.fullmatch(r"/dev/pts/([1-9][0-9]{0,5}|0)", str(terminal))
    if (
        match is None
        or not stat.S_ISCHR(terminal_metadata.st_mode)
        or not stat.S_ISCHR(terminal_path_metadata.st_mode)
        or terminal_metadata.st_dev != terminal_path_metadata.st_dev
        or terminal_metadata.st_ino != terminal_path_metadata.st_ino
        or terminal_metadata.st_rdev != terminal_path_metadata.st_rdev
    ):
        raise BootstrapError("physical_session_required", "The caller terminal is not an exact local pts.")
    return match.group(1)


def _validate_local_terminal_owner(invoker_uid: int) -> None:
    """Bind the foreground pts to GNOME Ptyxis, not an SSH-owned pty."""

    terminal_fd = -1
    try:
        terminal_fd = os.open("/dev/tty", os.O_RDWR | os.O_CLOEXEC | os.O_NOCTTY)
        tty_index = _resolved_pts_index(0)
        if (
            not os.isatty(0)
            or os.tcgetpgrp(0) != os.getpgrp()
            or os.tcgetpgrp(terminal_fd) != os.getpgrp()
        ):
            raise BootstrapError("physical_session_required", "The caller does not own a foreground local pts.")
        trusted_holder = False
        for process_path in Path("/proc").iterdir():
            if not process_path.name.isdigit():
                continue
            try:
                process_metadata = os.stat(process_path)
                if process_metadata.st_uid != invoker_uid:
                    continue
                for fdinfo in (process_path / "fdinfo").iterdir():
                    raw = fdinfo.read_text(encoding="ascii", errors="strict")
                    if f"tty-index:\t{tty_index}\n" not in raw:
                        continue
                    executable = (process_path / "exe").resolve(strict=True)
                    if (
                        executable == Path("/usr/bin/ptyxis")
                        and _command_available(str(executable))
                    ):
                        trusted_holder = True
                        break
                if trusted_holder:
                    break
            except (FileNotFoundError, NotADirectoryError, PermissionError, ProcessLookupError, UnicodeError):
                continue
        if not trusted_holder:
            raise BootstrapError(
                "physical_session_required",
                "The foreground terminal is not owned by the local GNOME Ptyxis session.",
            )
    except OSError as exc:
        raise BootstrapError("physical_session_required", "A local foreground terminal is required.") from exc
    finally:
        if terminal_fd >= 0:
            os.close(terminal_fd)


def _command_available(path: str) -> bool:
    try:
        link = os.lstat(path)
        target = Path(path).resolve(strict=True)
        info = os.stat(target)
    except OSError:
        return False
    return (
        (stat.S_ISREG(link.st_mode) or stat.S_ISLNK(link.st_mode))
        and link.st_uid == 0
        and (stat.S_ISLNK(link.st_mode) or not stat.S_IMODE(link.st_mode) & 0o022)
        and stat.S_ISREG(info.st_mode)
        and info.st_uid == 0
        and not stat.S_IMODE(info.st_mode) & 0o022
        and bool(info.st_mode & 0o111)
    )


def _validate_encrypted_file(path: Path, *, maximum: int = 64 * 1024) -> None:
    if not 32 <= maximum <= 2 * 1024 * 1024:
        raise BootstrapError("credential_unsafe", "An encrypted credential bound is invalid.")
    try:
        info = os.lstat(path)
    except OSError as exc:
        raise BootstrapError("credential_missing", "A required TPM-bound recovery share is absent.") from exc
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != 0
        or stat.S_IMODE(info.st_mode) & 0o077
        or not 32 <= info.st_size <= maximum
    ):
        raise BootstrapError("credential_unsafe", "A required TPM-bound recovery share is unsafe.")


def _decrypt_credential(name: str, path: Path, maximum: int = 4096) -> bytearray:
    _validate_encrypted_file(path, maximum=max(64 * 1024, maximum))
    completed = subprocess.run(
        ["/usr/bin/systemd-creds", "decrypt", "--refuse-null", f"--name={name}", str(path), "-"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or not completed.stdout or len(completed.stdout) > maximum:
        raise BootstrapError("credential_unavailable", "A TPM-bound bootstrap credential cannot be decrypted.")
    value = bytearray(completed.stdout.rstrip(b"\r\n"))
    if not 16 <= len(value) <= maximum or any(chr(byte).isspace() for byte in value):
        _wipe(value)
        raise BootstrapError("credential_invalid", "A TPM-bound bootstrap credential is invalid.")
    return value


def _wipe(value: bytearray | None) -> None:
    if value is not None:
        for index in range(len(value)):
            value[index] = 0


def _openbao_opener() -> urllib.request.OpenerDirector:
    context = ssl.create_default_context(cafile=str(OPENBAO_CA))
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    return urllib.request.build_opener(
        urllib.request.ProxyHandler({}), _NoRedirects(), urllib.request.HTTPSHandler(context=context)
    )


def openbao_request(
    method: str,
    path: str,
    *,
    payload: dict[str, Any] | None = None,
    token: str | None = None,
    allowed_statuses: frozenset[int] = frozenset({200}),
    additional_paths: frozenset[str] = frozenset(),
) -> tuple[int, dict[str, Any] | None]:
    exact_paths = {
        "/v1/sys/health",
        "/v1/sys/generate-root/attempt",
        "/v1/sys/generate-root/update",
        "/v1/auth/userpass/users/ops-user",
        "/v1/auth/userpass/login/ops-user",
        "/v1/auth/token/lookup-self",
        "/v1/auth/token/revoke-self",
        "/v1/auth/token/accessors",
        "/v1/auth/token/lookup-accessor",
        "/v1/auth/token/revoke-accessor",
    }
    for role in (*OPENBAO_UNDO_ROLES, *OPENBAO_FORBIDDEN_LEGACY_ROLES):
        exact_paths.update(
            {
                f"/v1/auth/approle/role/{role}",
                f"/v1/auth/approle/role/{role}/secret-id",
                f"/v1/auth/approle/role/{role}/secret-id-accessor/destroy",
            }
        )
    exact_paths.update(f"/v1/sys/policies/acl/{name}" for name in OPENBAO_UNDO_POLICIES)
    for data_path, metadata_path, destroy_path in OPENBAO_UNDO_KV.values():
        exact_paths.update({data_path, metadata_path, destroy_path})
    if any(
        not re.fullmatch(
            r"/v1/kv-infra-shared/(?:data|metadata)/llm/(?:qwen|deepseek|providers/[a-z0-9-]{2,32})",
            candidate,
        )
        for candidate in additional_paths
    ):
        raise BootstrapError("openbao_request_rejected", "A provider health path is invalid.")
    exact_paths.update(additional_paths)
    if method not in {"GET", "LIST", "POST", "PUT", "DELETE"} or path not in exact_paths:
        raise BootstrapError("openbao_request_rejected", "An internal OpenBao request escaped its allowlist.")
    headers = {"Accept": "application/json", "User-Agent": "ops-control-plane-bootstrap/1"}
    body = None
    if payload is not None or method in {"POST", "PUT"}:
        body = json.dumps(payload or {}, separators=(",", ":")).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if token is not None:
        if not TOKEN_RE.fullmatch(token):
            raise BootstrapError("openbao_invalid", "OpenBao returned an invalid token.")
        headers["X-Vault-Token"] = token
    request = urllib.request.Request(OPENBAO_ORIGIN + path, data=body, headers=headers, method=method)
    raw = b""
    try:
        with _openbao_opener().open(request, timeout=5) as response:
            status = response.status
            raw = response.read(MAX_API_RESPONSE + 1)
    except urllib.error.HTTPError as exc:
        status = exc.code
        raw = exc.read(MAX_API_RESPONSE + 1)
        exc.close()
    except (OSError, ssl.SSLError, urllib.error.URLError) as exc:
        raise BootstrapError("openbao_unavailable", "The local OpenBao API is unavailable.") from exc
    if status not in allowed_statuses:
        raise BootstrapError("openbao_rejected", "OpenBao rejected a bounded bootstrap request.")
    if len(raw) > MAX_API_RESPONSE:
        raise BootstrapError("openbao_invalid", "OpenBao returned an oversized response.")
    if not raw:
        return status, None
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid JSON.") from exc
    if not isinstance(document, dict):
        raise BootstrapError("openbao_invalid", "OpenBao returned an invalid document.")
    return status, document


class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, unix_path: Path) -> None:
        super().__init__("localhost", timeout=5)
        self._unix_path = unix_path

    def connect(self) -> None:
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        connection.settimeout(self.timeout)
        try:
            connection.connect(str(self._unix_path))
        except BaseException:
            connection.close()
            raise
        self.sock = connection


def openbao_recovery_request(
    method: str,
    path: str,
    *,
    payload: dict[str, Any] | None = None,
    allowed_statuses: frozenset[int] = frozenset({200}),
) -> tuple[int, dict[str, Any] | None]:
    """Call only the transient root/openbao 0600 Unix listener."""

    if method not in {"GET", "POST", "PUT", "DELETE"} or path not in {
        "/v1/sys/generate-root/attempt", "/v1/sys/generate-root/update"
    }:
        raise BootstrapError("openbao_request_rejected", "A recovery request escaped its allowlist.")
    try:
        metadata = os.lstat(OPENBAO_RECOVERY_SOCKET)
        openbao_identity = pwd.getpwnam("openbao")
        openbao_group = grp.getgrnam("openbao")
    except (OSError, KeyError) as exc:
        raise BootstrapError("openbao_unavailable", "The temporary recovery socket is unavailable.") from exc
    if (
        not stat.S_ISSOCK(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != openbao_identity.pw_uid or metadata.st_gid != openbao_group.gr_gid
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise BootstrapError("openbao_unavailable", "The temporary recovery socket is unsafe.")
    body = None if payload is None else json.dumps(payload, separators=(",", ":")).encode("utf-8")
    headers = {
        "Accept": "application/json", "Host": "localhost",
        "User-Agent": "ops-control-plane-bootstrap/1",
    }
    if body is not None:
        headers["Content-Type"] = "application/json"
    connection = _UnixHTTPConnection(OPENBAO_RECOVERY_SOCKET)
    try:
        connection.request(method, path, body=body, headers=headers)
        response = connection.getresponse()
        status = response.status
        raw = response.read(MAX_API_RESPONSE + 1)
    except (OSError, http.client.HTTPException) as exc:
        raise BootstrapError("openbao_unavailable", "The temporary recovery API is unavailable.") from exc
    finally:
        connection.close()
    if status not in allowed_statuses:
        raise BootstrapError("openbao_rejected", "OpenBao rejected a bounded recovery request.")
    if len(raw) > MAX_API_RESPONSE:
        raise BootstrapError("openbao_invalid", "OpenBao returned an oversized recovery response.")
    if not raw:
        return status, None
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("openbao_invalid", "OpenBao returned invalid recovery JSON.") from exc
    if not isinstance(document, dict):
        raise BootstrapError("openbao_invalid", "OpenBao returned an invalid recovery document.")
    return status, document


def _wait_openbao(*, timeout: int = 90) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    while True:
        try:
            _, document = openbao_request(
                "GET", "/v1/sys/health", allowed_statuses=frozenset({200, 429, 472, 473, 501, 503})
            )
            if isinstance(document, dict) and document.get("initialized") is True and document.get("sealed") is False:
                return document
        except BootstrapError:
            pass
        if time.monotonic() >= deadline:
            raise BootstrapError("openbao_unavailable", "OpenBao did not become initialized and unsealed.")
        time.sleep(1)


def _credential_group_state() -> dict[str, bool]:
    result: dict[str, bool] = {}
    for group, names in CREDENTIAL_GROUPS.items():
        present = [os.path.lexists(Path("/etc/credstore.encrypted") / name) for name in names]
        if any(present) and not all(present):
            raise BootstrapError("credential_partial", f"The encrypted {group} credential set is incomplete.")
        if all(present):
            for name in names:
                _validate_encrypted_file(Path("/etc/credstore.encrypted") / name)
        result[group] = all(present)
    return result


def _host_os_release() -> dict[str, str]:
    raw = _read_root_file(Path("/usr/lib/os-release"), 64 * 1024, private=False)
    values: dict[str, str] = {}
    for line in raw.decode("utf-8", errors="strict").splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key not in {"ID", "VERSION_ID"}:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", value):
            raise BootstrapError("host_unsupported", "The host release metadata is invalid.")
        values[key] = value
    return values


def _installed_nevra(package: str) -> str | None:
    if not re.fullmatch(r"[a-z0-9][a-z0-9+._-]{0,127}", package):
        raise BootstrapError("host_incomplete", "A package name is invalid.")
    completed = subprocess.run(
        [
            "/usr/bin/rpm", "-q", "--qf",
            "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}", package,
        ],
        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, timeout=10,
    )
    if completed.returncode != 0:
        return None
    try:
        value = completed.stdout.decode("ascii", errors="strict")
    except UnicodeError as exc:
        raise BootstrapError("host_incomplete", "An installed package identity is invalid.") from exc
    if len(value) > 256 or not re.fullmatch(r"[A-Za-z0-9+._:-]{1,256}", value):
        raise BootstrapError("host_incomplete", "An installed package identity is invalid.")
    return value


def _validate_finance_identity_readonly() -> str:
    try:
        finance_user = pwd.getpwnam("opsfinance")
    except KeyError:
        finance_user = None
    try:
        finance_group = grp.getgrnam("opsfinance")
    except KeyError:
        finance_group = None
    if finance_user is None and finance_group is None:
        return "absent"
    if finance_user is None or finance_group is None:
        raise BootstrapError("host_incomplete", "The provider-finance identity is incomplete.")
    try:
        client_user = pwd.getpwnam("opsorchestrator")
    except KeyError as exc:
        raise BootstrapError("host_incomplete", "The finance client identity is absent.") from exc
    if (
        finance_user.pw_gid != finance_group.gr_gid
        or finance_user.pw_uid == client_user.pw_uid
        or finance_user.pw_dir != "/nonexistent"
        or finance_user.pw_shell != "/usr/sbin/nologin"
        or finance_group.gr_mem != ["opsorchestrator"]
    ):
        raise BootstrapError("host_incomplete", "The provider-finance identity differs from review.")
    return "present"


def _validate_noop_identity_baseline() -> None:
    for user_name, (expected_home, expected_shell) in NOOP_IDENTITY_USERS.items():
        try:
            user = pwd.getpwnam(user_name)
            primary_group = grp.getgrgid(user.pw_gid)
        except KeyError as exc:
            raise BootstrapError(
                "host_incomplete", "A required immutable service identity is absent."
            ) from exc
        if (
            user.pw_uid == 0
            or user.pw_uid >= 1000
            or user.pw_dir != expected_home
            or user.pw_shell != expected_shell
            or primary_group.gr_name != user_name
        ):
            raise BootstrapError(
                "host_incomplete", "A required service identity differs from review."
            )
    try:
        ops-user = pwd.getpwnam("ops-user")
    except KeyError as exc:
        raise BootstrapError(
            "host_incomplete", "The physical operator identity is absent."
        ) from exc
    if ops-user.pw_uid != 1000 or ops-user.pw_dir != "/home/ops-user":
        raise BootstrapError(
            "host_incomplete", "The physical operator identity differs from review."
        )
    passwd_records = pwd.getpwall()
    for group_name, expected_members in NOOP_IDENTITY_GROUP_MEMBERS.items():
        try:
            group = grp.getgrnam(group_name)
        except KeyError as exc:
            raise BootstrapError(
                "host_incomplete", "A required immutable API group is absent."
            ) from exc
        primary_users = {
            record.pw_name for record in passwd_records if record.pw_gid == group.gr_gid
        }
        if set(group.gr_mem) != expected_members or primary_users:
            raise BootstrapError(
                "host_incomplete", "An immutable API group membership differs from review."
            )
    for group_name, member in NOOP_IDENTITY_REQUIRED_MEMBERS.items():
        try:
            group = grp.getgrnam(group_name)
        except KeyError as exc:
            raise BootstrapError(
                "host_incomplete", "A required device access group is absent."
            ) from exc
        if member not in group.gr_mem:
            raise BootstrapError(
                "host_incomplete", "A required device group membership is incomplete."
            )


def _readonly_output(argv: list[str], *, maximum: int = 4 * 1024 * 1024) -> bytes:
    completed = subprocess.run(
        argv,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=60,
        env={"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
    )
    if completed.returncode != 0 or len(completed.stdout) > maximum:
        raise BootstrapError("docker_conflict", "A Docker network prerequisite is unavailable.")
    return completed.stdout


def _normalized_firewalld_readonly(arguments: list[str]) -> bytes:
    return re.sub(
        rb" \((?:default(?:, active)?|active|disabled)\)(?=\n)",
        b"",
        _readonly_output(["/usr/bin/firewall-cmd", *arguments]),
    ).strip() + b"\n"


def _validate_docker_network_readonly() -> None:
    preservation_roots: list[os.stat_result] = []
    for preservation_root in (Path("/var/lib"), Path("/var/backups")):
        try:
            root_metadata = os.lstat(preservation_root)
        except OSError as exc:
            raise BootstrapError(
                "docker_conflict", "A Docker volume preservation root is unavailable."
            ) from exc
        if (
            not stat.S_ISDIR(root_metadata.st_mode)
            or stat.S_ISLNK(root_metadata.st_mode)
            or root_metadata.st_uid != 0
        ):
            raise BootstrapError(
                "docker_conflict", "A Docker volume preservation root is unsafe."
            )
        preservation_roots.append(root_metadata)
    if preservation_roots[0].st_dev != preservation_roots[1].st_dev:
        raise BootstrapError(
            "docker_conflict", "Docker volumes cannot be preserved atomically."
        )
    recovered_root = Path("/var/backups/zulip-local")
    if os.path.lexists(recovered_root):
        recovered_metadata = os.lstat(recovered_root)
        if (
            not stat.S_ISDIR(recovered_metadata.st_mode)
            or stat.S_ISLNK(recovered_metadata.st_mode)
            or recovered_metadata.st_uid != 0
            or recovered_metadata.st_gid != 0
            or stat.S_IMODE(recovered_metadata.st_mode) != 0o700
        ):
            raise BootstrapError(
                "docker_conflict", "The Zulip recovery archive root is unsafe."
            )
    try:
        firewalld_lines = _read_root_file(
            Path("/etc/firewalld/firewalld.conf"), 256 * 1024, private=False
        ).decode("utf-8", errors="strict").splitlines()
    except UnicodeError as exc:
        raise BootstrapError(
            "docker_conflict", "The firewalld backend configuration is invalid."
        ) from exc
    backend_values: list[str] = []
    for raw_line in firewalld_lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if separator and key.strip() == "FirewallBackend":
            backend_values.append(value.strip())
    if len(backend_values) > 1 or (
        backend_values and backend_values[0] != "nftables"
    ):
        raise BootstrapError(
            "docker_conflict", "firewalld is not using its reviewed nftables backend."
        )
    if _readonly_output(["/usr/bin/firewall-cmd", "--state"]).strip() != b"running":
        raise BootstrapError("docker_conflict", "firewalld is not running.")
    for runtime_args, permanent_args in (
        (["--list-all-zones"], ["--permanent", "--list-all-zones"]),
        (["--list-all-policies"], ["--permanent", "--list-all-policies"]),
    ):
        if _normalized_firewalld_readonly(runtime_args) != _normalized_firewalld_readonly(permanent_args):
            raise BootstrapError(
                "docker_conflict", "firewalld has uncommitted runtime-only configuration."
            )
    runtime_direct = b"".join(
        _normalized_firewalld_readonly(["--direct", operation])
        for operation in ("--get-all-chains", "--get-all-rules", "--get-all-passthroughs")
    )
    permanent_direct = b"".join(
        _normalized_firewalld_readonly(["--permanent", "--direct", operation])
        for operation in ("--get-all-chains", "--get-all-rules", "--get-all-passthroughs")
    )
    if runtime_direct != permanent_direct:
        raise BootstrapError(
            "docker_conflict", "firewalld direct rules are not durably synchronized."
        )
    for key, expected in DOCKER_NETWORK_SYSCTLS.items():
        if _readonly_output(["/usr/sbin/sysctl", "-n", key]).strip() != str(expected).encode():
            raise BootstrapError("docker_conflict", "Host forwarding sysctls differ from review.")
    alternatives = _readonly_output(["/usr/bin/alternatives", "--display", "iptables"])
    if (
        b"iptables - status is auto." not in alternatives
        or b" link currently points to /usr/bin/iptables-nft" not in alternatives
    ):
        raise BootstrapError("docker_conflict", "iptables is not the reviewed nft alternative.")
    nft_document = _readonly_output(
        ["/usr/sbin/nft", "--json", "--handle", "list", "ruleset"],
        maximum=8 * 1024 * 1024,
    )
    try:
        parsed_nft = json.loads(nft_document)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("docker_conflict", "The nftables ruleset is invalid.") from exc
    if not isinstance(parsed_nft, dict):
        raise BootstrapError("docker_conflict", "The nftables ruleset is invalid.")
    reviewed = [
        ipaddress.ip_network(contract["subnet"], strict=True)
        for contract in ZULIP_DOCKER_NETWORKS.values()
    ]
    for argv, kind in (
        (["/usr/sbin/ip", "-j", "route", "show", "table", "all"], "route"),
        (["/usr/sbin/ip", "-j", "address", "show"], "address"),
    ):
        try:
            records = json.loads(_readonly_output(argv))
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise BootstrapError("docker_conflict", "The host route inventory is invalid.") from exc
        if not isinstance(records, list) or any(not isinstance(item, dict) for item in records):
            raise BootstrapError("docker_conflict", "The host route inventory is invalid.")
        candidates: list[ipaddress.IPv4Network] = []
        if kind == "route":
            raw_networks = [
                item.get("dst") for item in records if item.get("dst") not in (None, "default")
            ]
            for raw_network in raw_networks:
                try:
                    network = ipaddress.ip_network(raw_network, strict=False)
                except (TypeError, ValueError) as exc:
                    raise BootstrapError("docker_conflict", "The host route inventory is invalid.") from exc
                if isinstance(network, ipaddress.IPv4Network):
                    candidates.append(network)
        else:
            for item in records:
                entries = item.get("addr_info")
                if not isinstance(entries, list):
                    raise BootstrapError("docker_conflict", "The host address inventory is invalid.")
                for entry in entries:
                    if not isinstance(entry, dict) or entry.get("family") != "inet":
                        continue
                    try:
                        candidates.append(
                            ipaddress.ip_network(
                                f"{entry.get('local')}/{entry.get('prefixlen')}", strict=False
                            )
                        )
                    except (TypeError, ValueError) as exc:
                        raise BootstrapError("docker_conflict", "The host address inventory is invalid.") from exc
        if any(candidate.overlaps(target) for candidate in candidates for target in reviewed):
            raise BootstrapError("docker_conflict", "A reviewed Docker subnet overlaps the host network.")
    try:
        resolver_lines = Path("/etc/resolv.conf").read_text(
            encoding="ascii", errors="strict"
        ).splitlines()
    except (OSError, UnicodeError) as exc:
        raise BootstrapError("docker_conflict", "The host resolver configuration is unavailable.") from exc
    if sum(len(line) + 1 for line in resolver_lines) > 64 * 1024:
        raise BootstrapError("docker_conflict", "The host resolver configuration is invalid.")
    for line in resolver_lines:
        fields = line.split()
        if not fields or fields[0] != "nameserver":
            continue
        if len(fields) != 2:
            raise BootstrapError("docker_conflict", "The host resolver configuration is invalid.")
        try:
            resolver = ipaddress.ip_address(fields[1])
        except ValueError as exc:
            raise BootstrapError("docker_conflict", "The host resolver configuration is invalid.") from exc
        if isinstance(resolver, ipaddress.IPv4Address) and any(
            resolver in target for target in reviewed
        ):
            raise BootstrapError("docker_conflict", "A reviewed Docker subnet overlaps a DNS resolver.")
    try:
        resolved_records = json.loads(
            _readonly_output(["/usr/bin/resolvectl", "--json=short", "status"])
        )
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError(
            "docker_conflict", "The effective DNS resolver inventory is invalid."
        ) from exc
    if not isinstance(resolved_records, list) or any(
        not isinstance(item, dict) for item in resolved_records
    ):
        raise BootstrapError(
            "docker_conflict", "The effective DNS resolver inventory is invalid."
        )
    for record in resolved_records:
        candidates: list[Any] = []
        servers = record.get("servers")
        if servers is not None:
            if not isinstance(servers, list) or len(servers) > 256:
                raise BootstrapError(
                    "docker_conflict", "The effective DNS resolver inventory is invalid."
                )
            candidates.extend(servers)
        current = record.get("currentServer")
        if current is not None:
            candidates.append(current)
        for candidate in candidates:
            if not isinstance(candidate, dict):
                raise BootstrapError(
                    "docker_conflict", "The effective DNS resolver inventory is invalid."
                )
            raw_address = candidate.get("addressString")
            if not isinstance(raw_address, str) or len(raw_address) > 64:
                raise BootstrapError(
                    "docker_conflict", "The effective DNS resolver inventory is invalid."
                )
            try:
                resolver = ipaddress.ip_address(raw_address)
            except ValueError as exc:
                raise BootstrapError(
                    "docker_conflict", "The effective DNS resolver inventory is invalid."
                ) from exc
            if isinstance(resolver, ipaddress.IPv4Address) and any(
                resolver in target for target in reviewed
            ):
                raise BootstrapError(
                    "docker_conflict",
                    "A reviewed Docker subnet overlaps an effective DNS resolver.",
                )


def _validate_docker_readonly(manifest: dict[str, Any]) -> str:
    docker = manifest.get("host", {}).get("docker")
    if not isinstance(docker, dict):
        raise BootstrapError("manifest_invalid", "The Docker release contract is invalid.")
    packages = docker.get("packages")
    dependencies = docker.get("dependencies")
    if (
        not isinstance(packages, dict)
        or not isinstance(dependencies, dict)
        or docker.get("initial_state") != "absent"
        or docker.get("in_place_upgrade_supported") is not False
        or docker.get("rollback_preserves_named_volumes") is not True
        or docker.get("rollback_named_volumes_root") != "/var/backups/zulip-local"
        or docker.get("service") != "docker.service"
        or docker.get("units") != list(DOCKER_SERVICE_UNITS)
        or docker.get("preinstalled_dependencies")
        != list(DOCKER_PREINSTALLED_DEPENDENCIES)
        or docker.get("daemon_config") != DOCKER_DAEMON_CONFIG_DOCUMENT
        or docker.get("network")
        != {
            "firewalld_required": True,
            "fixed_networks": ZULIP_DOCKER_NETWORKS,
            "ipv4_forwarding_required": True,
            "ipv6_forwarding_required": False,
        }
    ):
        raise BootstrapError("manifest_invalid", "The Docker package contract is invalid.")
    conflicts = ("podman-docker", "docker-ce", "docker-ce-cli", "containerd.io")
    if any(_installed_nevra(name) is not None for name in conflicts):
        raise BootstrapError("docker_conflict", "A conflicting Docker provider is installed.")
    installed_packages = {name: _installed_nevra(name) for name in packages}
    installed_dependencies = {name: _installed_nevra(name) for name in dependencies}
    if any(
        value is not None and value != dependencies[name]
        for name, value in installed_dependencies.items()
    ):
        raise BootstrapError("docker_conflict", "Installed Docker dependency versions differ from review.")
    count = sum(value is not None for value in installed_packages.values())
    if count == 0:
        if os.path.lexists(DOCKER_ROLLBACK_PRESET_PARENT):
            preset_parent = os.lstat(DOCKER_ROLLBACK_PRESET_PARENT)
            if (
                not stat.S_ISDIR(preset_parent.st_mode)
                or stat.S_ISLNK(preset_parent.st_mode)
                or preset_parent.st_uid != 0
                or preset_parent.st_gid != 0
                or stat.S_IMODE(preset_parent.st_mode) & 0o022
            ):
                raise BootstrapError(
                    "docker_conflict", "The systemd preset parent is unsafe."
                )
        loaded_docker_units = []
        for unit in DOCKER_SERVICE_UNITS:
            loaded = subprocess.run(
                ["/usr/bin/systemctl", "show", unit, "--property=LoadState", "--value"],
                check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, timeout=10,
            )
            if loaded.stdout.strip() not in {b"", b"not-found"}:
                loaded_docker_units.append(unit)
        try:
            grp.getgrnam("docker")
        except KeyError:
            docker_group_exists = False
        else:
            docker_group_exists = True
        if (
            any(path.exists() or path.is_symlink() for path in DOCKER_UNMANAGED_PATHS)
            or loaded_docker_units
            or docker_group_exists
            or os.path.lexists("/sys/class/net/docker0")
            or any(
                os.path.lexists(f"/sys/class/net/{bridge}")
                for contract in ZULIP_DOCKER_NETWORKS.values()
                for bridge in (contract["bridge_name"],)
            )
        ):
            raise BootstrapError("docker_conflict", "An unmanaged Docker runtime is present.")
        for dependency in DOCKER_PREINSTALLED_DEPENDENCIES:
            if installed_dependencies.get(dependency) != dependencies.get(dependency):
                raise BootstrapError(
                    "host_incomplete",
                    "A reviewed host-level Docker dependency must already be installed.",
                )
        verified = subprocess.run(
            ["/usr/bin/rpm", "-V", *DOCKER_PREINSTALLED_DEPENDENCIES],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=120,
        )
        if verified.returncode != 0 or verified.stdout.strip():
            raise BootstrapError(
                "docker_conflict", "A reviewed Docker dependency payload was modified."
            )
        _validate_docker_network_readonly()
        return "absent"
    if installed_packages != packages or installed_dependencies != dependencies:
        raise BootstrapError("docker_conflict", "The reviewed Docker package set is incomplete.")
    if not _command_available("/usr/bin/docker"):
        raise BootstrapError("docker_conflict", "The reviewed Docker client is unavailable.")
    try:
        grp.getgrnam("docker")
    except KeyError as exc:
        raise BootstrapError("docker_conflict", "The reviewed Docker group is absent.") from exc
    compose = subprocess.run(
        ["/usr/bin/docker", "compose", "version", "--short"],
        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, timeout=15,
    )
    if compose.returncode != 0 or compose.stdout.strip() != b"5.5.0":
        raise BootstrapError("docker_conflict", "The reviewed Docker Compose version differs.")
    if _systemctl_state("docker.service", "is-active"):
        info = subprocess.run(
            ["/usr/bin/docker", "info", "--format", "{{json .SecurityOptions}}"],
            check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=30,
        )
        if info.returncode != 0 or b"rootless" in info.stdout.lower():
            raise BootstrapError("docker_conflict", "The active Docker daemon is not reviewed rootful Docker.")
        return "active"
    return "installed"


def _atlas_installed_identity() -> str | None:
    completed = subprocess.run(
        ["/usr/bin/rpm", "-q", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}", "modeles-ia"],
        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, timeout=10,
    )
    if completed.returncode != 0:
        return None
    try:
        value = completed.stdout.decode("ascii", errors="strict")
    except UnicodeError as exc:
        raise BootstrapError("rollback_unavailable", "The installed Atlas identity is invalid.") from exc
    if len(value) > 256 or not re.fullmatch(r"[A-Za-z0-9+._-]{1,256}", value):
        raise BootstrapError("rollback_unavailable", "The installed Atlas identity is invalid.")
    return value


def _validate_atlas_temporary_payloads_absent() -> None:
    for payload in ATLAS_PAYLOAD_PATHS:
        if not os.path.lexists(payload.parent):
            continue
        try:
            parent = os.lstat(payload.parent)
            entries = list(os.scandir(payload.parent))
        except OSError as exc:
            raise BootstrapError(
                "rollback_unavailable", "An Atlas RPM payload parent is unavailable."
            ) from exc
        if (
            not stat.S_ISDIR(parent.st_mode)
            or stat.S_ISLNK(parent.st_mode)
            or parent.st_uid != 0
            or stat.S_IMODE(parent.st_mode) & 0o022
            or len(entries) > 100_000
        ):
            raise BootstrapError(
                "rollback_unavailable", "An Atlas RPM payload parent is unsafe."
            )
        pattern = re.compile(re.escape(payload.name) + r";[0-9a-f]{8}\Z")
        if any(pattern.fullmatch(entry.name) for entry in entries):
            raise BootstrapError(
                "rollback_unavailable", "An interrupted Atlas RPM payload is present."
            )


def _validate_network_dependencies(manifest: dict[str, Any]) -> None:
    """Authenticate the vendored Hermes source without network or mutable state.

    DNF is deliberately not invoked by the pre-consent bootstrap.  Even a
    repoquery can update caches, logs, or plugin state outside the volatile
    enrollment directory.  The reviewed Docker NEVRAs and their exact closure
    are checked by the transactional worker immediately before installation.
    """

    hermes = manifest["components"]["hermes"]
    archive = manifest["artifacts"]["hermes_source_archive"]
    supply_chain = manifest["supply_chain"]["hermes"]
    archive_path = Path(archive["source_path"])
    try:
        archive_metadata = os.lstat(archive_path)
    except OSError as exc:
        raise BootstrapError(
            "artifact_invalid", "The vendored Hermes release is unavailable."
        ) from exc
    if (
        supply_chain.get("source_archive_vendored") is not True
        or supply_chain.get("network_git_transport") is not False
        or archive.get("commit") != hermes.get("commit")
        or not stat.S_ISREG(archive_metadata.st_mode)
        or stat.S_ISLNK(archive_metadata.st_mode)
        or archive_metadata.st_nlink != 1
        or stat.S_IMODE(archive_metadata.st_mode) & 0o022
        or archive_metadata.st_size != archive.get("compressed_size")
        or not hmac.compare_digest(
            _independent_regular_sha256(archive_path),
            archive["sha256"],
        )
    ):
        raise BootstrapError(
            "artifact_invalid", "The vendored Hermes release differs from review."
        )


def _rollback_finalize_preflight(
    manifest: dict[str, Any],
    source_digest: str,
    manifest_digest: str,
    transaction: dict[str, Any],
    corrective_context: dict[str, Any] | None,
) -> dict[str, Any]:
    """Review only the evidence needed to finish a pre-production rollback."""

    pending = transaction.get("phase") == PREPRODUCTION_ROLLBACK_AUDIT_PHASE
    terminal_candidate = _preproduction_terminal_rollback_candidate(
        transaction,
        release_id=manifest["release_id"],
        source_tree_sha256=source_digest,
        atlas_rpm_sha256=manifest["artifacts"]["atlas_rpm"]["sha256"],
        hermes_source_archive_sha256=manifest["artifacts"]["hermes_source_archive"]["sha256"],
    )
    if not pending and terminal_candidate is None:
        raise BootstrapError(
            "bootstrap_state_conflict",
            "The rollback-only resume frontier differs.",
        )
    observed_candidate = transaction if pending else terminal_candidate
    assert observed_candidate is not None
    if not _preproduction_rollback_is_unchanged(observed_candidate):
        raise BootstrapError(
            "bootstrap_state_conflict",
            "The rollback-only service frontier differs.",
        )
    _validate_preproduction_recovery_scaffold_readonly(transaction)
    # Accept one strict canonical append prefix without changing it during
    # preflight; apply reconciles that prefix only after explicit commit.
    _raw, _complete, records, _tail, partial = _read_audit_partial_frontier(
        AUDIT_PATH
    )
    if terminal_candidate is not None:
        matches = [
            (index, record)
            for index, record in enumerate(records)
            if record.get("event") == "bootstrap_rolled_back"
            and record.get("release_id") == transaction.get("release_id")
        ]
        if (
            partial
            or len(matches) != 1
            or matches[0][0] != len(records) - 1
            or matches[0][1].get("details")
            != {"password_recovery_persists": True}
            or matches[0][1].get("timestamp", 0)
            > transaction["rolled_back_at"]
        ):
            raise BootstrapError(
                "audit_invalid", "The terminal rollback audit differs."
            )
    credentials = _credential_group_state()
    if any(credentials.values()):
        raise BootstrapError(
            "credential_state_conflict",
            "Credentials appeared before rollback finalization.",
        )
    if _validate_docker_readonly(manifest) != "absent":
        raise BootstrapError(
            "docker_conflict", "Docker changed before rollback finalization."
        )
    _validate_atlas_temporary_payloads_absent()
    if _atlas_installed_identity() is not None or any(
        os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS
    ):
        raise BootstrapError(
            "rollback_unavailable", "Atlas changed before rollback finalization."
        )
    if any(
        os.path.lexists(path)
        for path in (
            Path("/opt/ops-control-plane/deploy/zulip-local"),
            Path("/etc/zulip-local"),
            Path("/var/lib/zulip-local"),
        )
    ):
        raise BootstrapError(
            "zulip_present", "Zulip changed before rollback finalization."
        )
    return {
        "release_id": manifest["release_id"],
        "manifest_sha256": manifest_digest,
        "source_tree_sha256": source_digest,
        "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
        "catalogue_sha256": manifest["components"]["model_catalogue"]["sha256"],
        "provider_integrations_sha256": manifest["components"]["provider_integrations"]["sha256"],
        "credential_groups_present": credentials,
        "provider_keys_required": False,
        "network_dependencies": "not-required",
        "zulip": "absent",
        "enrollment_resume": True,
        "rollback_finalize_resume": True,
        "operation_mode": "corrective" if corrective_context is not None else "fresh",
        **(
            {
                "recovery_from_release_id": CORRECTIVE_PREDECESSOR["release_id"],
                "corrective_resume": True,
            }
            if corrective_context is not None
            else {}
        ),
    }


def bootstrap_preflight(
    manifest: dict[str, Any], source_digest: str, manifest_digest: str,
    *,
    enrollment_resume: dict[str, Any] | None = None,
    corrective_context: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise BootstrapError("permission_denied", "The sealed bootstrap helper must run as root.")
    if os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH):
        raise BootstrapError(
            "bootstrap_state_conflict",
            "A public installed proof already exists; fresh enrollment is forbidden.",
        )
    if corrective_context is not None:
        if (
            corrective_context.get("kind") not in {"new", "handoff", "resume"}
            or corrective_context.get("enrollment_resume") != enrollment_resume
        ):
            raise BootstrapError(
                "corrective_state_invalid", "The corrective preflight context differs."
            )
    elif enrollment_resume is None:
        if os.path.lexists(CONSUMED_PATH):
            raise BootstrapError("bootstrap_consumed", "The one-shot bootstrap capability is already consumed.")
        if os.path.lexists(STATE_ROOT):
            raise BootstrapError("bootstrap_state_conflict", "Unconsumed bootstrap state already exists.")
        if any(os.path.lexists(path) for path in RECOVERY_ASSETS):
            raise BootstrapError(
                "bootstrap_state_conflict",
                "Prior bootstrap recovery infrastructure is present.",
            )
        if os.path.lexists(LIVE_TRANSACTION_PATH):
            raise BootstrapError("bootstrap_state_conflict", "A stale live bootstrap marker is present.")
    else:
        _validate_transaction_document(enrollment_resume)
        if _live_bootstrap_is_verified(enrollment_resume):
            raise BootstrapError("bootstrap_busy", "The matching bootstrap enrollment is still active.")
        if (
            enrollment_resume.get("phase") == PREPRODUCTION_ROLLBACK_AUDIT_PHASE
            or (
                enrollment_resume.get("status") == "rolled-back"
                and enrollment_resume.get("phase") == "rolled-back"
            )
        ):
            return _rollback_finalize_preflight(
                manifest,
                source_digest,
                manifest_digest,
                enrollment_resume,
                corrective_context,
            )
    if platform.machine() != "x86_64":
        raise BootstrapError("host_unsupported", "The host architecture is not reviewed.")
    try:
        swap_lines = Path("/proc/swaps").read_text(encoding="ascii").splitlines()[1:]
    except (OSError, UnicodeError) as exc:
        raise BootstrapError("host_unsupported", "Swap state is unavailable.") from exc
    if any(line.split() and not line.split()[0].startswith("/dev/zram") for line in swap_lines):
        raise BootstrapError("host_unsupported", "Disk-backed swap is forbidden during secret recovery.")
    os_release = _host_os_release()
    if os_release.get("ID") != "fedora" or os_release.get("VERSION_ID") != "44":
        raise BootstrapError("host_unsupported", "The host is not Fedora 44.")
    for executable in (
        "/usr/bin/age", "/usr/bin/alternatives", "/usr/bin/bash", "/usr/bin/curl", "/usr/bin/dnf",
        "/usr/bin/firewall-cmd",
        "/usr/bin/flock", "/usr/bin/getent", "/usr/bin/install",
        "/usr/bin/loginctl", "/usr/bin/openssl", "/usr/bin/pkexec", "/usr/bin/python3",
        "/usr/bin/resolvectl", "/usr/bin/rpm", "/usr/bin/rpmkeys", "/usr/bin/runuser", "/usr/bin/stat",
        "/usr/bin/systemctl", "/usr/bin/systemd-analyze", "/usr/bin/systemd-ask-password",
        "/usr/bin/systemd-creds", "/usr/bin/systemd-inhibit", "/usr/bin/systemd-sysusers",
        "/usr/bin/systemd-tmpfiles", "/usr/bin/systemd-run",
        "/usr/bin/sync", "/usr/bin/tar", "/usr/bin/update-ca-trust", "/usr/bin/visudo",
        "/usr/sbin/groupdel", "/usr/sbin/ip", "/usr/sbin/iptables-nft",
        "/usr/sbin/nft", "/usr/sbin/sysctl", "/usr/sbin/userdel",
    ):
        if not _command_available(executable):
            raise BootstrapError("host_incomplete", f"A required root-owned executable is unavailable: {Path(executable).name}")
    # DNF is deliberately not executed before confirmation; even a help probe
    # may initialize durable plugin/cache state. Presence is checked passively.
    if _installed_nevra("dnf5-plugins") is None:
        raise BootstrapError("host_incomplete", "DNF download support is unavailable.")
    _validate_noop_identity_baseline()
    for fixed_executable in (
        Path("/usr/lib/systemd/systemd-socket-proxyd"),
        Path("/opt/ops-memory/bin/ops-memory-mcp"),
    ):
        if not _command_available(str(fixed_executable)):
            raise BootstrapError("host_incomplete", f"A required local runtime is unsafe: {fixed_executable.name}")
    for account in (
        "ops-user", "hermesd", "minecraft-ops", "infra-network", "ops-monitor",
        "backup-agent", "deploy-agent", "security-audit",
    ):
        try:
            pwd.getpwnam(account)
        except KeyError as exc:
            raise BootstrapError("host_incomplete", f"A required local account is absent: {account}") from exc
    try:
        import grp
        grp.getgrnam("node-exporter")
    except KeyError as exc:
        raise BootstrapError("host_incomplete", "The node-exporter group is absent.") from exc
    _validate_finance_identity_readonly()
    if not _systemctl_state("ops-memory.service", "is-active"):
        raise BootstrapError("host_incomplete", "The local memory service is inactive.")
    if not _systemctl_state("prometheus-alertmanager.service", "is-active"):
        raise BootstrapError("host_incomplete", "The local Alertmanager service is inactive.")
    if not _systemctl_state("openbao.service", "is-active"):
        raise BootstrapError("openbao_unavailable", "OpenBao is inactive.")
    rpm_query = subprocess.run(
        ["/usr/bin/rpm", "-q", "--qf", "%{VERSION}", "openbao"], check=False,
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15,
    )
    if rpm_query.returncode != 0 or rpm_query.stdout != manifest["bootstrap"]["openbao"]["version"].encode("ascii"):
        raise BootstrapError("openbao_version_mismatch", "OpenBao is not the reviewed version.")
    _read_root_file(OPENBAO_CA, 1024 * 1024, private=False)
    _wait_openbao(timeout=5)
    if _systemctl_state("zulip-local.service", "is-active"):
        raise BootstrapError("zulip_present", "Zulip is already active; the bootstrap exception does not apply.")
    if _systemctl_state("zulip-local.service", "is-enabled"):
        raise BootstrapError("zulip_present", "Zulip is already enabled; the bootstrap exception does not apply.")
    for existing_zulip_path in (
        Path("/opt/ops-control-plane/deploy/zulip-local"),
        Path("/etc/zulip-local"),
        Path("/var/lib/zulip-local"),
    ):
        if os.path.lexists(existing_zulip_path):
            raise BootstrapError("zulip_present", "Existing Zulip state is outside the one-shot bootstrap scope.")
    for unit in (
        "zulip-alertmanager-query.service",
        "zulip-alertmanager-query.socket",
        "zulip-approval-bridge.service",
        "zulip-local-backup.service",
        "zulip-local-backup.timer",
        "zulip-local-health.service",
        "zulip-local-health.timer",
        "zulip-local-init.service",
        "zulip-local-secrets.service",
        "zulip-local.service",
    ):
        loaded = subprocess.run(
            ["/usr/bin/systemctl", "show", unit, "--property=LoadState", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        if loaded.stdout.strip() not in {b"", b"not-found"}:
            expected_sha256 = ZULIP_LEGACY_UNIT_SHA256.get(unit)
            if expected_sha256 is None:
                raise BootstrapError(
                    "zulip_present", "Existing Zulip units are outside the one-shot bootstrap scope."
                )
            unit_path = Path("/etc/systemd/system") / unit
            try:
                item = os.lstat(unit_path)
                payload = _read_root_file(unit_path, 256 * 1024, private=False)
            except OSError as exc:
                raise BootstrapError(
                    "zulip_present", "A legacy Zulip unit is unavailable."
                ) from exc
            dropins = subprocess.run(
                ["/usr/bin/systemctl", "show", unit, "--property=DropInPaths", "--value"],
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
            fragment = subprocess.run(
                ["/usr/bin/systemctl", "show", unit, "--property=FragmentPath", "--value"],
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
            active_state = subprocess.run(
                ["/usr/bin/systemctl", "show", unit, "--property=ActiveState", "--value"],
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
            unit_file_state = subprocess.run(
                ["/usr/bin/systemctl", "show", unit, "--property=UnitFileState", "--value"],
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
            expected_dropins = (
                str(SYSTEMD_GLOBAL_SERVICE_DROPIN).encode("ascii")
                if unit.endswith(".service")
                else b""
            )
            if expected_dropins:
                global_dropin = os.lstat(SYSTEMD_GLOBAL_SERVICE_DROPIN)
                global_dropin_payload = _read_root_file(
                    SYSTEMD_GLOBAL_SERVICE_DROPIN, 256 * 1024, private=False
                )
                if (
                    not stat.S_ISREG(global_dropin.st_mode)
                    or stat.S_ISLNK(global_dropin.st_mode)
                    or global_dropin.st_uid != 0
                    or global_dropin.st_gid != 0
                    or stat.S_IMODE(global_dropin.st_mode) != 0o644
                    or hashlib.sha256(global_dropin_payload).hexdigest()
                    != SYSTEMD_GLOBAL_SERVICE_DROPIN_SHA256
                ):
                    raise BootstrapError(
                        "zulip_present", "The global systemd service drop-in differs from review."
                    )
            if (
                active_state.returncode != 0
                or active_state.stdout.strip() != b"inactive"
                or unit_file_state.returncode != 0
                or unit_file_state.stdout.strip()
                != ZULIP_LEGACY_UNIT_FILE_STATE[unit].encode("ascii")
                or fragment.returncode != 0
                or fragment.stdout.strip() != str(unit_path).encode("ascii")
                or dropins.returncode != 0
                or dropins.stdout.strip() != expected_dropins
                or not stat.S_ISREG(item.st_mode)
                or stat.S_ISLNK(item.st_mode)
                or item.st_uid != 0
                or item.st_gid != 0
                or stat.S_IMODE(item.st_mode) != 0o644
                or hashlib.sha256(payload).hexdigest() != expected_sha256
            ):
                raise BootstrapError(
                    "zulip_present",
                    "A legacy Zulip unit differs from the reviewed dormant baseline.",
                )
    if _systemctl_state("ops-broker.service", "is-active"):
        raise BootstrapError("broker_busy", "The broker service must be quiescent before bootstrap.")
    expected_openbao = EXPECTED_SOURCE_ROOT / "config/openbao/openbao.hcl"
    expected_bytes = _read_bounded_regular(expected_openbao, 256 * 1024)
    installed_bytes = _read_root_file(OPENBAO_CONFIG, 256 * 1024, private=False)
    expected_sha = manifest["bootstrap"]["openbao"]["listener_source_sha256"]
    if (
        hashlib.sha256(expected_bytes).hexdigest() != expected_sha
        or not hmac.compare_digest(expected_bytes, installed_bytes)
        or installed_bytes.count(TRUE_TOGGLE) != 1
        or FALSE_TOGGLE in installed_bytes
        or TEMPORARY_UNIX_LISTENER in installed_bytes
        or b'address         = "127.0.0.1:8200"' not in installed_bytes
    ):
        raise BootstrapError("openbao_config_drift", "The installed OpenBao listener is not the reviewed loopback-only configuration.")
    if os.path.lexists(OPENBAO_RECOVERY_SOCKET):
        raise BootstrapError("openbao_config_drift", "A temporary OpenBao recovery socket already exists.")
    for name in RECOVERY_CREDENTIALS:
        share = _decrypt_credential(name, Path("/etc/credstore.encrypted") / name)
        _wipe(share)
    credentials = _credential_group_state()
    if any(credentials.values()):
        raise BootstrapError(
            "credential_state_conflict",
            "The one-shot zero-key bootstrap requires all four AppRole groups to be absent.",
        )
    try:
        docker_state = _validate_docker_readonly(manifest)
        if docker_state != "absent":
            raise BootstrapError(
                "docker_conflict",
                "This one-shot release requires the reviewed Docker-absent baseline.",
            )
        atlas = manifest["artifacts"]["atlas_rpm"]
        _validate_atlas_memfd(manifest["artifacts"]["atlas_rpm"], manifest["bootstrap"]["gui_protocol"])
        _validate_atlas_temporary_payloads_absent()
        installed_atlas = _atlas_installed_identity()
        expected_atlas = f"{atlas['name']}-{atlas['version']}-{atlas['release']}.{atlas['architecture']}"
        if installed_atlas is None and any(
            os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS
        ):
            raise BootstrapError(
                "rollback_unavailable", "An unmanaged Atlas RPM payload is present."
            )
        if installed_atlas is not None:
            raise BootstrapError(
                "rollback_unavailable",
                "This bootstrap release requires Atlas to be initially absent.",
            )
    except BootstrapError:
        raise
    except BaseException as exc:
        raise BootstrapError(getattr(exc, "code", "preflight_failed"), "A deployment prerequisite failed.") from exc
    for root in (Path("/var/lib"), Path("/var/backups")):
        if shutil.disk_usage(root).free < 5 * 1024 * 1024 * 1024:
            raise BootstrapError("disk_full", "Less than 5 GiB is available for transactional backup.")
    _validate_network_dependencies(manifest)
    return {
        "release_id": manifest["release_id"],
        "manifest_sha256": manifest_digest,
        "source_tree_sha256": source_digest,
        "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
        "catalogue_sha256": manifest["components"]["model_catalogue"]["sha256"],
        "provider_integrations_sha256": manifest["components"]["provider_integrations"]["sha256"],
        "credential_groups_present": credentials,
        "provider_keys_required": False,
        "network_dependencies": "hermes-source-vendored",
        "zulip": "absent",
        "enrollment_resume": enrollment_resume is not None,
        "rollback_finalize_resume": bool(
            enrollment_resume is not None
            and enrollment_resume.get("phase")
            == PREPRODUCTION_ROLLBACK_AUDIT_PHASE
        ),
        "operation_mode": "corrective" if corrective_context is not None else "fresh",
        **(
            {
                "recovery_from_release_id": CORRECTIVE_PREDECESSOR["release_id"],
                "corrective_resume": corrective_context["kind"] != "new",
            }
            if corrective_context is not None
            else {}
        ),
    }


def _display_release(preflight: dict[str, Any]) -> None:
    print("\nBootstrap local one-shot — release revue")
    print(f"Release: {preflight['release_id']}")
    print(f"Helper SHA-256: {preflight['bootstrap_helper_sha256']}")
