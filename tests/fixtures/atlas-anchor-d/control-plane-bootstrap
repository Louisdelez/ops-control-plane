def _validate_corrective_transaction_marker_identity(
    transaction: dict[str, Any], marker: dict[str, Any]
) -> None:
    _validate_corrective_transaction(transaction)
    initial = marker["initial_transaction"]
    if any(
        transaction.get(key) != initial.get(key)
        for key in (
            "corrective_id", "operation_mode", "consumed_at",
            "recovery_from_release_id", "release_id", "source_tree_sha256",
            "atlas_rpm_sha256", "hermes_source_archive_sha256",
            "bootstrap_helper_sha256", "manifest_sha256",
            "history_path", "predecessor_marker_sha256",
            "predecessor_transaction_sha256", "predecessor_audit_sha256",
            "predecessor_audit_tail_sha256", "successor_consumed_sha256",
        )
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective mutable WAL identity differs."
        )


def _validate_corrective_transaction_successor(
    current: dict[str, Any], successor: dict[str, Any]
) -> None:
    _validate_corrective_transaction(current)
    _validate_corrective_transaction(successor)
    mutable = {
        "status", "phase", "completed_at", "updated_at",
        *CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS,
    }
    immutable = set(current) - mutable
    if (
        set(successor) != set(current)
        or any(successor[key] != current[key] for key in immutable)
        or _corrective_transaction_progress_rank(successor)
        != _corrective_transaction_progress_rank(current) + 1
        or successor["updated_at"] < current["updated_at"]
        or (
            successor["completed_at"] is not None
            and successor["completed_at"] > successor["updated_at"]
        )
    ):
        raise BootstrapError(
            "corrective_state_invalid",
            "The staged corrective WAL is not the exact next durable state.",
        )


def _read_corrective_wal_frontier(
    marker: dict[str, Any], *, promote_staging: bool
) -> dict[str, Any] | None:
    """Read, and optionally finish, the sole deterministic WAL replacement."""

    try:
        names = {entry.name for entry in os.scandir(CORRECTIVE_STATE_ROOT)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective WAL root is unreadable."
        ) from exc
    allowed = {
        CORRECTIVE_TRANSACTION_PATH.name,
        CORRECTIVE_TRANSACTION_STAGING_PATH.name,
    }
    if not names.issubset(allowed):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective WAL root contains foreign entries."
        )
    primary_present = CORRECTIVE_TRANSACTION_PATH.name in names
    staging_present = CORRECTIVE_TRANSACTION_STAGING_PATH.name in names
    if not primary_present:
        if staging_present:
            raise BootstrapError(
                "corrective_state_invalid",
                "A corrective WAL staging inode exists without its durable predecessor.",
            )
        return None
    current = _exact_json_document(
        _read_exact_root_file(CORRECTIVE_TRANSACTION_PATH, 256 * 1024, 0o600)
    )
    _validate_corrective_transaction_marker_identity(current, marker)
    if not staging_present:
        return current
    successor = _exact_json_document(
        _read_exact_root_file(
            CORRECTIVE_TRANSACTION_STAGING_PATH, 256 * 1024, 0o600
        )
    )
    _validate_corrective_transaction_marker_identity(successor, marker)
    _validate_corrective_transaction_successor(current, successor)
    if promote_staging:
        try:
            os.replace(
                CORRECTIVE_TRANSACTION_STAGING_PATH, CORRECTIVE_TRANSACTION_PATH
            )
            _fsync_directory(CORRECTIVE_STATE_ROOT)
        except OSError as exc:
            raise BootstrapError(
                "write_failed", "The staged corrective WAL could not be committed."
            ) from exc
    return successor


def _replace_durable_wal(
    path: Path, staging_path: Path, payload: bytes
) -> None:
    """Atomically replace a root-owned WAL without a random named tempfile.

    The new inode remains unnamed until fully written and fsynced.  Its only
    possible crash residue is the caller-selected staging name, published and
    directory-fsynced before rename.  Each WAL reader binds that name and inode
    to the exact durable predecessor before it can finish the rename.
    """

    state_root = path.parent
    _validate_root_directory(state_root, 0o700)
    if (
        staging_path.parent != state_root
        or staging_path == path
        or os.path.lexists(staging_path)
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "A durable WAL staging conflict exists."
        )
    parent_fd = os.open(
        state_root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    )
    descriptor = -1
    staging_published = False
    try:
        try:
            descriptor = os.open(
                state_root,
                os.O_WRONLY | os.O_TMPFILE | os.O_CLOEXEC,
                0o600,
            )
        except OSError as exc:
            raise BootstrapError(
                "write_failed", "The corrective WAL filesystem lacks O_TMPFILE."
            ) from exc
        os.fchmod(descriptor, 0o600)
        os.fchown(descriptor, 0, 0)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError(
                    "write_failed", "The corrective WAL write was incomplete."
                )
            view = view[written:]
        os.fsync(descriptor)
        libc = ctypes.CDLL(None, use_errno=True)
        linkat = libc.linkat
        linkat.argtypes = [
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
            ctypes.c_int,
        ]
        linkat.restype = ctypes.c_int
        if linkat(
            descriptor,
            b"",
            parent_fd,
            os.fsencode(staging_path.name),
            0x1000,  # AT_EMPTY_PATH
        ) != 0:
            observed_errno = ctypes.get_errno()
            if observed_errno == errno.EEXIST:
                raise BootstrapError(
                    "bootstrap_state_conflict", "A durable WAL staging conflict exists."
                )
            raise BootstrapError(
                "write_failed", "The corrective WAL staging inode could not be published."
            )
        staging_published = True
        os.fsync(parent_fd)
        os.replace(staging_path, path)
        staging_published = False
        os.fsync(parent_fd)
    except OSError as exc:
        # Deliberately retain a published staging inode.  The next recovery
        # validates it as the exact next WAL state before completing the rename.
        raise BootstrapError(
            "write_failed", "The corrective WAL replacement failed."
        ) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_fd)
        # This is documentary: no unlink belongs here.  An unnamed failed write
        # vanishes on close; a published one is durable recovery evidence.
        _ = staging_published


def _materialize_corrective_state(marker: dict[str, Any]) -> dict[str, Any]:
    initial = marker["initial_transaction"]
    if not os.path.lexists(CORRECTIVE_STATE_ROOT):
        CORRECTIVE_STATE_ROOT.mkdir(mode=0o700, exist_ok=False)
        os.chown(CORRECTIVE_STATE_ROOT, 0, 0)
        os.chmod(CORRECTIVE_STATE_ROOT, 0o700)
        _fsync_directory(CORRECTIVE_STATE_ROOT.parent)
    _validate_root_directory(CORRECTIVE_STATE_ROOT, 0o700)
    transaction = _read_corrective_wal_frontier(marker, promote_staging=True)
    if transaction is None:
        try:
            _exclusive_atomic_bytes(
                CORRECTIVE_TRANSACTION_PATH, _canonical(initial) + b"\n", 0o600
            )
        except BootstrapError:
            if not os.path.lexists(CORRECTIVE_TRANSACTION_PATH):
                raise
        transaction = _read_corrective_wal_frontier(
            marker, promote_staging=True
        )
    if transaction is None:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective WAL could not be materialized."
        )
    return transaction


def _read_corrective_transaction_readonly(marker: dict[str, Any]) -> dict[str, Any]:
    root_present = os.path.lexists(CORRECTIVE_STATE_ROOT)
    transaction_present = os.path.lexists(CORRECTIVE_TRANSACTION_PATH)
    if not root_present and not transaction_present:
        return dict(marker["initial_transaction"])
    if not root_present:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective mutable WAL is incomplete."
        )
    _validate_root_directory(CORRECTIVE_STATE_ROOT, 0o700)
    transaction = _read_corrective_wal_frontier(
        marker, promote_staging=False
    )
    return transaction or dict(marker["initial_transaction"])


def _set_corrective_transaction(
    transaction: dict[str, Any], **changes: Any
) -> None:
    if set(changes) - set(transaction):
        raise BootstrapError(
            "corrective_state_invalid", "A corrective WAL update is undeclared."
        )
    successor = dict(transaction)
    successor.update(changes)
    successor["updated_at"] = max(
        int(time.time()), int(transaction["updated_at"])
    )
    _validate_corrective_transaction_successor(transaction, successor)
    _replace_durable_wal(
        CORRECTIVE_TRANSACTION_PATH,
        CORRECTIVE_TRANSACTION_STAGING_PATH,
        _canonical(successor) + b"\n",
    )
    transaction.clear()
    transaction.update(successor)


def _publish_exact_once(path: Path, payload: bytes, mode: int) -> None:
    if not os.path.lexists(path):
        try:
            _exclusive_atomic_bytes(path, payload, mode)
        except BootstrapError:
            if not os.path.lexists(path):
                raise
    observed = _read_exact_root_file(path, max(len(payload), 1) + 1024, mode)
    if not hmac.compare_digest(observed, payload):
        raise BootstrapError(
            "corrective_state_invalid", "A corrective handoff publication conflicts."
        )


def _rename_noreplace(source: Path, destination: Path) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise BootstrapError(
            "corrective_state_invalid", "Atomic no-replace rename is unavailable."
        )
    renameat2.argtypes = [
        ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if renameat2(
        -100, os.fsencode(source), -100, os.fsencode(destination), 1
    ) != 0:  # AT_FDCWD, RENAME_NOREPLACE
        observed_errno = ctypes.get_errno()
        if observed_errno == errno.EEXIST:
            raise BootstrapError(
                "corrective_state_invalid", "Corrective archive destination already exists."
            )
        raise BootstrapError(
            "corrective_state_invalid", "Corrective evidence could not be archived atomically."
        )


def _ensure_corrective_history_path(path: Path) -> None:
    if path.parent != CORRECTIVE_HISTORY_ROOT:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective history child is invalid."
        )
    for directory in (CORRECTIVE_HISTORY_ROOT, path):
        if not os.path.lexists(directory):
            directory.mkdir(mode=0o700, exist_ok=False)
            os.chown(directory, 0, 0)
            os.chmod(directory, 0o700)
            _fsync_directory(directory.parent)
        _validate_root_directory(directory, 0o700)
    try:
        root_names = {entry.name for entry in os.scandir(CORRECTIVE_HISTORY_ROOT)}
        attempt_names = {entry.name for entry in os.scandir(path)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive cannot be enumerated."
        ) from exc
    if root_names != {path.name} or not attempt_names.issubset(
        {"consumed.json", "state", "archive.json"}
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive contains foreign entries."
        )
    if os.stat(CORRECTIVE_HISTORY_ROOT).st_dev != os.stat(STATE_ROOT.parent).st_dev:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive is not rename-atomic."
        )


def _archive_predecessor_file(
    source: Path,
    destination: Path,
    expected_sha256: str,
    successor_payload: bytes,
) -> None:
    destination_matches = False
    if os.path.lexists(destination):
        destination_matches = hmac.compare_digest(
            hashlib.sha256(
                _read_exact_root_file(destination, 512 * 1024, 0o600)
            ).hexdigest(),
            expected_sha256,
        )
        if not destination_matches:
            raise BootstrapError(
                "corrective_state_invalid", "The archived predecessor marker differs."
            )
    if os.path.lexists(source):
        source_sha = hashlib.sha256(
            _read_exact_root_file(source, 512 * 1024, 0o600)
        ).hexdigest()
        if hmac.compare_digest(source_sha, expected_sha256):
            if destination_matches:
                raise BootstrapError(
                    "corrective_state_invalid", "Duplicate predecessor marker evidence exists."
                )
            _rename_noreplace(source, destination)
            _fsync_directory(source.parent)
            _fsync_directory(destination.parent)
            destination_matches = True
        elif (
            not destination_matches
            or not hmac.compare_digest(
                _read_exact_root_file(source, len(successor_payload) + 1024, 0o600),
                successor_payload,
            )
        ):
            raise BootstrapError(
                "corrective_state_invalid", "The live marker is neither predecessor nor successor."
            )
    if not destination_matches:
        raise BootstrapError(
            "corrective_state_invalid", "The predecessor marker evidence disappeared."
        )


def _archived_state_matches(path: Path, marker: dict[str, Any]) -> bool:
    if not os.path.lexists(path):
        return False
    _validate_root_directory(path, 0o700)
    try:
        names = {entry.name for entry in os.scandir(path)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The archived predecessor state is unreadable."
        ) from exc
    if names != {"transaction.json", "events.jsonl"}:
        raise BootstrapError(
            "corrective_state_invalid", "The archived predecessor state differs."
        )
    transaction_sha = hashlib.sha256(
        _read_exact_root_file(path / "transaction.json", 128 * 1024, 0o600)
    ).hexdigest()
    audit_sha = hashlib.sha256(
        _read_exact_root_file(path / "events.jsonl", 8 * 1024 * 1024, 0o600)
    ).hexdigest()
    return hmac.compare_digest(
        transaction_sha, marker["predecessor_transaction_sha256"]
    ) and hmac.compare_digest(audit_sha, marker["predecessor_audit_sha256"])


def _archive_predecessor_state(
    destination: Path, marker: dict[str, Any]
) -> None:
    destination_matches = _archived_state_matches(destination, marker)
    source_matches = False
    if os.path.lexists(STATE_ROOT):
        try:
            transaction_sha = hashlib.sha256(
                _read_exact_root_file(TRANSACTION_PATH, 128 * 1024, 0o600)
            ).hexdigest()
            audit_sha = hashlib.sha256(
                _read_exact_root_file(AUDIT_PATH, 8 * 1024 * 1024, 0o600)
            ).hexdigest()
            source_matches = hmac.compare_digest(
                transaction_sha, marker["predecessor_transaction_sha256"]
            ) and hmac.compare_digest(audit_sha, marker["predecessor_audit_sha256"])
        except BootstrapError:
            source_matches = False
    if source_matches:
        if destination_matches:
            raise BootstrapError(
                "corrective_state_invalid", "Duplicate predecessor state evidence exists."
            )
        _rename_noreplace(STATE_ROOT, destination)
        _fsync_directory(STATE_ROOT.parent)
        _fsync_directory(destination.parent)
        destination_matches = _archived_state_matches(destination, marker)
    elif os.path.lexists(STATE_ROOT):
        if not destination_matches:
            raise BootstrapError(
                "corrective_state_invalid", "The live bootstrap state is unrecognized."
            )
        _validate_root_directory(STATE_ROOT, 0o700)
        try:
            names = {entry.name for entry in os.scandir(STATE_ROOT)}
        except OSError as exc:
            raise BootstrapError(
                "corrective_state_invalid", "The successor state frontier is unreadable."
            ) from exc
        if not names.issubset({TRANSACTION_PATH.name, AUDIT_PATH.name}):
            raise BootstrapError(
                "corrective_state_invalid", "The successor state frontier has extra files."
            )
        successor_transaction = marker["successor_consumed"]["initial_transaction"]
        if TRANSACTION_PATH.name in names and not hmac.compare_digest(
            _read_exact_root_file(TRANSACTION_PATH, 128 * 1024, 0o600),
            _canonical(successor_transaction) + b"\n",
        ):
            raise BootstrapError(
                "corrective_state_invalid", "The successor transaction frontier differs."
            )
        if AUDIT_PATH.name in names and not hmac.compare_digest(
            _read_exact_root_file(AUDIT_PATH, 8 * 1024 * 1024, 0o600),
            _successor_audit_bytes(marker, destination),
        ):
            raise BootstrapError(
                "corrective_state_invalid", "The successor audit frontier differs."
            )
    if not destination_matches:
        raise BootstrapError(
            "corrective_state_invalid", "The predecessor state evidence disappeared."
        )


def _successor_audit_bytes(marker: dict[str, Any], archived_state: Path) -> bytes:
    prior, records, tail = _read_exact_audit(archived_state / "events.jsonl")
    if (
        hashlib.sha256(prior).hexdigest() != marker["predecessor_audit_sha256"]
        or tail != marker["predecessor_audit_tail_sha256"]
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The archived audit anchor differs."
        )
    archive_record = _audit_record(
        "bootstrap_corrective_archived",
        marker["release_id"],
        marker["consumed_at"],
        tail,
        {
            "corrective_id": marker["corrective_id"],
            "recovery_from_release_id": marker["recovery_from_release_id"],
            "history_path": marker["history_path"],
            "predecessor_marker_sha256": marker["predecessor_marker_sha256"],
        },
    )
    consumed_record = _audit_record(
        "bootstrap_consumed",
        marker["release_id"],
        marker["consumed_at"],
        archive_record["record_sha256"],
        {
            "physical_uid": marker["physical_uid"],
            "physical_session": marker["physical_session"],
            "operation_mode": "corrective",
            "recovery_from_release_id": marker["recovery_from_release_id"],
        },
    )
    return prior + _canonical(archive_record) + b"\n" + _canonical(consumed_record) + b"\n"


def _validate_completed_corrective_history_inventory(history: Path) -> None:
    """Bind terminal evidence to the sole reviewed archive namespace."""

    _validate_root_directory(CORRECTIVE_HISTORY_ROOT, 0o700)
    try:
        root_names = {entry.name for entry in os.scandir(CORRECTIVE_HISTORY_ROOT)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective history root is unreadable."
        ) from exc
    if history.parent != CORRECTIVE_HISTORY_ROOT or root_names != {history.name}:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective history inventory differs."
        )
    _validate_root_directory(history, 0o700)
    try:
        attempt_names = {entry.name for entry in os.scandir(history)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive is unreadable."
        ) from exc
    if attempt_names != {"consumed.json", "state", "archive.json"}:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive inventory differs."
        )


def _validate_completed_corrective_handoff(
    marker: dict[str, Any], transaction: dict[str, Any]
) -> dict[str, Any]:
    if transaction.get("status") != "completed":
        raise BootstrapError(
            "corrective_state_invalid", "The corrective handoff is not terminal."
        )
    history = Path(marker["history_path"])
    _validate_completed_corrective_history_inventory(history)
    archived_marker = _read_exact_root_file(
        history / "consumed.json", 512 * 1024, 0o600
    )
    if hashlib.sha256(archived_marker).hexdigest() != marker["predecessor_marker_sha256"]:
        raise BootstrapError(
            "corrective_state_invalid", "The archived predecessor marker differs."
        )
    if not _archived_state_matches(history / "state", marker):
        raise BootstrapError(
            "corrective_state_invalid", "The archived predecessor state differs."
        )
    archive_raw = _read_exact_root_file(history / "archive.json", 256 * 1024, 0o600)
    if not hmac.compare_digest(
        archive_raw, _canonical(marker["archive_manifest"]) + b"\n"
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive record differs."
        )
    successor_raw = _canonical(marker["successor_consumed"]) + b"\n"
    if not hmac.compare_digest(
        _read_exact_root_file(CONSUMED_PATH, len(successor_raw) + 1024, 0o600),
        successor_raw,
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The successor consumed marker differs."
        )
    _validate_root_directory(STATE_ROOT, 0o700)
    try:
        state_names = {entry.name for entry in os.scandir(STATE_ROOT)}
    except OSError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The successor state cannot be enumerated."
        ) from exc
    transaction_staging = _standard_transaction_staging_candidates()
    successor_transaction = _read_standard_transaction_frontier(
        promote_staging=False
    )
    if successor_transaction is None:
        raise BootstrapError(
            "corrective_state_invalid", "The successor transaction is absent."
        )
    escrow_staging = _validate_escrow_staging_frontier_readonly(
        successor_transaction
    )
    allowed_state_names = {
        TRANSACTION_PATH.name, AUDIT_PATH.name, PROOF_PATH.name, APPROVER_PATH.name,
        ROOT_TOKEN_ESCROW.name, OPENBAO_UNDO_ESCROW.name,
        USERPASS_PASSWORD_ESCROW.name,
        *(path.name for path in transaction_staging),
        *(path.name for path in escrow_staging),
    }
    if (
        not {TRANSACTION_PATH.name, AUDIT_PATH.name}.issubset(state_names)
        or not state_names.issubset(allowed_state_names)
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The successor state inventory differs."
        )
    _read_consumed_identity_at(CONSUMED_PATH, successor_transaction)
    live_audit, _complete_audit, _records, _tail, _partial = (
        _read_audit_partial_frontier(AUDIT_PATH)
    )
    expected_prefix = _successor_audit_bytes(marker, history / "state")
    if not live_audit.startswith(expected_prefix):
        raise BootstrapError(
            "corrective_state_invalid", "The successor audit does not preserve its archive link."
        )
    return successor_transaction


def _reconcile_corrective_handoff(marker: dict[str, Any]) -> dict[str, Any]:
    """Replay every post-marker rename/publication without erasing evidence."""

    _validate_corrective_marker_document(marker)
    transaction = _materialize_corrective_state(marker)
    if transaction.get("status") == "completed":
        _validate_completed_corrective_handoff(marker, transaction)
        _reconcile_audit_partial_frontier()
        if _read_audit_partial_frontier(AUDIT_PATH)[-1]:
            raise BootstrapError(
                "corrective_state_invalid", "The successor audit tail remains incomplete."
            )
        return _validate_completed_corrective_handoff(marker, transaction)
    history = Path(marker["history_path"])
    _ensure_corrective_history_path(history)
    archived_marker = history / "consumed.json"
    archived_state = history / "state"
    _archive_predecessor_file(
        CONSUMED_PATH,
        archived_marker,
        marker["predecessor_marker_sha256"],
        _canonical(marker["successor_consumed"]) + b"\n",
    )
    if transaction["predecessor_marker_archived"] is not True:
        _set_corrective_transaction(
            transaction,
            predecessor_marker_archived=True,
            phase="predecessor-marker-archived",
        )
    _archive_predecessor_state(archived_state, marker)
    if transaction["predecessor_state_archived"] is not True:
        _set_corrective_transaction(
            transaction,
            predecessor_state_archived=True,
            phase="predecessor-state-archived",
        )
    _publish_exact_once(
        history / "archive.json",
        _canonical(marker["archive_manifest"]) + b"\n",
        0o600,
    )
    if transaction["archive_manifest_published"] is not True:
        _set_corrective_transaction(
            transaction,
            archive_manifest_published=True,
            phase="archive-manifest-published",
        )
    successor = marker["successor_consumed"]
    initial = successor["initial_transaction"]
    if not os.path.lexists(STATE_ROOT):
        STATE_ROOT.mkdir(mode=0o700, exist_ok=False)
        os.chown(STATE_ROOT, 0, 0)
        os.chmod(STATE_ROOT, 0o700)
        _fsync_directory(STATE_ROOT.parent)
    _validate_root_directory(STATE_ROOT, 0o700)
    _publish_exact_once(
        TRANSACTION_PATH, _canonical(initial) + b"\n", 0o600
    )
    if transaction["successor_state_materialized"] is not True:
        _set_corrective_transaction(
            transaction,
            successor_state_materialized=True,
            phase="successor-state-materialized",
        )
    _publish_exact_once(
        AUDIT_PATH, _successor_audit_bytes(marker, archived_state), 0o600
    )
    if transaction["successor_audit_published"] is not True:
        _set_corrective_transaction(
            transaction,
            successor_audit_published=True,
            phase="successor-audit-published",
        )
    _publish_exact_once(
        CONSUMED_PATH, _canonical(successor) + b"\n", 0o600
    )
    if transaction["successor_marker_published"] is not True:
        _set_corrective_transaction(
            transaction,
            successor_marker_published=True,
            phase="successor-marker-published",
        )
    if transaction["status"] != "completed":
        completed_at = int(time.time())
        _set_corrective_transaction(
            transaction,
            status="completed",
            phase="completed",
            completed_at=completed_at,
            predecessor_marker_archived=True,
            predecessor_state_archived=True,
            archive_manifest_published=True,
            successor_state_materialized=True,
            successor_audit_published=True,
            successor_marker_published=True,
        )
    return initial


def _consume_corrective_exception(
    marker: dict[str, Any], helper_sha256: str
) -> dict[str, Any]:
    """Publish the sole corrective authority only after its watcher is durable."""

    _validate_corrective_marker_document(marker)
    _validate_corrective_scaffold(helper_sha256, require_active_path=True)
    _exclusive_atomic_bytes(
        CORRECTIVE_CONSUMED_PATH, _canonical(marker) + b"\n", 0o600
    )
    _activate_corrective_recovery_service(helper_sha256)
    return _reconcile_corrective_handoff(marker)


def _acquire_corrective_recovery_lock(
    timeout: float = 21_300.0,
    *,
    wait_validator: Callable[[], None] | None = None,
) -> int:
    lock_path = Path("/run/lock/ops-control-plane-deployment.lock")
    descriptor = os.open(
        lock_path, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600
    )
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return descriptor
        except OSError as exc:
            if exc.errno not in {errno.EACCES, errno.EAGAIN}:
                os.close(descriptor)
                raise
            if time.monotonic() >= deadline:
                os.close(descriptor)
                raise BootstrapError(
                    "bootstrap_busy", "Corrective recovery could not acquire the deployment lock."
                ) from exc
            if wait_validator is not None:
                wait_validator()
            time.sleep(0.25)


def _standard_recovery_enablement(unit: str) -> tuple[Path, Path]:
    expected_target = Path("/etc/systemd/system") / unit
    for link, target in RECOVERY_ENABLEMENT_LINKS.items():
        if target == expected_target:
            return link, target
    raise BootstrapError(
        "recovery_unsafe", "The standard recovery unit is outside the reviewed set."
    )


def _validate_standard_recovery_unit_bytes(
    marker: dict[str, Any],
    transaction: dict[str, Any],
    unit: str,
) -> Path:
    """Bind one installed recovery fragment to the root-owned staged release."""

    if unit not in {RECOVERY_UNITS[1], RECOVERY_JANITOR_UNIT}:
        raise BootstrapError(
            "recovery_unsafe", "The requested standard recovery unit differs."
        )
    release = _direct_root_child(
        transaction.get("staged_release"),
        DEPLOYMENT_RELEASES_ROOT,
        location="staged release",
    )
    if release.name != transaction.get("release_id"):
        raise BootstrapError(
            "recovery_unsafe", "The staged standard recovery release differs."
        )
    release_info = os.lstat(release)
    if (
        not stat.S_ISDIR(release_info.st_mode)
        or stat.S_ISLNK(release_info.st_mode)
        or release_info.st_uid != 0
        or release_info.st_gid != 0
        or stat.S_IMODE(release_info.st_mode) & 0o022
    ):
        raise BootstrapError(
            "recovery_unsafe", "The staged standard recovery release is unsafe."
        )
    staged_tree = release / "tree"
    staged_digest, _worker = _independent_source_digest(
        staged_tree, require_root_owned=True
    )
    if not hmac.compare_digest(
        staged_digest, str(transaction.get("source_tree_sha256"))
    ):
        raise BootstrapError(
            "recovery_unsafe", "The staged standard recovery tree differs."
        )
    installed_helper = _read_exact_root_file(
        INSTALLED_HELPER, 4 * 1024 * 1024, 0o700
    )
    staged_helper = _read_exact_root_file(
        staged_tree / "deploy/control-plane/bin/control-plane-bootstrap",
        4 * 1024 * 1024,
        0o755,
    )
    if (
        not hmac.compare_digest(installed_helper, staged_helper)
        or not hmac.compare_digest(
            hashlib.sha256(installed_helper).hexdigest(),
            marker["bootstrap_helper_sha256"],
        )
    ):
        raise BootstrapError(
            "recovery_unsafe", "The installed standard recovery helper differs."
        )
    _link, installed_unit = _standard_recovery_enablement(unit)
    staged_unit = staged_tree / "deploy/control-plane/systemd" / unit
    if not hmac.compare_digest(
        _read_exact_root_file(installed_unit, 256 * 1024, 0o644),
        _read_exact_root_file(staged_unit, 256 * 1024, 0o644),
    ):
        raise BootstrapError(
            "recovery_unsafe", "The installed standard recovery unit differs."
        )
    return installed_unit


def _validate_standard_recovery_handoff_anchor(
    marker: dict[str, Any],
    transaction: dict[str, Any],
    unit: str,
) -> None:
    """Bind an enabled PID 1 recovery job to the staged release bytes."""

    installed_unit = _validate_standard_recovery_unit_bytes(
        marker, transaction, unit
    )
    link, expected_target = _standard_recovery_enablement(unit)
    if expected_target != installed_unit:
        raise BootstrapError(
            "recovery_unsafe", "The standard recovery target differs."
        )
    _validate_enablement_link(link, installed_unit)
    global_dropin = _read_exact_root_file(
        SYSTEMD_GLOBAL_SERVICE_DROPIN, 256 * 1024, 0o644
    )
    properties = _strict_systemctl_properties(unit)
    if (
        hashlib.sha256(global_dropin).hexdigest()
        != SYSTEMD_GLOBAL_SERVICE_DROPIN_SHA256
        or properties.get("LoadState") != "loaded"
        or properties.get("FragmentPath") != str(installed_unit)
        or properties.get("DropInPaths") != str(SYSTEMD_GLOBAL_SERVICE_DROPIN)
        or properties.get("UnitFileState") != "enabled"
        or properties.get("ActiveState")
        not in {"inactive", "failed", "activating", "active"}
    ):
        raise BootstrapError(
            "recovery_unsafe", "PID 1 standard recovery identity differs."
        )


def _terminal_standard_recovery_is_clean(
    transaction: dict[str, Any],
) -> bool:
    if (
        transaction.get("recovery_guard_installing") is not False
        or transaction.get("recovery_guard_installed") is not False
        or any(os.path.lexists(path) for path in RECOVERY_ASSETS[1:4])
        or any(os.path.lexists(path) for path in RECOVERY_BARRIER_ASSETS)
        or any(os.path.lexists(path) for path in RECOVERY_ENABLEMENT_LINKS)
    ):
        return False
    if transaction.get("status") == "completed":
        if transaction.get("phase") != "completed" or not os.path.lexists(
            PUBLIC_INSTALLED_PROOF_PATH
        ):
            return False
        return _read_public_installed_proof() == _expected_public_installed_proof(
            transaction
        )
    if transaction.get("status") == "rolled-back":
        return (
            transaction.get("phase") == "rolled-back"
            and not os.path.lexists(PUBLIC_INSTALLED_PROOF_PATH)
        )
    return False


def _standard_recovery_handoff_unit(
    marker: dict[str, Any], transaction: dict[str, Any]
) -> str | None:
    """Select no job only for the exact GUI-resumable or fully-clean frontier."""

    _validate_transaction_document(transaction)
    safe_enrollment = _transaction_matches_safe_enrollment_frontier(
        transaction,
        release_id=marker["release_id"],
        source_tree_sha256=marker["source_tree_sha256"],
        atlas_rpm_sha256=marker["atlas_rpm_sha256"],
        hermes_source_archive_sha256=marker["hermes_source_archive_sha256"],
    )
    rollback_finalize_pending = (
        safe_enrollment
        and transaction.get("phase") == PREPRODUCTION_ROLLBACK_AUDIT_PHASE
    )
    if safe_enrollment and not rollback_finalize_pending:
        return None
    terminal = transaction.get("status") in {"completed", "rolled-back"}
    if terminal:
        if _terminal_standard_recovery_is_clean(transaction):
            return None
        candidates = (RECOVERY_UNITS[1], RECOVERY_JANITOR_UNIT)
    elif rollback_finalize_pending:
        # The pending record means rollback has already entered its durable,
        # secretless audit-finalization protocol.  If the dependency-free
        # supervisor or corrective watcher is alive, hand this exact frontier
        # to the full recovery service instead of waiting for another GUI
        # launch.  recovery_entry has a dedicated branch which performs no
        # worker, provisioning, secret or managed-service operation.
        candidates = (RECOVERY_UNITS[1],)
    elif (
        transaction.get("status") in {"running", "rollback-failed", "activation-pending"}
        and transaction.get("recovery_guard_installing") is False
        and transaction.get("recovery_guard_installed") is True
    ):
        candidates = (RECOVERY_UNITS[1],)
    else:
        raise BootstrapError(
            "recovery_unsafe", "The successor has no reviewed recovery handoff."
        )
    for unit in candidates:
        link, target = _standard_recovery_enablement(unit)
        link_present = os.path.lexists(link)
        target_present = os.path.lexists(target)
        if link_present and not target_present:
            raise BootstrapError(
                "recovery_unsafe", "A standard recovery anchor is partial."
            )
        if target_present and not link_present:
            if not terminal:
                raise BootstrapError(
                    "recovery_unsafe", "A standard recovery anchor is partial."
                )
            # Cleanup disables the primary link before removing its reviewed
            # fragment.  Authenticate that exact target-only crash frontier,
            # then continue to the still-enabled janitor.
            _validate_standard_recovery_unit_bytes(marker, transaction, unit)
            continue
        if link_present:
            _validate_standard_recovery_handoff_anchor(marker, transaction, unit)
            return unit
    raise BootstrapError(
        "recovery_unsafe", "No durable standard recovery trigger remains."
    )


def _start_standard_recovery_handoff(unit: str) -> None:
    commands = (
        (["/usr/bin/systemctl", "reset-failed", unit], 60),
        # Do not let the transient supervisor report success merely because a
        # recovery job was queued.  A synchronous start propagates a killed or
        # failed oneshot back to Restart=on-failure on the supervisor; the two
        # durable standard units also retry independently until they succeed.
        (["/usr/bin/systemctl", "start", unit], 6 * 60 * 60 + 10 * 60),
    )
    for command, timeout in commands:
        completed = subprocess.run(
            command,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
        if completed.returncode != 0:
            raise BootstrapError(
                "recovery_failed", "PID 1 could not queue standard recovery."
            )


def _standard_recovery_supervisor_state() -> str:
    names = (
        "LoadState", "ActiveState", "UnitFileState", "FragmentPath",
        "DropInPaths", "Transient", "Type", "Description", "User", "Group",
        "SubState", "MainPID",
    )
    completed = subprocess.run(
        [
            "/usr/bin/systemctl", "show", STANDARD_RECOVERY_SUPERVISOR_UNIT,
            *(f"--property={name}" for name in names),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    try:
        properties = dict(
            line.split("=", 1)
            for line in completed.stdout.decode("utf-8", errors="strict").splitlines()
            if "=" in line
        )
    except (UnicodeError, ValueError) as exc:
        raise BootstrapError(
            "recovery_guard_failed", "The recovery supervisor identity is invalid."
        ) from exc
    if properties.get("LoadState") == "not-found":
        if completed.returncode in {0, 4}:
            return "absent"
        raise BootstrapError(
            "recovery_guard_failed", "The recovery supervisor lookup failed."
        )
    expected = {
        "LoadState": "loaded",
        "UnitFileState": "transient",
        "FragmentPath": f"/run/systemd/transient/{STANDARD_RECOVERY_SUPERVISOR_UNIT}",
        "DropInPaths": str(SYSTEMD_GLOBAL_SERVICE_DROPIN),
        "Transient": "yes",
        "Type": "exec",
        "Description": STANDARD_RECOVERY_SUPERVISOR_DESCRIPTION,
        "User": "root",
        "Group": "root",
    }
    active_state = properties.get("ActiveState")
    if (
        completed.returncode != 0
        or set(properties) != set(names)
        or any(properties.get(key) != value for key, value in expected.items())
        or active_state not in {"activating", "active"}
    ):
        raise BootstrapError(
            "recovery_guard_failed", "The recovery supervisor identity differs."
        )
    if active_state == "activating":
        return "starting"
    raw_pid = properties.get("MainPID", "")
    if (
        properties.get("SubState") != "running"
        or not raw_pid.isdigit()
        or int(raw_pid) <= 1
        or not _standard_recovery_supervisor_process_is_exact(int(raw_pid))
    ):
        raise BootstrapError(
            "recovery_guard_failed", "The recovery supervisor process differs."
        )
    return "active"


def _standard_recovery_supervisor_process_is_exact(pid: int) -> bool:
    process_root = Path(f"/proc/{pid}")
    try:
        cmdline_raw = (process_root / "cmdline").read_bytes()
        status = (process_root / "status").read_text(
            encoding="ascii", errors="strict"
        )
        cgroup = (process_root / "cgroup").read_text(
            encoding="ascii", errors="strict"
        )
        python_info = os.stat("/usr/bin/python3")
        executable_info = os.stat(process_root / "exe")
    except (OSError, UnicodeError):
        return False
    expected_cmdline = b"\0".join(
        (
            b"/usr/bin/python3",
            b"-I",
            str(INSTALLED_HELPER).encode("utf-8"),
            b"--recover-supervise",
            b"",
        )
    )
    uid_match = re.search(
        r"(?m)^Uid:\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*$", status
    )
    expected_cgroup = f"/system.slice/{STANDARD_RECOVERY_SUPERVISOR_UNIT}"
    return (
        len(cmdline_raw) <= 4096
        and hmac.compare_digest(cmdline_raw, expected_cmdline)
        and uid_match is not None
        and all(int(value) == 0 for value in uid_match.groups())
        and any(line.endswith(expected_cgroup) for line in cgroup.splitlines())
        and stat.S_ISREG(python_info.st_mode)
        and python_info.st_uid == 0
        and stat.S_IMODE(python_info.st_mode) & 0o022 == 0
        and executable_info.st_dev == python_info.st_dev
        and executable_info.st_ino == python_info.st_ino
    )


def _start_standard_recovery_supervisor(transaction: dict[str, Any]) -> None:
    """Start a dependency-free transient lock waiter for this boot."""

    consumed = _read_consumed_identity(transaction)
    _validate_standard_recovery_handoff_anchor(
        consumed, transaction, RECOVERY_UNITS[1]
    )
    if _standard_recovery_supervisor_state() in {"active", "starting"}:
        return
    command = [
        "/usr/bin/systemd-run",
        "--quiet",
        "--no-block",
        "--collect",
        f"--unit={STANDARD_RECOVERY_SUPERVISOR_UNIT}",
        f"--description={STANDARD_RECOVERY_SUPERVISOR_DESCRIPTION}",
        "--service-type=exec",
        "--uid=root",
        "--gid=root",
        "--property=UMask=0077",
        "--property=Restart=on-failure",
        "--property=RestartSec=5s",
        # Cover the maximum 5h55 lock wait plus one bounded 6h10 recovery
        # handoff, with margin for PID 1 scheduling and validation.
        "--property=RuntimeMaxSec=13h",
        "--property=TimeoutStopSec=30s",
        "--property=KillMode=mixed",
        "--property=LimitCORE=0",
        "--property=NoNewPrivileges=yes",
        "--property=PrivateDevices=yes",
        "--property=PrivateNetwork=yes",
        "--property=PrivateTmp=yes",
        "--property=ProtectClock=yes",
        "--property=ProtectControlGroups=yes",
        "--property=ProtectHome=yes",
        "--property=ProtectHostname=yes",
        "--property=ProtectKernelLogs=yes",
        "--property=ProtectKernelModules=yes",
        "--property=ProtectKernelTunables=yes",
        "--property=ProtectSystem=strict",
        "--property=ReadWritePaths=/run/lock",
        "--property=RestrictAddressFamilies=AF_UNIX",
        "--property=RestrictNamespaces=yes",
        "--property=RestrictRealtime=yes",
        "--property=RestrictSUIDSGID=yes",
        "--property=SystemCallArchitectures=native",
        "--property=LockPersonality=yes",
        "--property=MemoryDenyWriteExecute=yes",
        str(INSTALLED_HELPER),
        "--recover-supervise",
    ]
    completed = subprocess.run(
        command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
    )
    if completed.returncode != 0:
        raise BootstrapError(
            "recovery_guard_failed",
            "PID 1 could not start the standard recovery supervisor.",
        )


def _wait_standard_recovery_supervisor(timeout: float = 5.0) -> None:
    """Prove the current-boot recovery job is waiting before production work."""

    deadline = time.monotonic() + timeout
    while True:
        try:
            state = _standard_recovery_supervisor_state()
        except BootstrapError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.05)
            continue
        if state == "active":
            return
        if time.monotonic() >= deadline:
            raise BootstrapError(
                "recovery_guard_failed",
                "The standard recovery supervisor did not become active.",
            )
        time.sleep(0.05)


def corrective_recovery_entry() -> int:
    global ACTIVE_DEPLOYMENT_LOCK_FD
    if os.geteuid() != 0:
        raise BootstrapError(
            "permission_denied", "Corrective recovery must run as root."
        )
    if not os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        return 0
    marker = _read_corrective_marker()
    if not hmac.compare_digest(
        _independent_regular_sha256(
            CORRECTIVE_RECOVERY_HELPER, maximum=4 * 1024 * 1024
        ),
        marker["bootstrap_helper_sha256"],
    ):
        raise BootstrapError(
            "corrective_scaffold_conflict", "The corrective recovery helper differs."
        )
    expected_marker = _canonical(marker)

    def validate_wait_frontier() -> None:
        if not hmac.compare_digest(
            _canonical(_read_corrective_marker()), expected_marker
        ):
            raise BootstrapError(
                "corrective_state_invalid",
                "The corrective marker changed while recovery waited.",
            )

    lock = _acquire_corrective_recovery_lock(
        wait_validator=validate_wait_frontier
    )
    ACTIVE_DEPLOYMENT_LOCK_FD = lock
    recovery_unit: str | None = None
    try:
        marker = _read_corrective_marker()
        successor = _reconcile_corrective_handoff(marker)
        if successor.get("phase") == PREPRODUCTION_ROLLBACK_AUDIT_PHASE:
            # The corrective watcher is itself the durable, reviewed root
            # recovery anchor.  Finalize this pre-production rollback here so
            # it remains automatic even when the standard guard was only
            # partially installed and therefore has no startable main unit.
            if not _preproduction_corrector_frontier_is_unchanged(successor):
                raise BootstrapError(
                    "recovery_unsafe",
                    "The corrective pre-production rollback frontier changed.",
                )
            _validate_preproduction_recovery_scaffold_readonly(successor)
            _finalize_rollback_transaction(successor, preproduction=True)
            _cleanup_recovery_guard(successor)
        elif (
            successor.get("status") == "rolled-back"
            and successor.get("phase") == "rolled-back"
        ):
            # A crash after the terminal rollback WAL but before recovery
            # scaffold cleanup must not depend on a standard unit link which
            # may itself be the interrupted cleanup frontier.  Authenticate
            # every remaining old/new byte, require the exact terminal audit,
            # then replay only idempotent authority/proof cleanup.
            _validate_preproduction_recovery_scaffold_readonly(successor)
            _append_rollback_audit_exact_once(successor)
            _cleanup_recovery_guard(successor)
        else:
            recovery_unit = _standard_recovery_handoff_unit(marker, successor)
    finally:
        ACTIVE_DEPLOYMENT_LOCK_FD = None
        os.close(lock)
    if recovery_unit is not None:
        # systemd recovery must acquire the same deployment lock.  Never queue
        # it while this corrector still owns that lock or it can fail busy
        # before observing the handoff transaction.
        _start_standard_recovery_handoff(recovery_unit)
    return 0


def standard_recovery_supervisor_entry() -> int:
    """Wait outside the dependency graph, then hand off crash recovery."""

    global ACTIVE_DEPLOYMENT_LOCK_FD
    if os.geteuid() != 0 or Path(__file__) != INSTALLED_HELPER:
        raise BootstrapError(
            "permission_denied", "Standard recovery supervision must use its root helper."
        )
    helper_info = os.lstat(INSTALLED_HELPER)
    current_info = os.stat(Path(__file__))
    if (
        not stat.S_ISREG(helper_info.st_mode)
        or stat.S_ISLNK(helper_info.st_mode)
        or helper_info.st_uid != 0
        or helper_info.st_gid != 0
        or stat.S_IMODE(helper_info.st_mode) != 0o700
        or helper_info.st_nlink != 1
        or current_info.st_dev != helper_info.st_dev
        or current_info.st_ino != helper_info.st_ino
    ):
        raise BootstrapError(
            "recovery_unsafe", "The standard recovery supervisor helper is unsafe."
        )
    expected_consumed_raw = _read_exact_root_file(
        CONSUMED_PATH, 128 * 1024, 0o600
    )
    consumed = _exact_json_document(expected_consumed_raw)
    if not hmac.compare_digest(
        expected_consumed_raw, _canonical(consumed) + b"\n"
    ):
        raise BootstrapError(
            "recovery_unsafe", "The supervised consumed marker is not canonical."
        )

    def validate_wait_frontier() -> None:
        # The WAL is intentionally mutable under the lock holder.  Scanning
        # its staging slot here would race a valid atomic rename, so only the
        # immutable one-shot marker is revalidated until flock is acquired.
        if not hmac.compare_digest(
            _read_exact_root_file(CONSUMED_PATH, 128 * 1024, 0o600),
            expected_consumed_raw,
        ):
            raise BootstrapError(
                "recovery_unsafe",
                "The supervised bootstrap identity changed while waiting.",
            )

    lock = _acquire_corrective_recovery_lock(
        wait_validator=validate_wait_frontier
    )
    ACTIVE_DEPLOYMENT_LOCK_FD = lock
    recovery_unit: str | None = None
    try:
        # The transient supervisor is sandboxed read-only except for the lock.
        # A hash-bound staged WAL already represents the verified successor;
        # the queued standard recovery service promotes it under its own lock.
        transaction = _read_standard_transaction_frontier(promote_staging=False)
        if transaction is None or not hmac.compare_digest(
            _canonical(_read_consumed_identity(transaction)), _canonical(consumed)
        ):
            raise BootstrapError(
                "recovery_unsafe", "The supervised bootstrap handoff changed."
            )
        recovery_unit = _standard_recovery_handoff_unit(consumed, transaction)
    finally:
        ACTIVE_DEPLOYMENT_LOCK_FD = None
        os.close(lock)
    if recovery_unit is not None:
        _start_standard_recovery_handoff(recovery_unit)
    return 0


def _review_corrective_retry(
    manifest: dict[str, Any],
    source_digest: str,
    manifest_digest: str,
    helper_sha256: str,
) -> dict[str, Any]:
    """Recognize either the sole eligible .10 state or its same consumed repair."""

    _validate_corrective_authority()
    if (
        manifest.get("release_id") != CORRECTIVE_TARGET_RELEASE_ID
        or source_digest != manifest.get("source", {}).get("tree_sha256")
        or manifest_digest == CORRECTIVE_PREDECESSOR["manifest_sha256"]
        or not SHA256_RE.fullmatch(manifest_digest)
        or not SHA256_RE.fullmatch(helper_sha256)
    ):
        raise BootstrapError(
            "corrective_target_invalid", "The corrective target identity differs."
        )
    if not os.path.lexists(CORRECTIVE_CONSUMED_PATH):
        return {
            "kind": "new",
            "predecessor": _review_corrective_predecessor(manifest),
            "marker": None,
            "enrollment_resume": None,
        }
    marker = _read_corrective_marker()
    if any(
        marker.get(key) != expected
        for key, expected in (
            ("release_id", manifest["release_id"]),
            ("source_tree_sha256", source_digest),
            ("atlas_rpm_sha256", manifest["artifacts"]["atlas_rpm"]["sha256"]),
            (
                "hermes_source_archive_sha256",
                manifest["artifacts"]["hermes_source_archive"]["sha256"],
            ),
            ("bootstrap_helper_sha256", helper_sha256),
            ("manifest_sha256", manifest_digest),
        )
    ):
        raise BootstrapError(
            "corrective_consumed", "A different corrective attempt is already consumed."
        )
    transaction = _read_corrective_transaction_readonly(marker)
    enrollment_resume: dict[str, Any] | None = None
    if transaction.get("status") == "completed":
        successor_transaction = _validate_completed_corrective_handoff(
            marker, transaction
        )
        if successor_transaction.get("status") == "completed" or (
            successor_transaction.get("status") == "rolled-back"
            and _terminal_standard_recovery_is_clean(successor_transaction)
        ):
            raise BootstrapError(
                "corrective_consumed", "The sole corrective transaction is terminal."
            )
        try:
            enrollment_resume = _review_enrollment_resume(
                manifest,
                source_digest,
                manifest_digest,
                helper_sha256,
                allow_corrective_successor=True,
            )
        except BootstrapError as exc:
            raise BootstrapError(
                "corrective_consumed",
                "The corrective successor is past its safe credential-resume boundary.",
            ) from exc
    return {
        "kind": "resume" if enrollment_resume is not None else "handoff",
        "predecessor": None,
        "marker": marker,
        "enrollment_resume": enrollment_resume,
    }


def _classify_gui_recovery_mode(
    manifest: dict[str, Any],
    source_digest: str,
    manifest_digest: str,
    helper_sha256: str,
) -> tuple[str, dict[str, Any] | None, dict[str, Any] | None]:
    """Classify the disjoint reviewed recovery states without mutating them.

    The neutral GUI operation is intentionally not a third authorization
    mode.  Root must prove exactly one of: the sole .10 corrective state (or
    its already-consumed successor), or an existing safe fresh .11 enrollment.
    An untouched host, foreign state, and any ambiguous double match fail
    closed.
    """

    candidates: list[
        tuple[str, dict[str, Any] | None, dict[str, Any] | None]
    ] = []
    try:
        corrective = _review_corrective_retry(
            manifest, source_digest, manifest_digest, helper_sha256
        )
    except BootstrapError:
        corrective = None
    if corrective is not None:
        candidates.append(
            ("corrective", corrective, corrective["enrollment_resume"])
        )
    try:
        fresh = _review_enrollment_resume(
            manifest, source_digest, manifest_digest, helper_sha256
        )
    except BootstrapError:
        fresh = None
    if fresh is not None:
        candidates.append(("fresh", None, fresh))
    if len(candidates) != 1:
        raise BootstrapError(
            "recovery_state_unrecognized",
            "The local bootstrap state has no unique reviewed recovery mode.",
        )
    return candidates[0]


