def _validate_complete_audit_payload(
    raw: bytes,
) -> tuple[bytes, list[dict[str, Any]], str]:
    if not raw.endswith(b"\n"):
        raise BootstrapError(
            "bootstrap_state_conflict", "The audit has an incomplete record."
        )
    records: list[dict[str, Any]] = []
    previous = "0" * 64
    for line in raw.splitlines():
        try:
            record = json.loads(line)
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise BootstrapError(
                "bootstrap_state_conflict", "The predecessor audit is invalid."
            ) from exc
        expected = {
            "schema_version", "timestamp", "event", "release_id", "actor",
            "previous_sha256", "record_sha256",
        }
        if isinstance(record, dict) and "details" in record:
            expected.add("details")
        unsigned = dict(record) if isinstance(record, dict) else {}
        observed = unsigned.pop("record_sha256", None)
        calculated = hashlib.sha256(_canonical(unsigned)).hexdigest()
        if (
            not isinstance(record, dict)
            or set(record) != expected
            or line != _canonical(record)
            or record.get("schema_version") != 1
            or isinstance(record.get("timestamp"), bool)
            or not isinstance(record.get("timestamp"), int)
            or record["timestamp"] <= 0
            or record.get("actor") != "codex-supervised"
            or record.get("previous_sha256") != previous
            or not isinstance(observed, str)
            or not hmac.compare_digest(observed, calculated)
            or ("details" in record and not isinstance(record["details"], dict))
        ):
            raise BootstrapError(
                "bootstrap_state_conflict", "The predecessor audit chain differs."
            )
        records.append(record)
        previous = observed
    if not records:
        raise BootstrapError(
            "bootstrap_state_conflict", "The predecessor audit chain is empty."
        )
    return raw, records, previous


def _read_exact_audit(path: Path) -> tuple[bytes, list[dict[str, Any]], str]:
    """Validate an audit chain without truncating or otherwise changing evidence."""

    raw = _read_exact_root_file(path, 8 * 1024 * 1024, 0o600)
    return _validate_complete_audit_payload(raw)


def _read_stable_audit_file(path: Path) -> bytes:
    """Read the audit inode while permitting only its first-write empty state."""

    return _read_exact_root_file(
        path, 8 * 1024 * 1024, 0o600, allow_empty=True
    )


def _read_audit_partial_frontier(
    path: Path,
) -> tuple[bytes, bytes, list[dict[str, Any]], str, bytes]:
    """Accept only one bounded prefix of the final append record."""

    raw = _read_stable_audit_file(path)
    if not raw:
        return raw, b"", [], "0" * 64, b""
    if raw.endswith(b"\n"):
        complete, records, tail = _validate_complete_audit_payload(raw)
        return raw, complete, records, tail, b""
    boundary = raw.rfind(b"\n") + 1
    complete = raw[:boundary]
    partial = raw[boundary:]
    header = b'{"actor":"codex-supervised"'
    if (
        not partial
        or len(partial) > 64 * 1024
        or not partial.isascii()
        or any(byte < 0x20 or byte > 0x7E for byte in partial)
        or not (
            header.startswith(partial)
            if len(partial) <= len(header)
            else partial.startswith(header)
        )
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "The audit append frontier is invalid."
        )
    if complete:
        complete, records, tail = _validate_complete_audit_payload(complete)
    else:
        # A crash during the very first O_APPEND write has no committed
        # record before its canonical prefix.  Only the strict prefix checks
        # above make this zero-record frontier repairable.
        records = []
        tail = "0" * 64
    return raw, complete, records, tail, partial


def _reconcile_audit_partial_frontier() -> None:
    raw, complete, _records, _tail, partial = _read_audit_partial_frontier(
        AUDIT_PATH
    )
    if not partial:
        return
    descriptor = os.open(AUDIT_PATH, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
            or metadata.st_size != len(raw)
        ):
            raise BootstrapError(
                "bootstrap_state_conflict", "The audit append frontier changed."
            )
        os.ftruncate(descriptor, len(complete))
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _fsync_directory(AUDIT_PATH.parent)


def _corrective_predecessor_is_terminal(transaction: dict[str, Any]) -> None:
    _validate_corrective_predecessor_transaction_document(transaction)
    false_flags = (
        "openbao_restore_required", "root_token_escrowed",
        "root_generation_pending", "root_remint_required",
        "root_attempt_closed", "root_reconciliation_complete",
        "recovery_guard_installing", "recovery_guard_installed",
        "openbao_runtime_dir_created", "approver_state_created",
        "openbao_undo_escrowed", "openbao_undo_write_started",
        "openbao_poststate_recorded",
        "openbao_undo_started", "openbao_provisioning_started",
        "password_recovery_started", "password_recovery_persists",
        "userpass_password_escrowed", "userpass_finalized",
    )
    if (
        transaction.get("status") != "rolled-back"
        or transaction.get("phase") != "rolled-back"
        or transaction.get("release_id") != CORRECTIVE_PREDECESSOR["release_id"]
        or transaction.get("source_tree_sha256")
        != CORRECTIVE_PREDECESSOR["source_tree_sha256"]
        or transaction.get("atlas_rpm_sha256")
        != CORRECTIVE_PREDECESSOR["atlas_rpm_sha256"]
        or transaction.get("deployment_backup") is not None
        or transaction.get("openbao_backup") is not None
        or transaction.get("openbao_backup_sha256") is not None
        or transaction.get("root_generation_started_at") is not None
        or transaction.get("root_generation_remints") != 0
        or transaction.get("root_final_share_windows") != []
        or transaction.get("recovery_activation_units") != []
        or transaction.get("openbao_undo_complete") is not True
        or any(transaction.get(field) is not False for field in false_flags)
        or transaction.get("proof") is not None
        or transaction.get("completed_at") is not None
        or isinstance(transaction.get("rolled_back_at"), bool)
        or not isinstance(transaction.get("rolled_back_at"), int)
        or transaction["rolled_back_at"] <= 0
        or transaction.get("credentials_before")
        != {name: False for name in CREDENTIAL_GROUPS}
    ):
        raise BootstrapError(
            "corrective_predecessor_invalid",
            "The prior bootstrap is not the exact reviewed terminal rollback.",
        )


