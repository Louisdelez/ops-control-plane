def _read_consumed_identity_at_mode(
    path: Path,
    transaction: dict[str, Any],
    *,
    legacy_predecessor: bool,
) -> dict[str, Any]:
    """Shared closed validator selected only by the two schema-specific readers."""

    document = _exact_json_document(
        _read_exact_root_file(path, 128 * 1024, 0o600)
    )
    expected_fields = {
        "schema_version", "consumed", "consumed_at", "actor", "physical_uid",
        "physical_session", "release_id", "source_tree_sha256", "atlas_rpm_sha256",
        "hermes_source_archive_sha256",
        "bootstrap_helper_sha256", "manifest_sha256", "initial_transaction",
    }
    if legacy_predecessor:
        expected_fields.remove("hermes_source_archive_sha256")
    try:
        louis_uid = pwd.getpwnam("ops-user").pw_uid
    except KeyError as exc:
        raise BootstrapError(
            "bootstrap_state_conflict", "The physical owner account is absent."
        ) from exc
    initial = document.get("initial_transaction")
    if not isinstance(initial, dict):
        raise BootstrapError(
            "bootstrap_state_conflict", "The initial bootstrap transaction is absent."
        )
    if legacy_predecessor:
        _validate_corrective_predecessor_transaction_document(initial)
        _validate_corrective_predecessor_transaction_document(transaction)
    else:
        _validate_transaction_document(initial)
    if (
        set(document) != expected_fields
        or document.get("schema_version") != 1
        or document.get("consumed") is not True
        or document.get("actor") != "codex-supervised"
        or isinstance(document.get("consumed_at"), bool)
        or not isinstance(document.get("consumed_at"), int)
        or document["consumed_at"] <= 0
        or document.get("physical_uid") != louis_uid
        or not isinstance(document.get("physical_session"), str)
        or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", document["physical_session"])
        or not isinstance(document.get("release_id"), str)
        or not RELEASE_RE.fullmatch(document["release_id"])
        or not isinstance(document.get("source_tree_sha256"), str)
        or not SHA256_RE.fullmatch(document["source_tree_sha256"])
        or not isinstance(document.get("atlas_rpm_sha256"), str)
        or not SHA256_RE.fullmatch(document["atlas_rpm_sha256"])
        or (
            not legacy_predecessor
            and (
                not isinstance(document.get("hermes_source_archive_sha256"), str)
                or not SHA256_RE.fullmatch(document["hermes_source_archive_sha256"])
            )
        )
        or not isinstance(document.get("bootstrap_helper_sha256"), str)
        or not SHA256_RE.fullmatch(document["bootstrap_helper_sha256"])
        or not isinstance(document.get("manifest_sha256"), str)
        or not SHA256_RE.fullmatch(document["manifest_sha256"])
        or initial.get("status") != "running"
        or initial.get("phase") != "consumed"
        or initial.get("proof") is not None
        or initial.get("completed_at") is not None
        or initial.get("rolled_back_at") is not None
        or initial.get("release_id") != document.get("release_id")
        or initial.get("source_tree_sha256") != document.get("source_tree_sha256")
        or initial.get("atlas_rpm_sha256") != document.get("atlas_rpm_sha256")
        or (
            not legacy_predecessor
            and initial.get("hermes_source_archive_sha256")
            != document.get("hermes_source_archive_sha256")
        )
        or transaction.get("release_id") != document.get("release_id")
        or transaction.get("source_tree_sha256") != document.get("source_tree_sha256")
        or transaction.get("atlas_rpm_sha256") != document.get("atlas_rpm_sha256")
        or (
            not legacy_predecessor
            and transaction.get("hermes_source_archive_sha256")
            != document.get("hermes_source_archive_sha256")
        )
    ):
        raise BootstrapError(
            "bootstrap_state_conflict", "The consumed bootstrap identity differs."
        )
    return document


