CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS = (
    "predecessor_marker_archived",
    "predecessor_state_archived",
    "archive_manifest_published",
    "successor_state_materialized",
    "successor_audit_published",
    "successor_marker_published",
)
CORRECTIVE_TRANSACTION_PROGRESS = (
    ("running", "consumed", frozenset()),
    ("running", "predecessor-marker-archived", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS[:1])),
    ("running", "predecessor-state-archived", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS[:2])),
    ("running", "archive-manifest-published", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS[:3])),
    ("running", "successor-state-materialized", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS[:4])),
    ("running", "successor-audit-published", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS[:5])),
    ("running", "successor-marker-published", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS)),
    ("completed", "completed", frozenset(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS)),
)


def _corrective_transaction_progress_rank(transaction: dict[str, Any]) -> int:
    true_fields = frozenset(
        field
        for field in CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS
        if transaction.get(field) is True
    )
    for rank, (status, phase, expected_true) in enumerate(
        CORRECTIVE_TRANSACTION_PROGRESS
    ):
        if (
            transaction.get("status") == status
            and transaction.get("phase") == phase
            and true_fields == expected_true
        ):
            return rank
    return -1


def _validate_corrective_transaction(transaction: dict[str, Any]) -> None:
    expected = {
        "schema_version", "status", "phase", "corrective_id", "operation_mode",
        "consumed_at", "recovery_from_release_id", "release_id",
        "source_tree_sha256", "atlas_rpm_sha256", "bootstrap_helper_sha256",
        "hermes_source_archive_sha256",
        "manifest_sha256", "history_path", "predecessor_marker_sha256",
        "predecessor_transaction_sha256", "predecessor_audit_sha256",
        "predecessor_audit_tail_sha256", "successor_consumed_sha256",
        "predecessor_marker_archived", "predecessor_state_archived",
        "archive_manifest_published", "successor_state_materialized",
        "successor_audit_published", "successor_marker_published",
        "completed_at", "updated_at",
    }
    boolean_fields = set(CORRECTIVE_TRANSACTION_BOOLEAN_FIELDS)
    if (
        not isinstance(transaction, dict)
        or set(transaction) != expected
        or transaction.get("schema_version") != 1
        or transaction.get("status") not in {"running", "completed"}
        or not isinstance(transaction.get("phase"), str)
        or not re.fullmatch(r"[a-z][a-z0-9-]{2,63}", transaction["phase"])
        or not isinstance(transaction.get("corrective_id"), str)
        or not re.fullmatch(r"corrective-[0-9a-f]{12}", transaction["corrective_id"])
        or transaction.get("operation_mode") != "corrective"
        or transaction.get("recovery_from_release_id")
        != CORRECTIVE_PREDECESSOR["release_id"]
        or transaction.get("release_id") != CORRECTIVE_TARGET_RELEASE_ID
        or any(
            not isinstance(transaction.get(key), str)
            or not SHA256_RE.fullmatch(transaction[key])
            for key in (
                "source_tree_sha256", "atlas_rpm_sha256",
                "hermes_source_archive_sha256",
                "bootstrap_helper_sha256", "manifest_sha256",
                "predecessor_marker_sha256", "predecessor_transaction_sha256",
                "predecessor_audit_sha256", "predecessor_audit_tail_sha256",
                "successor_consumed_sha256",
            )
        )
        or any(not isinstance(transaction.get(key), bool) for key in boolean_fields)
        or isinstance(transaction.get("consumed_at"), bool)
        or not isinstance(transaction.get("consumed_at"), int)
        or transaction["consumed_at"] <= 0
        or isinstance(transaction.get("updated_at"), bool)
        or isinstance(transaction.get("updated_at"), bool)
        or not isinstance(transaction.get("updated_at"), int)
        or transaction["updated_at"] <= 0
        or transaction["updated_at"] < transaction["consumed_at"]
        or _corrective_transaction_progress_rank(transaction) < 0
        or (
            transaction.get("status") == "completed"
            and (
                not all(transaction[key] for key in boolean_fields)
                or isinstance(transaction.get("completed_at"), bool)
                or not isinstance(transaction.get("completed_at"), int)
                or transaction["completed_at"] < transaction["consumed_at"]
            )
        )
        or (
            transaction.get("status") == "running"
            and transaction.get("completed_at") is not None
        )
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective transaction WAL differs."
        )
    expected_history = CORRECTIVE_HISTORY_ROOT / transaction["corrective_id"]
    if transaction.get("history_path") != str(expected_history):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive path differs."
        )


def _validate_corrective_marker_document(marker: dict[str, Any]) -> None:
    expected = {
        "schema_version", "consumed", "consumed_at", "actor", "physical_uid",
        "physical_session", "operation_mode", "corrective_id",
        "recovery_from_release_id", "recovery_from_source_tree_sha256",
        "recovery_from_atlas_rpm_sha256",
        "recovery_from_bootstrap_helper_sha256",
        "recovery_from_manifest_sha256", "release_id", "source_tree_sha256",
        "atlas_rpm_sha256", "bootstrap_helper_sha256", "manifest_sha256",
        "hermes_source_archive_sha256",
        "history_path", "predecessor_marker_sha256",
        "predecessor_transaction_sha256", "predecessor_audit_sha256",
        "predecessor_audit_tail_sha256", "initial_transaction",
        "successor_consumed", "archive_manifest",
    }
    if (
        not isinstance(marker, dict)
        or set(marker) != expected
        or marker.get("schema_version") != 1
        or marker.get("consumed") is not True
        or marker.get("actor") != "codex-supervised"
        or marker.get("operation_mode") != "corrective"
        or marker.get("release_id") != CORRECTIVE_TARGET_RELEASE_ID
        or any(
            marker.get(f"recovery_from_{key}") != value
            for key, value in CORRECTIVE_PREDECESSOR.items()
        )
        or isinstance(marker.get("consumed_at"), bool)
        or not isinstance(marker.get("consumed_at"), int)
        or marker["consumed_at"] <= 0
        or isinstance(marker.get("physical_uid"), bool)
        or not isinstance(marker.get("physical_uid"), int)
        or marker["physical_uid"] < 0
        or not isinstance(marker.get("physical_session"), str)
        or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", marker["physical_session"])
        or any(
            not isinstance(marker.get(key), str)
            or not SHA256_RE.fullmatch(marker[key])
            for key in (
                "source_tree_sha256", "atlas_rpm_sha256",
                "hermes_source_archive_sha256",
                "bootstrap_helper_sha256", "manifest_sha256",
                "predecessor_marker_sha256", "predecessor_transaction_sha256",
                "predecessor_audit_sha256", "predecessor_audit_tail_sha256",
            )
        )
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective consumed marker differs."
        )
    try:
        louis_uid = pwd.getpwnam("ops-user").pw_uid
    except KeyError as exc:
        raise BootstrapError(
            "corrective_state_invalid", "The physical owner account is absent."
        ) from exc
    if marker["physical_uid"] != louis_uid:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective physical owner differs."
        )
    suffix = _corrective_suffix_for_identity(
        release_id=marker["release_id"],
        helper_sha256=marker["bootstrap_helper_sha256"],
        manifest_sha256=marker["manifest_sha256"],
        source_sha256=marker["source_tree_sha256"],
        hermes_source_archive_sha256=marker["hermes_source_archive_sha256"],
    )
    if (
        marker.get("corrective_id") != f"corrective-{suffix}"
        or marker.get("history_path")
        != str(CORRECTIVE_HISTORY_ROOT / f"corrective-{suffix}")
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective attempt identity differs."
        )
    transaction = marker.get("initial_transaction")
    _validate_corrective_transaction(transaction)
    successor = marker.get("successor_consumed")
    if not isinstance(successor, dict):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective successor WAL is absent."
        )
    successor_keys = {
        "schema_version", "consumed", "consumed_at", "actor", "physical_uid",
        "physical_session", "release_id", "source_tree_sha256",
        "atlas_rpm_sha256", "hermes_source_archive_sha256",
        "bootstrap_helper_sha256", "manifest_sha256",
        "initial_transaction",
    }
    initial = successor.get("initial_transaction")
    if not isinstance(initial, dict):
        raise BootstrapError(
            "corrective_state_invalid", "The successor transaction is absent."
        )
    _validate_transaction_document(initial)
    if (
        set(successor) != successor_keys
        or successor.get("schema_version") != 1
        or successor.get("consumed") is not True
        or successor.get("consumed_at") != marker["consumed_at"]
        or successor.get("actor") != "codex-supervised"
        or successor.get("physical_uid") != marker["physical_uid"]
        or successor.get("physical_session") != marker["physical_session"]
        or any(
            successor.get(key) != marker[key]
            for key in (
                "release_id", "source_tree_sha256", "atlas_rpm_sha256",
                "hermes_source_archive_sha256",
                "bootstrap_helper_sha256", "manifest_sha256",
            )
        )
        or initial.get("status") != "running"
        or initial.get("phase") != "consumed"
        or any(
            initial.get(key) != marker[key]
            for key in (
                "release_id", "source_tree_sha256", "atlas_rpm_sha256",
                "hermes_source_archive_sha256",
            )
        )
        or transaction.get("corrective_id") != marker["corrective_id"]
        or transaction.get("consumed_at") != marker["consumed_at"]
        or transaction.get("history_path") != marker["history_path"]
        or any(
            transaction.get(key) != marker[key]
            for key in (
                "release_id", "source_tree_sha256", "atlas_rpm_sha256",
                "hermes_source_archive_sha256",
                "bootstrap_helper_sha256", "manifest_sha256",
                "predecessor_marker_sha256", "predecessor_transaction_sha256",
                "predecessor_audit_sha256", "predecessor_audit_tail_sha256",
            )
        )
        or transaction.get("successor_consumed_sha256")
        != hashlib.sha256(_canonical(successor) + b"\n").hexdigest()
    ):
        raise BootstrapError(
            "corrective_state_invalid", "The corrective successor identity differs."
        )
    archive = marker.get("archive_manifest")
    archive_expected = {
        "schema_version": 1,
        "corrective_id": marker["corrective_id"],
        "operation_mode": "corrective",
        "archived_at": marker["consumed_at"],
        **{
            f"recovery_from_{key}": value
            for key, value in CORRECTIVE_PREDECESSOR.items()
        },
        "release_id": marker["release_id"],
        "predecessor_marker_sha256": marker["predecessor_marker_sha256"],
        "predecessor_transaction_sha256": marker["predecessor_transaction_sha256"],
        "predecessor_audit_sha256": marker["predecessor_audit_sha256"],
        "predecessor_audit_tail_sha256": marker["predecessor_audit_tail_sha256"],
        "original_consumed_path": str(CONSUMED_PATH),
        "original_state_path": str(STATE_ROOT),
        "archived_consumed_path": str(Path(marker["history_path"]) / "consumed.json"),
        "archived_state_path": str(Path(marker["history_path"]) / "state"),
    }
    if archive != archive_expected:
        raise BootstrapError(
            "corrective_state_invalid", "The corrective archive manifest differs."
        )


