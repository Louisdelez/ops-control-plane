def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _atomic_bytes(
    path: Path,
    payload: bytes,
    mode: int = 0o600,
    *,
    uid: int = 0,
    gid: int = 0,
) -> None:
    before = os.lstat(path.parent)
    if (
        not stat.S_ISDIR(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_uid != 0
        or stat.S_IMODE(before.st_mode) & 0o022
    ):
        raise BootstrapError("unsafe_state", "A bootstrap state directory is unsafe.")
    descriptor, raw_temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(raw_temporary)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, uid, gid)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError("write_failed", "A durable bootstrap write was incomplete.")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def _atomic_json(path: Path, document: dict[str, Any], mode: int = 0o600) -> None:
    _atomic_bytes(path, _canonical(document) + b"\n", mode)


def _exclusive_atomic_bytes(path: Path, payload: bytes, mode: int = 0o600) -> None:
    """Publish a fully-fsynced unnamed inode exactly once.

    The one-shot marker cannot be written in place: SIGKILL or power loss
    during that first write would permanently consume the exception with a
    truncated JSON document. Linux O_TMPFILE plus linkat(AT_EMPTY_PATH)
    publishes either the complete fsynced WAL or no name at all.
    """

    parent_info = os.lstat(path.parent)
    if (
        not stat.S_ISDIR(parent_info.st_mode) or stat.S_ISLNK(parent_info.st_mode)
        or parent_info.st_uid != 0 or stat.S_IMODE(parent_info.st_mode) & 0o022
    ):
        raise BootstrapError("unsafe_state", "The one-shot marker parent is unsafe.")
    parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                path.parent,
                os.O_WRONLY | os.O_TMPFILE | os.O_CLOEXEC,
                mode,
            )
        except OSError as exc:
            raise BootstrapError(
                "write_failed", "The filesystem cannot atomically publish the one-shot WAL."
            ) from exc
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, 0, 0)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise BootstrapError("write_failed", "The one-shot WAL write was incomplete.")
            view = view[written:]
        os.fsync(descriptor)
        libc = ctypes.CDLL(None, use_errno=True)
        linkat = libc.linkat
        linkat.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
        linkat.restype = ctypes.c_int
        if linkat(descriptor, b"", parent_fd, os.fsencode(path.name), 0x1000) != 0:  # AT_EMPTY_PATH
            observed_errno = ctypes.get_errno()
            if observed_errno == errno.EEXIST:
                raise BootstrapError(
                    "bootstrap_consumed", "The one-shot bootstrap capability is already consumed."
                )
            raise BootstrapError("write_failed", "The one-shot WAL could not be published.")
        os.fsync(parent_fd)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_fd)


def _read_root_file(path: Path, maximum: int, *, private: bool) -> bytes:
    try:
        before = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError("file_unavailable", f"A required local file is unavailable: {path.name}") from exc
    try:
        opened = os.fstat(descriptor)
        forbidden = 0o077 if private else 0o022
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != 0
            or stat.S_IMODE(opened.st_mode) & forbidden
            or opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or opened.st_size > maximum
        ):
            raise BootstrapError("file_unsafe", f"A required local file is unsafe: {path.name}")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        if len(raw) > maximum:
            raise BootstrapError("file_unsafe", f"A required local file is oversized: {path.name}")
        return raw
    finally:
        os.close(descriptor)


def _read_json(path: Path, maximum: int = 128 * 1024) -> dict[str, Any]:
    try:
        value = json.loads(_read_root_file(path, maximum, private=True))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise BootstrapError("state_invalid", "A durable bootstrap document is invalid.") from exc
    if not isinstance(value, dict):
        raise BootstrapError("state_invalid", "A durable bootstrap document is invalid.")
    return value


def _read_exact_root_file(
    path: Path, maximum: int, mode: int, *, allow_empty: bool = False
) -> bytes:
    """Read one root-owned inode and reject path/content replacement races."""

    try:
        before = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise BootstrapError(
            "bootstrap_state_conflict", "A bootstrap identity file is unavailable."
        ) from exc
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or stat.S_ISLNK(before.st_mode)
            or before.st_uid != 0
            or before.st_gid != 0
            or stat.S_IMODE(before.st_mode) != mode
            or before.st_nlink != 1
            or before.st_size < 0
            or (before.st_size == 0 and not allow_empty)
            or before.st_size > maximum
            or opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or opened.st_uid != before.st_uid
            or opened.st_gid != before.st_gid
            or opened.st_mode != before.st_mode
            or opened.st_nlink != before.st_nlink
            or opened.st_size != before.st_size
        ):
            raise BootstrapError(
                "bootstrap_state_conflict", "A bootstrap identity file is unsafe."
            )
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        after_fd = os.fstat(descriptor)
        after_path = os.lstat(path)
        stable_fields = (
            "st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_nlink",
            "st_size", "st_mtime_ns", "st_ctime_ns",
        )
        if (
            (not payload and not allow_empty)
            or len(payload) > maximum
            or any(getattr(opened, field) != getattr(after_fd, field) for field in stable_fields)
            or any(getattr(after_fd, field) != getattr(after_path, field) for field in stable_fields)
            or stat.S_ISLNK(after_path.st_mode)
        ):
            raise BootstrapError(
                "bootstrap_state_conflict", "A bootstrap identity file changed while read."
            )
        return payload
    finally:
        os.close(descriptor)


