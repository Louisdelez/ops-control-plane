id: network.publish-zulip.v3
version: 1
project: infra-shared
action_class: C
description: Activer le paquet borné HTTPS zulip.example.org via VPS WireGuard NAS et relais SSH Dell, certificat public et migration locale avec retour arrière
timeout_seconds: 20
command:
  argv: [/usr/bin/sudo, -n, /usr/local/libexec/ops-runbooks/publish-zulip-v3, "{bundle_sha256}"]
parameters:
  bundle_sha256:
    type: enum
    values: [bc5c0b662f0bfe290e938c0ec2d87d0ad68a702dcb2956226e05b6eb27f66c9a]
output:
  max_bytes: 4096
  redact: true
