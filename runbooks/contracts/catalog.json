{
  "schema_version": 1,
  "contracts": [
    {
      "name": "ops.readonly_check.v1",
      "version": 1,
      "description": "Execute une sonde reseau, TLS, HTTP, port ou preuve de backup strictement allowlistee.",
      "project": "monitoring-shared",
      "phase": "observation",
      "action_class": "A",
      "risk": "low",
      "permissions": ["inventory:read", "network:probe-read"],
      "parameters": {"check_id": {"type": "identifier", "required": true}},
      "preconditions": ["inventaire valide", "sonde enabled=true", "invocation explicite avec --probe"],
      "expected_result": ["resultat structure sans secret", "temps de reponse borne", "preuve horodatee"],
      "errors": ["inventory_invalid", "check_disabled", "timeout", "mismatch", "unavailable"],
      "timeout_seconds": 15,
      "max_attempts": 1,
      "idempotency": "lecture seule; aucun effet distant",
      "dry_run": "sans --probe, valide et marque toutes les sondes skipped",
      "rollback": "sans objet"
    },
    {
      "name": "ops.verify_backup_evidence.v1",
      "version": 1,
      "description": "Valide une preuve locale bornee de sauvegarde et d'integrite sans acceder au secret du depot.",
      "project": "backup-shared",
      "phase": "observation",
      "action_class": "A",
      "risk": "low",
      "permissions": ["backup:evidence-read"],
      "parameters": {"check_id": {"type": "identifier", "required": true}},
      "preconditions": ["fichier de preuve allowliste", "fichier regulier non symlink", "age maximum declare"],
      "expected_result": ["snapshot identifie", "status success", "integrity_verified=true"],
      "errors": ["evidence_missing", "evidence_stale", "integrity_unverified", "resource_mismatch"],
      "timeout_seconds": 5,
      "max_attempts": 1,
      "idempotency": "lecture seule",
      "dry_run": "validation du contrat sans lecture de cible",
      "rollback": "sans objet; toute relance est un autre runbook borne"
    },
    {
      "name": "ops.inventory_drift.v1",
      "version": 1,
      "description": "Compare une observation structuree a l'inventaire sans modifier ni supprimer de ressource.",
      "project": "infra-shared",
      "phase": "analysis",
      "action_class": "A",
      "risk": "low",
      "permissions": ["inventory:read", "observation:read"],
      "parameters": {"observation_path": {"type": "local_file", "required": true}},
      "preconditions": ["inventaire valide", "observation horodatee et structuree"],
      "expected_result": ["liste missing/unexpected/mismatch", "inventaire inchange"],
      "errors": ["inventory_invalid", "observation_invalid", "observation_stale"],
      "timeout_seconds": 10,
      "max_attempts": 1,
      "idempotency": "comparaison pure",
      "dry_run": "mode unique; aucune application n'existe",
      "rollback": "sans objet"
    },
    {
      "name": "ops.config_diff.v1",
      "version": 1,
      "description": "Produit un diff redige et valide un candidat local contre une cible de configuration allowlistee.",
      "project": "infra-shared",
      "phase": "observation",
      "action_class": "A",
      "risk": "low",
      "permissions": ["config:read", "candidate:read"],
      "parameters": {
        "target_id": {"type": "identifier", "required": true},
        "candidate_path": {"type": "local_file", "required": true}
      },
      "preconditions": ["cible enabled=true", "chemins allowlistes", "fichiers reguliers", "validateur deterministe connu"],
      "expected_result": ["hash avant/apres", "diff unifie", "valeurs sensibles masquees", "validation syntaxique"],
      "errors": ["target_disabled", "path_escape", "symlink_forbidden", "validation_failed", "file_too_large"],
      "timeout_seconds": 20,
      "max_attempts": 1,
      "idempotency": "lecture seule",
      "dry_run": "toujours; cet outil ne sait pas appliquer",
      "rollback": "sans objet; l'application necessite un contrat de classe C"
    },
    {
      "name": "ops.release_plan.v1",
      "version": 1,
      "description": "Construit un plan de release lie a un artefact versionne et verifie toutes les preconditions sans mutation.",
      "project": "infra-shared",
      "phase": "analysis",
      "action_class": "A",
      "risk": "low",
      "permissions": ["release:read", "inventory:read", "backup:evidence-read"],
      "parameters": {"manifest_path": {"type": "local_file", "required": true}},
      "preconditions": ["target enabled", "artefact dans incoming_root", "SHA-256 exact", "version/commit/build declares", "aucune entree persistante dans l'artefact", "preuve backup fraiche si requise"],
      "expected_result": ["plan_hash stable", "phases observation/analyse/action explicites", "rollback prepare"],
      "errors": ["target_disabled", "checksum_mismatch", "unsafe_archive", "backup_invalid", "insufficient_space"],
      "timeout_seconds": 60,
      "max_attempts": 1,
      "idempotency": "le meme manifest et artefact produisent le meme plan_hash",
      "dry_run": "mode unique",
      "rollback": "version courante capturee dans le plan"
    },
    {
      "name": "ops.deploy_release.v1",
      "version": 1,
      "description": "Stage une archive verifiee, preserve les donnees allowlistees, commute atomiquement puis execute les health checks.",
      "project": "infra-shared",
      "phase": "action",
      "action_class": "C",
      "risk": "high",
      "permissions": ["release:write", "service:bounded-control", "approval:consume"],
      "parameters": {"manifest_path": {"type": "local_file", "required": true}},
      "preconditions": ["plan recalcule identique", "approbation durable liee au plan_hash", "verrou ressource acquis", "rollback connu", "health checks declares", "migration=none"],
      "expected_result": ["release immuable dans releases_root", "lien current commute atomiquement", "persistance intacte", "health checks OK", "audit JSONL"],
      "errors": ["approval_missing", "approval_expired", "resource_locked", "stage_failed", "service_failed", "health_failed", "rollback_failed"],
      "timeout_seconds": 300,
      "max_attempts": 1,
      "idempotency": "release_id+plan_hash deja stage retourne existing; aucun recopiage aveugle",
      "dry_run": "release-plan; apply refuse sans --execute",
      "rollback": "commutation atomique vers la release precedente; automatique seulement si preautorisee"
    },
    {
      "name": "ops.rollback_release.v1",
      "version": 1,
      "description": "Revient vers une release immuable deja connue par commutation atomique et reverifie la sante.",
      "project": "infra-shared",
      "phase": "action",
      "action_class": "C",
      "risk": "high",
      "permissions": ["release:rollback", "service:bounded-control", "approval:consume"],
      "parameters": {
        "target_id": {"type": "identifier", "required": true},
        "release_id": {"type": "identifier", "required": true}
      },
      "preconditions": ["release cible connue et immuable", "metadata plan_hash valide", "approbation ou preautorisation du deploiement", "verrou ressource acquis"],
      "expected_result": ["current pointe sur la release demandee", "services bornes relances", "health checks OK", "audit JSONL"],
      "errors": ["release_unknown", "approval_missing", "resource_locked", "health_failed"],
      "timeout_seconds": 180,
      "max_attempts": 1,
      "idempotency": "si current pointe deja sur la cible, succes sans commutation",
      "dry_run": "plan de rollback sans --execute",
      "rollback": "retour vers la release qui etait courante avant l'operation"
    },
    {
      "name": "ops.retention_apply.v1",
      "version": 1,
      "description": "Met en quarantaine des rapports/logs locaux ages selon une politique allowlistee; aucune suppression directe.",
      "project": "monitoring-shared",
      "phase": "action",
      "action_class": "C",
      "risk": "medium",
      "permissions": ["retention:plan", "retention:quarantine", "approval:consume"],
      "parameters": {"rule_id": {"type": "identifier", "required": true}},
      "preconditions": ["regle enabled=true", "racines absolues allowlistees", "plan lie a l'approbation", "fichiers reguliers non symlink"],
      "expected_result": ["fichiers deplaces vers quarantine_root", "latest conserve", "audit"],
      "errors": ["rule_disabled", "approval_missing", "path_escape", "resource_locked"],
      "timeout_seconds": 60,
      "max_attempts": 1,
      "idempotency": "un fichier deja absent n'est pas retraité",
      "dry_run": "retention-plan obligatoire",
      "rollback": "restauration depuis quarantine_root avant purge separee"
    },
    {
      "name": "ops.skill_validate.v1",
      "version": 1,
      "description": "Valide structure, metadata, tests declares et permissions d'un skill sans l'activer.",
      "project": "infra-shared",
      "phase": "observation",
      "action_class": "A",
      "risk": "low",
      "permissions": ["skill:read", "test-evidence:read"],
      "parameters": {"skill_name": {"type": "identifier", "required": false}},
      "preconditions": ["registre valide", "SKILL.md regulier", "tests declares existants"],
      "expected_result": ["rapport de validation", "aucune promotion automatique"],
      "errors": ["registry_invalid", "skill_missing", "frontmatter_invalid", "tests_missing"],
      "timeout_seconds": 20,
      "max_attempts": 1,
      "idempotency": "validation pure",
      "dry_run": "mode unique",
      "rollback": "sans objet"
    },
    {
      "name": "ops.skill_promote.v1",
      "version": 1,
      "description": "Produit un registre candidat pour une promotion manuelle vers semi-automatique puis automatique sous conditions.",
      "project": "infra-shared",
      "phase": "action",
      "action_class": "C",
      "risk": "high",
      "permissions": ["skill:promote", "permissions:review", "git:review"],
      "parameters": {
        "skill_name": {"type": "identifier", "required": true},
        "target_level": {"type": "enum", "values": ["semi-automatic", "automatic"], "required": true},
        "evidence_path": {"type": "local_file", "required": true}
      },
      "preconditions": ["tests passes", "inspection approuvee", "permissions revues", "commit Git declare", "approbation durable", "seuil d'executions fiables atteint"],
      "expected_result": ["nouveau registre candidat distinct", "diff et review avant installation"],
      "errors": ["invalid_transition", "tests_failed", "review_missing", "insufficient_successes", "failures_present"],
      "timeout_seconds": 20,
      "max_attempts": 1,
      "idempotency": "la meme preuve produit le meme registre candidat",
      "dry_run": "aucune modification du registre source",
      "rollback": "revenir au registre Git precedent"
    }
  ]
}
