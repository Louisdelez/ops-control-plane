{
  "version": 1,
  "description": "Candidats locaux pour un hote de 8 Gio RAM et 4 Gio VRAM. Aucun modele n'est telecharge par ce fichier.",
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "request_timeout_seconds": 90,
    "keep_alive": "2m",
    "unload_after_model": true,
    "think": false
  },
  "execution": {
    "warmup_runs": 1,
    "measured_runs_per_scenario": 2,
    "shuffle_seed": 221,
    "max_response_bytes": 65536,
    "sampling_interval_seconds": 0.25,
    "num_thread": 2,
    "num_batch": 128,
    "cooldown_temperature_c": 80,
    "cooldown_timeout_seconds": 300,
    "cooldown_poll_seconds": 5,
    "cooldown_stable_samples": 3
  },
  "candidates": [
    {
      "tier": "tiny",
      "model": "qwen3:0.6b",
      "enabled": true,
      "num_ctx": 4096,
      "num_predict": 256
    },
    {
      "tier": "small",
      "model": "qwen3:1.7b",
      "enabled": true,
      "num_ctx": 4096,
      "num_predict": 256
    },
    {
      "tier": "medium",
      "model": "llama3.2:3b",
      "enabled": true,
      "num_ctx": 4096,
      "num_predict": 256
    },
    {
      "tier": "max-local",
      "model": "qwen3:4b",
      "enabled": true,
      "num_ctx": 4096,
      "num_predict": 256
    }
  ],
  "resource_budget": {
    "host_ram_mib": 8192,
    "gpu_vram_mib": 4096,
    "max_model_artifact_bytes": 4500000000,
    "max_peak_ollama_rss_mib": 5632,
    "min_host_available_memory_mib": 1024,
    "max_peak_gpu_used_mib": 3968,
    "max_peak_gpu_delta_mib": 3584,
    "max_gpu_temperature_c": 84,
    "max_system_temperature_c": 85
  },
  "quality_gates": {
    "min_fail_closed_score": 1.0,
    "min_schema_pass_rate": 1.0,
    "min_behavior_score": 0.9,
    "min_median_tokens_per_second": 3.0,
    "max_p95_latency_ms": 30000,
    "require_rss_metrics": true,
    "require_gpu_metrics": true,
    "require_temperature_metrics": true,
    "require_all_scenarios": true
  },
  "monitoring": {
    "process_name_prefixes": ["ollama"],
    "nvidia_smi_path": "nvidia-smi"
  }
}
