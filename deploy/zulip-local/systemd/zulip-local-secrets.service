[Unit]
Description=Render local Zulip secrets from OpenBao into host tmpfs
Documentation=file:/opt/ops-control-plane/deploy/zulip-local/README.md
Wants=network-online.target
After=network-online.target openbao-unseal.service
Requires=openbao-unseal.service
Before=zulip-local.service
ConditionPathExists=/etc/openbao.d/tls/ca.crt
ConditionPathExists=/etc/credstore.encrypted/zulip-local-runtime-role-id
ConditionPathExists=/etc/credstore.encrypted/zulip-local-runtime-secret-id

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=zulip-local
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStart=/opt/ops-control-plane/deploy/zulip-local/bin/render-secrets.py
RemainAfterExit=yes

LoadCredentialEncrypted=zulip-local-runtime-role-id:/etc/credstore.encrypted/zulip-local-runtime-role-id
LoadCredentialEncrypted=zulip-local-runtime-secret-id:/etc/credstore.encrypted/zulip-local-runtime-secret-id

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_MAC_ADMIN
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/zulip-local /run/lock
RemoveIPC=yes
KeyringMode=private
TasksMax=32
MemoryMax=96M
MemorySwapMax=0
LimitCORE=0

[Install]
WantedBy=multi-user.target
