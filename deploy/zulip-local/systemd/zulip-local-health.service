[Unit]
Description=Health check for local Zulip HTTPS and Compose services
Documentation=file:/opt/ops-control-plane/deploy/zulip-local/README.md
After=zulip-local.service
Requisite=zulip-local.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ops-control-plane/deploy/zulip-local/bin/health.sh --quiet --periodic
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
