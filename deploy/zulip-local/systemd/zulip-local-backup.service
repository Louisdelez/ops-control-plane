[Unit]
Description=Create an encrypted snapshot of the local Zulip deployment
Documentation=file:/opt/ops-control-plane/deploy/zulip-local/README.md
After=zulip-local.service
Requisite=zulip-local.service
ConditionPathExists=/etc/openbao.d/recovery.age-recipient

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ops-control-plane/deploy/zulip-local/bin/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/zulip-local /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
LimitCORE=0
TimeoutStartSec=2h
