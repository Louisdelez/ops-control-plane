  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "nonnegativeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "positiveCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:~_-]{0,127}$"
    }
  }
