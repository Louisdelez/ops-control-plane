                  ],
                  "properties": {
                    "token_prices_not_officially_verified": {
                      "$ref": "#/$defs/positiveCount"
                    },
                    "quarantined": {
                      "$ref": "#/$defs/positiveCount"
                    },
                    "exact_model_id_unverified": {
                      "$ref": "#/$defs/positiveCount"
                    },
                    "minimax_m3_chat_api_contract_unverified": {
                      "$ref": "#/$defs/positiveCount"
                    }
                  }
                }
              }
            }
          }
        },
        "provider_integrations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "revision",
            "sha256",
            "provider_accounts"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "revision": {
              "$ref": "#/$defs/identifier"
            },
            "sha256": {
