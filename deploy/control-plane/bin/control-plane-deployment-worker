SHA256_RE = re.compile(r"\A[0-9a-f]{64}\Z")
GIT_COMMIT_RE = re.compile(r"\A[0-9a-f]{40}\Z")
IDENTIFIER_RE = re.compile(r"\A[a-z0-9][a-z0-9._-]{1,127}\Z")
VERSION_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9.+:~_-]{0,127}\Z")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
ACCOUNT_RE = re.compile(r"\A[A-Za-z_][A-Za-z0-9_.-]{0,63}\Z")

