        or atlas["payload_executable_sha256"]
        != bootstrap_gui["atlas_payload_sha256"]
        or bootstrap_gui["atlas_payload_member"] != ATLAS_PAYLOAD_MEMBER
        or atlas["name"] != "modeles-ia"
        or atlas["initial_state"] != "absent"
        or atlas["signed"] is not False
        or atlas["architecture"] != "x86_64"
    ):
        raise DeploymentError("manifest_invalid", "Atlas package identity differs from review")
    _version(atlas["version"], "artifacts.atlas_rpm.version")
    _version(atlas["release"], "artifacts.atlas_rpm.release")

    components = _mapping(document["components"], "components")
    _exact_keys(
        components,
        {
            "atlas",
            "orchestrator",
            "hermes",
            "zulip_bridge",
            "zulip",
            "model_catalogue",
            "provider_integrations",
        },
        "components",
    )
    for name in ("atlas", "orchestrator", "zulip_bridge"):
        item = _mapping(components[name], f"components.{name}")
        _exact_keys(item, {"version", "mode"}, f"components.{name}")
        _version(item["version"], f"components.{name}.version")
    hermes_component = _mapping(components["hermes"], "components.hermes")
    if hermes_component.get("commit") != hermes_archive["commit"]:
        raise DeploymentError(
            "manifest_invalid", "Hermes component and source archive commits differ"
        )
    if components["orchestrator"]["mode"] != "api-first":
        raise DeploymentError("manifest_invalid", "local model inference is forbidden")
    if components["atlas"]["mode"] != "desktop-local":
        raise DeploymentError("manifest_invalid", "Atlas mode differs from review")
    if components["zulip_bridge"]["mode"] != "local-only":
        raise DeploymentError("manifest_invalid", "Zulip bridge mode differs from review")

    hermes = _mapping(components["hermes"], "components.hermes")
    _exact_keys(hermes, {"version", "tag", "commit"}, "components.hermes")
    _version(hermes["version"], "components.hermes.version")
