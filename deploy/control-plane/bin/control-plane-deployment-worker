    _identifier(
        provider_integrations["revision"], "components.provider_integrations.revision"
    )
    _sha256(provider_integrations["sha256"], "components.provider_integrations.sha256")
    integration_accounts = _count(
        provider_integrations["provider_accounts"],
        "components.provider_integrations.provider_accounts",
        positive=True,
    )
    if integration_accounts != catalogue_accounts:
        raise DeploymentError(
            "manifest_invalid", "catalogue and integration account counts differ"
