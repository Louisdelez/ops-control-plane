    runtime = _mapping(document["runtime"], "runtime")
    _exact_keys(
        runtime,
        {
            "encrypted_credentials",
            "zulip_owner_password_file",
            "services",
            "finance_isolation",
            "provider_credential_scopes",
            "provider_optional_credential_scopes",
            "dynamic_services",
        },
        "runtime",
    )
    credentials = runtime["encrypted_credentials"]
    if not isinstance(credentials, list) or not credentials or len(credentials) > 32:
        raise DeploymentError("manifest_invalid", "runtime credentials are invalid")
    for name in credentials:
        _identifier(name, "runtime.encrypted_credentials")
    if tuple(credentials) != ENCRYPTED_CREDENTIAL_NAMES:
        raise DeploymentError("manifest_invalid", "runtime credentials differ from the reviewed set")
    if runtime["zulip_owner_password_file"] != str(ZULIP_PASSWORD_FILE):
        raise DeploymentError("manifest_invalid", "Zulip password reference differs from review")
    if runtime["services"] != list(SERVICE_NAMES):
        raise DeploymentError("manifest_invalid", "runtime service order differs from review")
    if runtime["dynamic_services"] != list(DYNAMIC_SERVICE_NAMES):
        raise DeploymentError("manifest_invalid", "runtime dynamic services differ from review")
    finance_isolation = _mapping(runtime["finance_isolation"], "runtime.finance_isolation")
    _exact_keys(
        finance_isolation,
        {
            "worker_user",
            "worker_group",
            "client_user",
            "socket_path",
            "socket_mode",
            "stateless",
        },
        "runtime.finance_isolation",
    )
    if finance_isolation != {
        "worker_user": FINANCE_WORKER_USER,
        "worker_group": FINANCE_WORKER_GROUP,
        "client_user": FINANCE_CLIENT_USER,
        "socket_path": str(FINANCE_SOCKET),
        "socket_mode": FINANCE_SOCKET_MODE,
        "stateless": True,
    }:
        raise DeploymentError("manifest_invalid", "finance isolation differs from review")
    credential_scopes = _mapping(
        runtime["provider_credential_scopes"], "runtime.provider_credential_scopes"
    )
    if credential_scopes != PROVIDER_CREDENTIAL_SCOPES:
        raise DeploymentError("manifest_invalid", "provider credential scopes differ from review")
    optional_credential_scopes = _mapping(
        runtime["provider_optional_credential_scopes"],
        "runtime.provider_optional_credential_scopes",
    )
    if optional_credential_scopes != PROVIDER_OPTIONAL_CREDENTIAL_SCOPES:
        raise DeploymentError(
            "manifest_invalid",
            "optional provider credential scopes differ from review",
        )

    rollback = _mapping(document["rollback"], "rollback")
    _exact_keys(
        rollback,
        {"automatic_on_failure", "explicit_last_transaction", "zulip_restore_identity_file", "secret_material_backed_up"},
        "rollback",
    )
    if rollback["automatic_on_failure"] is not True or rollback["explicit_last_transaction"] is not False:
        raise DeploymentError("manifest_invalid", "only the outer automatic rollback is allowed")
    if rollback["zulip_restore_identity_file"] != str(ZULIP_RESTORE_IDENTITY):
        raise DeploymentError("manifest_invalid", "rollback identity reference differs from review")
    if rollback["secret_material_backed_up"] is not False:
        raise DeploymentError("manifest_invalid", "secret backup is forbidden")
    return document


def load_manifest(
    path: Path = MANIFEST_PATH,
    *,
    require_root_owned: bool = True,
) -> dict[str, Any]:
    return validate_manifest(read_json(path, require_root_owned=require_root_owned))


def normalized_file_mode(metadata: os.stat_result) -> int:
    return 0o755 if metadata.st_mode & 0o111 else 0o644


def _excluded(relative: PurePosixPath) -> bool:
    if any(part in EXCLUDED_DIRECTORY_NAMES for part in relative.parts):
        return True
    return relative.name.endswith(EXCLUDED_FILE_SUFFIXES)


def iter_source_paths(source_root: Path, roots: Iterable[str]) -> Iterator[tuple[Path, PurePosixPath]]:
    seen: set[PurePosixPath] = set()
    for raw_root in sorted(roots):
        relative_root = _relative_path(raw_root, "source.roots")
        absolute_root = source_root.joinpath(*relative_root.parts)
        try:
            root_metadata = os.lstat(absolute_root)
        except OSError as exc:
            raise DeploymentError("source_invalid", f"release source is missing: {relative_root}") from exc
        if stat.S_ISLNK(root_metadata.st_mode):
            raise DeploymentError("source_invalid", f"release source is symlinked: {relative_root}")
        if stat.S_ISREG(root_metadata.st_mode):
            if relative_root not in seen and not _excluded(relative_root):
                if CONTROL_RE.search(relative_root.as_posix()):
                    raise DeploymentError("source_invalid", "release source path contains control characters")
                seen.add(relative_root)
                yield absolute_root, relative_root
            continue
        if not stat.S_ISDIR(root_metadata.st_mode):
            raise DeploymentError("source_invalid", f"release source has unsupported type: {relative_root}")
        for directory, directory_names, file_names in os.walk(absolute_root, topdown=True, followlinks=False):
            directory_path = Path(directory)
            relative_directory = PurePosixPath(directory_path.relative_to(source_root).as_posix())
            kept_directories: list[str] = []
            for name in sorted(directory_names):
                child_relative = relative_directory / name
                if CONTROL_RE.search(child_relative.as_posix()):
                    raise DeploymentError("source_invalid", "release source path contains control characters")
                child = directory_path / name
                child_metadata = os.lstat(child)
                if stat.S_ISLNK(child_metadata.st_mode):
                    raise DeploymentError("source_invalid", f"release source contains a symlink: {child_relative}")
                if not stat.S_ISDIR(child_metadata.st_mode):
                    raise DeploymentError("source_invalid", f"release source contains a special entry: {child_relative}")
                if not _excluded(child_relative):
                    kept_directories.append(name)
            directory_names[:] = kept_directories
            for name in sorted(file_names):
                child_relative = relative_directory / name
                if CONTROL_RE.search(child_relative.as_posix()):
                    raise DeploymentError("source_invalid", "release source path contains control characters")
                if _excluded(child_relative):
                    continue
                child = directory_path / name
                child_metadata = os.lstat(child)
                if stat.S_ISLNK(child_metadata.st_mode) or not stat.S_ISREG(child_metadata.st_mode):
                    raise DeploymentError("source_invalid", f"release source contains an unsafe file: {child_relative}")
                if child_relative in seen:
                    continue
                seen.add(child_relative)
                yield child, child_relative
    if not seen:
        raise DeploymentError("source_invalid", "release source tree is empty")


def copy_and_hash(source: Path, destination: Path) -> tuple[int, int, str]:
    try:
        source_fd = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("source_invalid", f"cannot open release input: {source.name}") from exc
    try:
        before = os.fstat(source_fd)
        if not stat.S_ISREG(before.st_mode) or before.st_size > MAX_SOURCE_FILE_BYTES:
            raise DeploymentError("source_invalid", f"release input is not a bounded regular file: {source.name}")
        mode = normalized_file_mode(before)
        destination.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        destination_fd = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            mode,
        )
        digest = hashlib.sha256()
        total = 0
        try:
            while True:
                chunk = os.read(source_fd, 1024 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_SOURCE_FILE_BYTES:
                    raise DeploymentError("source_invalid", f"release input grew beyond its bound: {source.name}")
                digest.update(chunk)
                view = memoryview(chunk)
                while view:
                    written = os.write(destination_fd, view)
                    if written <= 0:
                        raise DeploymentError("write_failed", "a release copy was incomplete")
                    view = view[written:]
            os.fchmod(destination_fd, mode)
            os.fsync(destination_fd)
        finally:
            os.close(destination_fd)
        after = os.fstat(source_fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            destination.unlink(missing_ok=True)
            raise DeploymentError("source_changed", f"release input changed while copied: {source.name}")
        return mode, total, digest.hexdigest()
    finally:
        os.close(source_fd)


def fsync_tree(root: Path) -> None:
    """Make a bounded, already-validated release/restore tree crash-durable."""

    directories: list[Path] = []
    files_seen = 0
    for directory, directory_names, file_names in os.walk(root, topdown=True, followlinks=False):
        base = Path(directory)
        directories.append(base)
        files_seen += len(file_names) + len(directory_names)
        if files_seen > 50_000:
            raise DeploymentError("write_failed", "the durable tree entry bound was exceeded")
        for name in file_names:
            path = base / name
            metadata = os.lstat(path)
            if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
                raise DeploymentError("write_failed", "a durable tree contains an unsafe entry")
            descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
    for directory in reversed(directories):
        descriptor = os.open(
            directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
        )
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def canonical_tree_hash(entries: Iterable[tuple[PurePosixPath, int, int, str]]) -> str:
    digest = hashlib.sha256()
    for relative, mode, size, file_digest in sorted(entries, key=lambda item: item[0].as_posix()):
        line = f"{relative.as_posix()}\0{mode:o}\0{size}\0{file_digest}\n"
        digest.update(line.encode("utf-8"))
    return digest.hexdigest()


def source_tree_digest(source_root: Path, roots: Iterable[str]) -> str:
    entries: list[tuple[PurePosixPath, int, int, str]] = []
    total = 0
    for source, relative in iter_source_paths(source_root, roots):
        try:
            descriptor = os.open(
                source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
            )
        except OSError as exc:
            raise DeploymentError(
                "source_invalid", f"cannot open release input: {source.name}"
            ) from exc
        try:
            before = os.fstat(descriptor)
            if not stat.S_ISREG(before.st_mode) or before.st_size > MAX_SOURCE_FILE_BYTES:
                raise DeploymentError(
                    "source_invalid",
                    f"release input is not a bounded regular file: {source.name}",
                )
            if relative.as_posix() in SOURCE_INSTALLER_ENTRYPOINTS and not before.st_mode & 0o111:
                raise DeploymentError("source_invalid", f"source installer is not executable: {relative}")
            digest = hashlib.sha256()
            size = 0
            while True:
                chunk = os.read(descriptor, 1024 * 1024)
                if not chunk:
                    break
                size += len(chunk)
                if size > MAX_SOURCE_FILE_BYTES:
                    raise DeploymentError(
                        "source_invalid",
                        f"release input grew beyond its bound: {source.name}",
                    )
                digest.update(chunk)
            after = os.fstat(descriptor)
            if (
                before.st_dev,
                before.st_ino,
                before.st_size,
                before.st_mtime_ns,
                before.st_ctime_ns,
            ) != (
                after.st_dev,
                after.st_ino,
                after.st_size,
                after.st_mtime_ns,
                after.st_ctime_ns,
            ):
                raise DeploymentError(
                    "source_changed", f"release input changed while hashed: {source.name}"
                )
            entries.append(
                (relative, normalized_file_mode(before), size, digest.hexdigest())
            )
        finally:
            os.close(descriptor)
        total += size
        if total > MAX_SOURCE_TREE_BYTES:
            raise DeploymentError("source_invalid", "release source tree exceeds its bound")
    return canonical_tree_hash(entries)


def sha256_regular(path: Path, *, maximum: int = MAX_SOURCE_FILE_BYTES) -> str:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("artifact_invalid", "Atlas artifact is unavailable") from exc
    digest = hashlib.sha256()
    total = 0
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > maximum:
            raise DeploymentError("artifact_invalid", "Atlas artifact is unsafe or oversized")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > maximum:
                raise DeploymentError("artifact_invalid", "Atlas artifact exceeded its size bound")
            digest.update(chunk)
    finally:
        os.close(descriptor)
    return digest.hexdigest()


def validate_hermes_source_archive(
    path: Path, contract: dict[str, Any]
) -> None:
    """Authenticate the vendored GitHub export and its normalized file tree."""

    try:
        before_path = os.lstat(path)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError(
            "artifact_invalid", "Hermes source archive is unavailable"
        ) from exc
    stable_fields = (
        "st_dev",
        "st_ino",
        "st_uid",
        "st_gid",
        "st_mode",
        "st_nlink",
        "st_size",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or stat.S_ISLNK(before_path.st_mode)
            or opened.st_nlink != 1
            or stat.S_IMODE(opened.st_mode) & 0o022
            or opened.st_size != contract["compressed_size"]
            or opened.st_size > MAX_SOURCE_FILE_BYTES
            or any(
                getattr(before_path, field) != getattr(opened, field)
                for field in stable_fields
            )
        ):
            raise DeploymentError(
                "artifact_invalid", "Hermes source archive metadata differs from review"
            )

        archive_digest = hashlib.sha256()
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            archive_digest.update(chunk)
        if not hmac.compare_digest(archive_digest.hexdigest(), contract["sha256"]):
            raise DeploymentError(
                "checksum_mismatch", "Hermes source archive differs from review"
            )
        os.lseek(descriptor, 0, os.SEEK_SET)

        expected_pax = {"comment": contract["commit"]}
        expected_prefix = contract["top_level_directory"]
        seen: set[str] = set()
        seen_exported: dict[str, bool] = {}
        entries: list[tuple[PurePosixPath, int, int, str]] = []
        member_count = 0
        regular_count = 0
        directory_count = 0
        expanded_size = 0
        maximum_size = 0
        with os.fdopen(os.dup(descriptor), "rb") as archive_stream:
            with tarfile.open(fileobj=archive_stream, mode="r:gz") as archive:
                if archive.pax_headers != expected_pax:
                    raise DeploymentError(
                        "artifact_invalid", "Hermes archive provenance differs from review"
                    )
                for member in archive:
                    member_count += 1
                    if member_count > contract["members"]:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive has too many members"
                        )
                    name = member.name
                    try:
                        encoded_name = name.encode("utf-8", errors="strict")
                    except UnicodeError as exc:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive path is invalid"
                        ) from exc
                    relative = PurePosixPath(name)
                    if (
                        not name
                        or len(encoded_name) > 4096
                        or relative.as_posix() != name
                        or name in seen
                        or relative.is_absolute()
                        or "\\" in name
                        or any(part in {"", ".", ".."} for part in relative.parts)
                        or any(len(part.encode("utf-8")) > 255 for part in relative.parts)
                        or any(byte < 32 or byte == 127 for byte in encoded_name)
                        or member.pax_headers != expected_pax
                        or member.sparse
                        or member.uid != 0
                        or member.gid != 0
                        or member.uname != "root"
                        or member.gname != "root"
                    ):
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive inventory is unsafe"
                        )
                    seen.add(name)
                    if name == expected_prefix:
                        if (
                            not member.isdir()
                            or member.mode != 0o775
                            or member.size != 0
                        ):
                            raise DeploymentError(
                                "artifact_invalid", "Hermes archive root differs from review"
                            )
                        directory_count += 1
                        continue
                    prefix = f"{expected_prefix}/"
                    if not name.startswith(prefix):
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive root differs from review"
                        )
                    stripped = PurePosixPath(name.removeprefix(prefix))
                    stripped_name = stripped.as_posix()
                    ancestors = tuple(
                        PurePosixPath(*stripped.parts[:index]).as_posix()
                        for index in range(1, len(stripped.parts))
                    )
                    if (
                        stripped_name in seen_exported
                        or any(seen_exported.get(ancestor) is False for ancestor in ancestors)
                        or any(ancestor not in seen_exported for ancestor in ancestors)
                        or (
                            member.isfile()
                            and any(
                                existing.startswith(f"{stripped_name}/")
                                for existing in seen_exported
                            )
                        )
                    ):
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive paths collide"
                        )
                    if member.isdir():
                        if member.mode != 0o775 or member.size != 0:
                            raise DeploymentError(
                                "artifact_invalid", "Hermes archive directory differs from review"
                            )
                        directory_count += 1
                        seen_exported[stripped_name] = True
                        continue
                    if not member.isfile() or member.mode not in {0o664, 0o775}:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive contains an unsupported member"
                        )
                    if member.size > contract["max_file_size"]:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive member exceeds its bound"
                        )
                    if expanded_size + member.size > contract["expanded_size"]:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive expansion exceeds its bound"
                        )
                    source = archive.extractfile(member)
                    if source is None:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive member is unreadable"
                        )
                    file_digest = hashlib.sha256()
                    observed_size = 0
                    while True:
                        chunk = source.read(1024 * 1024)
                        if not chunk:
                            break
                        observed_size += len(chunk)
                        file_digest.update(chunk)
                    if observed_size != member.size:
                        raise DeploymentError(
                            "artifact_invalid", "Hermes archive member is truncated"
                        )
                    regular_count += 1
                    seen_exported[stripped_name] = False
                    expanded_size += observed_size
                    maximum_size = max(maximum_size, observed_size)
                    entries.append(
                        (
                            stripped,
                            0o755 if member.mode & 0o111 else 0o644,
                            observed_size,
                            file_digest.hexdigest(),
                        )
                    )
        if (
            member_count != contract["members"]
            or regular_count != contract["regular_files"]
            or directory_count != contract["directories"]
            or expanded_size != contract["expanded_size"]
            or maximum_size != contract["max_file_size"]
            or not hmac.compare_digest(
                canonical_tree_hash(entries), contract["canonical_tree_sha256"]
            )
        ):
            raise DeploymentError(
                "checksum_mismatch", "Hermes exported source tree differs from review"
            )
        after_fd = os.fstat(descriptor)
        after_path = os.lstat(path)
        if any(
            getattr(opened, field) != getattr(after_fd, field)
            or getattr(after_fd, field) != getattr(after_path, field)
            for field in stable_fields
        ):
            raise DeploymentError(
                "source_changed", "Hermes source archive changed while verified"
            )
    except (tarfile.TarError, EOFError, OSError) as exc:
        raise DeploymentError(
            "artifact_invalid", "Hermes source archive could not be inspected"
        ) from exc
    finally:
        os.close(descriptor)


def read_release_file(root: Path, relative: str, *, maximum: int = 2 * 1024 * 1024) -> bytes:
    path = root / relative
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("source_invalid", f"component declaration is unavailable: {relative}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > maximum:
            raise DeploymentError("source_invalid", f"component declaration is unsafe: {relative}")
        raw = b""
        while len(raw) <= maximum:
            chunk = os.read(descriptor, min(65_536, maximum + 1 - len(raw)))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(descriptor)
    if len(raw) > maximum:
        raise DeploymentError("source_invalid", f"component declaration is oversized: {relative}")
    return raw


def catalogue_runtime_inventory(root: Path) -> dict[str, Any]:
    """Derive release counts with the reviewed runtime's own fail-closed logic."""

    probe = r'''import hashlib
import json
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, sys.argv[1])
from ops_orchestrator.catalogue import ModelCatalogue
from ops_orchestrator.config import expand_catalogue_runtime, load_config

root = Path(sys.argv[2])
catalogue_path = root / "catalog/model-catalog.v2.json"
integrations_path = root / "catalog/provider-integrations.v1.json"
config = expand_catalogue_runtime(
    load_config(root / "orchestrator/config/orchestrator.json"),
    catalogue_path=catalogue_path,
    provider_integrations_path=integrations_path,
)
catalogue = ModelCatalogue.load(
    catalogue_path,
    configured_deployment_ids=(provider.provider_id for provider in config.providers),
    auxiliary_deployment_ids=config.catalogue_auxiliary_deployment_ids,
    runtime_bindings=config.catalogue_runtime_bindings,
    runtime_reasons=config.catalogue_runtime_reasons,
)
static = [
    card for card in catalogue.cards
    if card["deployment_ids"] and "catalogue_integration_stage" not in card
]
dynamic = [
    card for card in catalogue.cards
    if card["deployment_ids"] and "catalogue_integration_stage" in card
]
blocked_cards = [card for card in catalogue.cards if not card["deployment_ids"]]
blocked = Counter(
    config.catalogue_runtime_reasons[str(card["card_id"])] for card in blocked_cards
)
provider_inventory = sorted(
    (
        {
            "id": provider.provider_id,
            "provider_account_id": provider.account_id,
            "role": provider.role.value,
            "location": provider.location,
        }
        for provider in config.providers
    ),
    key=lambda item: item["id"],
)
provider_inventory_sha256 = hashlib.sha256(
    json.dumps(provider_inventory, sort_keys=True, separators=(",", ":")).encode("utf-8")
).hexdigest()
print(json.dumps({
    "static_cards": len(static),
    "static_deployments": sum(len(card["deployment_ids"]) for card in static),
    "dynamic_cards": len(dynamic),
    "invocable_cards": len(static) + len(dynamic),
    "blocked_cards": len(blocked_cards),
    "blocked_reasons": dict(sorted(blocked.items())),
    "provider_deployments": len(config.providers),
    "provider_inventory_sha256": provider_inventory_sha256,
}, sort_keys=True, separators=(",", ":")))
'''
    try:
        completed = subprocess.run(
            [
                "/usr/bin/python3",
                "-I",
                "-S",
                "-B",
                "-c",
                probe,
                str(root / "orchestrator/src"),
                str(root),
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            close_fds=True,
            timeout=30,
            env={
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
                "PYTHONDONTWRITEBYTECODE": "1",
                "PYTHONSAFEPATH": "1",
            },
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise DeploymentError(
            "source_invalid", "catalogue runtime inventory could not be derived"
        ) from exc
    if completed.returncode != 0 or len(completed.stdout) > 65_536:
        raise DeploymentError(
            "source_invalid", "catalogue runtime inventory could not be derived"
        )
    try:
        inventory = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "source_invalid", "catalogue runtime inventory is invalid"
        ) from exc
    if not isinstance(inventory, dict):
        raise DeploymentError("source_invalid", "catalogue runtime inventory is invalid")
    return inventory


def validate_component_declarations(root: Path, manifest: dict[str, Any]) -> None:
    components = manifest["components"]
    try:
        orchestrator = tomllib.loads(
            read_release_file(root, "orchestrator/pyproject.toml").decode("utf-8")
        )
        bridge = tomllib.loads(
            read_release_file(root, "bridges/zulip/pyproject.toml").decode("utf-8")
        )
        atlas = json.loads(
            read_release_file(root, "apps/model-manager/src-tauri/tauri.conf.json")
        )
    except (UnicodeError, tomllib.TOMLDecodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("source_invalid", "a component version declaration is invalid") from exc
    if orchestrator.get("project", {}).get("version") != components["orchestrator"]["version"]:
        raise DeploymentError("version_mismatch", "orchestrator version differs from manifest")
    if bridge.get("project", {}).get("version") != components["zulip_bridge"]["version"]:
        raise DeploymentError("version_mismatch", "Zulip bridge version differs from manifest")
    if not isinstance(atlas, dict) or atlas.get("version") != components["atlas"]["version"]:
        raise DeploymentError("version_mismatch", "Atlas version differs from manifest")

    catalogue_raw = read_release_file(root, "catalog/model-catalog.v2.json")
    integrations_raw = read_release_file(root, "catalog/provider-integrations.v1.json")
    try:
        catalogue_document = json.loads(catalogue_raw)
        integrations_document = json.loads(integrations_raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("source_invalid", "catalogue declarations are invalid") from exc
    model_catalogue = components["model_catalogue"]
    provider_integrations = components["provider_integrations"]
    if (
        hashlib.sha256(catalogue_raw).hexdigest() != model_catalogue["sha256"]
        or not isinstance(catalogue_document, dict)
        or catalogue_document.get("schema_version") != model_catalogue["schema_version"]
        or catalogue_document.get("revision") != model_catalogue["revision"]
        or not isinstance(catalogue_document.get("cards"), list)
        or len(catalogue_document["cards"]) != model_catalogue["cards"]
        or not isinstance(catalogue_document.get("provider_accounts"), list)
        or len(catalogue_document["provider_accounts"])
        != model_catalogue["provider_accounts"]
    ):
        raise DeploymentError(
            "checksum_mismatch", "model catalogue differs from manifest"
        )
    if (
        hashlib.sha256(integrations_raw).hexdigest() != provider_integrations["sha256"]
        or not isinstance(integrations_document, dict)
        or integrations_document.get("schema_version")
        != provider_integrations["schema_version"]
        or integrations_document.get("revision") != provider_integrations["revision"]
        or not isinstance(integrations_document.get("provider_accounts"), list)
        or len(integrations_document["provider_accounts"])
        != provider_integrations["provider_accounts"]
    ):
        raise DeploymentError(
            "checksum_mismatch", "provider integrations differ from manifest"
        )
    if catalogue_runtime_inventory(root) != model_catalogue["runtime"]:
        raise DeploymentError(
            "source_invalid", "catalogue runtime inventory differs from manifest"
        )

    hermes_installer = read_release_file(root, "scripts/install-hermes.sh").decode(
        "utf-8", errors="strict"
    )
    expected_hermes_lines = (
        f"readonly hermes_version={components['hermes']['version']}",
        f"readonly hermes_tag={components['hermes']['tag']}",
        f"readonly hermes_commit={components['hermes']['commit']}",
        f"readonly uv_version={HERMES_UV_VERSION}",
    )
    if any(line not in hermes_installer for line in expected_hermes_lines):
        raise DeploymentError("version_mismatch", "Hermes pin differs from manifest")
    if (
        "uv.lock" not in hermes_installer
        or '"$managed_uv" sync' not in hermes_installer
        or "--extra all --locked" not in hermes_installer
    ):
        raise DeploymentError("source_invalid", "Hermes locked runtime sync differs from review")

    supply_chain = manifest["supply_chain"]
    installer_by_closure = {
        "orchestrator": read_release_file(root, "scripts/install-orchestrator.sh").decode(
            "utf-8", errors="strict"
        ),
        "broker": read_release_file(root, "scripts/install-broker.sh").decode(
            "utf-8", errors="strict"
        ),
    }
    for closure_name, closure in supply_chain["python_closures"].items():
        lock_content = read_release_file(root, closure["path"])
        if hashlib.sha256(lock_content).hexdigest() != closure["sha256"]:
            raise DeploymentError(
                "checksum_mismatch", f"Python runtime closure differs from review: {closure_name}"
            )
        try:
            lock_text = lock_content.decode("utf-8", errors="strict")
        except UnicodeError as exc:
            raise DeploymentError("source_invalid", "Python runtime closure is invalid") from exc
        distributions = [
            line.strip()
            for line in lock_text.splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
        if len(distributions) != closure["distributions"] or any(
            not re.fullmatch(
                r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}==[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}",
                line,
            )
            for line in distributions
        ):
            raise DeploymentError("source_invalid", "Python runtime closure is not exact")
        installer = installer_by_closure[closure_name]
        if (
            closure["path"].split("/", 1)[-1] not in installer
            or "--no-deps" not in installer
            or "--only-binary=:all:" not in installer
            or "from importlib.metadata import" not in installer
            or "-m pip check" not in installer
        ):
            raise DeploymentError(
                "source_invalid", f"Python runtime verification differs from review: {closure_name}"
            )

    orchestrator_config = read_release_file(
        root, "orchestrator/config/orchestrator.json"
    ).decode("utf-8", errors="strict")
    if "ollama" in orchestrator_config.lower():
        raise DeploymentError("source_invalid", "local inference appears in the API-first runtime")
    try:
        orchestrator_document = json.loads(orchestrator_config)
    except json.JSONDecodeError as exc:
        raise DeploymentError("source_invalid", "orchestrator configuration is invalid") from exc
    orchestrator_paths = (
        orchestrator_document.get("paths")
        if isinstance(orchestrator_document, dict)
        else None
    )
    if not isinstance(orchestrator_paths, dict) or orchestrator_paths.get(
        "finance_socket"
    ) != "/run/ops-orchestrator-finance/api.sock":
        raise DeploymentError("source_invalid", "isolated provider-finance socket differs from review")
    if (
        orchestrator_paths.get("model_catalogue")
        != "/usr/local/share/ops-control-plane/catalog/model-catalog.v2.json"
        or orchestrator_paths.get("provider_integrations")
        != "/usr/local/share/ops-control-plane/catalog/provider-integrations.v1.json"
        or orchestrator_document.get("catalogue_auxiliary_deployments")
        != ["qwen-coder-api", "embedding-api-backup", "reranker-api-backup"]
    ):
        raise DeploymentError("source_invalid", "catalogue runtime paths differ from review")
    catalogue_runtime = orchestrator_document.get("catalogue_runtime")
    if not isinstance(catalogue_runtime, dict) or catalogue_runtime.get("enabled") is not True:
        raise DeploymentError("source_invalid", "catalogue API runtime is not enabled")
    orchestrator_environment = read_release_file(
        root, "orchestrator/config/orchestrator.env"
    ).decode("utf-8", errors="strict")
    if (
        orchestrator_environment.splitlines().count(
            "OPS_ORCHESTRATOR_ENABLE_CATALOGUE_API=1"
        )
        != 1
    ):
        raise DeploymentError("source_invalid", "catalogue API activation flag differs from review")

    service_sources = {
        unit: read_release_file(root, f"systemd/{unit}").decode(
            "utf-8", errors="strict"
        )
        for unit in PROVIDER_CREDENTIAL_SCOPES
    }
    for unit, expected_credentials in PROVIDER_CREDENTIAL_SCOPES.items():
        discovered_credentials = re.findall(
            r"^LoadCredential=([a-z0-9][a-z0-9-]{0,63}):",
            service_sources[unit],
            re.MULTILINE,
        )
        if discovered_credentials != expected_credentials:
            raise DeploymentError(
                "source_invalid", f"provider credential scope differs from review: {unit}"
            )
        discovered_optional_credentials = re.findall(
            r"^SetCredential=([a-z0-9][a-z0-9-]{0,63}):\\n$",
            service_sources[unit],
            re.MULTILINE,
        )
        if discovered_optional_credentials != PROVIDER_OPTIONAL_CREDENTIAL_SCOPES[unit]:
            raise DeploymentError(
                "source_invalid",
                f"optional provider credential scope differs from review: {unit}",
            )
    finance_unit = service_sources[
        "ops-orchestrator-provider-finance-daemon.service"
    ]
    finance_required_lines = (
        f"User={FINANCE_WORKER_USER}",
        f"Group={FINANCE_WORKER_GROUP}",
        f"SupplementaryGroups={FINANCE_CLIENT_USER}",
        "RuntimeDirectory=ops-orchestrator-finance",
        "RuntimeDirectoryMode=0750",
        "ReadWritePaths=/run/ops-orchestrator-finance",
    )
    if any(line not in finance_unit.splitlines() for line in finance_required_lines):
        raise DeploymentError("source_invalid", "provider-finance unit isolation differs from review")
    if "StateDirectory=" in finance_unit or "/var/lib" in finance_unit:
        raise DeploymentError("source_invalid", "provider-finance worker must remain stateless")
    if "SupplementaryGroups=opsorchestrator opsfinance" not in service_sources[
        "ops-orchestrator.service"
    ].splitlines():
        raise DeploymentError("source_invalid", "orchestrator finance client group differs from review")
    if f"InaccessiblePaths={FINANCE_SOCKET.parent}" not in service_sources[
        "ops-orchestrator-hermes-facade.service"
    ].splitlines():
        raise DeploymentError("source_invalid", "Hermes facade can access the finance socket")
    sysusers = read_release_file(
        root, "orchestrator/deploy/ops-orchestrator.sysusers"
    ).decode("utf-8", errors="strict")
    for exact_line in (
        f"g {FINANCE_WORKER_GROUP} -",
        f'u {FINANCE_WORKER_USER} - "Ops provider finance worker" /nonexistent /usr/sbin/nologin',
        f"m {FINANCE_CLIENT_USER} {FINANCE_WORKER_GROUP}",
    ):
        if exact_line not in sysusers.splitlines():
            raise DeploymentError("source_invalid", "provider-finance identity differs from review")

    compose = read_release_file(root, "deploy/zulip-local/compose.yaml").decode(
        "utf-8", errors="strict"
    )
    discovered = dict(
        re.findall(
            r'^\s*image:\s*"([^"@]+)@sha256:([0-9a-f]{64})"\s*$',
            compose,
            re.MULTILINE,
        )
    )
    expected_images = {
        f"ghcr.io/zulip/zulip-server:{components['zulip']['version']}": components["zulip"]["images"]["zulip"],
        "zulip/zulip-postgresql:14": components["zulip"]["images"]["postgresql"],
        "memcached:alpine": components["zulip"]["images"]["memcached"],
        "rabbitmq:4.2": components["zulip"]["images"]["rabbitmq"],
        "redis:alpine": components["zulip"]["images"]["redis"],
    }
    if discovered != expected_images:
        raise DeploymentError("checksum_mismatch", "Zulip Compose pins differ from manifest")


def atomic_json(path: Path, document: dict[str, Any], *, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        payload = json.dumps(document, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise DeploymentError("write_failed", "an atomic state write was incomplete")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def atomic_bytes(path: Path, payload: bytes, *, mode: int) -> None:
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise DeploymentError("write_failed", "an atomic file write was incomplete")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def transaction_atomic_bytes(
    path: Path, staging: Path, payload: bytes, *, mode: int
) -> None:
    """Crash-replayable fixed-slot publication for pre-commit host files."""

    if staging.parent != path.parent or staging == path:
        raise DeploymentError("write_failed", "transaction staging path is invalid")
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)

    def validate_exact(candidate: Path) -> None:
        try:
            item = os.lstat(candidate)
            content = candidate.read_bytes()
        except OSError as exc:
            raise DeploymentError("write_failed", "transaction file is unavailable") from exc
        if (
            not stat.S_ISREG(item.st_mode)
            or stat.S_ISLNK(item.st_mode)
            or item.st_uid != 0
            or item.st_gid != 0
            or stat.S_IMODE(item.st_mode) != mode
            or content != payload
        ):
            raise DeploymentError("write_failed", "transaction file differs from review")

    if os.path.lexists(staging):
        try:
            validate_exact(staging)
        except DeploymentError:
            # SIGKILL may leave the designated slot after a partial write. It
            # is attributable only when it is a private, single-link root file
            # no larger than the reviewed payload; anything else fails closed.
            try:
                partial = os.lstat(staging)
            except OSError as exc:
                raise DeploymentError("write_failed", "transaction staging file changed") from exc
            if (
                not stat.S_ISREG(partial.st_mode)
                or stat.S_ISLNK(partial.st_mode)
                or partial.st_uid != 0
                or partial.st_gid != 0
                or partial.st_nlink != 1
                or stat.S_IMODE(partial.st_mode) & 0o022
                or partial.st_size > len(payload)
            ):
                raise
            staging.unlink()
            _fsync_directory_path(path.parent)
        else:
            if os.path.lexists(path):
                validate_exact(path)
                staging.unlink()
                _fsync_directory_path(path.parent)
                return
            os.replace(staging, path)
            _fsync_directory_path(path.parent)
            return
    if os.path.lexists(path):
        validate_exact(path)
        return
    descriptor = os.open(
        staging,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    try:
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, mode)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise DeploymentError("write_failed", "transaction file write was incomplete")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(staging, path)
    _fsync_directory_path(path.parent)


def remove_attributable_transaction_staging(staging: Path, payload: bytes) -> None:
    if not os.path.lexists(staging):
        return
    try:
        item = os.lstat(staging)
    except OSError as exc:
        raise DeploymentError("rollback_failed", "transaction staging file changed") from exc
    if (
        not stat.S_ISREG(item.st_mode)
        or stat.S_ISLNK(item.st_mode)
        or item.st_uid != 0
        or item.st_gid != 0
        or item.st_nlink != 1
        or stat.S_IMODE(item.st_mode) & 0o022
        or item.st_size > len(payload)
    ):
        raise DeploymentError("rollback_failed", "transaction staging file is unsafe")
    staging.unlink()
    _fsync_directory_path(staging.parent)


def append_audit(event: dict[str, Any]) -> None:
    STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    record = {
        "timestamp": int(time.time()),
        **event,
    }
    payload = json.dumps(record, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
    descriptor = os.open(
        AUDIT_PATH,
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise DeploymentError("write_failed", "an audit write was incomplete")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def run_command(name: str, argv: list[str], *, timeout: int) -> None:
    started = time.monotonic()
    process: subprocess.Popen[bytes] | None = None
    try:
        inherited = (
            (INHERITED_LOCK_FD,)
            if isinstance(INHERITED_LOCK_FD, int) and INHERITED_LOCK_FD >= 3
            else ()
        )
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            pass_fds=inherited,
            start_new_session=True,
            env={
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
            },
        )
        return_code = process.wait(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        append_audit({"event": "step_failed", "step": name, "reason": "timeout"})
        raise DeploymentError("step_timeout", f"deployment step timed out: {name}") from exc
    except OSError as exc:
        if process is not None and process.poll() is None:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
        append_audit({
            "event": "step_failed", "step": name, "reason": "launch_failed",
            "errno": exc.errno if type(exc.errno) is int else 0,
        })
        raise DeploymentError("step_failed", f"deployment step could not start: {name}") from exc
    except BaseException:
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        raise
    duration_ms = int((time.monotonic() - started) * 1000)
    if return_code != 0:
        append_audit(
            {
                "event": "step_failed",
                "step": name,
                "return_code": return_code,
                "duration_ms": duration_ms,
            }
        )
        raise DeploymentError("step_failed", f"deployment step failed: {name}")
    append_audit({"event": "step_succeeded", "step": name, "duration_ms": duration_ms})


def command_available(path: str) -> bool:
    try:
        link_metadata = os.lstat(path)
        resolved = Path(path).resolve(strict=True)
        metadata = os.stat(resolved)
    except OSError:
        return False
    return (
        (stat.S_ISREG(link_metadata.st_mode) or stat.S_ISLNK(link_metadata.st_mode))
        and link_metadata.st_uid == 0
        and (
            stat.S_ISLNK(link_metadata.st_mode)
            or not stat.S_IMODE(link_metadata.st_mode) & 0o022
        )
        and resolved.parent in {Path("/usr/bin"), Path("/usr/sbin")}
        and stat.S_ISREG(metadata.st_mode)
        and metadata.st_uid == 0
        and not stat.S_IMODE(metadata.st_mode) & 0o022
        and bool(metadata.st_mode & 0o111)
    )


def host_os_release() -> dict[str, str]:
    path = Path("/usr/lib/os-release")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("preflight_failed", "Fedora release metadata is unavailable") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) & 0o022
            or metadata.st_size > 64 * 1024
        ):
            raise DeploymentError("preflight_failed", "Fedora release metadata is unsafe")
        raw = os.read(descriptor, 64 * 1024 + 1)
    finally:
        os.close(descriptor)
    if len(raw) > 64 * 1024:
        raise DeploymentError("preflight_failed", "Fedora release metadata is oversized")
    try:
        text_value = raw.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        raise DeploymentError("preflight_failed", "Fedora release metadata is invalid") from exc
    values: dict[str, str] = {}
    for line in text_value.splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key not in {"ID", "VERSION_ID"}:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", value):
            raise DeploymentError("preflight_failed", "Fedora release metadata is invalid")
        values[key] = value
    return values


def installed_package_nevra(package_name: str) -> str | None:
    if package_name not in (
        set(DOCKER_PACKAGE_NEVRAS)
        | set(DOCKER_DEPENDENCY_NEVRAS)
        | set(DOCKER_CONFLICT_PACKAGES)
        | PREFLIGHT_QUERY_PACKAGES
    ):
        raise DeploymentError("package_invalid", "an unreviewed package was queried")
    completed = subprocess.run(
        [
            "/usr/bin/rpm",
            "-q",
            "--qf",
            "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\\n",
            package_name,
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    if completed.returncode != 0:
        return None
    try:
        lines = completed.stdout.decode("ascii", errors="strict").splitlines()
    except UnicodeError as exc:
        raise DeploymentError("package_invalid", "installed package identity is invalid") from exc
    if len(lines) != 1 or len(lines[0]) > 256 or CONTROL_RE.search(lines[0]):
        raise DeploymentError("package_invalid", "installed package identity is invalid")
    return lines[0]


def docker_package_snapshot() -> dict[str, str | None]:
    return {
        package_name: installed_package_nevra(package_name)
        for package_name in DOCKER_PACKAGE_NEVRAS
    }


def docker_transaction_package_snapshot() -> dict[str, str | None]:
    return {
        package_name: installed_package_nevra(package_name)
        for package_name in DOCKER_TRANSACTION_NEVRAS
    }


def unit_is_loaded(unit: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return completed.returncode == 0 and completed.stdout.strip() not in {b"", b"not-found"}


def network_link_exists(name: str) -> bool:
    reviewed_links = {
        contract["bridge_name"] for contract in ZULIP_DOCKER_NETWORKS.values()
    }
    if name not in {"docker0", *reviewed_links}:
        raise DeploymentError("docker_conflict", "an unreviewed network link was queried")
    return os.path.lexists(Path("/sys/class/net") / name)


def local_inference_snapshot() -> dict[str, dict[str, bool]]:
    return {
        unit: {
            "loaded": unit_is_loaded(unit),
            "active": systemctl_state(unit, "is-active"),
            "enabled": systemctl_state(unit, "is-enabled"),
        }
        for unit in LOCAL_INFERENCE_UNITS
    }


def local_inference_status() -> str:
    snapshot = local_inference_snapshot()
    if any(item["active"] for item in snapshot.values()):
        return "active"
    if any(item["enabled"] for item in snapshot.values()):
        return "enabled"
    if any(item["loaded"] for item in snapshot.values()):
        return "disabled"
    return "absent"


def validate_finance_identity(*, allow_absent: bool) -> str:
    try:
        finance_user = pwd.getpwnam(FINANCE_WORKER_USER)
    except KeyError:
        finance_user = None
    try:
        finance_group = grp.getgrnam(FINANCE_WORKER_GROUP)
    except KeyError:
        finance_group = None
    if finance_user is None and finance_group is None and allow_absent:
        return "absent"
    if finance_user is None or finance_group is None:
        raise DeploymentError(
            "preflight_failed" if allow_absent else "health_failed",
            "provider-finance identity is incomplete",
        )
    try:
        client_user = pwd.getpwnam(FINANCE_CLIENT_USER)
    except KeyError as exc:
        raise DeploymentError(
            "preflight_failed" if allow_absent else "health_failed",
            "provider-finance client identity is absent",
        ) from exc
    if (
        finance_user.pw_gid != finance_group.gr_gid
        or finance_user.pw_uid == client_user.pw_uid
        or finance_user.pw_dir != "/nonexistent"
        or finance_user.pw_shell != "/usr/sbin/nologin"
        or finance_group.gr_mem != [FINANCE_CLIENT_USER]
    ):
        raise DeploymentError(
            "preflight_failed" if allow_absent else "health_failed",
            "provider-finance identity differs from review",
        )
    return "present"


def validate_finance_socket() -> None:
    validate_finance_identity(allow_absent=False)
    finance_user = pwd.getpwnam(FINANCE_WORKER_USER)
    finance_group = grp.getgrnam(FINANCE_WORKER_GROUP)
    runtime_directory = FINANCE_SOCKET.parent
    try:
        directory_metadata = os.lstat(runtime_directory)
        socket_metadata = os.lstat(FINANCE_SOCKET)
    except OSError as exc:
        raise DeploymentError("health_failed", "provider-finance socket is unavailable") from exc
    if (
        not stat.S_ISDIR(directory_metadata.st_mode)
        or stat.S_ISLNK(directory_metadata.st_mode)
        or directory_metadata.st_uid != finance_user.pw_uid
        or directory_metadata.st_gid != finance_group.gr_gid
        or stat.S_IMODE(directory_metadata.st_mode) != 0o750
        or not stat.S_ISSOCK(socket_metadata.st_mode)
        or stat.S_ISLNK(socket_metadata.st_mode)
        or socket_metadata.st_uid != finance_user.pw_uid
        or socket_metadata.st_gid != finance_group.gr_gid
        or stat.S_IMODE(socket_metadata.st_mode) != int(FINANCE_SOCKET_MODE, 8)
    ):
        raise DeploymentError("health_failed", "provider-finance socket metadata differs from review")


def validate_alertmanager_query_socket() -> None:
    try:
        socket_metadata = os.lstat(ALERTMANAGER_QUERY_SOCKET)
        query_group = grp.getgrnam("zulipbridge")
    except (OSError, KeyError) as exc:
        raise DeploymentError(
            "health_failed", "Alertmanager query socket is unavailable"
        ) from exc
    if (
        not stat.S_ISSOCK(socket_metadata.st_mode)
        or stat.S_ISLNK(socket_metadata.st_mode)
        or socket_metadata.st_uid != 0
        or socket_metadata.st_gid != query_group.gr_gid
        or stat.S_IMODE(socket_metadata.st_mode) != 0o660
    ):
        raise DeploymentError(
            "health_failed", "Alertmanager query socket metadata differs from review"
        )


def restore_finance_identity(metadata: dict[str, Any]) -> None:
    prior = metadata.get("finance_identity_before")
    if prior not in {"absent", "present"}:
        raise DeploymentError("rollback_failed", "saved provider-finance identity state is invalid")
    if prior == "present":
        try:
            validate_finance_identity(allow_absent=False)
        except DeploymentError as exc:
            raise DeploymentError(
                "rollback_failed", "provider-finance identity did not return to its prior state"
            ) from exc
        return

    if FINANCE_SOCKET.parent.exists() or FINANCE_SOCKET.parent.is_symlink():
        raise DeploymentError(
            "rollback_failed", "provider-finance runtime remained before identity rollback"
        )

    try:
        finance_user = pwd.getpwnam(FINANCE_WORKER_USER)
    except KeyError:
        finance_user = None
    try:
        finance_group = grp.getgrnam(FINANCE_WORKER_GROUP)
    except KeyError:
        finance_group = None
    if finance_user is not None:
        if finance_group is None:
            raise DeploymentError("rollback_failed", "provider-finance identity is unsafe to remove")
        try:
            client_user = pwd.getpwnam(FINANCE_CLIENT_USER)
        except KeyError as exc:
            raise DeploymentError(
                "rollback_failed", "provider-finance identity is unsafe to remove"
            ) from exc
        if (
            finance_user.pw_gid != finance_group.gr_gid
            or finance_user.pw_uid == client_user.pw_uid
            or finance_user.pw_dir != "/nonexistent"
            or finance_user.pw_shell != "/usr/sbin/nologin"
            or any(member != FINANCE_CLIENT_USER for member in finance_group.gr_mem)
        ):
            raise DeploymentError("rollback_failed", "provider-finance identity is unsafe to remove")
        run_command(
            "rollback-provider-finance-user",
            ["/usr/sbin/userdel", FINANCE_WORKER_USER],
            timeout=120,
        )
    try:
        remaining_group = grp.getgrnam(FINANCE_WORKER_GROUP)
    except KeyError:
        remaining_group = None
    if remaining_group is not None:
        if any(member != FINANCE_CLIENT_USER for member in remaining_group.gr_mem):
            raise DeploymentError("rollback_failed", "provider-finance group is unsafe to remove")
        run_command(
            "rollback-provider-finance-group",
            ["/usr/sbin/groupdel", FINANCE_WORKER_GROUP],
            timeout=120,
        )
    try:
        pwd.getpwnam(FINANCE_WORKER_USER)
        identity_absent = False
    except KeyError:
        identity_absent = True
    try:
        grp.getgrnam(FINANCE_WORKER_GROUP)
        group_absent = False
    except KeyError:
        group_absent = True
    if not identity_absent or not group_absent:
        raise DeploymentError("rollback_failed", "provider-finance identity remained after rollback")


def disable_local_inference(metadata: dict[str, Any]) -> None:
    prior = metadata.get("local_inference_before")
    if not isinstance(prior, dict) or set(prior) != set(LOCAL_INFERENCE_UNITS):
        raise DeploymentError(
            "local_inference_changed",
            "saved local inference state is invalid",
        )
    for item in prior.values():
        if (
            not isinstance(item, dict)
            or set(item) != {"loaded", "active", "enabled"}
            or not all(isinstance(value, bool) for value in item.values())
        ):
            raise DeploymentError(
                "local_inference_changed",
                "saved local inference state is invalid",
            )
    if prior != local_inference_snapshot():
        raise DeploymentError(
            "local_inference_changed",
            "local inference state changed after the deployment snapshot",
        )
    for unit in LOCAL_INFERENCE_UNITS:
        if prior[unit]["loaded"]:
            run_command(
                f"disable-local-inference-{unit}",
                ["/usr/bin/systemctl", "disable", "--now", unit],
                timeout=180,
            )
    if local_inference_status() not in {"disabled", "absent"}:
        raise DeploymentError("health_failed", "local inference remains in the runtime path")


def restore_local_inference(metadata: dict[str, Any]) -> None:
    prior = metadata.get("local_inference_before")
    if not isinstance(prior, dict) or set(prior) != set(LOCAL_INFERENCE_UNITS):
        raise DeploymentError("rollback_failed", "saved local inference state is invalid")
    for unit in LOCAL_INFERENCE_UNITS:
        item = prior[unit]
        if (
            not isinstance(item, dict)
            or set(item) != {"loaded", "active", "enabled"}
            or not all(isinstance(value, bool) for value in item.values())
        ):
            raise DeploymentError("rollback_failed", "saved local inference state is invalid")
        if unit_is_loaded(unit) != item["loaded"]:
            raise DeploymentError("rollback_failed", "local inference unit presence changed")
        if not item["loaded"]:
            continue
        enable_operation = "enable" if item["enabled"] else "disable"
        run_command(
            f"restore-{enable_operation}-{unit}",
            ["/usr/bin/systemctl", enable_operation, unit],
            timeout=120,
        )
        active_operation = "start" if item["active"] else "stop"
        run_command(
            f"restore-{active_operation}-{unit}",
            ["/usr/bin/systemctl", active_operation, unit],
            timeout=180,
        )
    if local_inference_snapshot() != prior:
        raise DeploymentError(
            "rollback_failed", "local inference did not return to its prior state"
        )


def docker_compose_works() -> bool:
    completed = subprocess.run(
        ["/usr/bin/docker", "compose", "version"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return completed.returncode == 0


def docker_is_rootful() -> bool:
    try:
        completed = subprocess.run(
            ["/usr/bin/docker", "info", "--format", "{{json .SecurityOptions}}"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
    except FileNotFoundError:
        if os.path.lexists("/usr/bin/docker"):
            raise
        return False
    return completed.returncode == 0 and b"rootless" not in completed.stdout.lower()


def validate_docker_daemon_config(*, required: bool) -> None:
    if not DOCKER_DAEMON_CONFIG.exists():
        if required:
            raise DeploymentError(
                "docker_conflict", "the reviewed Docker daemon configuration is absent"
            )
        return
    try:
        metadata = os.lstat(DOCKER_DAEMON_CONFIG)
    except OSError as exc:
        raise DeploymentError(
            "docker_conflict", "the Docker daemon configuration is unavailable"
        ) from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o644
    ):
        raise DeploymentError(
            "docker_conflict", "the Docker daemon configuration metadata is unsafe"
        )
    if read_json(DOCKER_DAEMON_CONFIG, maximum=4096, require_root_owned=True) != DOCKER_DAEMON_CONFIG_DOCUMENT:
        raise DeploymentError(
            "docker_conflict", "the Docker daemon configuration differs from review"
        )


def validate_containerd_package_configuration(*, required: bool) -> None:
    """Accept only the two paths shipped by Fedora's reviewed containerd RPM."""

    if not os.path.lexists(CONTAINERD_CONFIG_ROOT):
        if required:
            raise DeploymentError(
                "docker_conflict", "the reviewed containerd package configuration is absent"
            )
        return
    if not required:
        raise DeploymentError(
            "docker_conflict", "containerd configuration exists before package installation"
        )
    try:
        root_metadata = os.lstat(CONTAINERD_CONFIG_ROOT)
        children = list(os.scandir(CONTAINERD_CONFIG_ROOT))
        file_metadata = os.lstat(CONTAINERD_CONFIG_FILE)
    except OSError as exc:
        raise DeploymentError(
            "docker_conflict", "the containerd package configuration is unavailable"
        ) from exc
    if (
        not stat.S_ISDIR(root_metadata.st_mode)
        or stat.S_ISLNK(root_metadata.st_mode)
        or root_metadata.st_uid != 0
        or root_metadata.st_gid != 0
        or stat.S_IMODE(root_metadata.st_mode) & 0o022
        or len(children) != 1
        or children[0].name != CONTAINERD_CONFIG_FILE.name
        or children[0].is_symlink()
        or not stat.S_ISREG(file_metadata.st_mode)
        or stat.S_ISLNK(file_metadata.st_mode)
        or file_metadata.st_uid != 0
        or file_metadata.st_gid != 0
        or stat.S_IMODE(file_metadata.st_mode) & 0o022
    ):
        raise DeploymentError(
            "docker_conflict", "the containerd package configuration differs from review"
        )
    owner = subprocess.run(
        ["/usr/bin/rpm", "-qf", "--qf", "%{NAME}", str(CONTAINERD_CONFIG_FILE)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    if owner.returncode != 0 or owner.stdout != b"containerd":
        raise DeploymentError(
            "docker_conflict", "the containerd configuration is not owned by its reviewed RPM"
        )


def docker_rollback_preset_parent_exists() -> bool:
    if not os.path.lexists(DOCKER_ROLLBACK_PRESET_PARENT):
        return False
    try:
        metadata = os.lstat(DOCKER_ROLLBACK_PRESET_PARENT)
    except OSError as exc:
        raise DeploymentError(
            "docker_conflict", "the systemd preset parent is unavailable"
        ) from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) & 0o022
    ):
        raise DeploymentError("docker_conflict", "the systemd preset parent is unsafe")
    return True


def verify_docker_package_payloads() -> None:
    completed = subprocess.run(
        [
            "/usr/bin/rpm",
            "-V",
            *sorted(
                (
                    *DOCKER_PACKAGE_NEVRAS,
                    "containerd",
                    "runc",
                    "moby-filesystem",
                    "container-selinux",
                    "iptables-nft",
                )
            ),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=120,
    )
    if completed.returncode != 0 or completed.stdout.strip():
        raise DeploymentError(
            "docker_conflict", "a reviewed Docker package payload was modified"
        )


def validate_docker_host_configuration(*, installed: bool) -> None:
    forbidden = (
        Path("/etc/systemd/system/containerd.service.d"),
        Path("/etc/systemd/system/docker.service.d"),
        Path("/etc/systemd/system/docker.socket.d"),
        Path("/run/systemd/system/containerd.service.d"),
        Path("/run/systemd/system/docker.service.d"),
        Path("/run/systemd/system/docker.socket.d"),
    )
    if any(path.exists() or path.is_symlink() for path in forbidden):
        raise DeploymentError(
            "docker_conflict", "an unreviewed Docker or containerd override is present"
        )
    docker_rollback_preset_parent_exists()
    validate_containerd_package_configuration(required=installed)
    validate_docker_daemon_config(required=installed)
    if installed:
        try:
            direct_metadata = os.lstat(DOCKER_FIREWALL_DIRECT)
            direct_payload = DOCKER_FIREWALL_DIRECT.read_bytes()
        except OSError as exc:
            raise DeploymentError(
                "docker_network_conflict", "the reviewed Docker firewall guard is absent"
            ) from exc
        if (
            not stat.S_ISREG(direct_metadata.st_mode)
            or stat.S_ISLNK(direct_metadata.st_mode)
            or direct_metadata.st_uid != 0
            or stat.S_IMODE(direct_metadata.st_mode) != 0o600
            or direct_payload != DOCKER_FIREWALL_DIRECT_BYTES
        ):
            raise DeploymentError(
                "docker_network_conflict", "the reviewed Docker firewall guard differs"
            )
        for generated_path in (DOCKER_FIREWALL_ZONE, DOCKER_FIREWALL_POLICY):
            try:
                generated = os.lstat(generated_path)
            except OSError as exc:
                raise DeploymentError(
                    "docker_network_conflict", "Docker firewalld integration is incomplete"
                ) from exc
            if (
                not stat.S_ISREG(generated.st_mode)
                or stat.S_ISLNK(generated.st_mode)
                or generated.st_uid != 0
                or stat.S_IMODE(generated.st_mode) & 0o022
            ):
                raise DeploymentError(
                    "docker_network_conflict", "Docker firewalld integration is unsafe"
                )
        verify_docker_package_payloads()


def validate_preinstalled_docker_dependencies(
    dependencies: dict[str, str | None],
) -> None:
    for package_name in DOCKER_PREINSTALLED_DEPENDENCIES:
        if dependencies.get(package_name) != DOCKER_DEPENDENCY_NEVRAS[package_name]:
            raise DeploymentError(
                "docker_conflict",
                "a reviewed host-level Docker dependency must already be installed",
            )
    completed = subprocess.run(
        ["/usr/bin/rpm", "-V", *DOCKER_PREINSTALLED_DEPENDENCIES],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=120,
    )
    if completed.returncode != 0 or completed.stdout.strip():
        raise DeploymentError(
            "docker_conflict",
            "a reviewed host-level Docker dependency payload was modified",
        )


def _normalized_firewalld_listing(arguments: list[str]) -> bytes:
    completed = subprocess.run(
        ["/usr/bin/firewall-cmd", *arguments],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=60,
    )
    if completed.returncode != 0 or len(completed.stdout) > 1024 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "firewalld configuration is unavailable"
        )
    return re.sub(
        rb" \((?:default(?:, active)?|active|disabled)\)(?=\n)",
        b"",
        completed.stdout,
    ).strip() + b"\n"


def _normalized_firewalld_direct(*, permanent: bool) -> bytes:
    prefix = ["--permanent"] if permanent else []
    records: list[bytes] = []
    for operation in (
        "--get-all-chains",
        "--get-all-rules",
        "--get-all-passthroughs",
    ):
        records.append(
            _normalized_firewalld_listing([*prefix, "--direct", operation])
        )
    return b"".join(records)


def validate_firewalld_nft_backend() -> None:
    path = Path("/etc/firewalld/firewalld.conf")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError(
            "docker_network_conflict", "firewalld backend configuration is unavailable"
        ) from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) & 0o022
            or metadata.st_size > 256 * 1024
        ):
            raise DeploymentError(
                "docker_network_conflict", "firewalld backend configuration is unsafe"
            )
        raw = os.read(descriptor, 256 * 1024 + 1)
    finally:
        os.close(descriptor)
    if len(raw) > 256 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "firewalld backend configuration is oversized"
        )
    try:
        lines = raw.decode("utf-8", errors="strict").splitlines()
    except UnicodeError as exc:
        raise DeploymentError(
            "docker_network_conflict", "firewalld backend configuration is invalid"
        ) from exc
    values: list[str] = []
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if separator and key.strip() == "FirewallBackend":
            values.append(value.strip())
    # firewalld 2.4 defaults to nftables when the setting is omitted. An
    # explicit duplicate is rejected rather than relying on parser ordering.
    if len(values) > 1 or (values and values[0] != "nftables"):
        raise DeploymentError(
            "docker_network_conflict", "firewalld is not using its nftables backend"
        )


def firewalld_snapshot(*, require_synchronized: bool) -> dict[str, str]:
    validate_firewalld_nft_backend()
    state = subprocess.run(
        ["/usr/bin/firewall-cmd", "--state"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    if state.returncode != 0 or state.stdout.strip() != b"running":
        raise DeploymentError("docker_network_conflict", "firewalld is not running")
    runtime_zones = _normalized_firewalld_listing(["--list-all-zones"])
    permanent_zones = _normalized_firewalld_listing(
        ["--permanent", "--list-all-zones"]
    )
    runtime_policies = _normalized_firewalld_listing(["--list-all-policies"])
    permanent_policies = _normalized_firewalld_listing(
        ["--permanent", "--list-all-policies"]
    )
    runtime_direct = _normalized_firewalld_direct(permanent=False)
    permanent_direct = _normalized_firewalld_direct(permanent=True)
    if require_synchronized and (
        runtime_zones != permanent_zones
        or runtime_policies != permanent_policies
        or runtime_direct != permanent_direct
    ):
        raise DeploymentError(
            "docker_network_conflict",
            "firewalld has uncommitted runtime-only configuration",
        )
    default_zone = subprocess.run(
        ["/usr/bin/firewall-cmd", "--get-default-zone"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    if default_zone.returncode != 0 or not re.fullmatch(
        rb"[A-Za-z0-9_.-]{1,64}\n?", default_zone.stdout
    ):
        raise DeploymentError(
            "docker_network_conflict", "firewalld default zone is invalid"
        )
    return {
        "runtime_zones_sha256": hashlib.sha256(runtime_zones).hexdigest(),
        "permanent_zones_sha256": hashlib.sha256(permanent_zones).hexdigest(),
        "runtime_policies_sha256": hashlib.sha256(runtime_policies).hexdigest(),
        "permanent_policies_sha256": hashlib.sha256(permanent_policies).hexdigest(),
        "runtime_direct_sha256": hashlib.sha256(runtime_direct).hexdigest(),
        "permanent_direct_sha256": hashlib.sha256(permanent_direct).hexdigest(),
        "default_zone": default_zone.stdout.decode("ascii").strip(),
    }


def nft_ruleset_document() -> dict[str, Any]:
    completed = subprocess.run(
        ["/usr/sbin/nft", "--json", "--handle", "list", "ruleset"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=60,
    )
    if completed.returncode != 0 or len(completed.stdout) > 8 * 1024 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "the nftables ruleset is unavailable"
        )
    try:
        document = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "the nftables ruleset is invalid"
        ) from exc

    return document


def nft_document_sha256(document: dict[str, Any]) -> str:
    def stable(value: Any) -> Any:
        if isinstance(value, dict):
            return {
                key: stable(item)
                for key, item in sorted(value.items())
                if key not in {"bytes", "handle", "packets"}
            }
        if isinstance(value, list):
            return [stable(item) for item in value]
        return value

    payload = json.dumps(stable(document), sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(payload).hexdigest()


def nft_ruleset_sha256() -> str:
    return nft_document_sha256(nft_ruleset_document())


def empty_docker_nft_cleanup(document: dict[str, Any], expected: str) -> list[dict[str, str]]:
    """Find only empty compatibility tables whose removal exactly restores the WAL hash."""
    if nft_document_sha256(document) == expected:
        return []
    entries = document.get("nftables", [])
    candidates = []
    for entry in entries:
        table = entry.get("table")
        if not isinstance(table, dict) or set(table) - {"family", "name", "handle"}:
            continue
        if table.get("family") not in {"ip", "ip6"} or table.get("name") not in {"filter", "nat", "raw"}:
            continue
        if any(isinstance(value, dict) and value.get("family") == table["family"]
               and value.get("table") == table["name"]
               for item in entries for value in item.values()):
            continue
        candidates.append(entry)
    for count in range(1, len(candidates) + 1):
        for subset in itertools.combinations(candidates, count):
            projected = {**document, "nftables": [entry for entry in entries if entry not in subset]}
            if nft_document_sha256(projected) == expected:
                return [{"family": entry["table"]["family"], "name": entry["table"]["name"]} for entry in subset]
    raise DeploymentError("rollback_failed", "nftables differs beyond empty Docker compatibility tables")


def restore_empty_docker_nft_tables(expected: str) -> None:
    tables = empty_docker_nft_cleanup(nft_ruleset_document(), expected)
    if not tables:
        return
    if any(state["active"] for state in docker_service_snapshot().values()):
        raise DeploymentError("rollback_failed", "Docker must be stopped before empty table cleanup")
    # One nft batch commits all deletions atomically. The deployment lock is held
    # by the caller; the historical baseline is never rewritten.
    batch = "; ".join(f"delete table {table['family']} {table['name']}" for table in tables)
    run_command("rollback-remove-empty-docker-nft-tables", ["/usr/sbin/nft", batch], timeout=60)
    if nft_ruleset_sha256() != expected:
        raise DeploymentError("rollback_failed", "nftables baseline differs after empty table cleanup")


def docker_network_sysctl_snapshot() -> dict[str, int]:
    result: dict[str, int] = {}
    for key in DOCKER_NETWORK_SYSCTLS:
        completed = subprocess.run(
            ["/usr/sbin/sysctl", "-n", key],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        if completed.returncode != 0 or completed.stdout.strip() not in {b"0", b"1"}:
            raise DeploymentError(
                "docker_network_conflict", "a required network sysctl is invalid"
            )
        result[key] = int(completed.stdout.strip())
    return result


def iptables_alternatives_snapshot() -> dict[str, str]:
    completed = subprocess.run(
        ["/usr/bin/alternatives", "--display", "iptables"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    if completed.returncode != 0 or len(completed.stdout) > 64 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "iptables alternatives state is unavailable"
        )
    text_value = completed.stdout.decode("utf-8", errors="strict")
    mode_match = re.search(r"^iptables - status is (auto|manual)\.$", text_value, re.MULTILINE)
    current_match = re.search(r"^ link currently points to (/[A-Za-z0-9_./+-]+)$", text_value, re.MULTILINE)
    if mode_match is None or current_match is None:
        raise DeploymentError(
            "docker_network_conflict", "iptables alternatives state is invalid"
        )
    return {
        "mode": mode_match.group(1),
        "current": current_match.group(1),
        "sha256": hashlib.sha256(completed.stdout).hexdigest(),
    }


def validate_docker_user_firewall() -> None:
    completed = subprocess.run(
        ["/usr/sbin/iptables-nft", "-S", "DOCKER-USER"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    expected = b"""-N DOCKER-USER
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A DOCKER-USER -i zulip-backend -o zulip-backend -j ACCEPT
-A DOCKER-USER -i zulip-frontend -o zulip-frontend -j ACCEPT
-A DOCKER-USER -i zulip-backend ! -o zulip-backend -j DROP
-A DOCKER-USER -i zulip-frontend ! -o zulip-frontend -j DROP
-A DOCKER-USER -o zulip-backend -j DROP
-A DOCKER-USER -o zulip-frontend -j DROP
-A DOCKER-USER -j RETURN
"""
    if completed.returncode != 0 or completed.stdout != expected:
        raise DeploymentError(
            "docker_network_conflict", "Docker ingress/egress firewall differs from review"
        )
    forward = subprocess.run(
        ["/usr/sbin/iptables-nft", "-S", "FORWARD"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if forward.returncode != 0 or len(forward.stdout) > 64 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "Docker FORWARD firewall is unavailable"
        )
    forward_rules = [
        line for line in forward.stdout.splitlines() if line.startswith(b"-A FORWARD ")
    ]
    if (
        not forward_rules
        or forward_rules[0] != b"-A FORWARD -j DOCKER-USER"
        or forward_rules.count(b"-A FORWARD -j DOCKER-USER") != 1
    ):
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall guard is not the first FORWARD rule"
        )
    input_chain = subprocess.run(
        ["/usr/sbin/iptables-nft", "-S", "OPS-ZULIP-INPUT"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    expected_input = b"""-N OPS-ZULIP-INPUT
-A OPS-ZULIP-INPUT -i zulip-backend -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A OPS-ZULIP-INPUT -i zulip-frontend -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A OPS-ZULIP-INPUT -i zulip-backend -j DROP
-A OPS-ZULIP-INPUT -i zulip-frontend -j DROP
-A OPS-ZULIP-INPUT -j RETURN
"""
    if input_chain.returncode != 0 or input_chain.stdout != expected_input:
        raise DeploymentError(
            "docker_network_conflict", "Docker container-to-host firewall differs from review"
        )
    input_rules = subprocess.run(
        ["/usr/sbin/iptables-nft", "-S", "INPUT"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    effective_input = [
        line for line in input_rules.stdout.splitlines() if line.startswith(b"-A INPUT ")
    ]
    guard = b"-A INPUT -j OPS-ZULIP-INPUT"
    zone_indexes = [
        index for index, line in enumerate(effective_input) if b"INPUT_ZONES" in line
    ]
    if (
        input_rules.returncode != 0
        or not effective_input
        or effective_input[0] != guard
        or effective_input.count(guard) != 1
        or (zone_indexes and effective_input.index(guard) > min(zone_indexes))
    ):
        raise DeploymentError(
            "docker_network_conflict", "Docker container-to-host guard is not first"
        )


def docker_firewalld_reloaded_at() -> str | None:
    completed = subprocess.run(
        [
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--max-filesize",
            str(MAX_HEALTH_RESPONSE_BYTES),
            "--noproxy",
            "*",
            "--proto",
            "=http",
            "--unix-socket",
            "/run/docker.sock",
            "http://localhost/v1.55/info",
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    if completed.returncode != 0 or len(completed.stdout) > MAX_HEALTH_RESPONSE_BYTES:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall reload state is unavailable"
        )
    try:
        document = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall reload state is invalid"
        ) from exc
    if not isinstance(document, dict):
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall reload state is invalid"
        )
    backend = document.get("FirewallBackend")
    if not isinstance(backend, dict) or set(backend) != {"Driver", "Info"}:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall backend differs from review"
        )
    if backend.get("Driver") != "iptables+firewalld" or not isinstance(
        backend.get("Info"), list
    ):
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall backend differs from review"
        )
    values = [
        item[1]
        for item in backend["Info"]
        if isinstance(item, list)
        and len(item) == 2
        and item[0] == "ReloadedAt"
        and isinstance(item[1], str)
    ]
    if len(values) > 1 or (
        values
        and not re.fullmatch(
            r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})",
            values[0],
        )
    ):
        raise DeploymentError(
            "docker_network_conflict", "Docker firewall reload timestamp is invalid"
        )
    return values[0] if values else None


def reload_firewalld_with_docker_barrier() -> None:
    before = docker_firewalld_reloaded_at()
    # ReloadedAt is second-granularity on the reviewed Moby build. Move into a
    # later wall-clock second before requesting reload so equality is not
    # ambiguous, then wait for the daemon's asynchronous callback to finish.
    initial_second = int(time.time())
    second_deadline = time.monotonic() + 2
    while int(time.time()) == initial_second:
        if time.monotonic() >= second_deadline:
            raise DeploymentError(
                "docker_network_conflict", "wall clock did not advance before firewall reload"
            )
        time.sleep(0.05)
    run_command(
        "reload-docker-firewall",
        ["/usr/bin/firewall-cmd", "--reload"],
        timeout=180,
    )
    deadline = time.monotonic() + 30
    while True:
        current = docker_firewalld_reloaded_at()
        if current is not None and current != before:
            return
        if time.monotonic() >= deadline:
            raise DeploymentError(
                "docker_network_conflict", "Docker did not finish its firewall reload"
            )
        time.sleep(0.1)


def _firewall_value(arguments: list[str]) -> str:
    completed = subprocess.run(
        ["/usr/bin/firewall-cmd", *arguments],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or len(completed.stdout) > 4096:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewalld state is unavailable"
        )
    try:
        value = completed.stdout.decode("ascii", errors="strict").strip()
    except UnicodeError as exc:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewalld state is invalid"
        ) from exc
    if CONTROL_RE.search(value):
        raise DeploymentError(
            "docker_network_conflict", "Docker firewalld state is invalid"
        )
    return value


def validate_moby_firewalld_contract(*, require_bridges: bool) -> None:
    if _firewall_value(["--permanent", "--zone=docker", "--get-target"]) != "ACCEPT":
        raise DeploymentError(
            "docker_network_conflict", "Docker firewalld zone target differs"
        )
    if _firewall_value(["--permanent", "--policy=docker-forwarding", "--get-target"]) != "ACCEPT":
        raise DeploymentError(
            "docker_network_conflict", "Docker forwarding policy target differs"
        )
    ingress = set(
        _firewall_value(
            ["--permanent", "--policy=docker-forwarding", "--list-ingress-zones"]
        ).split()
    )
    egress = set(
        _firewall_value(
            ["--permanent", "--policy=docker-forwarding", "--list-egress-zones"]
        ).split()
    )
    if ingress != {"ANY"} or egress != {"docker"}:
        raise DeploymentError(
            "docker_network_conflict", "Docker forwarding policy differs from review"
        )
    runtime_interfaces = set(
        _firewall_value(["--zone=docker", "--list-interfaces"]).split()
    )
    expected_interfaces = (
        {
            contract["bridge_name"]
            for contract in ZULIP_DOCKER_NETWORKS.values()
        }
        if require_bridges
        else set()
    )
    if runtime_interfaces != expected_interfaces:
        raise DeploymentError(
            "docker_network_conflict", "Docker firewalld bridge inventory differs"
        )


def _docker_network_inspect(names: tuple[str, ...]) -> list[dict[str, Any]]:
    completed = subprocess.run(
        ["/usr/bin/docker", "network", "inspect", *names],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or len(completed.stdout) > 1024 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "Docker network inventory is unavailable"
        )
    try:
        document = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "Docker network inventory is invalid"
        ) from exc
    if (
        not isinstance(document, list)
        or len(document) != len(names)
        or any(not isinstance(item, dict) for item in document)
    ):
        raise DeploymentError(
            "docker_network_conflict", "Docker network inventory is invalid"
        )
    return document


def require_docker_networks_absent() -> None:
    for engine_name, contract in ZULIP_DOCKER_NETWORKS.items():
        completed = subprocess.run(
            ["/usr/bin/docker", "network", "inspect", engine_name],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        if completed.returncode == 0 or completed.returncode not in {1}:
            raise DeploymentError(
                "docker_network_conflict", "a reviewed Docker network name is occupied"
            )
        if network_link_exists(contract["bridge_name"]):
            raise DeploymentError(
                "docker_network_conflict", "a reviewed Docker bridge name is occupied"
            )


def validate_docker_network_inventory() -> None:
    names = tuple(ZULIP_DOCKER_NETWORKS)
    records = _docker_network_inspect(names)
    by_name = {item.get("Name"): item for item in records}
    if set(by_name) != set(names):
        raise DeploymentError(
            "docker_network_conflict", "Docker network names differ from review"
        )
    for engine_name, contract in ZULIP_DOCKER_NETWORKS.items():
        record = by_name[engine_name]
        options = record.get("Options")
        labels = record.get("Labels")
        ipam = record.get("IPAM")
        expected_options = {
            "com.docker.network.bridge.enable_ip_masquerade": "false",
            "com.docker.network.bridge.name": contract["bridge_name"],
        }
        allowed_label_keys = {
            "com.docker.compose.config-hash",
            "com.docker.compose.network",
            "com.docker.compose.project",
            "com.docker.compose.version",
        }
        if (
            record.get("Driver") != "bridge"
            or record.get("EnableIPv4") is not True
            or record.get("EnableIPv6") is not False
            or record.get("Internal") is not contract["internal"]
            or record.get("Attachable") is not False
            or record.get("Ingress") is not False
            or options != expected_options
            or not isinstance(labels, dict)
            or not set(labels).issubset(allowed_label_keys)
            or labels.get("com.docker.compose.project") != "zulip-local"
            or labels.get("com.docker.compose.network")
            != contract["compose_network"]
            or labels.get("com.docker.compose.version") != "5.5.0"
            or not isinstance(ipam, dict)
            or ipam.get("Driver") != "default"
            or ipam.get("Options") not in (None, {})
        ):
            raise DeploymentError(
                "docker_network_conflict", "Docker network contract differs from review"
            )
        config = ipam.get("Config")
        if not isinstance(config, list) or len(config) != 1 or not isinstance(config[0], dict):
            raise DeploymentError(
                "docker_network_conflict", "Docker network IPAM contract is invalid"
            )
        expected_subnet = ipaddress.ip_network(contract["subnet"], strict=True)
        try:
            actual_subnet = ipaddress.ip_network(config[0].get("Subnet"), strict=True)
            gateway = ipaddress.ip_address(config[0].get("Gateway"))
        except (TypeError, ValueError) as exc:
            raise DeploymentError(
                "docker_network_conflict", "Docker network IPAM contract is invalid"
            ) from exc
        if (
            actual_subnet != expected_subnet
            or gateway != expected_subnet.network_address + 1
            or set(config[0]) != {"Subnet", "Gateway"}
            or not network_link_exists(contract["bridge_name"])
        ):
            raise DeploymentError(
                "docker_network_conflict", "Docker network IPAM contract differs from review"
            )


def validate_zulip_container_network_contract() -> None:
    completed = subprocess.run(
        ["/usr/bin/docker", "container", "inspect", *ZULIP_CONTAINER_NAMES],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or len(completed.stdout) > 4 * 1024 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "Zulip container network inventory is unavailable"
        )
    try:
        records = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "Zulip container network inventory is invalid"
        ) from exc
    if not isinstance(records, list) or len(records) != len(ZULIP_CONTAINER_NAMES):
        raise DeploymentError(
            "docker_network_conflict", "Zulip container network inventory is invalid"
        )
    by_name: dict[str, dict[str, Any]] = {}
    for record in records:
        if not isinstance(record, dict) or not isinstance(record.get("Name"), str):
            raise DeploymentError(
                "docker_network_conflict", "Zulip container network inventory is invalid"
            )
        by_name[record["Name"].lstrip("/")] = record
    if set(by_name) != set(ZULIP_CONTAINER_NAMES):
        raise DeploymentError(
            "docker_network_conflict", "Zulip container names differ from review"
        )
    expected_networks = {
        "zulip-local-database-1": {"zulip-local_backend"},
        "zulip-local-memcached-1": {"zulip-local_backend"},
        "zulip-local-rabbitmq-1": {"zulip-local_backend"},
        "zulip-local-redis-1": {"zulip-local_backend"},
        "zulip-local-zulip-1": {
            "zulip-local_backend",
            "zulip-local_frontend",
        },
    }
    expected_binding = {"443/tcp": [{"HostIp": "127.0.0.1", "HostPort": "8443"}]}
    expected_ports = {
        "zulip-local-database-1": {"5432/tcp"},
        "zulip-local-memcached-1": {"11211/tcp"},
        "zulip-local-rabbitmq-1": {
            "4369/tcp", "5671/tcp", "5672/tcp", "15691/tcp",
            "15692/tcp", "25672/tcp",
        },
        "zulip-local-redis-1": {"6379/tcp"},
        "zulip-local-zulip-1": {"25/tcp", "80/tcp", "443/tcp"},
    }
    for name, record in by_name.items():
        host_config = record.get("HostConfig")
        network_settings = record.get("NetworkSettings")
        if not isinstance(host_config, dict) or not isinstance(network_settings, dict):
            raise DeploymentError(
                "docker_network_conflict", "Zulip container network inventory is invalid"
            )
        bindings = host_config.get("PortBindings")
        runtime_ports = network_settings.get("Ports")
        if (
            not isinstance(runtime_ports, dict)
            or set(runtime_ports) != expected_ports[name]
            or host_config.get("Dns") != ["127.0.0.1"]
        ):
            raise DeploymentError(
                "docker_network_conflict", "Zulip container port inventory is invalid"
            )
        if name == "zulip-local-zulip-1":
            if (
                bindings != expected_binding
                or runtime_ports.get("443/tcp") != expected_binding["443/tcp"]
                or any(
                    value is not None and port != "443/tcp"
                    for port, value in runtime_ports.items()
                )
            ):
                raise DeploymentError(
                    "docker_network_conflict", "Zulip HTTPS binding differs from review"
                )
        elif bindings not in (None, {}) or (
            isinstance(runtime_ports, dict)
            and any(value is not None for value in runtime_ports.values())
        ):
            raise DeploymentError(
                "docker_network_conflict", "a Zulip backend port is exposed to the host"
            )
        networks = network_settings.get("Networks")
        if not isinstance(networks, dict) or set(networks) != expected_networks[name]:
            raise DeploymentError(
                "docker_network_conflict", "Zulip container network membership differs"
            )
        for engine_name, endpoint in networks.items():
            if not isinstance(endpoint, dict):
                raise DeploymentError(
                    "docker_network_conflict", "Zulip container endpoint is invalid"
                )
            try:
                address = ipaddress.ip_address(endpoint.get("IPAddress"))
                subnet = ipaddress.ip_network(
                    ZULIP_DOCKER_NETWORKS[engine_name]["subnet"], strict=True
                )
            except (TypeError, ValueError) as exc:
                raise DeploymentError(
                    "docker_network_conflict", "Zulip container endpoint is invalid"
                ) from exc
            if address not in subnet or address == subnet.network_address + 1:
                raise DeploymentError(
                    "docker_network_conflict", "Zulip container endpoint differs from review"
                )


def validate_docker_runtime_network() -> None:
    validate_docker_network_inventory()
    validate_zulip_container_network_contract()
    # Re-evaluate host routes, addresses, and systemd-resolved's effective
    # upstreams after Docker creates the two reviewed bridges.  Only the exact
    # bridge-owned gateway routes/addresses are exempted; a late VPN/LAN/DNS
    # collision is a fail-closed health condition.
    validate_docker_route_baseline(allow_reviewed_docker_routes=True)
    validate_moby_firewalld_contract(require_bridges=True)
    validate_docker_user_firewall()
    if docker_network_sysctl_snapshot() != {
        "net.ipv4.ip_forward": 1,
        "net.ipv6.conf.all.forwarding": 0,
        "net.ipv6.conf.default.forwarding": 0,
    }:
        raise DeploymentError(
            "docker_network_conflict", "Docker changed host forwarding sysctls"
        )
    alternatives = iptables_alternatives_snapshot()
    if alternatives["mode"] != "auto" or alternatives["current"] != "/usr/bin/iptables-nft":
        raise DeploymentError(
            "docker_network_conflict", "Docker changed the reviewed iptables alternative"
        )
    dns_probe = subprocess.run(
        [
            "/usr/bin/docker", "exec", "zulip-local-zulip-1",
            "/usr/bin/python3", "-c",
            (
                "import socket,sys;socket.getaddrinfo('database',5432);"
                "\ntry: socket.getaddrinfo('example.com',443)\n"
                "except socket.gaierror: sys.exit(0)\n"
                "sys.exit(1)"
            ),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=15,
    )
    if dns_probe.returncode != 0:
        raise DeploymentError(
            "docker_network_conflict",
            "Zulip service DNS failed or external DNS forwarding remained enabled",
        )


def validate_docker_network_baseline(
    *, require_firewalld_synchronized: bool,
) -> tuple[dict[str, str], dict[str, int], dict[str, str], str]:
    firewalld = firewalld_snapshot(
        require_synchronized=require_firewalld_synchronized
    )
    sysctls = docker_network_sysctl_snapshot()
    alternatives = iptables_alternatives_snapshot()
    if sysctls != {
        "net.ipv4.ip_forward": 1,
        "net.ipv6.conf.all.forwarding": 0,
        "net.ipv6.conf.default.forwarding": 0,
    }:
        raise DeploymentError(
            "docker_network_conflict", "host forwarding sysctls differ from review"
        )
    if alternatives["mode"] != "auto" or alternatives["current"] != "/usr/bin/iptables-nft":
        raise DeploymentError(
            "docker_network_conflict", "iptables is not the reviewed nft alternative"
        )
    return firewalld, sysctls, alternatives, nft_ruleset_sha256()


def validate_docker_volume_preservation_roots() -> None:
    roots = (Path("/var/lib"), Path("/var/backups"))
    metadata: list[os.stat_result] = []
    for path in roots:
        try:
            item = os.lstat(path)
        except OSError as exc:
            raise DeploymentError(
                "docker_conflict", "Docker volume preservation root is unavailable"
            ) from exc
        if (
            not stat.S_ISDIR(item.st_mode)
            or stat.S_ISLNK(item.st_mode)
            or item.st_uid != 0
        ):
            raise DeploymentError(
                "docker_conflict", "Docker volume preservation root is unsafe"
            )
        metadata.append(item)
    if metadata[0].st_dev != metadata[1].st_dev:
        raise DeploymentError(
            "docker_conflict", "Docker volume preservation cannot use an atomic rename"
        )
    if os.path.lexists(ZULIP_RECOVERED_DATA_ROOT):
        _validate_preserved_volumes_directory(
            ZULIP_RECOVERED_DATA_ROOT, private_parent=True
        )


def _effective_dns_servers() -> set[ipaddress.IPv4Address | ipaddress.IPv6Address]:
    completed = subprocess.run(
        ["/usr/bin/resolvectl", "--json=short", "status"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or len(completed.stdout) > 4 * 1024 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "effective DNS resolver inventory is unavailable"
        )
    try:
        records = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "effective DNS resolver inventory is invalid"
        ) from exc
    if not isinstance(records, list) or any(not isinstance(item, dict) for item in records):
        raise DeploymentError(
            "docker_network_conflict", "effective DNS resolver inventory is invalid"
        )
    addresses: set[ipaddress.IPv4Address | ipaddress.IPv6Address] = set()
    for record in records:
        candidates: list[Any] = []
        servers = record.get("servers")
        if servers is not None:
            if not isinstance(servers, list) or len(servers) > 256:
                raise DeploymentError(
                    "docker_network_conflict", "effective DNS resolver inventory is invalid"
                )
            candidates.extend(servers)
        current = record.get("currentServer")
        if current is not None:
            candidates.append(current)
        for candidate in candidates:
            if not isinstance(candidate, dict):
                raise DeploymentError(
                    "docker_network_conflict", "effective DNS resolver inventory is invalid"
                )
            raw_address = candidate.get("addressString")
            if not isinstance(raw_address, str) or len(raw_address) > 64:
                raise DeploymentError(
                    "docker_network_conflict", "effective DNS resolver inventory is invalid"
                )
            try:
                addresses.add(ipaddress.ip_address(raw_address))
            except ValueError as exc:
                raise DeploymentError(
                    "docker_network_conflict", "effective DNS resolver inventory is invalid"
                ) from exc
    return addresses


def validate_docker_route_baseline(*, allow_reviewed_docker_routes: bool = False) -> None:
    reviewed = [
        ipaddress.ip_network(contract["subnet"], strict=True)
        for contract in ZULIP_DOCKER_NETWORKS.values()
    ]
    for arguments in (
        ["/usr/sbin/ip", "-j", "route", "show", "table", "all"],
        ["/usr/sbin/ip", "-j", "address", "show"],
    ):
        completed = subprocess.run(
            arguments,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if completed.returncode != 0 or len(completed.stdout) > 4 * 1024 * 1024:
            raise DeploymentError(
                "docker_network_conflict", "host route inventory is unavailable"
            )
        try:
            records = json.loads(completed.stdout)
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "docker_network_conflict", "host route inventory is invalid"
            ) from exc
        if not isinstance(records, list) or any(not isinstance(item, dict) for item in records):
            raise DeploymentError(
                "docker_network_conflict", "host route inventory is invalid"
            )
        if "route" in arguments:
            for item in records:
                destination = item.get("dst")
                if destination in (None, "default"):
                    continue
                try:
                    network = ipaddress.ip_network(destination, strict=False)
                except (TypeError, ValueError) as exc:
                    raise DeploymentError(
                        "docker_network_conflict", "host route inventory is invalid"
                    ) from exc
                if not isinstance(network, ipaddress.IPv4Network):
                    continue
                overlapping = [target for target in reviewed if network.overlaps(target)]
                if not overlapping:
                    continue
                if allow_reviewed_docker_routes and len(overlapping) == 1:
                    target = overlapping[0]
                    contract = next(
                        item
                        for item in ZULIP_DOCKER_NETWORKS.values()
                        if ipaddress.ip_network(item["subnet"], strict=True) == target
                    )
                    source = item.get("prefsrc", item.get("src"))
                    if (
                        network.subnet_of(target)
                        and item.get("dev") == contract["bridge_name"]
                        and source == str(target.network_address + 1)
                    ):
                        continue
                raise DeploymentError(
                    "docker_network_conflict", "a reviewed Docker subnet overlaps the host network"
                )
        else:
            for item in records:
                address_info = item.get("addr_info")
                if not isinstance(address_info, list):
                    raise DeploymentError(
                        "docker_network_conflict", "host address inventory is invalid"
                    )
                for address in address_info:
                    if not isinstance(address, dict) or address.get("family") != "inet":
                        continue
                    local = address.get("local")
                    prefixlen = address.get("prefixlen")
                    try:
                        network = ipaddress.ip_network(
                            f"{local}/{prefixlen}", strict=False
                        )
                    except (TypeError, ValueError) as exc:
                        raise DeploymentError(
                            "docker_network_conflict", "host address inventory is invalid"
                        ) from exc
                    overlapping = [target for target in reviewed if network.overlaps(target)]
                    if not overlapping:
                        continue
                    if allow_reviewed_docker_routes and len(overlapping) == 1:
                        target = overlapping[0]
                        contract = next(
                            contract
                            for contract in ZULIP_DOCKER_NETWORKS.values()
                            if ipaddress.ip_network(contract["subnet"], strict=True) == target
                        )
                        if (
                            item.get("ifname") == contract["bridge_name"]
                            and address.get("local") == str(target.network_address + 1)
                            and address.get("prefixlen") == target.prefixlen
                        ):
                            continue
                    raise DeploymentError(
                        "docker_network_conflict", "a reviewed Docker subnet overlaps the host network"
                    )
    try:
        resolver_lines = Path("/etc/resolv.conf").read_text(
            encoding="ascii", errors="strict"
        ).splitlines()
    except (OSError, UnicodeError) as exc:
        raise DeploymentError(
            "docker_network_conflict", "host resolver configuration is unavailable"
        ) from exc
    if sum(len(line) + 1 for line in resolver_lines) > 64 * 1024:
        raise DeploymentError(
            "docker_network_conflict", "host resolver configuration is invalid"
        )
    for line in resolver_lines:
        fields = line.split()
        if not fields or fields[0] != "nameserver":
            continue
        if len(fields) != 2:
            raise DeploymentError(
                "docker_network_conflict", "host resolver configuration is invalid"
            )
        try:
            resolver = ipaddress.ip_address(fields[1])
        except ValueError as exc:
            raise DeploymentError(
                "docker_network_conflict", "host resolver configuration is invalid"
            ) from exc
        if isinstance(resolver, ipaddress.IPv4Address) and any(
            resolver in target for target in reviewed
        ):
            raise DeploymentError(
                "docker_network_conflict", "a reviewed Docker subnet overlaps a DNS resolver"
            )
    if any(
        isinstance(resolver, ipaddress.IPv4Address)
        and any(resolver in target for target in reviewed)
        for resolver in _effective_dns_servers()
    ):
        raise DeploymentError(
            "docker_network_conflict", "a reviewed Docker subnet overlaps an effective DNS resolver"
        )


def validate_saved_docker_network_state(docker_record: dict[str, Any]) -> None:
    firewalld = docker_record.get("firewalld_before")
    if (
        not isinstance(firewalld, dict)
        or set(firewalld)
        != {
            "runtime_zones_sha256",
            "permanent_zones_sha256",
            "runtime_policies_sha256",
            "permanent_policies_sha256",
            "runtime_direct_sha256",
            "permanent_direct_sha256",
            "default_zone",
        }
        or any(
            not isinstance(firewalld[key], str)
            or not SHA256_RE.fullmatch(firewalld[key])
            for key in (
                "runtime_zones_sha256",
                "permanent_zones_sha256",
                "runtime_policies_sha256",
                "permanent_policies_sha256",
                "runtime_direct_sha256",
                "permanent_direct_sha256",
            )
        )
        or not isinstance(firewalld.get("default_zone"), str)
        or not IDENTIFIER_RE.fullmatch(firewalld["default_zone"])
    ):
        raise DeploymentError("rollback_failed", "saved firewalld state is invalid")
    sysctls = docker_record.get("sysctls_before")
    if (
        not isinstance(sysctls, dict)
        or set(sysctls) != set(DOCKER_NETWORK_SYSCTLS)
        or any(value not in {0, 1} for value in sysctls.values())
    ):
        raise DeploymentError("rollback_failed", "saved network sysctls are invalid")
    alternatives = docker_record.get("iptables_alternatives_before")
    if (
        not isinstance(alternatives, dict)
        or set(alternatives) != {"mode", "current", "sha256"}
        or alternatives.get("mode") not in {"auto", "manual"}
        or not isinstance(alternatives.get("current"), str)
        or not alternatives["current"].startswith("/")
        or not isinstance(alternatives.get("sha256"), str)
        or not SHA256_RE.fullmatch(alternatives["sha256"])
    ):
        raise DeploymentError(
            "rollback_failed", "saved iptables alternatives state is invalid"
        )
    nft_digest = docker_record.get("nft_ruleset_sha256_before")
    if not isinstance(nft_digest, str) or not SHA256_RE.fullmatch(nft_digest):
        raise DeploymentError("rollback_failed", "saved nftables state is invalid")


def verify_docker_network_rollback(
    docker_record: dict[str, Any], *, reload_firewalld: bool
) -> None:
    validate_saved_docker_network_state(docker_record)
    if reload_firewalld:
        run_command(
            "rollback-reload-firewalld",
            ["/usr/bin/firewall-cmd", "--reload"],
            timeout=180,
        )
    current_firewalld = firewalld_snapshot(require_synchronized=True)
    if current_firewalld != docker_record["firewalld_before"]:
        raise DeploymentError(
            "rollback_failed", "firewalld did not return to its reviewed baseline"
        )
    if docker_network_sysctl_snapshot() != docker_record["sysctls_before"]:
        raise DeploymentError(
            "rollback_failed", "network sysctls did not return to their reviewed baseline"
        )
    if iptables_alternatives_snapshot() != docker_record["iptables_alternatives_before"]:
        raise DeploymentError(
            "rollback_failed", "iptables alternatives did not return to their baseline"
        )
    if reload_firewalld:
        restore_empty_docker_nft_tables(docker_record["nft_ruleset_sha256_before"])
    if nft_ruleset_sha256() != docker_record["nft_ruleset_sha256_before"]:
        raise DeploymentError(
            "rollback_failed", "nftables did not return to its reviewed baseline"
        )
    reviewed_links = {
        "docker0",
        *(contract["bridge_name"] for contract in ZULIP_DOCKER_NETWORKS.values()),
    }
    if any(network_link_exists(name) for name in reviewed_links):
        raise DeploymentError(
            "rollback_failed", "a transaction-created Docker bridge remained"
        )


def validate_docker_installation(*, require_active: bool) -> str:
    conflicts = [
        name for name in DOCKER_CONFLICT_PACKAGES if installed_package_nevra(name) is not None
    ]
    if conflicts:
        raise DeploymentError("docker_conflict", "a conflicting Docker provider is installed")
    dependencies = {
        name: installed_package_nevra(name) for name in DOCKER_DEPENDENCY_NEVRAS
    }
    if any(
        installed is not None and installed != DOCKER_DEPENDENCY_NEVRAS[name]
        for name, installed in dependencies.items()
    ):
        raise DeploymentError("docker_conflict", "installed Docker dependency versions differ from review")
    validate_preinstalled_docker_dependencies(dependencies)
    packages = docker_package_snapshot()
    installed_count = sum(value is not None for value in packages.values())
    if installed_count == 0:
        if any(path.exists() or path.is_symlink() for path in DOCKER_UNMANAGED_PATHS) or any(
            unit_is_loaded(unit) for unit in DOCKER_SERVICE_UNITS
        ):
            raise DeploymentError("docker_conflict", "an unmanaged Docker runtime is present")
        reviewed_links = {
            "docker0",
            *(contract["bridge_name"] for contract in ZULIP_DOCKER_NETWORKS.values()),
        }
        if any(network_link_exists(name) for name in reviewed_links):
            raise DeploymentError("docker_conflict", "an unmanaged Docker bridge link is present")
        if docker_group_snapshot() is not None:
            raise DeploymentError(
                "docker_conflict", "a pre-existing Docker group is forbidden"
            )
        validate_docker_host_configuration(installed=False)
        if require_active:
            raise DeploymentError("health_failed", "the reviewed Docker runtime is absent")
        return "absent"
    if packages != DOCKER_PACKAGE_NEVRAS:
        raise DeploymentError("docker_conflict", "installed Docker package versions differ from review")
    if dependencies != DOCKER_DEPENDENCY_NEVRAS:
        raise DeploymentError("docker_conflict", "reviewed Docker dependencies are incomplete")
    validate_docker_host_configuration(installed=True)
    if any(not unit_is_loaded(unit) for unit in DOCKER_SERVICE_UNITS):
        raise DeploymentError("docker_conflict", "reviewed Docker systemd units are incomplete")
    if not command_available("/usr/bin/docker") or not docker_compose_works():
        raise DeploymentError("docker_conflict", "the reviewed Docker Compose plugin is unavailable")
    active = systemctl_state(DOCKER_SERVICE, "is-active")
    if require_active and (not active or not docker_is_rootful()):
        raise DeploymentError("health_failed", "the reviewed rootful Docker daemon is unavailable")
    if active and not docker_is_rootful():
        raise DeploymentError("docker_conflict", "the active Docker daemon is not rootful")
    return "active" if active else "installed"


def _bootstrap_recovery_barrier_is_exact(path: Path) -> bool:
    descriptor = -1
    try:
        before = os.lstat(path)
        if (
            not stat.S_ISREG(before.st_mode)
            or stat.S_ISLNK(before.st_mode)
            or before.st_uid != 0
            or before.st_gid != 0
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o644
            or before.st_size != len(BOOTSTRAP_RECOVERY_BARRIER_DROPIN)
        ):
            return False
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or stat.S_ISLNK(opened.st_mode)
            or opened.st_uid != 0
            or opened.st_gid != 0
            or opened.st_nlink != 1
            or stat.S_IMODE(opened.st_mode) != 0o644
            or opened.st_size != len(BOOTSTRAP_RECOVERY_BARRIER_DROPIN)
            or (
                opened.st_dev,
                opened.st_ino,
                opened.st_uid,
                opened.st_gid,
                opened.st_mode,
                opened.st_nlink,
                opened.st_size,
                opened.st_mtime_ns,
                opened.st_ctime_ns,
            )
            != (
                before.st_dev,
                before.st_ino,
                before.st_uid,
                before.st_gid,
                before.st_mode,
                before.st_nlink,
                before.st_size,
                before.st_mtime_ns,
                before.st_ctime_ns,
            )
        ):
            return False
        payload = b""
        while len(payload) <= len(BOOTSTRAP_RECOVERY_BARRIER_DROPIN):
            chunk = os.read(
                descriptor,
                len(BOOTSTRAP_RECOVERY_BARRIER_DROPIN) + 1 - len(payload),
            )
            if not chunk:
                break
            payload += chunk
        after = os.lstat(path)
    except OSError:
        return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return (
        payload == BOOTSTRAP_RECOVERY_BARRIER_DROPIN
        and stat.S_ISREG(after.st_mode)
        and not stat.S_ISLNK(after.st_mode)
        and after.st_uid == 0
        and after.st_gid == 0
        and after.st_nlink == 1
        and stat.S_IMODE(after.st_mode) == 0o644
        and after.st_size == len(BOOTSTRAP_RECOVERY_BARRIER_DROPIN)
        and (
            after.st_dev,
            after.st_ino,
            after.st_uid,
            after.st_gid,
            after.st_mode,
            after.st_nlink,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        )
        == (
            opened.st_dev,
            opened.st_ino,
            opened.st_uid,
            opened.st_gid,
            opened.st_mode,
            opened.st_nlink,
            opened.st_size,
            opened.st_mtime_ns,
            opened.st_ctime_ns,
        )
    )


def validate_initial_zulip_absent(
    *, allow_bootstrap_recovery_barrier: bool = False
) -> None:
    if any(os.path.lexists(path) for path in ZULIP_INITIAL_ABSENT_PATHS):
        raise DeploymentError(
            "docker_conflict", "existing Zulip state requires a future upgrade runbook"
        )
    for unit in ZULIP_INITIAL_UNITS:
        if not unit_is_loaded(unit):
            continue
        expected_sha256 = ZULIP_LEGACY_UNIT_SHA256.get(unit)
        if expected_sha256 is None:
            raise DeploymentError(
                "docker_conflict", "existing Zulip units require a future upgrade runbook"
            )
        unit_path = Path("/etc/systemd/system") / unit
        try:
            item = os.lstat(unit_path)
        except OSError as exc:
            raise DeploymentError(
                "docker_conflict", "a legacy Zulip unit is unavailable"
            ) from exc
        dropins = subprocess.run(
            ["/usr/bin/systemctl", "show", unit, "--property=DropInPaths", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        fragment = subprocess.run(
            ["/usr/bin/systemctl", "show", unit, "--property=FragmentPath", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        active_state = subprocess.run(
            ["/usr/bin/systemctl", "show", unit, "--property=ActiveState", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        unit_file_state = subprocess.run(
            ["/usr/bin/systemctl", "show", unit, "--property=UnitFileState", "--value"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        expected_dropins: list[bytes] = []
        if unit.endswith(".service"):
            expected_dropins.append(
                str(SYSTEMD_GLOBAL_SERVICE_DROPIN).encode("ascii")
            )
            try:
                global_dropin = os.lstat(SYSTEMD_GLOBAL_SERVICE_DROPIN)
            except OSError as exc:
                raise DeploymentError(
                    "docker_conflict", "the global systemd service drop-in is unavailable"
                ) from exc
            if (
                not stat.S_ISREG(global_dropin.st_mode)
                or stat.S_ISLNK(global_dropin.st_mode)
                or global_dropin.st_uid != 0
                or global_dropin.st_gid != 0
                or stat.S_IMODE(global_dropin.st_mode) != 0o644
                or sha256_regular(SYSTEMD_GLOBAL_SERVICE_DROPIN)
                != SYSTEMD_GLOBAL_SERVICE_DROPIN_SHA256
            ):
                raise DeploymentError(
                    "docker_conflict", "the global systemd service drop-in differs from review"
                )
        if allow_bootstrap_recovery_barrier:
            recovery_barrier = (
                unit_path.parent
                / f"{unit}.d"
                / BOOTSTRAP_RECOVERY_BARRIER_FILENAME
            )
            if not _bootstrap_recovery_barrier_is_exact(recovery_barrier):
                raise DeploymentError(
                    "docker_conflict",
                    "a bootstrap recovery barrier differs from review",
                )
            expected_dropins.append(str(recovery_barrier).encode("ascii"))
        observed_dropins = dropins.stdout.strip().split()
        if (
            active_state.returncode != 0
            or active_state.stdout.strip() != b"inactive"
            or unit_file_state.returncode != 0
            or unit_file_state.stdout.strip()
            != ZULIP_LEGACY_UNIT_FILE_STATE[unit].encode("ascii")
            or fragment.returncode != 0
            or fragment.stdout.strip() != str(unit_path).encode("ascii")
            or dropins.returncode != 0
            or len(observed_dropins) != len(expected_dropins)
            or set(observed_dropins) != set(expected_dropins)
            or not stat.S_ISREG(item.st_mode)
            or stat.S_ISLNK(item.st_mode)
            or item.st_uid != 0
            or item.st_gid != 0
            or stat.S_IMODE(item.st_mode) != 0o644
            or sha256_regular(unit_path) != expected_sha256
        ):
            raise DeploymentError(
                "docker_conflict", "a legacy Zulip unit differs from the reviewed dormant baseline"
            )


def dnf_docker_history() -> dict[int, str]:
    completed = subprocess.run(
        [
            "/usr/bin/dnf",
            "history",
            "list",
            "--json",
            "--contains-pkgs=moby-engine,docker-cli,docker-compose",
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
        env={
            "PATH": "/usr/sbin:/usr/bin",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
        },
    )
    if completed.returncode != 0 or len(completed.stdout) > 1024 * 1024:
        raise DeploymentError("package_history_invalid", "Docker package history is unavailable")
    try:
        document = json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("package_history_invalid", "Docker package history is invalid") from exc
    if not isinstance(document, list) or len(document) > 4096:
        raise DeploymentError("package_history_invalid", "Docker package history is invalid")
    transactions: dict[int, str] = {}
    for item in document:
        if not isinstance(item, dict):
            raise DeploymentError("package_history_invalid", "Docker package history is invalid")
        transaction_id = item.get("id")
        transaction_status = item.get("status")
        if (
            isinstance(transaction_id, bool)
            or not isinstance(transaction_id, int)
            or transaction_id < 0
            or not isinstance(transaction_status, str)
            or len(transaction_status) > 32
            or CONTROL_RE.search(transaction_status)
        ):
            raise DeploymentError("package_history_invalid", "Docker package history is invalid")
        transactions[transaction_id] = transaction_status
    return transactions


def validate_saved_docker_packages(value: Any, error_code: str) -> dict[str, str | None]:
    if not isinstance(value, dict) or set(value) != set(DOCKER_TRANSACTION_NEVRAS):
        raise DeploymentError(error_code, "saved Docker package state is invalid")
    for package_name, installed_nevra in value.items():
        if installed_nevra not in {None, DOCKER_TRANSACTION_NEVRAS[package_name]}:
            raise DeploymentError(error_code, "saved Docker package state is invalid")
    top_values = {value[name] for name in DOCKER_PACKAGE_NEVRAS}
    if top_values not in ({None}, set(DOCKER_PACKAGE_NEVRAS.values())):
        raise DeploymentError(error_code, "saved Docker package state is partial")
    return value


def prepare_docker_bundle(
    backup: Path, before_packages: dict[str, str | None]
) -> tuple[list[Path], dict[str, str], str, int]:
    missing_nevras = {
        nevra for package_name, nevra in DOCKER_TRANSACTION_NEVRAS.items()
        if before_packages[package_name] is None
    }
    missing_preinstalled = [
        package_name
        for package_name in DOCKER_PREINSTALLED_DEPENDENCIES
        if before_packages[package_name] is None
    ]
    if missing_preinstalled:
        raise DeploymentError(
            "docker_conflict",
            "a reviewed host-level Docker dependency must be installed before deployment",
        )
    if not missing_nevras:
        return [], {}, hashlib.sha256(b"[]").hexdigest(), 0
    bundle = backup / "docker-rpms"
    bundle.mkdir(mode=0o700, exist_ok=False)
    run_command(
        "resolve-docker-bundle",
        [
            "/usr/bin/dnf",
            "--refresh",
            "--releasever=44",
            "--disablerepo=*",
            "--enablerepo=fedora",
            "--enablerepo=updates",
            "--setopt=install_weak_deps=False",
            "--setopt=gpgcheck=True",
            "download",
            "--resolve",
            "--destdir",
            str(bundle),
            *sorted(missing_nevras),
        ],
        timeout=1800,
    )
    try:
        entries = sorted(bundle.iterdir())
    except OSError as exc:
        raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle is unavailable") from exc
    if not entries or len(entries) > len(DOCKER_TRANSACTION_NEVRAS):
        raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle size differs from review")

    discovered: dict[str, Path] = {}
    digests: dict[str, str] = {}
    total_size = 0
    for path in entries:
        try:
            metadata = os.lstat(path)
        except OSError as exc:
            raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle changed") from exc
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) & 0o022
            or metadata.st_size > MAX_SOURCE_FILE_BYTES
        ):
            raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle contains an unsafe file")
        total_size += metadata.st_size
        if total_size > MAX_SOURCE_TREE_BYTES:
            raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle exceeds its size bound")
        signature = subprocess.run(
            ["/usr/bin/rpmkeys", "--checksig", str(path)],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        identity = subprocess.run(
            [
                "/usr/bin/rpm",
                "-qp",
                "--qf",
                "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}",
                str(path),
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        try:
            nevra = identity.stdout.decode("ascii", errors="strict")
        except UnicodeError as exc:
            raise DeploymentError("docker_bundle_invalid", "Docker RPM identity is invalid") from exc
        if (
            signature.returncode != 0
            or identity.returncode != 0
            or nevra not in missing_nevras
            or nevra in discovered
        ):
            raise DeploymentError(
                "docker_bundle_invalid",
                "Docker dependency resolution differs from the reviewed allowlist",
            )
        discovered[nevra] = path
        digests[nevra] = sha256_regular(path)
    if set(discovered) != missing_nevras:
        raise DeploymentError(
            "docker_bundle_invalid",
            "Docker dependency resolution is incomplete",
        )
    package_paths = [discovered[nevra] for nevra in sorted(discovered)]
    validate_docker_bundle_collisions(package_paths)
    inventory, inventory_sha256 = rpm_non_directory_payload_inventory(
        discovered, error_code="docker_bundle_invalid"
    )
    assert_no_rpm_temporary_payloads(
        inventory, error_code="docker_conflict"
    )
    return package_paths, digests, inventory_sha256, len(inventory)


def validate_saved_docker_bundle(
    metadata: dict[str, Any],
    before_packages: dict[str, str | None],
    bundle_sha256: dict[str, str],
) -> tuple[list[Path], list[tuple[str, int, Path]]]:
    """Re-open the durable offline bundle without trusting filenames or rpmdb."""

    expected_nevras = {
        DOCKER_TRANSACTION_NEVRAS[name]
        for name, before in before_packages.items()
        if before is None
    }
    if set(bundle_sha256) != expected_nevras:
        raise DeploymentError(
            "rollback_failed", "saved Docker bundle does not match the initial package state"
        )
    raw_backup = metadata.get("backup_path")
    if not isinstance(raw_backup, str):
        raise DeploymentError("rollback_failed", "saved Docker backup path is invalid")
    backup = Path(raw_backup)
    if backup.parent != BACKUP_ROOT or not IDENTIFIER_RE.fullmatch(backup.name):
        raise DeploymentError("rollback_failed", "saved Docker backup path is invalid")
    bundle = backup / "docker-rpms"
    validate_private_directory(backup)
    validate_private_directory(bundle)
    try:
        entries = sorted(bundle.iterdir())
    except OSError as exc:
        raise DeploymentError("rollback_failed", "saved Docker bundle is unavailable") from exc
    if len(entries) != len(expected_nevras):
        raise DeploymentError("rollback_failed", "saved Docker bundle inventory differs")
    discovered: dict[str, Path] = {}
    for path in entries:
        try:
            item = os.lstat(path)
        except OSError as exc:
            raise DeploymentError("rollback_failed", "saved Docker bundle changed") from exc
        if (
            not stat.S_ISREG(item.st_mode)
            or stat.S_ISLNK(item.st_mode)
            or item.st_uid != 0
            or stat.S_IMODE(item.st_mode) & 0o022
            or item.st_size > MAX_SOURCE_FILE_BYTES
        ):
            raise DeploymentError("rollback_failed", "saved Docker bundle is unsafe")
        identity = subprocess.run(
            [
                "/usr/bin/rpm", "-qp", "--qf",
                "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}", str(path),
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        signature = subprocess.run(
            ["/usr/bin/rpmkeys", "--checksig", str(path)],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        try:
            nevra = identity.stdout.decode("ascii", errors="strict")
        except UnicodeError as exc:
            raise DeploymentError("rollback_failed", "saved Docker RPM identity is invalid") from exc
        if (
            identity.returncode != 0
            or signature.returncode != 0
            or nevra not in expected_nevras
            or nevra in discovered
            or sha256_regular(path) != bundle_sha256.get(nevra)
        ):
            raise DeploymentError("rollback_failed", "saved Docker RPM differs from review")
        discovered[nevra] = path
    if set(discovered) != expected_nevras:
        raise DeploymentError("rollback_failed", "saved Docker bundle is incomplete")
    inventory, inventory_sha256 = rpm_non_directory_payload_inventory(
        discovered, error_code="rollback_failed"
    )
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    if (
        inventory_sha256 != docker_record.get("payload_inventory_sha256")
        or len(inventory) != docker_record.get("payload_inventory_count")
        or docker_record.get("payload_siblings_clean") is not True
    ):
        raise DeploymentError("rollback_failed", "saved Docker payload inventory differs")
    return [discovered[nevra] for nevra in sorted(discovered)], inventory


def validate_docker_bundle_collisions(package_paths: Iterable[Path]) -> None:
    """Reject an install that would overwrite an unmanaged non-directory."""

    seen: set[Path] = set()
    for package_path in package_paths:
        completed = subprocess.run(
            ["/usr/bin/rpm", "-qpl", str(package_path)],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=60,
        )
        if completed.returncode != 0 or len(completed.stdout) > 8 * 1024 * 1024:
            raise DeploymentError(
                "docker_bundle_invalid", "Docker RPM payload paths are unavailable"
            )
        try:
            names = completed.stdout.decode("utf-8", errors="strict").splitlines()
        except UnicodeError as exc:
            raise DeploymentError(
                "docker_bundle_invalid", "Docker RPM payload paths are invalid"
            ) from exc
        if len(names) > 100_000:
            raise DeploymentError(
                "docker_bundle_invalid", "Docker RPM payload path count is excessive"
            )
        for name in names:
            path = Path(name)
            if (
                not path.is_absolute()
                or len(name) > 4096
                or CONTROL_RE.search(name)
                or ".." in path.parts
            ):
                raise DeploymentError(
                    "docker_bundle_invalid", "Docker RPM payload contains an unsafe path"
                )
            if path in seen:
                continue
            seen.add(path)
            if not os.path.lexists(path):
                continue
            try:
                current = os.lstat(path)
            except OSError as exc:
                raise DeploymentError(
                    "docker_conflict", "an RPM target changed during collision validation"
                ) from exc
            if not stat.S_ISDIR(current.st_mode):
                raise DeploymentError(
                    "docker_conflict", "Docker RPM installation would overwrite unmanaged data"
                )


def rpm_non_directory_payload_inventory(
    packages: dict[str, Path], *, error_code: str
) -> tuple[list[tuple[str, int, Path]], str]:
    inventory: list[tuple[str, int, Path]] = []
    for nevra, package in sorted(packages.items()):
        completed = subprocess.run(
            [
                "/usr/bin/rpm", "-qp", "--qf",
                "[%{FILEMODES}\\t%{FILENAMES}\\n]", str(package),
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=60,
        )
        if completed.returncode != 0 or len(completed.stdout) > 16 * 1024 * 1024:
            raise DeploymentError(error_code, "RPM payload inventory is unavailable")
        try:
            lines = completed.stdout.decode("utf-8", errors="strict").splitlines()
        except UnicodeError as exc:
            raise DeploymentError(error_code, "RPM payload inventory is invalid") from exc
        if len(lines) > 100_000:
            raise DeploymentError(error_code, "RPM payload inventory is excessive")
        for line in lines:
            raw_mode, separator, raw_path = line.partition("\t")
            if (
                not separator
                or not raw_mode.isdecimal()
                or not raw_path
                or len(raw_path) > 4096
                or CONTROL_RE.search(raw_path)
            ):
                raise DeploymentError(error_code, "RPM payload inventory is invalid")
            mode = int(raw_mode)
            path = Path(raw_path)
            if not path.is_absolute() or ".." in path.parts or mode > 0o177777:
                raise DeploymentError(error_code, "RPM payload inventory is invalid")
            if not stat.S_ISDIR(mode):
                inventory.append((nevra, mode, path))
    inventory.sort(key=lambda item: (item[0], item[1], str(item[2])))
    canonical = json.dumps(
        [[nevra, mode, str(path)] for nevra, mode, path in inventory],
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    if len(canonical) > 16 * 1024 * 1024:
        raise DeploymentError(error_code, "RPM payload inventory is excessive")
    return inventory, hashlib.sha256(canonical).hexdigest()


def rpm_temporary_payload_siblings(
    inventory: Iterable[tuple[str, int, Path]], *, error_code: str
) -> list[Path]:
    by_parent: dict[Path, set[str]] = {}
    for _nevra, _mode, path in inventory:
        by_parent.setdefault(path.parent, set()).add(path.name)
    matches: list[Path] = []
    suffix = re.compile(r";[0-9a-f]{8}\Z")
    for parent, basenames in sorted(by_parent.items(), key=lambda item: str(item[0])):
        if not os.path.lexists(parent):
            continue
        try:
            parent_metadata = os.lstat(parent)
            entries = list(os.scandir(parent))
        except OSError as exc:
            raise DeploymentError(error_code, "RPM payload parent is unavailable") from exc
        if (
            not stat.S_ISDIR(parent_metadata.st_mode)
            or stat.S_ISLNK(parent_metadata.st_mode)
            or parent_metadata.st_uid != 0
            or stat.S_IMODE(parent_metadata.st_mode) & 0o022
            or len(entries) > 100_000
        ):
            raise DeploymentError(error_code, "RPM payload parent is unsafe")
        for entry in entries:
            stem, separator, tail = entry.name.rpartition(";")
            if separator and stem in basenames and suffix.fullmatch(f";{tail}"):
                matches.append(parent / entry.name)
    return sorted(set(matches))


def assert_no_rpm_temporary_payloads(
    inventory: Iterable[tuple[str, int, Path]], *, error_code: str
) -> None:
    if rpm_temporary_payload_siblings(inventory, error_code=error_code):
        raise DeploymentError(error_code, "an RPM transaction temporary payload remains")


def remove_attributable_rpm_temporary_payloads(
    inventory: Iterable[tuple[str, int, Path]], *, error_code: str
) -> None:
    inventory_items = list(inventory)
    expected_types: dict[Path, set[int]] = {}
    for _nevra, mode, target in inventory_items:
        expected_types.setdefault(target, set()).add(stat.S_IFMT(mode))
    touched: set[Path] = set()
    for path in rpm_temporary_payload_siblings(inventory_items, error_code=error_code):
        try:
            item = os.lstat(path)
        except OSError as exc:
            raise DeploymentError(error_code, "RPM temporary payload changed") from exc
        target_name, _separator, _suffix = path.name.rpartition(";")
        target = path.parent / target_name
        if (
            stat.S_IFMT(item.st_mode) not in expected_types.get(target, set())
            or stat.S_ISDIR(item.st_mode)
            or item.st_uid != 0
            or item.st_gid != 0
            or item.st_nlink < 1
            or item.st_nlink > max(2, len(inventory_items) * 2)
            or (not stat.S_ISLNK(item.st_mode) and os.path.ismount(path))
        ):
            raise DeploymentError(error_code, "RPM temporary payload is unsafe")
        path.unlink()
        touched.add(path.parent)
    for parent in sorted(touched):
        _fsync_directory_path(parent)


def docker_service_snapshot() -> dict[str, dict[str, bool]]:
    return {
        unit: {
            "active": systemctl_state(unit, "is-active"),
            "enabled": systemctl_state(unit, "is-enabled"),
        }
        for unit in DOCKER_SERVICE_UNITS
    }


def validate_saved_docker_service_state(
    raw: Any, error_code: str
) -> dict[str, dict[str, bool]]:
    if not isinstance(raw, dict) or set(raw) != set(DOCKER_SERVICE_UNITS):
        raise DeploymentError(error_code, "saved Docker service matrix is invalid")
    validated: dict[str, dict[str, bool]] = {}
    for unit in DOCKER_SERVICE_UNITS:
        state = raw.get(unit)
        if (
            not isinstance(state, dict)
            or set(state) != {"active", "enabled"}
            or not all(isinstance(state.get(key), bool) for key in ("active", "enabled"))
        ):
            raise DeploymentError(error_code, "saved Docker service matrix is invalid")
        validated[unit] = dict(state)
    return validated


def docker_group_snapshot() -> dict[str, Any] | None:
    try:
        entry = grp.getgrnam("docker")
    except KeyError:
        return None
    primary_users = sorted(
        account.pw_name for account in pwd.getpwall() if account.pw_gid == entry.gr_gid
    )
    return {
        "gid": entry.gr_gid,
        "members": sorted(entry.gr_mem),
        "primary_users": primary_users,
    }


def validate_saved_docker_group(raw: Any, error_code: str) -> dict[str, Any] | None:
    if raw is None:
        return None
    if not isinstance(raw, dict) or set(raw) != {"gid", "members", "primary_users"}:
        raise DeploymentError(error_code, "saved Docker group state is invalid")
    gid = raw.get("gid")
    members = raw.get("members")
    primary_users = raw.get("primary_users")
    if (
        isinstance(gid, bool)
        or not isinstance(gid, int)
        or gid < 0
        or not isinstance(members, list)
        or not isinstance(primary_users, list)
        or any(not isinstance(name, str) or not ACCOUNT_RE.fullmatch(name) for name in members)
        or any(
            not isinstance(name, str) or not ACCOUNT_RE.fullmatch(name)
            for name in primary_users
        )
        or members != sorted(set(members))
        or primary_users != sorted(set(primary_users))
    ):
        raise DeploymentError(error_code, "saved Docker group state is invalid")
    return {"gid": gid, "members": list(members), "primary_users": list(primary_users)}


def zulip_container_restart_snapshot() -> dict[str, str]:
    completed = subprocess.run(
        [
            "/usr/bin/docker",
            "ps",
            "--all",
            "--filter",
            "label=com.docker.compose.project=zulip-local",
            "--format",
            "{{.Names}}",
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0 or len(completed.stdout) > 4096:
        raise DeploymentError(
            "docker_conflict", "the Zulip container inventory is unavailable"
        )
    try:
        names = completed.stdout.decode("ascii", errors="strict").splitlines()
    except UnicodeError as exc:
        raise DeploymentError(
            "docker_conflict", "the Zulip container inventory is invalid"
        ) from exc
    if len(names) != len(set(names)) or any(name not in ZULIP_CONTAINER_NAMES for name in names):
        raise DeploymentError(
            "docker_conflict", "the Zulip container inventory differs from review"
        )
    names = sorted(names)
    if names and set(names) != set(ZULIP_CONTAINER_NAMES):
        raise DeploymentError(
            "docker_conflict", "the Zulip container inventory is incomplete"
        )
    snapshot: dict[str, str] = {}
    for name in names:
        inspected = subprocess.run(
            [
                "/usr/bin/docker",
                "inspect",
                "--format",
                "{{json .HostConfig.RestartPolicy}}",
                name,
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if inspected.returncode != 0 or len(inspected.stdout) > 1024:
            raise DeploymentError(
                "docker_conflict", "a Zulip restart policy is unavailable"
            )
        try:
            policy = json.loads(inspected.stdout)
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise DeploymentError(
                "docker_conflict", "a Zulip restart policy is invalid"
            ) from exc
        if (
            not isinstance(policy, dict)
            or set(policy) != {"Name", "MaximumRetryCount"}
            or policy.get("Name") not in {"no", "unless-stopped"}
            or policy.get("MaximumRetryCount") != 0
        ):
            raise DeploymentError(
                "docker_conflict", "a Zulip restart policy differs from review"
            )
        snapshot[name] = str(policy["Name"])
    return snapshot


def _remove_restart_suppression_marker() -> None:
    if DOCKER_RESTART_SUPPRESS_MARKER.is_symlink():
        raise DeploymentError(
            "installed_state_unsafe", "the Docker restart marker is symlinked"
        )
    DOCKER_RESTART_SUPPRESS_MARKER.unlink(missing_ok=True)
    if DOCKER_RESTART_SUPPRESS_MARKER.parent.exists():
        directory_fd = os.open(
            DOCKER_RESTART_SUPPRESS_MARKER.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC,
        )
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)


def suppress_zulip_container_restarts(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    before = docker_record.get("restart_policies_before")
    if not isinstance(before, dict) or any(
        name not in ZULIP_CONTAINER_NAMES or policy != "unless-stopped"
        for name, policy in before.items()
    ):
        raise DeploymentError(
            "docker_conflict", "saved Zulip restart policies are invalid"
        )
    docker_record["restart_suppression_started"] = True
    atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)
    atomic_json(
        DOCKER_RESTART_SUPPRESS_MARKER,
        {
            "schema_version": 1,
            "release_id": metadata["release_id"],
            "transaction_id": metadata["transaction_id"],
            "status": "suppressed",
        },
    )
    if before and zulip_container_restart_snapshot():
        raise DeploymentError(
            "docker_conflict", "prior Zulip containers remained after quiescence"
        )
    docker_record["restart_suppressed"] = True
    atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)


def restore_zulip_container_restart_policies(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    before = docker_record.get("restart_policies_before")
    if not isinstance(before, dict) or any(
        name not in ZULIP_CONTAINER_NAMES or policy != "unless-stopped"
        for name, policy in before.items()
    ):
        raise DeploymentError(
            "rollback_failed", "saved Zulip restart policies are invalid"
        )
    current = zulip_container_restart_snapshot() if docker_is_rootful() else {}
    if before:
        if set(current) != set(before):
            raise DeploymentError(
                "rollback_failed", "prior Zulip containers were not restored"
            )
        run_command(
            "restore-zulip-container-restarts",
            [
                "/usr/bin/docker",
                "update",
                "--restart=unless-stopped",
                *ZULIP_CONTAINER_NAMES,
            ],
            timeout=120,
        )
        if zulip_container_restart_snapshot() != before:
            raise DeploymentError(
                "rollback_failed", "prior Zulip restart policies were not restored"
            )
    elif current:
        raise DeploymentError(
            "rollback_failed", "new Zulip containers remained after rollback"
        )
    _remove_restart_suppression_marker()


def commit_zulip_container_restart_policies(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    if docker_record.get("restart_suppressed") is not True:
        raise DeploymentError(
            "health_failed", "Zulip restart suppression was not committed"
        )
    current = zulip_container_restart_snapshot()
    if set(current) != set(ZULIP_CONTAINER_NAMES) or any(
        policy not in {"no", "unless-stopped"} for policy in current.values()
    ):
        raise DeploymentError(
            "health_failed", "Zulip restart-policy commit cannot be resumed safely"
        )
    # This function is called only after the outer bootstrap WAL is durably
    # committed. Remove the suppression marker first. A crash here leaves all
    # containers at policy=no; the recovery janitor replays the update. Once
    # the marker is absent, an already committed systemd start is also allowed
    # to converge the stack rather than re-enter the precommit policy.
    _remove_restart_suppression_marker()
    run_command(
        "commit-zulip-container-restarts",
        [
            "/usr/bin/docker",
            "update",
            "--restart=unless-stopped",
            *ZULIP_CONTAINER_NAMES,
        ],
        timeout=120,
    )
    if zulip_container_restart_snapshot() != {
        name: "unless-stopped" for name in ZULIP_CONTAINER_NAMES
    }:
        raise DeploymentError(
            "health_failed", "Zulip container restart policies were not armed"
        )
    docker_record["restart_policies_committed"] = True
    atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)


def validate_zulip_precommit_restart_state(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    if (
        docker_record.get("restart_suppression_started") is not True
        or docker_record.get("restart_suppressed") is not True
        or docker_record.get("restart_policies_committed") is not False
    ):
        raise DeploymentError(
            "health_failed", "Zulip restart suppression state is incomplete"
        )
    marker = read_json(
        DOCKER_RESTART_SUPPRESS_MARKER,
        maximum=4096,
        require_root_owned=True,
    )
    if marker != {
        "schema_version": 1,
        "release_id": metadata["release_id"],
        "transaction_id": metadata["transaction_id"],
        "status": "suppressed",
    }:
        raise DeploymentError(
            "health_failed", "Zulip restart suppression marker differs"
        )
    if zulip_container_restart_snapshot() != {
        name: "no" for name in ZULIP_CONTAINER_NAMES
    }:
        raise DeploymentError(
            "health_failed", "Zulip containers could restart before global commit"
        )


def restore_docker_group(docker_record: dict[str, Any]) -> None:
    before = validate_saved_docker_group(
        docker_record.get("group_before"), "rollback_failed"
    )
    creation_expected = docker_record.get("group_creation_expected")
    created_gid = docker_record.get("group_created_gid")
    if not isinstance(creation_expected, bool) or (
        created_gid is not None
        and (isinstance(created_gid, bool) or not isinstance(created_gid, int) or created_gid < 0)
    ):
        raise DeploymentError("rollback_failed", "saved Docker group transaction is invalid")
    if before is not None:
        if creation_expected or created_gid is not None or docker_group_snapshot() != before:
            raise DeploymentError("rollback_failed", "pre-existing Docker group changed")
        return
    current = docker_group_snapshot()
    if not creation_expected:
        if current is not None or created_gid is not None:
            raise DeploymentError("rollback_failed", "unexpected Docker group appeared")
        return
    if current is not None:
        if (
            (created_gid is not None and current["gid"] != created_gid)
            or current["members"]
            or current["primary_users"]
        ):
            raise DeploymentError(
                "rollback_failed", "transaction-created Docker group is no longer safe to remove"
            )
        run_command(
            "rollback-docker-group",
            ["/usr/sbin/groupdel", "docker"],
            timeout=120,
        )
    if docker_group_snapshot() is not None:
        raise DeploymentError("rollback_failed", "transaction-created Docker group remained")


def _mount_inventory() -> set[str]:
    try:
        mount_lines = Path("/proc/self/mountinfo").read_text(
            encoding="utf-8", errors="strict"
        ).splitlines()
    except (OSError, UnicodeError) as exc:
        raise DeploymentError(
            "rollback_failed", "the mount inventory is unavailable"
        ) from exc
    mountpoints: set[str] = set()
    for line in mount_lines:
        fields = line.split()
        if len(fields) < 10 or "-" not in fields:
            raise DeploymentError("rollback_failed", "the mount inventory is invalid")
        mountpoints.add(
            fields[4]
            .replace("\\040", " ")
            .replace("\\011", "\t")
            .replace("\\012", "\n")
            .replace("\\134", "\\")
        )
    return mountpoints


def _path_has_mount(path: Path, mountpoints: set[str]) -> bool:
    path_text = str(path)
    return any(
        mountpoint == path_text or mountpoint.startswith(path_text + "/")
        for mountpoint in mountpoints
    )


def _fsync_directory_path(path: Path) -> None:
    descriptor = os.open(
        path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _validate_preserved_volumes_directory(
    path: Path, *, private_parent: bool = False
) -> None:
    try:
        metadata = os.lstat(path)
    except OSError as exc:
        raise DeploymentError(
            "rollback_failed", "the preserved Docker volume archive is unavailable"
        ) from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or (
            private_parent
            and (metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700)
        )
    ):
        raise DeploymentError(
            "rollback_failed", "the preserved Docker volume archive is unsafe"
        )


def preserve_transaction_docker_volumes(metadata: dict[str, Any]) -> None:
    """Atomically retain named-volume data before removing the fresh engine."""

    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    started = docker_record.get("volumes_preservation_started")
    preserved = docker_record.get("volumes_preserved")
    raw_destination = docker_record.get("volumes_preservation_path")
    if not isinstance(started, bool) or not isinstance(preserved, bool):
        raise DeploymentError(
            "rollback_failed", "saved Docker volume preservation state is invalid"
        )
    transaction_id = metadata.get("transaction_id")
    if not isinstance(transaction_id, str) or not IDENTIFIER_RE.fullmatch(transaction_id):
        raise DeploymentError(
            "rollback_failed", "saved Docker volume transaction identity is invalid"
        )
    recovered_root = ZULIP_RECOVERED_DATA_ROOT / f"recovered-{transaction_id}"
    expected_destination = recovered_root / "docker-volumes"
    if raw_destination is not None and (
        not isinstance(raw_destination, str)
        or Path(raw_destination) != expected_destination
    ):
        raise DeploymentError(
            "rollback_failed", "saved Docker volume preservation path is invalid"
        )
    if not started and raw_destination is not None:
        raise DeploymentError(
            "rollback_failed", "unstarted Docker volume preservation has a path"
        )
    if preserved and (not started or raw_destination is None):
        raise DeploymentError(
            "rollback_failed", "saved Docker volume preservation state is inconsistent"
        )

    mountpoints = _mount_inventory()
    if _path_has_mount(DOCKER_VOLUMES_PATH, mountpoints) or _path_has_mount(
        expected_destination, mountpoints
    ):
        raise DeploymentError(
            "rollback_failed", "a Docker volume path is still mounted"
        )

    source_exists = os.path.lexists(DOCKER_VOLUMES_PATH)
    destination_exists = os.path.lexists(expected_destination)
    if not started:
        if destination_exists:
            raise DeploymentError(
                "rollback_failed", "an untracked Docker volume archive already exists"
            )
        if source_exists:
            try:
                source_metadata = os.lstat(DOCKER_VOLUMES_PATH)
            except OSError as exc:
                raise DeploymentError(
                    "rollback_failed", "the Docker volume store is unavailable"
                ) from exc
            if (
                not stat.S_ISDIR(source_metadata.st_mode)
                or stat.S_ISLNK(source_metadata.st_mode)
                or source_metadata.st_uid != 0
            ):
                raise DeploymentError(
                    "rollback_failed", "the Docker volume store is unsafe to preserve"
                )
            try:
                source_device = os.stat(DOCKER_VOLUMES_PATH.parent).st_dev
                destination_device = os.stat(ZULIP_RECOVERED_DATA_ROOT.parent).st_dev
            except OSError as exc:
                raise DeploymentError(
                    "rollback_failed", "Docker volume preservation roots are unavailable"
                ) from exc
            if source_device != destination_device:
                raise DeploymentError(
                    "rollback_failed", "Docker volume preservation is not an atomic rename"
                )
            raw_destination = str(expected_destination)
        else:
            raw_destination = None
        # This WAL is the authority for the only following mutation. A crash
        # after rename but before the second WAL is recognized by the
        # source-absent/destination-present replay case below.
        docker_record["volumes_preservation_started"] = True
        docker_record["volumes_preservation_path"] = raw_destination
        docker_record["volumes_preserved"] = False
        atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)

    if raw_destination is None:
        if os.path.lexists(DOCKER_VOLUMES_PATH) or os.path.lexists(expected_destination):
            raise DeploymentError(
                "rollback_failed", "Docker volumes appeared after the preservation WAL"
            )
        return

    source_exists = os.path.lexists(DOCKER_VOLUMES_PATH)
    destination_exists = os.path.lexists(expected_destination)
    if source_exists and destination_exists:
        raise DeploymentError(
            "rollback_failed", "Docker volume preservation has two conflicting copies"
        )
    if not source_exists and not destination_exists:
        raise DeploymentError(
            "rollback_failed", "Docker volume preservation lost both copies"
        )
    if source_exists:
        try:
            source_metadata = os.lstat(DOCKER_VOLUMES_PATH)
        except OSError as exc:
            raise DeploymentError(
                "rollback_failed", "the Docker volume store is unavailable"
            ) from exc
        if (
            not stat.S_ISDIR(source_metadata.st_mode)
            or stat.S_ISLNK(source_metadata.st_mode)
            or source_metadata.st_uid != 0
        ):
            raise DeploymentError(
                "rollback_failed", "the Docker volume store is unsafe to preserve"
            )
        if not ZULIP_RECOVERED_DATA_ROOT.exists():
            ZULIP_RECOVERED_DATA_ROOT.mkdir(mode=0o700, parents=True, exist_ok=False)
            os.chown(ZULIP_RECOVERED_DATA_ROOT, 0, 0)
            os.chmod(ZULIP_RECOVERED_DATA_ROOT, 0o700)
            _fsync_directory_path(ZULIP_RECOVERED_DATA_ROOT.parent)
        else:
            _validate_preserved_volumes_directory(
                ZULIP_RECOVERED_DATA_ROOT, private_parent=True
            )
        if not recovered_root.exists():
            recovered_root.mkdir(mode=0o700, exist_ok=False)
            os.chown(recovered_root, 0, 0)
            os.chmod(recovered_root, 0o700)
            _fsync_directory_path(recovered_root.parent)
        else:
            _validate_preserved_volumes_directory(
                recovered_root, private_parent=True
            )
        if os.stat(DOCKER_VOLUMES_PATH.parent).st_dev != os.stat(recovered_root).st_dev:
            raise DeploymentError(
                "rollback_failed", "Docker volume preservation is not an atomic rename"
            )
        os.rename(DOCKER_VOLUMES_PATH, expected_destination)
        _fsync_directory_path(DOCKER_VOLUMES_PATH.parent)
        _fsync_directory_path(recovered_root)
        _fsync_directory_path(recovered_root.parent)
    _validate_preserved_volumes_directory(expected_destination)
    if os.path.lexists(DOCKER_VOLUMES_PATH):
        raise DeploymentError(
            "rollback_failed", "the Docker volume store remained after preservation"
        )
    docker_record["volumes_preserved"] = True
    atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)


def verify_preserved_docker_volumes(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    started = docker_record.get("volumes_preservation_started")
    preserved = docker_record.get("volumes_preserved")
    raw_destination = docker_record.get("volumes_preservation_path")
    if not isinstance(started, bool) or not isinstance(preserved, bool) or not started:
        raise DeploymentError(
            "rollback_failed", "Docker volume preservation did not reach a terminal state"
        )
    if os.path.lexists(DOCKER_VOLUMES_PATH):
        raise DeploymentError(
            "rollback_failed", "the Docker volume store remained after rollback"
        )
    if raw_destination is None:
        if preserved:
            raise DeploymentError(
                "rollback_failed", "saved Docker volume preservation state is inconsistent"
            )
        return
    transaction_id = metadata.get("transaction_id")
    expected = ZULIP_RECOVERED_DATA_ROOT / f"recovered-{transaction_id}" / "docker-volumes"
    if not isinstance(raw_destination, str) or Path(raw_destination) != expected or not preserved:
        raise DeploymentError(
            "rollback_failed", "saved Docker volume preservation state is invalid"
        )
    _validate_preserved_volumes_directory(
        ZULIP_RECOVERED_DATA_ROOT, private_parent=True
    )
    _validate_preserved_volumes_directory(expected.parent, private_parent=True)
    _validate_preserved_volumes_directory(expected)


def remove_transaction_docker_state() -> None:
    mountpoints = _mount_inventory()
    for path in (*DOCKER_RUNTIME_STATE_PATHS, *DOCKER_PERSISTENT_STATE_PATHS):
        if not os.path.lexists(path):
            continue
        try:
            metadata = os.lstat(path)
        except OSError as exc:
            raise DeploymentError(
                "rollback_failed", "transaction-created Docker state changed"
            ) from exc
        has_nested_mount = _path_has_mount(path, mountpoints)
        if stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0 or has_nested_mount:
            raise DeploymentError(
                "rollback_failed", "transaction-created Docker state is unsafe to remove"
            )
        if stat.S_ISDIR(metadata.st_mode):
            shutil.rmtree(path)
        elif stat.S_ISSOCK(metadata.st_mode) or stat.S_ISREG(metadata.st_mode):
            path.unlink()
        else:
            raise DeploymentError(
                "rollback_failed", "transaction-created Docker state has an unsafe type"
            )
        parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    if any(
        os.path.lexists(path)
        for path in (*DOCKER_RUNTIME_STATE_PATHS, *DOCKER_PERSISTENT_STATE_PATHS)
    ):
        raise DeploymentError(
            "rollback_failed", "transaction-created Docker state remained"
        )


def ensure_docker(backup: Path, metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    before_packages = validate_saved_docker_packages(
        docker_record.get("packages_before"), "package_history_invalid"
    )
    current_state = validate_docker_installation(require_active=False)
    expected_initial_state = (
        "absent"
        if all(before_packages[name] is None for name in DOCKER_PACKAGE_NEVRAS)
        else None
    )
    if expected_initial_state == "absent" and current_state != "absent":
        raise DeploymentError("docker_conflict", "Docker state changed after the deployment snapshot")
    if expected_initial_state is None and current_state == "absent":
        raise DeploymentError("docker_conflict", "Docker state changed after the deployment snapshot")
    service_before = validate_saved_docker_service_state(
        docker_record.get("service_before"), "package_history_invalid"
    )
    if service_before != docker_service_snapshot():
        raise DeploymentError(
            "docker_conflict", "Docker service matrix changed after the deployment snapshot"
        )
    group_before = validate_saved_docker_group(
        docker_record.get("group_before"), "package_history_invalid"
    )
    creation_expected = docker_record.get("group_creation_expected")
    created_gid = docker_record.get("group_created_gid")
    if (
        not isinstance(creation_expected, bool)
        or creation_expected is not (group_before is None)
        or created_gid is not None
    ):
        raise DeploymentError(
            "package_history_invalid", "saved Docker group transaction is invalid"
        )
    if docker_group_snapshot() != group_before:
        raise DeploymentError(
            "docker_conflict", "Docker group state changed after the deployment snapshot"
        )
    if current_state == "absent" and group_before is not None:
        raise DeploymentError(
            "docker_conflict", "a pre-existing Docker group is forbidden before installation"
        )
    if current_state != "absent" and group_before is None:
        raise DeploymentError("docker_conflict", "the reviewed Docker group is absent")

    if current_state == "absent":
        validate_docker_route_baseline()
        history_before_raw = docker_record.get("history_ids_before")
        if (
            not isinstance(history_before_raw, list)
            or any(isinstance(item, bool) or not isinstance(item, int) or item < 0 for item in history_before_raw)
        ):
            raise DeploymentError("package_history_invalid", "saved Docker package history is invalid")
        history_before = set(history_before_raw)
        (
            package_paths,
            bundle_sha256,
            payload_inventory_sha256,
            payload_inventory_count,
        ) = prepare_docker_bundle(backup, before_packages)
        if not package_paths:
            raise DeploymentError("docker_bundle_invalid", "Docker RPM bundle is empty")
        docker_record["bundle_sha256"] = bundle_sha256
        docker_record["payload_inventory_sha256"] = payload_inventory_sha256
        docker_record["payload_inventory_count"] = payload_inventory_count
        docker_record["payload_siblings_clean"] = True
        docker_record["installation_attempted"] = True
        atomic_json(backup / "transaction.json", metadata)
        run_command(
            "install-docker",
            [
                "/usr/bin/dnf",
                "--assumeyes",
                "--disablerepo=*",
                "--setopt=install_weak_deps=False",
                "--setopt=gpgcheck=True",
                "--setopt=localpkg_gpgcheck=True",
                "install",
                *[str(path) for path in package_paths],
            ],
            timeout=1800,
        )
        history_after = dnf_docker_history()
        new_successful = sorted(
            transaction_id
            for transaction_id, transaction_status in history_after.items()
            if transaction_id not in history_before and transaction_status == "Ok"
        )
        if len(new_successful) != 1:
            raise DeploymentError(
                "package_history_invalid",
                "Docker install did not produce one attributable DNF transaction",
            )
        docker_record["transaction_id"] = new_successful[0]
        docker_record["packages_after"] = docker_transaction_package_snapshot()
        if docker_record["packages_after"] != DOCKER_TRANSACTION_NEVRAS:
            raise DeploymentError("docker_conflict", "Docker install did not match reviewed NEVRAs")
        installed_group = docker_group_snapshot()
        if group_before is None:
            if (
                installed_group is None
                or installed_group["members"]
                or installed_group["primary_users"]
            ):
                raise DeploymentError(
                    "docker_conflict", "Docker did not create the reviewed empty system group"
                )
            docker_record["group_created_gid"] = installed_group["gid"]
        elif installed_group != group_before:
            raise DeploymentError("docker_conflict", "pre-existing Docker group changed")
        atomic_json(backup / "transaction.json", metadata)
    else:
        docker_record["bundle_sha256"] = {}
        docker_record["payload_inventory_sha256"] = hashlib.sha256(b"[]").hexdigest()
        docker_record["payload_inventory_count"] = 0
        docker_record["payload_siblings_clean"] = True
        docker_record["packages_after"] = docker_transaction_package_snapshot()
        atomic_json(backup / "transaction.json", metadata)

    if current_state == "absent":
        if docker_record.get("config_parent_creation_started") is not False:
            raise DeploymentError(
                "docker_conflict", "saved Docker configuration-parent state is invalid"
            )
        docker_record["config_parent_creation_started"] = True
        atomic_json(backup / "transaction.json", metadata)
        DOCKER_DAEMON_CONFIG.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        os.chown(DOCKER_DAEMON_CONFIG.parent, 0, 0)
        os.chmod(DOCKER_DAEMON_CONFIG.parent, 0o755)
        transaction_atomic_bytes(
            DOCKER_DAEMON_CONFIG,
            DOCKER_DAEMON_CONFIG_STAGING,
            DOCKER_DAEMON_CONFIG_BYTES,
            mode=0o644,
        )
        # atomic_json fsyncs /etc/docker itself; also persist the newly created
        # directory entry in /etc before Docker can be enabled at boot.
        _fsync_directory_path(DOCKER_DAEMON_CONFIG.parent.parent)
        transaction_atomic_bytes(
            DOCKER_FIREWALL_DIRECT,
            DOCKER_FIREWALL_DIRECT_STAGING,
            DOCKER_FIREWALL_DIRECT_BYTES,
            mode=0o600,
        )
        run_command(
            "reload-reviewed-docker-firewall",
            ["/usr/bin/firewall-cmd", "--reload"],
            timeout=180,
        )

    run_command(
        "enable-docker",
        ["/usr/bin/systemctl", "enable", "--now", DOCKER_SERVICE],
        timeout=300,
    )
    validate_docker_installation(require_active=True)
    require_docker_networks_absent()
    validate_docker_route_baseline()
    validate_docker_user_firewall()
    validate_moby_firewalld_contract(require_bridges=False)
    if docker_network_sysctl_snapshot() != docker_record["sysctls_before"]:
        raise DeploymentError(
            "docker_network_conflict", "Docker changed host forwarding sysctls"
        )
    # Prove that the reviewed daemon configuration and firewalld guard survive
    # a real daemon restart before any container or named network exists.
    run_command(
        "restart-reviewed-docker",
        ["/usr/bin/systemctl", "restart", DOCKER_SERVICE],
        timeout=300,
    )
    require_docker_networks_absent()
    validate_docker_user_firewall()
    validate_moby_firewalld_contract(require_bridges=False)
    if docker_network_sysctl_snapshot() != docker_record["sysctls_before"]:
        raise DeploymentError(
            "docker_network_conflict", "Docker restart changed host forwarding sysctls"
        )


def stop_docker_runtime() -> None:
    for unit in reversed(DOCKER_SERVICE_UNITS):
        if unit_is_loaded(unit):
            run_command(
                f"rollback-stop-{unit}",
                ["/usr/bin/systemctl", "stop", unit],
                timeout=300,
            )
            if systemctl_state(unit, "is-active"):
                raise DeploymentError(
                    "rollback_failed", "a Docker runtime unit remained active"
                )


def quiesce_transaction_docker_runtime() -> None:
    # RPM may have unpacked a unit before its rpmdb commit and before systemd
    # noticed it. Reload first on every replay, then stop/disable every loaded
    # component and make that state durable before touching Docker data.
    run_command(
        "rollback-docker-preflight-daemon-reload",
        ["/usr/bin/systemctl", "daemon-reload"],
        timeout=120,
    )
    stop_docker_runtime()
    loaded_units = [unit for unit in DOCKER_SERVICE_UNITS if unit_is_loaded(unit)]
    if loaded_units:
        run_command(
            "rollback-disable-docker",
            ["/usr/bin/systemctl", "disable", *reversed(loaded_units)],
            timeout=300,
        )
    if any(
        systemctl_state(unit, operation)
        for unit in DOCKER_SERVICE_UNITS
        for operation in ("is-active", "is-enabled")
    ):
        raise DeploymentError(
            "rollback_failed", "Docker was not durably quiesced before data preservation"
        )
    _sync_rollback_filesystems()


def restore_docker(metadata: dict[str, Any]) -> None:
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    expected_keys = {
        "packages_before",
        "service_before",
        "group_before",
        "group_creation_expected",
        "group_created_gid",
        "history_ids_before",
        "installation_attempted",
        "transaction_id",
        "packages_after",
        "bundle_sha256",
        "payload_inventory_sha256",
        "payload_inventory_count",
        "payload_siblings_clean",
        "restart_policies_before",
        "restart_suppression_started",
        "restart_suppressed",
        "restart_policies_committed",
        "volumes_preservation_started",
        "volumes_preservation_path",
        "volumes_preserved",
        "config_parent_creation_started",
        "rollback_preset_started",
        "rollback_preset_removed",
        "rollback_preset_parent_existed",
        "firewalld_before",
        "sysctls_before",
        "iptables_alternatives_before",
        "nft_ruleset_sha256_before",
    }
    if set(docker_record) != expected_keys:
        raise DeploymentError("rollback_failed", "saved Docker transaction fields are invalid")
    before_packages = validate_saved_docker_packages(
        docker_record["packages_before"], "rollback_failed"
    )
    absent_top_packages = {name: None for name in DOCKER_PACKAGE_NEVRAS}
    service_before = validate_saved_docker_service_state(
        docker_record["service_before"], "rollback_failed"
    )
    group_before = validate_saved_docker_group(
        docker_record["group_before"], "rollback_failed"
    )
    creation_expected = docker_record["group_creation_expected"]
    created_gid = docker_record["group_created_gid"]
    if (
        not isinstance(creation_expected, bool)
        or creation_expected is not (group_before is None)
        or (
            created_gid is not None
            and (
                isinstance(created_gid, bool)
                or not isinstance(created_gid, int)
                or created_gid < 0
            )
        )
        or (group_before is not None and created_gid is not None)
    ):
        raise DeploymentError("rollback_failed", "saved Docker group transaction is invalid")
    if all(before_packages[name] is None for name in DOCKER_PACKAGE_NEVRAS) and any(
        service_before[unit][flag]
        for unit in (DOCKER_SERVICE, "docker.socket")
        for flag in ("active", "enabled")
    ):
        raise DeploymentError(
            "rollback_failed", "saved absent Docker service state is inconsistent"
        )
    history_before_raw = docker_record["history_ids_before"]
    if (
        not isinstance(history_before_raw, list)
        or any(isinstance(item, bool) or not isinstance(item, int) or item < 0 for item in history_before_raw)
    ):
        raise DeploymentError("rollback_failed", "saved Docker package history is invalid")
    attempted = docker_record["installation_attempted"]
    if not isinstance(attempted, bool):
        raise DeploymentError("rollback_failed", "saved Docker install state is invalid")
    if any(
        not isinstance(docker_record[key], bool)
        for key in (
            "restart_suppression_started",
            "restart_suppressed",
            "restart_policies_committed",
            "volumes_preservation_started",
            "volumes_preserved",
            "config_parent_creation_started",
            "rollback_preset_started",
            "rollback_preset_removed",
            "rollback_preset_parent_existed",
            "payload_siblings_clean",
        )
    ):
        raise DeploymentError("rollback_failed", "saved Docker restart state is invalid")
    if (
        docker_record["rollback_preset_removed"]
        and not docker_record["rollback_preset_started"]
    ) or (
        not attempted
        and (
            docker_record["rollback_preset_started"]
            or docker_record["rollback_preset_removed"]
        )
    ):
        raise DeploymentError("rollback_failed", "saved Docker rollback preset state is invalid")
    if docker_record["config_parent_creation_started"]:
        remove_attributable_transaction_staging(
            DOCKER_DAEMON_CONFIG_STAGING, DOCKER_DAEMON_CONFIG_BYTES
        )
        remove_attributable_transaction_staging(
            DOCKER_FIREWALL_DIRECT_STAGING, DOCKER_FIREWALL_DIRECT_BYTES
        )
    bundle_sha256 = docker_record["bundle_sha256"]
    if bundle_sha256 is not None and (
        not isinstance(bundle_sha256, dict)
        or any(
            not isinstance(nevra, str)
            or nevra not in DOCKER_TRANSACTION_NEVRAS.values()
            or not isinstance(digest, str)
            or not SHA256_RE.fullmatch(digest)
            for nevra, digest in bundle_sha256.items()
        )
    ):
        raise DeploymentError("rollback_failed", "saved Docker bundle identity is invalid")
    if attempted and not bundle_sha256:
        raise DeploymentError("rollback_failed", "saved Docker bundle identity is incomplete")
    payload_inventory_sha256 = docker_record["payload_inventory_sha256"]
    payload_inventory_count = docker_record["payload_inventory_count"]
    payload_siblings_clean = docker_record["payload_siblings_clean"]
    if attempted:
        if (
            not isinstance(payload_inventory_sha256, str)
            or not SHA256_RE.fullmatch(payload_inventory_sha256)
            or isinstance(payload_inventory_count, bool)
            or not isinstance(payload_inventory_count, int)
            or payload_inventory_count < 1
            or payload_inventory_count > 100_000
            or payload_siblings_clean is not True
        ):
            raise DeploymentError("rollback_failed", "saved Docker payload inventory is invalid")
    elif (
        payload_inventory_sha256 is not None
        or payload_inventory_count is not None
        or payload_siblings_clean is not False
    ):
        raise DeploymentError("rollback_failed", "unexpected Docker payload inventory exists")
    transaction_id = docker_record["transaction_id"]
    if transaction_id is not None and (
        isinstance(transaction_id, bool) or not isinstance(transaction_id, int) or transaction_id < 0
    ):
        raise DeploymentError("rollback_failed", "saved Docker transaction ID is invalid")

    if attempted:
        raw_backup = metadata.get("backup_path")
        if not isinstance(raw_backup, str):
            raise DeploymentError("rollback_failed", "saved Docker backup path is invalid")
        backup_transaction = Path(raw_backup) / "transaction.json"
        # First remove and fsync any enablement left by an interrupted original
        # RPM transaction. Only then publish the rollback preset; a crash in
        # its fixed-slot write therefore cannot leave a runnable daemon.
        quiesce_transaction_docker_runtime()
        docker_record["rollback_preset_started"] = True
        docker_record["rollback_preset_removed"] = False
        atomic_json(backup_transaction, metadata)
        transaction_atomic_bytes(
            DOCKER_ROLLBACK_PRESET,
            DOCKER_ROLLBACK_PRESET_STAGING,
            DOCKER_ROLLBACK_PRESET_BYTES,
            mode=0o644,
        )
        _fsync_directory_path(DOCKER_ROLLBACK_PRESET.parent)
        _fsync_directory_path(DOCKER_ROLLBACK_PRESET.parent.parent)
        assert isinstance(bundle_sha256, dict)
        bundle_paths, payload_inventory = validate_saved_docker_bundle(
            metadata, before_packages, bundle_sha256
        )
        remove_attributable_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )
        # RPM writes payload files before adding the package to rpmdb. A power
        # cut can therefore leave files that a package-delta-only rollback
        # cannot see. Complete the signed, hash-pinned bundle offline and then
        # reinstall it once so every payload is registered and restored before
        # the repeatable removal below. No repository or network is consulted.
        common_dnf = [
            "/usr/bin/dnf", "--assumeyes", "--releasever=44",
            "--disablerepo=*", "--setopt=install_weak_deps=False",
            "--setopt=gpgcheck=True", "--setopt=localpkg_gpgcheck=True",
        ]
        run_command(
            "rollback-complete-docker-bundle",
            [*common_dnf, "install", *[str(path) for path in bundle_paths]],
            timeout=1800,
        )
        run_command(
            "rollback-reinstall-docker-bundle",
            [*common_dnf, "reinstall", *[str(path) for path in bundle_paths]],
            timeout=1800,
        )
        expected_completed = {
            name: (
                DOCKER_TRANSACTION_NEVRAS[name]
                if before is None
                else before
            )
            for name, before in before_packages.items()
        }
        if docker_transaction_package_snapshot() != expected_completed:
            raise DeploymentError(
                "rollback_failed", "offline Docker package completion differs from review"
            )
        # Scriptlets may have refreshed systemd state. Re-establish and fsync
        # the boot-safe disabled boundary before moving named volumes.
        quiesce_transaction_docker_runtime()
    else:
        stop_docker_runtime()

    preserve_transaction_docker_volumes(metadata)

    if attempted:
        # A power cut may leave DNF history Error/Aborted or lose the final
        # successful transaction ID while a strict subset of the reviewed RPM
        # bundle is installed. The fresh-only baseline makes that subset
        # attributable without trusting history status: packages absent before
        # may now be either absent or their exact reviewed NEVRA; packages that
        # pre-existed must be byte/version-identical. Remove the complete
        # attributable delta with autoremove disabled, then re-prove baseline.
        current_packages = docker_transaction_package_snapshot()
        newly_installed: list[str] = []
        for package_name, before_nevra in before_packages.items():
            current_nevra = current_packages[package_name]
            if before_nevra is None:
                if current_nevra is None:
                    continue
                if current_nevra != DOCKER_TRANSACTION_NEVRAS[package_name]:
                    raise DeploymentError(
                        "rollback_failed", "a Docker package delta is not attributable"
                    )
                newly_installed.append(package_name)
            elif current_nevra != before_nevra:
                raise DeploymentError(
                    "rollback_failed", "a pre-existing Docker dependency changed"
                )
        if newly_installed:
            run_command(
                "rollback-docker-packages",
                [
                    "/usr/bin/dnf",
                    "--assumeyes",
                    "--releasever=44",
                    "--disablerepo=*",
                    "--setopt=gpgcheck=True",
                    "--setopt=clean_requirements_on_remove=False",
                    "remove",
                    "--no-autoremove",
                    *sorted(newly_installed),
                ],
                timeout=1800,
            )
        assert_no_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )

    if all(before_packages[name] is None for name in DOCKER_PACKAGE_NEVRAS):
        remove_transaction_docker_state()

    if docker_transaction_package_snapshot() != before_packages:
        raise DeploymentError("rollback_failed", "Docker packages did not return to prior state")
    run_command(
        "rollback-docker-daemon-reload",
        ["/usr/bin/systemctl", "daemon-reload"],
        timeout=120,
    )
    top_absent = all(before_packages[name] is None for name in DOCKER_PACKAGE_NEVRAS)
    if top_absent and (
        Path("/usr/bin/docker").exists()
        or unit_is_loaded(DOCKER_SERVICE)
        or unit_is_loaded("docker.socket")
    ):
        raise DeploymentError("rollback_failed", "Docker runtime remained after package rollback")

    if attempted:
        try:
            preset_metadata = os.lstat(DOCKER_ROLLBACK_PRESET)
            preset_payload = DOCKER_ROLLBACK_PRESET.read_bytes()
        except OSError as exc:
            raise DeploymentError(
                "rollback_failed", "the Docker rollback preset is unavailable"
            ) from exc
        if (
            not stat.S_ISREG(preset_metadata.st_mode)
            or stat.S_ISLNK(preset_metadata.st_mode)
            or preset_metadata.st_uid != 0
            or preset_metadata.st_gid != 0
            or stat.S_IMODE(preset_metadata.st_mode) != 0o644
            or preset_payload != DOCKER_ROLLBACK_PRESET_BYTES
        ):
            raise DeploymentError(
                "rollback_failed", "the Docker rollback preset differs from review"
            )
        DOCKER_ROLLBACK_PRESET.unlink()
        _fsync_directory_path(DOCKER_ROLLBACK_PRESET.parent)
        if not docker_record["rollback_preset_parent_existed"]:
            try:
                DOCKER_ROLLBACK_PRESET.parent.rmdir()
            except OSError as exc:
                raise DeploymentError(
                    "rollback_failed", "transaction-created systemd preset parent is not empty"
                ) from exc
            _fsync_directory_path(DOCKER_ROLLBACK_PRESET.parent.parent)
        elif not docker_rollback_preset_parent_exists():
            raise DeploymentError(
                "rollback_failed", "the pre-existing systemd preset parent disappeared"
            )
        docker_record["rollback_preset_removed"] = True
        atomic_json(Path(metadata["backup_path"]) / "transaction.json", metadata)

    restore_docker_group(docker_record)

    if docker_record["config_parent_creation_started"] is True:
        if os.path.lexists(DOCKER_DAEMON_CONFIG.parent):
            try:
                config_parent = os.lstat(DOCKER_DAEMON_CONFIG.parent)
            except OSError as exc:
                raise DeploymentError(
                    "rollback_failed", "transaction-created Docker configuration is unavailable"
                ) from exc
            if (
                not stat.S_ISDIR(config_parent.st_mode)
                or stat.S_ISLNK(config_parent.st_mode)
                or config_parent.st_uid != 0
            ):
                raise DeploymentError(
                    "rollback_failed", "transaction-created Docker configuration is unsafe"
                )
            try:
                DOCKER_DAEMON_CONFIG.parent.rmdir()
            except OSError as exc:
                raise DeploymentError(
                    "rollback_failed", "transaction-created Docker configuration is not empty"
                ) from exc
            _fsync_directory_path(DOCKER_DAEMON_CONFIG.parent.parent)
    elif os.path.lexists(DOCKER_DAEMON_CONFIG.parent):
        raise DeploymentError(
            "rollback_failed", "an untracked Docker configuration directory appeared"
        )

    available: dict[str, bool] = {}
    for unit in DOCKER_SERVICE_UNITS:
        available[unit] = unit_is_loaded(unit)
        state = service_before[unit]
        if not available[unit]:
            if state["active"] or state["enabled"]:
                raise DeploymentError(
                    "rollback_failed", "a prior Docker dependency unit is unavailable"
                )
            continue
        operation = "enable" if state["enabled"] else "disable"
        run_command(
            f"restore-{operation}-{unit}",
            ["/usr/bin/systemctl", operation, unit],
            timeout=120,
        )

    # Establish a known inactive baseline in dependency-safe reverse order,
    # then start only the exact prior active set from dependencies upward.
    for unit in reversed(DOCKER_SERVICE_UNITS):
        if available[unit]:
            run_command(
                f"restore-stop-{unit}",
                ["/usr/bin/systemctl", "stop", unit],
                timeout=300,
            )
    for unit in DOCKER_SERVICE_UNITS:
        if available[unit] and service_before[unit]["active"]:
            run_command(
                f"restore-start-{unit}",
                ["/usr/bin/systemctl", "start", unit],
                timeout=300,
            )
    if docker_service_snapshot() != service_before:
        raise DeploymentError("rollback_failed", "Docker service matrix was not restored exactly")
    if docker_record["restart_suppression_started"] is True:
        restore_zulip_container_restart_policies(metadata)
    elif DOCKER_RESTART_SUPPRESS_MARKER.exists() or DOCKER_RESTART_SUPPRESS_MARKER.is_symlink():
        raise DeploymentError("rollback_failed", "an untracked Docker restart marker remained")
    verify_docker_network_rollback(
        docker_record, reload_firewalld=attempted
    )


def validate_private_file(path: Path, *, allow_non_root_owner: bool = False) -> None:
    try:
        metadata = os.lstat(path)
    except OSError as exc:
        raise DeploymentError("preflight_failed", f"required private reference is absent: {path.name}") from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or stat.S_IMODE(metadata.st_mode) & 0o077
        or (not allow_non_root_owner and metadata.st_uid != 0)
    ):
        raise DeploymentError("preflight_failed", f"required private reference is unsafe: {path.name}")


def validate_private_directory(path: Path) -> None:
    try:
        metadata = os.lstat(path)
    except OSError as exc:
        raise DeploymentError("preflight_failed", f"required private directory is absent: {path.name}") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) & 0o077
    ):
        raise DeploymentError("preflight_failed", f"required private directory is unsafe: {path.name}")


def validate_noop_identity_baseline(*, error_code: str = "preflight_failed") -> None:
    """Prove every non-finance sysusers/usermod operation is already a no-op."""

    for user_name, (expected_home, expected_shell) in NOOP_IDENTITY_USERS.items():
        try:
            user = pwd.getpwnam(user_name)
            primary_group = grp.getgrgid(user.pw_gid)
        except KeyError as exc:
            raise DeploymentError(
                error_code, "a required immutable service identity is absent"
            ) from exc
        if (
            user.pw_uid == 0
            or user.pw_uid >= 1000
            or user.pw_dir != expected_home
            or user.pw_shell != expected_shell
            or primary_group.gr_name != user_name
        ):
            raise DeploymentError(
                error_code, "a required immutable service identity differs from review"
            )
    try:
        ops-user = pwd.getpwnam("ops-user")
    except KeyError as exc:
        raise DeploymentError(error_code, "the physical operator identity is absent") from exc
    if ops-user.pw_uid != 1000 or ops-user.pw_dir != "/home/ops-user":
        raise DeploymentError(error_code, "the physical operator identity differs from review")

    passwd_records = pwd.getpwall()
    for group_name, expected_members in NOOP_IDENTITY_GROUP_MEMBERS.items():
        try:
            group = grp.getgrnam(group_name)
        except KeyError as exc:
            raise DeploymentError(
                error_code, "a required immutable API group is absent"
            ) from exc
        primary_users = {
            record.pw_name for record in passwd_records if record.pw_gid == group.gr_gid
        }
        if set(group.gr_mem) != expected_members or primary_users:
            raise DeploymentError(
                error_code, "an immutable API group membership differs from review"
            )
    for group_name, member in NOOP_IDENTITY_REQUIRED_MEMBERS.items():
        try:
            group = grp.getgrnam(group_name)
        except KeyError as exc:
            raise DeploymentError(
                error_code, "a required device access group is absent"
            ) from exc
        if member not in group.gr_mem:
            raise DeploymentError(
                error_code, "a required device group membership is incomplete"
            )


def systemctl_state(unit: str, operation: str) -> bool:
    result = subprocess.run(
        ["/usr/bin/systemctl", operation, "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    return result.returncode == 0


def validate_atlas_rpm(path: Path, atlas: dict[str, Any]) -> None:
    try:
        source_fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("artifact_invalid", "Atlas RPM is unavailable") from exc
    memfd = -1
    try:
        before = os.fstat(source_fd)
        if not stat.S_ISREG(before.st_mode) or before.st_size > MAX_SOURCE_FILE_BYTES:
            raise DeploymentError("artifact_invalid", "Atlas RPM is unsafe or oversized")
        memfd = os.memfd_create(
            "ops-atlas-review", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING
        )
        digest = hashlib.sha256()
        total = 0
        while True:
            chunk = os.read(source_fd, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_SOURCE_FILE_BYTES:
                raise DeploymentError("artifact_invalid", "Atlas RPM exceeded its size bound")
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(memfd, view)
                if written <= 0:
                    raise DeploymentError("artifact_invalid", "Atlas RPM capture was incomplete")
                view = view[written:]
        after = os.fstat(source_fd)
        if (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise DeploymentError("artifact_invalid", "Atlas RPM changed while captured")
        if digest.hexdigest() != atlas["sha256"]:
            raise DeploymentError("checksum_mismatch", "Atlas RPM checksum differs from the reviewed release")
        os.lseek(memfd, 0, os.SEEK_SET)
        fcntl.fcntl(
            memfd,
            fcntl.F_ADD_SEALS,
            fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_SEAL,
        )
        completed = subprocess.run(
            [
                "/usr/bin/rpm",
                "-qp",
                "--qf",
                "%{NAME} %{VERSION} %{RELEASE} %{ARCH}",
                f"/proc/self/fd/{memfd}",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
            pass_fds=(memfd,),
        )
        expected = f"{atlas['name']} {atlas['version']} {atlas['release']} {atlas['architecture']}".encode()
        if completed.returncode != 0 or completed.stdout.strip() != expected:
            raise DeploymentError("artifact_invalid", "Atlas RPM identity differs from the reviewed release")
        payload_query = subprocess.run(
            [
                "/usr/bin/rpm",
                "-qp",
                "--qf",
                "[%{FILENAMES}\\t%{FILEDIGESTS}\\t%{FILEMODES:octal}\\t%{FILEUSERNAME}\\t%{FILEGROUPNAME}\\n]",
                f"/proc/self/fd/{memfd}",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
            pass_fds=(memfd,),
        )
        expected_launcher = (
            f"{ATLAS_PAYLOAD_MEMBER}\t"
            f"{atlas['payload_executable_sha256']}\t"
            "100755\troot\troot"
        )
        try:
            payload_lines = payload_query.stdout.decode(
                "ascii", errors="strict"
            ).splitlines()
        except UnicodeError as exc:
            raise DeploymentError(
                "artifact_invalid", "Atlas RPM payload metadata is invalid"
            ) from exc
        launcher_lines = [
            line for line in payload_lines
            if line.partition("\t")[0] == ATLAS_PAYLOAD_MEMBER
        ]
        if (
            payload_query.returncode != 0
            or len(payload_query.stdout) > 64 * 1024
            or launcher_lines != [expected_launcher]
        ):
            raise DeploymentError(
                "artifact_invalid",
                "Atlas RPM launcher differs from the reviewed release",
            )
    finally:
        os.close(source_fd)
        if memfd >= 0:
            os.close(memfd)


def atlas_payload_sha256(path: Path | None = None) -> str:
    query = ["/usr/bin/rpm", "-q"]
    if path is not None:
        query.append("-p")
    query.extend(["--qf", "%{PAYLOADSHA256}", str(path) if path is not None else "modeles-ia"])
    completed = subprocess.run(
        query,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    try:
        payload_digest = completed.stdout.decode("ascii", errors="strict").strip()
    except UnicodeError as exc:
        raise DeploymentError("artifact_invalid", "Atlas payload identity is invalid") from exc
    if completed.returncode != 0 or not SHA256_RE.fullmatch(payload_digest):
        raise DeploymentError("artifact_invalid", "Atlas payload identity is invalid")
    return payload_digest


def staged_release_path(manifest: dict[str, Any]) -> Path:
    return RELEASES_ROOT / manifest["release_id"]


def staged_metadata_path(manifest: dict[str, Any]) -> Path:
    return staged_release_path(manifest) / ".deployment-release.json"


def validate_staged_release(manifest: dict[str, Any]) -> Path | None:
    release = staged_release_path(manifest)
    if not release.exists():
        return None
    try:
        metadata = os.lstat(release)
    except OSError as exc:
        raise DeploymentError("release_invalid", "staged release is unavailable") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) & 0o022
    ):
        raise DeploymentError("release_invalid", "staged release root is unsafe")
    record = read_json(
        staged_metadata_path(manifest),
        maximum=16 * 1024,
        require_root_owned=True,
    )
    expected = {
        "schema_version": 1,
        "release_id": manifest["release_id"],
        "source_tree_sha256": manifest["source"]["tree_sha256"],
        "atlas_rpm_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"]["hermes_source_archive"]["sha256"],
    }
    if record != expected:
        raise DeploymentError("release_conflict", "staged release metadata differs from the reviewed manifest")
    return release


def verify_staged_release_contents(release: Path, manifest: dict[str, Any]) -> None:
    tree_root = release / "tree"
    if source_tree_digest(tree_root, manifest["source"]["roots"]) != manifest["source"]["tree_sha256"]:
        raise DeploymentError("checksum_mismatch", "staged source differs from the reviewed release")
    validate_component_declarations(tree_root, manifest)
    artifact = atlas_artifact_in_release(release, manifest)
    if sha256_regular(artifact) != manifest["artifacts"]["atlas_rpm"]["sha256"]:
        raise DeploymentError("checksum_mismatch", "staged Atlas RPM differs from the reviewed release")
    validate_atlas_rpm(artifact, manifest["artifacts"]["atlas_rpm"])
    validate_hermes_source_archive(
        hermes_archive_in_release(release, manifest),
        manifest["artifacts"]["hermes_source_archive"],
    )


def stage_release(manifest: dict[str, Any]) -> Path:
    existing = validate_staged_release(manifest)
    if existing is not None:
        verify_staged_release_contents(existing, manifest)
        return existing
    RELEASES_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{manifest['release_id']}.", dir=RELEASES_ROOT))
    tree_root = temporary / "tree"
    tree_root.mkdir(mode=0o755)
    entries: list[tuple[PurePosixPath, int, int, str]] = []
    total = 0
    source_root = Path(manifest["source"]["root"])
    try:
        for source, relative in iter_source_paths(source_root, manifest["source"]["roots"]):
            mode, size, digest = copy_and_hash(source, tree_root.joinpath(*relative.parts))
            total += size
            if total > MAX_SOURCE_TREE_BYTES:
                raise DeploymentError("source_invalid", "release source tree exceeds its bound")
            entries.append((relative, mode, size, digest))
        actual_tree_digest = canonical_tree_hash(entries)
        if actual_tree_digest != manifest["source"]["tree_sha256"]:
            raise DeploymentError("checksum_mismatch", "source tree changed after release review")
        validate_component_declarations(tree_root, manifest)

        # The manifest is intentionally excluded from its own source digest,
        # but installers running from the immutable staged tree require the
        # exact reviewed document. Install it as root-only inert data before
        # sealing the release directory.
        atomic_json(
            tree_root / "deploy/control-plane/release-manifest.v1.json",
            manifest,
            mode=0o600,
        )

        artifact_source = Path(manifest["artifacts"]["atlas_rpm"]["source_path"])
        artifact_target = temporary / "artifacts" / artifact_source.name
        _, _, artifact_digest = copy_and_hash(artifact_source, artifact_target)
        if artifact_digest != manifest["artifacts"]["atlas_rpm"]["sha256"]:
            raise DeploymentError("checksum_mismatch", "Atlas RPM changed after release review")
        validate_atlas_rpm(artifact_target, manifest["artifacts"]["atlas_rpm"])

        hermes_archive = manifest["artifacts"]["hermes_source_archive"]
        hermes_source = Path(hermes_archive["source_path"])
        hermes_target = temporary / "artifacts" / hermes_source.name
        _, _, hermes_digest = copy_and_hash(hermes_source, hermes_target)
        if hermes_digest != hermes_archive["sha256"]:
            raise DeploymentError(
                "checksum_mismatch",
                "Hermes source archive changed after release review",
            )
        validate_hermes_source_archive(hermes_target, hermes_archive)

        atomic_json(
            temporary / ".deployment-release.json",
            {
                "schema_version": 1,
                "release_id": manifest["release_id"],
                "source_tree_sha256": actual_tree_digest,
                "atlas_rpm_sha256": artifact_digest,
                "hermes_source_archive_sha256": hermes_digest,
            },
            mode=0o600,
        )
        for directory, directory_names, file_names in os.walk(temporary):
            for name in file_names:
                path = Path(directory) / name
                os.chown(path, 0, 0, follow_symlinks=False)
                os.chmod(path, stat.S_IMODE(os.lstat(path).st_mode) & ~0o222, follow_symlinks=False)
            for name in directory_names:
                path = Path(directory) / name
                os.chown(path, 0, 0, follow_symlinks=False)
                os.chmod(path, 0o555, follow_symlinks=False)
        os.chown(temporary, 0, 0)
        os.chmod(temporary, 0o500)
        fsync_tree(temporary)
        final = staged_release_path(manifest)
        os.rename(temporary, final)
        parent_descriptor = os.open(RELEASES_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(parent_descriptor)
        finally:
            os.close(parent_descriptor)
        return final
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise


HERMES_SOURCE_ROOT = Path("/var/lib/hermes/hermes-agent")


def hermes_source_disposition() -> str:
    """Classify the actual host before asking for bootstrap credentials."""
    if not os.path.lexists(HERMES_SOURCE_ROOT):
        return "absent"
    info = HERMES_SOURCE_ROOT.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise DeploymentError("hermes_source_conflict", "existing Hermes source root is unsafe")
    receipt = HERMES_SOURCE_ROOT / ".atlas-source.json"
    if not os.path.lexists(receipt):
        backup_parent = BACKUP_ROOT
        while not backup_parent.exists() and backup_parent != backup_parent.parent:
            backup_parent = backup_parent.parent
        if info.st_dev != backup_parent.stat().st_dev:
            raise DeploymentError("hermes_source_conflict", "Hermes preservation requires the backup filesystem")
        return "legacy-preserve-and-replace"
    info = receipt.lstat()
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise DeploymentError("hermes_source_conflict", "existing Hermes provenance receipt is unsafe")
    return "managed-verify-and-reuse"


def preserve_legacy_hermes_source(backup: Path, metadata: dict[str, Any]) -> None:
    """Move the unreceipted installation intact into its durable transaction backup."""
    if metadata.get("phase") != "installing" or metadata.get("backup_path") != str(backup):
        raise DeploymentError("hermes_source_conflict", "Hermes migration requires the installing WAL")
    destination = backup / "hermes-legacy-source"
    record = metadata.get("hermes_source_migration")
    if record is None and hermes_source_disposition() != "legacy-preserve-and-replace":
        return
    if systemctl_state("hermes-gateway.service", "is-active"):
        raise DeploymentError("hermes_source_conflict", "Hermes must be stopped before source migration")
    if str(HERMES_SOURCE_ROOT) not in metadata.get("managed_paths_existing", []):
        raise DeploymentError("rollback_unavailable", "legacy Hermes was not included in the backup")
    archive = backup / "managed-files.tar"
    if metadata.get("managed_archive") != str(archive):
        raise DeploymentError("rollback_unavailable", "the managed backup reference differs")
    validate_private_file(archive)
    if sha256_regular(archive, maximum=MAX_BACKUP_ARCHIVE_BYTES) != metadata.get("managed_archive_sha256"):
        raise DeploymentError("rollback_unavailable", "the managed backup checksum differs")
    if record is None:
        if os.path.lexists(destination):
            raise DeploymentError("hermes_source_conflict", "an unrecorded Hermes preservation path exists")
        info = HERMES_SOURCE_ROOT.lstat()
        if info.st_dev != backup.stat().st_dev:
            raise DeploymentError("hermes_source_conflict", "Hermes preservation requires an atomic local rename")
        record = {"phase": "planned", "device": info.st_dev, "inode": info.st_ino}
        metadata["hermes_source_migration"] = record
        atomic_json(backup / "transaction.json", metadata)
    if not isinstance(record, dict) or set(record) != {"phase", "device", "inode"} or record["phase"] not in {"planned", "preserved"}:
        raise DeploymentError("hermes_source_conflict", "the Hermes migration WAL is invalid")
    if not os.path.lexists(destination):
        info = HERMES_SOURCE_ROOT.lstat()
        if record["phase"] != "planned" or (info.st_dev, info.st_ino) != (record["device"], record["inode"]) or hermes_source_disposition() != "legacy-preserve-and-replace":
            raise DeploymentError("hermes_source_conflict", "legacy Hermes changed after migration planning")
        os.rename(HERMES_SOURCE_ROOT, destination)
    info = destination.lstat()
    if not stat.S_ISDIR(info.st_mode) or (info.st_dev, info.st_ino) != (record["device"], record["inode"]):
        raise DeploymentError("hermes_source_conflict", "the preserved Hermes identity differs")
    for parent in (backup, HERMES_SOURCE_ROOT.parent):
        descriptor = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    record["phase"] = "preserved"
    atomic_json(backup / "transaction.json", metadata)
    append_audit({"event": "hermes_legacy_source_preserved", "transaction_id": metadata["transaction_id"]})


def validate_hermes_transaction_temps_absent(error_code: str) -> None:
    """Reject every release-bound installer scratch path, including symlinks."""

    if any(os.path.lexists(path) for path in HERMES_TRANSACTION_TEMP_PATHS):
        raise DeploymentError(
            error_code,
            "a release-bound Hermes installer staging path remains",
        )


def preflight(
    manifest: dict[str, Any], *, require_password: bool,
    require_initial_docker_absent: bool = True,
) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise DeploymentError("permission_denied", "deployment worker must run as root")
    if platform.machine() != manifest["architecture"]:
        raise DeploymentError("preflight_failed", "host architecture differs from the release")
    validate_noop_identity_baseline()
    os_release = host_os_release()
    if os_release.get("ID") != "fedora" or os_release.get("VERSION_ID") != "44":
        raise DeploymentError("preflight_failed", "host is not the reviewed Fedora 44 release")
    hermes_source_disposition()
    validate_hermes_transaction_temps_absent("preflight_failed")
    for private_root in (STATE_ROOT, RELEASES_ROOT, BACKUP_ROOT, ZULIP_PASSWORD_FILE.parent):
        validate_private_directory(private_root)
    required_executables = (
        "/usr/bin/age",
        "/usr/bin/bash",
        "/usr/bin/curl",
        "/usr/bin/dnf",
        "/usr/bin/firewall-cmd",
        "/usr/bin/flock",
        "/usr/bin/getent",
        "/usr/bin/install",
        "/usr/bin/openssl",
        "/usr/bin/python3",
        "/usr/bin/rpm",
        "/usr/bin/rpmkeys",
        "/usr/bin/runuser",
        "/usr/bin/resolvectl",
        "/usr/bin/stat",
        "/usr/bin/systemd-analyze",
        "/usr/bin/systemd-creds",
        "/usr/bin/systemd-sysusers",
        "/usr/bin/systemd-tmpfiles",
        "/usr/bin/systemctl",
        "/usr/bin/sync",
        "/usr/bin/tar",
        "/usr/bin/update-ca-trust",
        "/usr/bin/visudo",
        "/usr/bin/alternatives",
        "/usr/sbin/groupdel",
        "/usr/sbin/ip",
        "/usr/sbin/iptables-nft",
        "/usr/sbin/nft",
        "/usr/sbin/sysctl",
        "/usr/sbin/userdel",
    )
    missing = [path for path in required_executables if not command_available(path)]
    if missing:
        raise DeploymentError("preflight_failed", f"required executable is absent: {Path(missing[0]).name}")
    # Preflight is observational: even a DNF help invocation may initialize
    # plugin/cache state. The reviewed download plugin is checked through the
    # RPM database and DNF itself runs only after the durable snapshot/WAL.
    if installed_package_nevra("dnf5-plugins") is None:
        raise DeploymentError("preflight_failed", "DNF download support is unavailable")
    for fixed_executable in (
        Path("/usr/lib/systemd/systemd-socket-proxyd"),
        Path("/opt/ops-memory/bin/ops-memory-mcp"),
    ):
        try:
            metadata = os.lstat(fixed_executable)
        except OSError as exc:
            raise DeploymentError("preflight_failed", f"required runtime is absent: {fixed_executable.name}") from exc
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) & 0o022
            or not metadata.st_mode & 0o111
        ):
            raise DeploymentError("preflight_failed", f"required runtime is unsafe: {fixed_executable.name}")
    for account in (
        "ops-user",
        "hermesd",
        "minecraft-ops",
        "infra-network",
        "ops-monitor",
        "backup-agent",
        "deploy-agent",
        "security-audit",
    ):
        try:
            pwd.getpwnam(account)
        except KeyError as exc:
            raise DeploymentError("preflight_failed", f"required service account is absent: {account}") from exc
    try:
        grp.getgrnam("node-exporter")
    except KeyError as exc:
        raise DeploymentError("preflight_failed", "required node-exporter group is absent") from exc
    validate_finance_identity(allow_absent=True)
    if not systemctl_state("ops-memory.service", "is-active"):
        raise DeploymentError("preflight_failed", "local memory service required by Hermes is inactive")
    if not Path("/etc/openbao.d/tls/ca.crt").is_file() or not systemctl_state("openbao.service", "is-active"):
        raise DeploymentError("preflight_failed", "local OpenBao is not ready")
    broker_socket = Path("/run/ops-broker/api.sock")
    try:
        broker_socket_metadata = os.lstat(broker_socket)
        broker_uid = pwd.getpwnam("opsbroker").pw_uid
        broker_gid = grp.getgrnam("opsbroker-api").gr_gid
    except (OSError, KeyError) as exc:
        raise DeploymentError(
            "preflight_failed", "private broker approval socket is unavailable"
        ) from exc
    if (
        not stat.S_ISSOCK(broker_socket_metadata.st_mode)
        or stat.S_ISLNK(broker_socket_metadata.st_mode)
        or broker_socket_metadata.st_uid != broker_uid
        or broker_socket_metadata.st_gid != broker_gid
        or stat.S_IMODE(broker_socket_metadata.st_mode) != 0o660
    ):
        raise DeploymentError("preflight_failed", "private broker approval socket is unavailable")
    docker_state = validate_docker_installation(require_active=False)
    if require_initial_docker_absent and docker_state != "absent":
        raise DeploymentError(
            "docker_conflict",
            "this release only supports the reviewed Docker-absent bootstrap",
        )
    if require_initial_docker_absent:
        validate_initial_zulip_absent()
        validate_docker_network_baseline(require_firewalld_synchronized=True)
        validate_docker_route_baseline()
        validate_docker_volume_preservation_roots()

    for credential_name in manifest["runtime"]["encrypted_credentials"]:
        validate_private_file(Path("/etc/credstore.encrypted") / credential_name)
    if require_password:
        validate_private_file(ZULIP_PASSWORD_FILE)
    if systemctl_state("zulip-local.service", "is-active"):
        validate_private_file(ZULIP_RESTORE_IDENTITY)

    installed_atlas = atlas_installed_identity()
    expected_atlas = (
        f"{manifest['artifacts']['atlas_rpm']['name']}-"
        f"{manifest['artifacts']['atlas_rpm']['version']}-"
        f"{manifest['artifacts']['atlas_rpm']['release']}."
        f"{manifest['artifacts']['atlas_rpm']['architecture']}"
    )
    if installed_atlas is None and any(
        os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS
    ):
        raise DeploymentError(
            "rollback_unavailable", "an unmanaged Atlas RPM payload is present"
        )
    if installed_atlas is not None:
        raise DeploymentError(
            "rollback_unavailable",
            "this bootstrap release requires Atlas to be initially absent",
        )

    release = validate_staged_release(manifest)
    if release is None:
        source_root = Path(manifest["source"]["root"])
        actual_tree_digest = source_tree_digest(source_root, manifest["source"]["roots"])
        if actual_tree_digest != manifest["source"]["tree_sha256"]:
            raise DeploymentError("checksum_mismatch", "source tree differs from the reviewed release")
        atlas_path = Path(manifest["artifacts"]["atlas_rpm"]["source_path"])
        validate_atlas_rpm(atlas_path, manifest["artifacts"]["atlas_rpm"])
        validate_hermes_source_archive(
            Path(manifest["artifacts"]["hermes_source_archive"]["source_path"]),
            manifest["artifacts"]["hermes_source_archive"],
        )
        atlas_candidate = atlas_path
    else:
        verify_staged_release_contents(release, manifest)
        atlas_candidate = atlas_artifact_in_release(release, manifest)
    atlas_preflight_inventory, _atlas_preflight_inventory_sha256 = (
        rpm_non_directory_payload_inventory(
            {expected_atlas: atlas_candidate}, error_code="rollback_unavailable"
        )
    )
    if {path for _nevra, _mode, path in atlas_preflight_inventory} != set(
        ATLAS_PAYLOAD_PATHS
    ):
        raise DeploymentError(
            "rollback_unavailable", "the Atlas RPM payload inventory differs from review"
        )
    assert_no_rpm_temporary_payloads(
        atlas_preflight_inventory, error_code="rollback_unavailable"
    )
    declaration_root = Path(manifest["source"]["root"]) if release is None else release / "tree"
    validate_component_declarations(declaration_root, manifest)
    dependency_check = subprocess.run(
        ["/usr/bin/rpm", "--upgrade", "--test", str(atlas_candidate)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
    )
    if dependency_check.returncode != 0:
        raise DeploymentError("preflight_failed", "Atlas runtime dependencies are incomplete")

    required_free = 5 * 1024 * 1024 * 1024
    for root in (STATE_ROOT, BACKUP_ROOT):
        if shutil.disk_usage(root).free < required_free:
            raise DeploymentError("preflight_failed", "less than 5 GiB is free for deployment and rollback")
    return {
        "release_id": manifest["release_id"],
        "preflight": "passed",
        "local_inference": local_inference_status(),
    }


def service_snapshot() -> dict[str, dict[str, bool]]:
    return {
        unit: {
            "active": systemctl_state(unit, "is-active"),
            "enabled": systemctl_state(unit, "is-enabled"),
        }
        for unit in SERVICE_NAMES
    }


def atlas_installed_identity() -> str | None:
    completed = subprocess.run(
        ["/usr/bin/rpm", "-q", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}", "modeles-ia"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=10,
    )
    if completed.returncode != 0:
        return None
    value = completed.stdout.decode("ascii", errors="strict")
    if len(value) > 256 or CONTROL_RE.search(value):
        raise DeploymentError("preflight_failed", "installed Atlas package identity is invalid")
    return value


def atlas_installation_is_pristine() -> bool:
    completed = subprocess.run(
        ["/usr/bin/rpm", "-V", "modeles-ia"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
    )
    return completed.returncode == 0


def validate_saved_atlas_artifact(
    metadata: dict[str, Any]
) -> tuple[Path, list[tuple[str, int, Path]]]:
    raw_path = metadata.get("atlas_artifact_path")
    digest = metadata.get("atlas_artifact_sha256")
    expected = metadata.get("atlas_expected")
    if (
        not isinstance(raw_path, str)
        or not isinstance(digest, str)
        or not SHA256_RE.fullmatch(digest)
        or not isinstance(expected, str)
        or len(expected) > 256
        or CONTROL_RE.search(expected)
    ):
        raise DeploymentError("rollback_failed", "saved Atlas artifact identity is invalid")
    path = Path(raw_path)
    try:
        relative = path.relative_to(RELEASES_ROOT)
        item = os.lstat(path)
    except (ValueError, OSError) as exc:
        raise DeploymentError("rollback_failed", "saved Atlas artifact is unavailable") from exc
    if (
        len(relative.parts) != 3
        or relative.parts[1] != "artifacts"
        or not IDENTIFIER_RE.fullmatch(relative.parts[0])
        or not stat.S_ISREG(item.st_mode)
        or stat.S_ISLNK(item.st_mode)
        or item.st_uid != 0
        or stat.S_IMODE(item.st_mode) & 0o022
        or sha256_regular(path) != digest
    ):
        raise DeploymentError("rollback_failed", "saved Atlas artifact differs from review")
    signature = subprocess.run(
        ["/usr/bin/rpmkeys", "--checksig", str(path)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    identity = subprocess.run(
        ["/usr/bin/rpm", "-qp", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}", str(path)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if signature.returncode != 0 or identity.returncode != 0:
        raise DeploymentError("rollback_failed", "saved Atlas artifact signature is invalid")
    try:
        artifact_identity = identity.stdout.decode("ascii", errors="strict")
    except UnicodeError as exc:
        raise DeploymentError("rollback_failed", "saved Atlas artifact identity is invalid") from exc
    if artifact_identity != expected:
        raise DeploymentError("rollback_failed", "saved Atlas artifact NEVRA differs")
    inventory, inventory_sha256 = rpm_non_directory_payload_inventory(
        {expected: path}, error_code="rollback_failed"
    )
    if (
        {item[2] for item in inventory} != set(ATLAS_PAYLOAD_PATHS)
        or inventory_sha256 != metadata.get("atlas_payload_inventory_sha256")
        or len(inventory) != metadata.get("atlas_payload_inventory_count")
        or metadata.get("atlas_payload_siblings_clean") is not True
    ):
        raise DeploymentError("rollback_failed", "saved Atlas payload inventory differs")
    return path, inventory


def restore_atlas(metadata: dict[str, Any]) -> None:
    before = metadata.get("atlas_before")
    attempted = metadata.get("atlas_installation_attempted")
    expected = metadata.get("atlas_expected")
    if (
        (before is not None and (not isinstance(before, str) or before != expected))
        or not isinstance(attempted, bool)
    ):
        raise DeploymentError("rollback_failed", "saved Atlas transaction is invalid")
    artifact, payload_inventory = validate_saved_atlas_artifact(metadata)
    if attempted:
        remove_attributable_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )
        common = [
            "/usr/bin/dnf", "--assumeyes", "--disablerepo=*",
            "--setopt=install_weak_deps=False",
        ]
        run_command(
            "rollback-complete-atlas-package",
            [*common, "install", str(artifact)],
            timeout=600,
        )
        run_command(
            "rollback-reinstall-atlas-package",
            [*common, "reinstall", str(artifact)],
            timeout=600,
        )
        if atlas_installed_identity() != expected or not atlas_installation_is_pristine():
            raise DeploymentError(
                "rollback_failed", "offline Atlas package completion differs from review"
            )
        if before is None:
            run_command(
                "rollback-atlas-package",
                [
                    "/usr/bin/dnf", "--assumeyes", "--disablerepo=*",
                    "--setopt=clean_requirements_on_remove=False", "remove",
                    "--no-autoremove", "modeles-ia",
                ],
                timeout=600,
            )
        assert_no_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )
    else:
        assert_no_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )
    if atlas_installed_identity() != before:
        raise DeploymentError("rollback_failed", "Atlas package did not return to its baseline")
    if before is None and any(os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS):
        raise DeploymentError("rollback_failed", "an Atlas RPM payload remained after rollback")
    if before is not None and not atlas_installation_is_pristine():
        raise DeploymentError("rollback_failed", "the restored Atlas package is modified")


def capture_backup(manifest: dict[str, Any]) -> tuple[Path, dict[str, Any]]:
    # Re-prove the membership gate immediately before the transaction record.
    # Every sysusers/usermod operation except the separately snapshotted
    # opsfinance identity must remain a no-op.
    validate_noop_identity_baseline(error_code="installed_state_unsafe")
    validate_initial_zulip_absent(allow_bootstrap_recovery_barrier=True)
    # This is the last pre-WAL frontier. A residue cannot be adopted or
    # overwritten because it is not attributable to the new transaction yet.
    validate_hermes_transaction_temps_absent("installed_state_unsafe")
    timestamp = time.strftime("%Y%m%d%H%M%S", time.gmtime())
    transaction_id = f"{manifest['release_id']}-{timestamp}-{os.getpid()}"
    backup = BACKUP_ROOT / transaction_id
    backup.mkdir(mode=0o700, parents=True, exist_ok=False)
    # The transaction directory itself must be durable before CURRENT can
    # reference it or any service is quiesced.
    directory_fd = os.open(BACKUP_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    existing = [path for path in MANAGED_BACKUP_PATHS if path.exists() or path.is_symlink()]
    for path in existing:
        if path.is_symlink():
            raise DeploymentError("installed_state_unsafe", "a managed deployment path is symlinked")
    docker_state = validate_docker_installation(require_active=False)
    if docker_state != "absent":
        raise DeploymentError(
            "docker_conflict",
            "this initial release requires the reviewed Docker-absent baseline",
        )
    docker_packages_before = docker_transaction_package_snapshot()
    docker_history_before = (
        sorted(dnf_docker_history()) if docker_state == "absent" else []
    )
    docker_service_before = docker_service_snapshot()
    docker_group_before = docker_group_snapshot()
    docker_rollback_preset_parent_before = docker_rollback_preset_parent_exists()
    if docker_state == "absent" and docker_group_before is not None:
        raise DeploymentError(
            "docker_conflict",
            "a pre-existing Docker group could gain rootful daemon access",
        )
    docker_restart_policies_before: dict[str, str] = {}
    (
        docker_firewalld_before,
        docker_sysctls_before,
        docker_alternatives_before,
        docker_nft_before,
    ) = validate_docker_network_baseline(
        require_firewalld_synchronized=docker_state == "absent"
    )
    local_inference_before = local_inference_snapshot()
    service_state = service_snapshot()
    if any(
        service_state.get(unit, {}).get("active") is True
        for unit in TRANSIENT_SERVICE_NAMES
    ) or any(
        systemctl_state(unit, "is-active") for unit in ALL_TRANSIENT_UNITS
        if unit not in TRANSIENT_SERVICE_NAMES
    ):
        raise DeploymentError(
            "maintenance_busy", "a transient maintenance unit is still active"
        )
    zulip_existing = False
    atlas_before = atlas_installed_identity()
    expected_atlas = (
        f"{manifest['artifacts']['atlas_rpm']['name']}-"
        f"{manifest['artifacts']['atlas_rpm']['version']}-"
        f"{manifest['artifacts']['atlas_rpm']['release']}."
        f"{manifest['artifacts']['atlas_rpm']['architecture']}"
    )
    if atlas_before is None and any(
        os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS
    ):
        raise DeploymentError(
            "rollback_unavailable", "an unmanaged Atlas RPM payload is present"
        )
    if atlas_before is not None:
        raise DeploymentError(
            "rollback_unavailable",
            "this bootstrap release requires Atlas to be initially absent",
        )
    staged_release = validate_staged_release(manifest)
    if staged_release is None:
        raise DeploymentError(
            "rollback_unavailable", "the staged Atlas rollback artifact is unavailable"
        )
    atlas_rollback_artifact = atlas_artifact_in_release(staged_release, manifest)
    if sha256_regular(atlas_rollback_artifact) != manifest["artifacts"]["atlas_rpm"]["sha256"]:
        raise DeploymentError(
            "rollback_unavailable", "the staged Atlas rollback artifact differs from review"
        )
    atlas_payload_inventory, atlas_payload_inventory_sha256 = (
        rpm_non_directory_payload_inventory(
            {expected_atlas: atlas_rollback_artifact},
            error_code="rollback_unavailable",
        )
    )
    if {path for _nevra, _mode, path in atlas_payload_inventory} != set(
        ATLAS_PAYLOAD_PATHS
    ):
        raise DeploymentError(
            "rollback_unavailable", "the Atlas RPM payload inventory differs from review"
        )
    assert_no_rpm_temporary_payloads(
        atlas_payload_inventory, error_code="rollback_unavailable"
    )

    tar_path = backup / "managed-files.tar"
    metadata: dict[str, Any] = {
        "schema_version": 1,
        "transaction_id": transaction_id,
        "release_id": manifest["release_id"],
        "backup_path": str(backup),
        "created_at": int(time.time()),
        "phase": "snapshotting",
        "managed_paths_existing": [str(path) for path in existing],
        "managed_archive": None,
        "managed_archive_sha256": None,
        "service_state": service_state,
        "local_inference_before": local_inference_before,
        "finance_identity_before": validate_finance_identity(allow_absent=True),
        "atlas_before": atlas_before,
        "atlas_expected": expected_atlas,
        "atlas_artifact_path": str(atlas_rollback_artifact),
        "atlas_artifact_sha256": manifest["artifacts"]["atlas_rpm"]["sha256"],
        "hermes_source_archive_sha256": manifest["artifacts"][
            "hermes_source_archive"
        ]["sha256"],
        "hermes_transaction_temp_paths": [
            str(path) for path in HERMES_TRANSACTION_TEMP_PATHS
        ],
        "atlas_installation_attempted": False,
        "atlas_payload_inventory_sha256": atlas_payload_inventory_sha256,
        "atlas_payload_inventory_count": len(atlas_payload_inventory),
        "atlas_payload_siblings_clean": True,
        "docker": {
            "packages_before": docker_packages_before,
            "service_before": docker_service_before,
            "group_before": docker_group_before,
            "group_creation_expected": docker_group_before is None,
            "group_created_gid": None,
            "history_ids_before": docker_history_before,
            "installation_attempted": False,
            "transaction_id": None,
            "packages_after": None,
            "bundle_sha256": None,
            "payload_inventory_sha256": None,
            "payload_inventory_count": None,
            "payload_siblings_clean": False,
            "restart_policies_before": docker_restart_policies_before,
            "restart_suppression_started": False,
            "restart_suppressed": False,
            "restart_policies_committed": False,
            "volumes_preservation_started": False,
            "volumes_preservation_path": None,
            "volumes_preserved": False,
            "config_parent_creation_started": False,
            "rollback_preset_started": False,
            "rollback_preset_removed": False,
            "rollback_preset_parent_existed": docker_rollback_preset_parent_before,
            "firewalld_before": docker_firewalld_before,
            "sysctls_before": docker_sysctls_before,
            "iptables_alternatives_before": docker_alternatives_before,
            "nft_ruleset_sha256_before": docker_nft_before,
        },
        "zulip_existing": zulip_existing,
        "zulip_backup": None,
        "rolled_back": False,
    }
    # Persist the recovery record before the first operation that may quiesce a
    # service. A power loss while creating the snapshot is therefore recoverable
    # without assuming that the archive is complete.
    atomic_json(backup / "transaction.json", metadata)
    atomic_json(
        CURRENT_PATH,
        {
            "schema_version": 1,
            "release_id": manifest["release_id"],
            "status": "deploying",
            "transaction_id": transaction_id,
            "backup_path": str(backup),
            "activated_at": int(time.time()),
        },
    )
    append_audit(
        {
            "event": "deployment_snapshot_started",
            "release_id": manifest["release_id"],
            "transaction_id": transaction_id,
        }
    )

    # Quiesce databases only after the official live Zulip backup. If snapshot
    # creation fails normally, restore the exact prior units immediately. If
    # the process is interrupted, `phase=snapshotting` drives the same recovery
    # on the next approved worker invocation.
    stop_attempted = False
    try:
        stop_attempted = True
        stop_dependents()
        # The old stack is now stopped/removed under a durable transaction
        # record. Only then publish the marker that makes every subsequent
        # Compose create/up use restart=no until the global commit.
        suppress_zulip_container_restarts(metadata)
        if existing:
            run_command(
                "backup-managed-files",
                [
                    "/usr/bin/tar",
                    "--create",
                    "--file",
                    str(tar_path),
                    "--one-file-system",
                    "--xattrs",
                    "--acls",
                    "--selinux",
                    "--",
                    *[str(path) for path in existing],
                ],
                timeout=900,
            )
            os.chmod(tar_path, 0o600)
            archive_fd = os.open(tar_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            try:
                os.fsync(archive_fd)
            finally:
                os.close(archive_fd)
            metadata["managed_archive"] = str(tar_path)
            metadata["managed_archive_sha256"] = sha256_regular(
                tar_path, maximum=MAX_BACKUP_ARCHIVE_BYTES
            )
        # Include separately mounted backup/Docker/Zulip filesystems before
        # the durable phase transition authorizes any installer mutation.
        _sync_rollback_filesystems()
        metadata["phase"] = "snapshotted"
        atomic_json(backup / "transaction.json", metadata)
    except BaseException as backup_error:
        try:
            if stop_attempted:
                restore_service_state(service_state)
                verify_service_state(service_state)
            if metadata["docker"].get("restart_suppression_started") is True:
                restore_zulip_container_restart_policies(metadata)
            _sync_rollback_filesystems()
            verify_terminal_rollback(metadata)
            metadata["rolled_back"] = True
            metadata["rolled_back_at"] = int(time.time())
            metadata["phase"] = "rolled-back"
            atomic_json(backup / "transaction.json", metadata)
            atomic_json(
                CURRENT_PATH,
                {
                    "schema_version": 1,
                    "release_id": manifest["release_id"],
                    "status": "rolled-back",
                    "transaction_id": transaction_id,
                    "backup_path": str(backup),
                    "activated_at": int(time.time()),
                },
            )
            append_audit(
                {
                    "event": "deployment_snapshot_failed",
                    "release_id": manifest["release_id"],
                    "transaction_id": transaction_id,
                    "rollback": "completed",
                }
            )
        except BaseException as restore_error:
            atomic_json(
                CURRENT_PATH,
                {
                    "schema_version": 1,
                    "release_id": manifest["release_id"],
                    "status": "rollback-failed",
                    "transaction_id": transaction_id,
                    "backup_path": str(backup),
                    "activated_at": int(time.time()),
                },
            )
            raise DeploymentError(
                "backup_recovery_failed",
                "backup failed and prior service state could not be restored",
            ) from restore_error
        raise backup_error
    return backup, metadata


def stop_dependents() -> None:
    for unit in (
        "ops-broker-audit-verify.timer",
        "ops-broker-backup.timer",
        "ops-broker-audit-verify.service",
        "ops-broker-backup.service",
        "ops-broker-backup-metric-success.service",
        "ops-broker-backup-metric-failure.service",
        "zulip-alertmanager-query.socket",
        "zulip-local-health.timer",
        "zulip-local-backup.timer",
        "zulip-alertmanager-query.service",
        "zulip-local-health.service",
        "zulip-local-backup.service",
        "zulip-approval-bridge.service",
        "zulip-local.service",
        "zulip-local-secrets.service",
        "hermes-gateway.service",
        "ops-orchestrator-hermes-facade.service",
        "ops-orchestrator-provider-finance.timer",
        "ops-orchestrator-provider-finance.service",
        "ops-orchestrator-metrics.timer",
        "ops-orchestrator-metrics.service",
        "ops-orchestrator.service",
        "ops-orchestrator-provider-finance-daemon.service",
        "ops-orchestrator-secrets.service",
    ):
        completed = subprocess.run(
            ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", unit],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        if completed.returncode == 0 and completed.stdout.strip() not in {b"", b"not-found"}:
            run_command(f"stop-{unit}", ["/usr/bin/systemctl", "stop", unit], timeout=180)


def atlas_artifact_in_release(release: Path, manifest: dict[str, Any]) -> Path:
    return release / "artifacts" / Path(manifest["artifacts"]["atlas_rpm"]["source_path"]).name


def hermes_archive_in_release(release: Path, manifest: dict[str, Any]) -> Path:
    return release / "artifacts" / Path(
        manifest["artifacts"]["hermes_source_archive"]["source_path"]
    ).name


def install_release(
    release: Path,
    manifest: dict[str, Any],
    backup: Path,
    metadata: dict[str, Any],
) -> None:
    source = release / "tree"
    preserve_legacy_hermes_source(backup, metadata)
    disable_local_inference(metadata)
    ensure_docker(backup, metadata)
    stop_dependents()
    marker = Path("/etc/hermes/hermes-gateway.enabled")
    if marker.is_symlink():
        raise DeploymentError("installed_state_unsafe", "Hermes activation marker is symlinked")
    marker.unlink(missing_ok=True)

    run_command(
        "install-orchestrator",
        [str(source / "scripts/install-orchestrator.sh"), "--replace-api-config"],
        timeout=1800,
    )
    atlas_rpm = atlas_artifact_in_release(release, manifest)
    # DNF can leave an installed package or attributable rpm temporary
    # payloads even when the command itself fails.  Persist the intent before
    # invoking it so crash/error rollback always takes the completion,
    # verification and baseline-restoration branch in restore_atlas().
    metadata["atlas_installation_attempted"] = True
    atomic_json(backup / "transaction.json", metadata)
    run_command(
        "install-atlas",
        [
            "/usr/bin/dnf",
            "--assumeyes",
            "--disablerepo=*",
            "--setopt=install_weak_deps=False",
            "install",
            str(atlas_rpm),
        ],
        timeout=900,
    )
    run_command("verify-atlas", ["/usr/bin/rpm", "-V", "modeles-ia"], timeout=60)

    run_command(
        "install-hermes",
        [
            str(source / "scripts/install-hermes.sh"),
            "--archive",
            str(hermes_archive_in_release(release, manifest)),
        ],
        timeout=3600,
    )
    run_command(
        "install-zulip-local",
        [str(source / "deploy/zulip-local/bin/install.sh"), "--install", "--enable"],
        timeout=300,
    )
    run_command("start-zulip-secrets", ["/usr/bin/systemctl", "start", "zulip-local-secrets.service"], timeout=120)
    require_docker_networks_absent()
    validate_docker_route_baseline()
    run_command(
        "initialize-zulip",
        ["/opt/ops-control-plane/deploy/zulip-local/bin/init.sh", "--start"],
        timeout=2400,
    )
    run_command(
        "provision-zulip-realm",
        [
            "/opt/ops-control-plane/deploy/zulip-local/bin/provision-zulip.py",
            "--admin-password-file",
            str(ZULIP_PASSWORD_FILE),
        ],
        timeout=300,
    )
    run_command(
        "enable-zulip",
        [
            "/usr/bin/systemctl",
            "enable",
            "--now",
            "zulip-local.service",
            "zulip-local-health.timer",
            "zulip-local-backup.timer",
        ],
        timeout=300,
    )

    run_command(
        "enable-orchestrator",
        [
            "/usr/bin/systemctl",
            "enable",
            "--now",
            "ops-orchestrator.service",
            "ops-orchestrator-metrics.timer",
            "ops-orchestrator-provider-finance.timer",
        ],
        timeout=300,
    )

    marker.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    descriptor = os.open(
        marker,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    os.close(descriptor)
    run_command(
        "enable-hermes",
        ["/usr/bin/systemctl", "enable", "--now", "hermes-gateway.service"],
        timeout=300,
    )

    run_command("install-zulip-bridge", [str(source / "scripts/install-zulip-bridge.sh"), "--activate"], timeout=1800)


def health_check(manifest: dict[str, Any]) -> None:
    # A successful release is not committed while any crash-recovery scratch
    # tree remains, even if every runtime endpoint is already responding.
    validate_hermes_transaction_temps_absent("health_failed")
    if local_inference_status() not in {"disabled", "absent"}:
        raise DeploymentError("health_failed", "local inference remains in the runtime path")
    validate_docker_installation(require_active=True)
    validate_docker_runtime_network()
    release = validate_staged_release(manifest)
    if release is None:
        raise DeploymentError("health_failed", "the reviewed release snapshot is absent")
    if source_tree_digest(release / "tree", manifest["source"]["roots"]) != manifest["source"]["tree_sha256"]:
        raise DeploymentError("health_failed", "the staged source tree changed during deployment")
    if sha256_regular(atlas_artifact_in_release(release, manifest)) != manifest["artifacts"]["atlas_rpm"]["sha256"]:
        raise DeploymentError("health_failed", "the staged Atlas artifact changed during deployment")
    try:
        validate_hermes_source_archive(
            hermes_archive_in_release(release, manifest),
            manifest["artifacts"]["hermes_source_archive"],
        )
    except DeploymentError as exc:
        raise DeploymentError(
            "health_failed", "the staged Hermes source archive changed during deployment"
        ) from exc
    for unit in SERVICE_NAMES:
        active = systemctl_state(unit, "is-active")
        if unit in TRANSIENT_SERVICE_NAMES:
            if active:
                raise DeploymentError("health_failed", f"transient unit remains active: {unit}")
        elif unit in DYNAMIC_SERVICE_NAMES:
            # Its socket and a real proxied request below are the stable health
            # contract; systemd-socket-proxyd may legitimately be idle here.
            continue
        elif not active:
            raise DeploymentError("health_failed", f"required unit is inactive: {unit}")
    for unit in ALL_TRANSIENT_UNITS:
        if unit not in SERVICE_NAMES and systemctl_state(unit, "is-active"):
            raise DeploymentError("health_failed", f"transient unit remains active: {unit}")
    validate_finance_socket()
    run_command(
        "health-zulip",
        ["/opt/ops-control-plane/deploy/zulip-local/bin/health.sh", "--quiet"],
        timeout=120,
    )
    if not systemctl_state("zulip-alertmanager-query.socket", "is-enabled"):
        raise DeploymentError(
            "health_failed", "Alertmanager query socket is not enabled"
        )
    validate_alertmanager_query_socket()
    run_command(
        "health-alertmanager-query",
        [
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--max-filesize",
            str(MAX_HEALTH_RESPONSE_BYTES),
            "--noproxy",
            "*",
            "--proto",
            "=http",
            "--unix-socket",
            str(ALERTMANAGER_QUERY_SOCKET),
            "--output",
            "/dev/null",
            "http://localhost/api/v2/alerts",
        ],
        timeout=10,
    )
    run_command(
        "health-orchestrator",
        [
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--unix-socket",
            "/run/ops-orchestrator/api.sock",
            "http://localhost/v1/health",
        ],
        timeout=10,
    )
    run_command(
        "health-provider-finance",
        [
            "/usr/bin/runuser",
            "-u",
            "opsorchestrator",
            "--",
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--unix-socket",
            "/run/ops-orchestrator-finance/api.sock",
            "http://localhost/v1/health",
        ],
        timeout=10,
    )
    run_command(
        "health-hermes-facade",
        [
            "/usr/bin/curl",
            "--silent",
            "--show-error",
            "--fail",
            "--max-time",
            "5",
            "--noproxy",
            "*",
            "--proto",
            "=http",
            "http://127.0.0.1:8643/healthz",
        ],
        timeout=10,
    )
    expected = (
        f"{manifest['artifacts']['atlas_rpm']['name']}-"
        f"{manifest['artifacts']['atlas_rpm']['version']}-"
        f"{manifest['artifacts']['atlas_rpm']['release']}."
        f"{manifest['artifacts']['atlas_rpm']['architecture']}"
    )
    if atlas_installed_identity() != expected:
        raise DeploymentError("health_failed", "installed Atlas package identity differs from release")
    if atlas_payload_sha256() != atlas_payload_sha256(
        atlas_artifact_in_release(release, manifest)
    ):
        raise DeploymentError("health_failed", "installed Atlas payload differs from release")
    run_command(
        "health-atlas-rpm",
        ["/usr/bin/rpm", "-V", manifest["artifacts"]["atlas_rpm"]["name"]],
        timeout=60,
    )


def _safe_remove_managed(path: Path) -> None:
    if path not in MANAGED_BACKUP_PATHS:
        raise DeploymentError("rollback_failed", "rollback attempted an unreviewed path")
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return
    if stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode):
        shutil.rmtree(path)
    else:
        path.unlink()


def restore_service_state(snapshot: dict[str, Any]) -> None:
    if set(snapshot) != set(SERVICE_NAMES):
        raise DeploymentError("rollback_failed", "saved service set is invalid")
    available: dict[str, bool] = {}
    for unit in SERVICE_NAMES:
        item = snapshot.get(unit)
        if not isinstance(item, dict) or set(item) != {"active", "enabled"}:
            raise DeploymentError("rollback_failed", "saved service state is invalid")
        if not isinstance(item["active"], bool) or not isinstance(item["enabled"], bool):
            raise DeploymentError("rollback_failed", "saved service flags are invalid")
        loaded = subprocess.run(
            ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", unit],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        available[unit] = loaded.returncode == 0 and loaded.stdout.strip() not in {
            b"",
            b"not-found",
        }
        if not available[unit]:
            if item["active"] is True or item["enabled"] is True:
                raise DeploymentError("rollback_failed", "a previously present unit cannot be restored")
            continue
        if item["enabled"] is True:
            run_command(f"restore-enable-{unit}", ["/usr/bin/systemctl", "enable", unit], timeout=120)
        else:
            run_command(f"restore-disable-{unit}", ["/usr/bin/systemctl", "disable", unit], timeout=120)

    # Stop trigger timers/sockets before their oneshots, then remove
    # enablements. This prevents a persistent timer from starting a writer in
    # the middle of file/database restoration.
    stop_dependents()
    for unit in reversed(SERVICE_NAMES):
        if (
            unit not in DYNAMIC_SERVICE_NAMES
            and available[unit]
            and snapshot[unit]["active"] is False
        ):
            run_command(f"restore-stop-{unit}", ["/usr/bin/systemctl", "stop", unit], timeout=180)
    for unit in SERVICE_NAMES:
        if (
            unit not in DYNAMIC_SERVICE_NAMES
            and available[unit]
            and snapshot[unit]["active"] is True
        ):
            run_command(f"restore-start-{unit}", ["/usr/bin/systemctl", "start", unit], timeout=300)
    verify_service_state(snapshot)


def verify_service_state(snapshot: dict[str, Any]) -> None:
    if set(snapshot) != set(SERVICE_NAMES):
        raise DeploymentError("rollback_failed", "saved service set is invalid")
    for unit in SERVICE_NAMES:
        state = snapshot.get(unit)
        if (
            not isinstance(state, dict) or set(state) != {"active", "enabled"}
            or not all(isinstance(state.get(key), bool) for key in ("active", "enabled"))
            or (
                unit not in DYNAMIC_SERVICE_NAMES
                and systemctl_state(unit, "is-active") is not state["active"]
            )
            or systemctl_state(unit, "is-enabled") is not state["enabled"]
        ):
            raise DeploymentError("rollback_failed", "restored service state differs from snapshot")


def _unit_is_loaded(unit: str) -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", unit],
        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, timeout=10,
    )
    return completed.returncode == 0 and completed.stdout.strip() not in {b"", b"not-found"}


def _sync_rollback_filesystems() -> None:
    """Durably commit all filesystems, including nested Docker/data mounts."""

    # A fixed root list can miss independently mounted paths such as
    # /var/lib/docker. GNU sync without operands flushes every mounted
    # filesystem. run_command bounds/reaps the process group and carries the
    # deployment OFD lock, so rollback cannot race a surviving child.
    run_command(
        "sync-control-plane-filesystems",
        ["/usr/bin/sync"],
        timeout=300,
    )


def validate_saved_hermes_transaction_identity(
    metadata: dict[str, Any], error_code: str,
) -> None:
    if (
        metadata.get("hermes_source_archive_sha256")
        != HERMES_SOURCE_ARCHIVE_SHA256
        or metadata.get("hermes_transaction_temp_paths")
        != [str(path) for path in HERMES_TRANSACTION_TEMP_PATHS]
    ):
        raise DeploymentError(
            error_code, "saved Hermes release transaction identity differs"
        )


def verify_terminal_rollback(metadata: dict[str, Any]) -> None:
    """Re-prove a terminal rollback before treating its WAL flag as final."""

    validate_saved_hermes_transaction_identity(metadata, "rollback_failed")
    validate_hermes_transaction_temps_absent("rollback_failed")
    verify_service_state(_mapping(metadata.get("service_state"), "service_state"))
    validate_noop_identity_baseline(error_code="rollback_failed")
    prior_inference = _mapping(
        metadata.get("local_inference_before"), "local_inference_before"
    )
    if local_inference_snapshot() != prior_inference:
        raise DeploymentError("rollback_failed", "local inference rollback state differs")
    prior_finance = metadata.get("finance_identity_before")
    if prior_finance not in {"absent", "present"}:
        raise DeploymentError("rollback_failed", "saved provider-finance identity is invalid")
    if validate_finance_identity(allow_absent=True) != prior_finance:
        raise DeploymentError("rollback_failed", "provider-finance rollback state differs")
    atlas_before = metadata.get("atlas_before")
    if atlas_before is not None and not isinstance(atlas_before, str):
        raise DeploymentError("rollback_failed", "saved Atlas rollback state is invalid")
    if atlas_installed_identity() != atlas_before:
        raise DeploymentError("rollback_failed", "Atlas rollback state differs")
    if atlas_before is None:
        if any(os.path.lexists(path) for path in ATLAS_PAYLOAD_PATHS):
            raise DeploymentError("rollback_failed", "an Atlas RPM payload remained")
    elif not atlas_installation_is_pristine():
        raise DeploymentError("rollback_failed", "the restored Atlas package is modified")
    if metadata.get("atlas_installation_attempted") is True:
        _atlas_artifact, atlas_inventory = validate_saved_atlas_artifact(metadata)
        assert_no_rpm_temporary_payloads(
            atlas_inventory, error_code="rollback_failed"
        )
    docker_record = _mapping(metadata.get("docker"), "transaction.docker")
    before_packages = validate_saved_docker_packages(
        docker_record.get("packages_before"), "rollback_failed"
    )
    if docker_record.get("installation_attempted") is True:
        raw_bundle = docker_record.get("bundle_sha256")
        if not isinstance(raw_bundle, dict):
            raise DeploymentError("rollback_failed", "saved Docker bundle is invalid")
        _bundle_paths, payload_inventory = validate_saved_docker_bundle(
            metadata, before_packages, raw_bundle
        )
        assert_no_rpm_temporary_payloads(
            payload_inventory, error_code="rollback_failed"
        )
    if docker_transaction_package_snapshot() != before_packages:
        raise DeploymentError("rollback_failed", "Docker rollback package state differs")
    service_before = validate_saved_docker_service_state(
        docker_record.get("service_before"), "rollback_failed"
    )
    top_absent = all(before_packages[name] is None for name in DOCKER_PACKAGE_NEVRAS)
    if top_absent:
        if (
            Path("/usr/bin/docker").exists()
            or unit_is_loaded(DOCKER_SERVICE)
            or unit_is_loaded("docker.socket")
        ):
            raise DeploymentError("rollback_failed", "Docker runtime remained after rollback")
    if docker_service_snapshot() != service_before:
        raise DeploymentError("rollback_failed", "Docker service rollback matrix differs")
    group_before = validate_saved_docker_group(
        docker_record.get("group_before"), "rollback_failed"
    )
    if docker_group_snapshot() != group_before:
        raise DeploymentError("rollback_failed", "Docker group rollback state differs")
    verify_docker_network_rollback(docker_record, reload_firewalld=False)
    verify_preserved_docker_volumes(metadata)
    if any(
        os.path.lexists(path)
        for path in (*DOCKER_RUNTIME_STATE_PATHS, *DOCKER_PERSISTENT_STATE_PATHS)
    ):
        raise DeploymentError(
            "rollback_failed", "transaction-created Docker runtime state remained"
        )
    if any(os.path.lexists(path) for path in DOCKER_UNMANAGED_PATHS):
        raise DeploymentError(
            "rollback_failed", "a fresh-only Docker artifact remained after rollback"
        )
    if docker_rollback_preset_parent_exists() is not docker_record.get(
        "rollback_preset_parent_existed"
    ):
        raise DeploymentError(
            "rollback_failed", "the systemd preset parent did not return to baseline"
        )
    _sync_rollback_filesystems()


def rollback_transaction(backup: Path, metadata: dict[str, Any]) -> None:
    validate_saved_hermes_transaction_identity(metadata, "rollback_failed")
    if metadata.get("rolled_back") is True:
        verify_terminal_rollback(metadata)
        return
    phase = metadata.get("phase")
    if phase not in {"snapshotting", "snapshotted", "installing", "healthy"}:
        raise DeploymentError("rollback_failed", "saved deployment phase is invalid")
    if phase == "snapshotting":
        # No installer or cutover is reached before the snapshot phase commits.
        # Only service quiescence may have happened, so never extract a partial
        # archive or invoke a Zulip data restore here.
        restore_service_state(_mapping(metadata.get("service_state"), "service_state"))
        restore_docker(metadata)
        restore_local_inference(metadata)
        restore_finance_identity(metadata)
        verify_service_state(_mapping(metadata.get("service_state"), "service_state"))
        _sync_rollback_filesystems()
        verify_terminal_rollback(metadata)
        metadata["rolled_back"] = True
        metadata["rolled_back_at"] = int(time.time())
        metadata["phase"] = "rolled-back"
        atomic_json(backup / "transaction.json", metadata)
        append_audit(
            {
                "event": "deployment_rolled_back",
                "release_id": metadata["release_id"],
                "transaction_id": metadata["transaction_id"],
                "from_phase": "snapshotting",
            }
        )
        return
    # A previous rollback may have restored files before losing power. Refresh
    # systemd so removed units are not mistaken for still-installed units.
    run_command("rollback-refresh-unit-state", ["/usr/bin/systemctl", "daemon-reload"], timeout=120)
    # First quiesce every trigger and writer while the installed unit files
    # are still present; only then remove enablements and restore files/data.
    stop_dependents()
    for unit in reversed(SERVICE_NAMES):
        if _unit_is_loaded(unit):
            run_command(
                f"rollback-disable-{unit}",
                ["/usr/bin/systemctl", "disable", "--now", unit],
                timeout=180,
            )

    for transient_unit in ALL_TRANSIENT_UNITS:
        if _unit_is_loaded(transient_unit) and systemctl_state(transient_unit, "is-active"):
            run_command(
                f"rollback-stop-{transient_unit}",
                ["/usr/bin/systemctl", "stop", transient_unit],
                timeout=180,
            )
        if systemctl_state(transient_unit, "is-active"):
            raise DeploymentError("rollback_failed", "a transient deployment unit remains active")

    if metadata.get("zulip_existing") is True:
        raw_backup = metadata.get("zulip_backup")
        if not isinstance(raw_backup, str):
            raise DeploymentError("rollback_failed", "saved Zulip rollback reference is invalid")
        zulip_backup = Path(raw_backup)
        try:
            relative_backup = zulip_backup.relative_to("/var/backups/zulip-local")
        except ValueError as exc:
            raise DeploymentError(
                "rollback_failed", "saved Zulip rollback reference is invalid"
            ) from exc
        if len(relative_backup.parts) != 1 or zulip_backup.suffix != ".age":
            raise DeploymentError("rollback_failed", "saved Zulip rollback reference is invalid")
        validate_private_file(zulip_backup)
        validate_private_file(ZULIP_RESTORE_IDENTITY)
        run_command(
            "rollback-zulip-data",
            [
                "/opt/ops-control-plane/deploy/zulip-local/bin/rollback.sh",
                "--backup",
                raw_backup,
                "--identity-file",
                str(ZULIP_RESTORE_IDENTITY),
                "--confirm",
                "RESTORE-ZULIP-LOCAL",
            ],
            timeout=3600,
        )
    elif Path("/opt/ops-control-plane/deploy/zulip-local/bin/rollback.sh").is_file():
        run_command(
            "rollback-new-zulip",
            ["/opt/ops-control-plane/deploy/zulip-local/bin/rollback.sh", "--stop-only"],
            timeout=300,
        )

    # Moby may own permanent firewalld objects. Stop all Docker components
    # before restoring/removing those files so its reload callback cannot
    # recreate them in the middle of rollback.
    stop_docker_runtime()

    existing_raw = metadata.get("managed_paths_existing")
    if not isinstance(existing_raw, list) or any(not isinstance(item, str) for item in existing_raw):
        raise DeploymentError("rollback_failed", "saved managed path list is invalid")
    existing = {Path(item) for item in existing_raw}
    if not existing.issubset(set(MANAGED_BACKUP_PATHS)):
        raise DeploymentError("rollback_failed", "saved managed path escaped the allowlist")
    archive_raw = metadata.get("managed_archive")
    archive_digest = metadata.get("managed_archive_sha256")
    if existing:
        if not isinstance(archive_raw, str) or Path(archive_raw) != backup / "managed-files.tar":
            raise DeploymentError("rollback_failed", "saved managed archive reference is invalid")
        if not isinstance(archive_digest, str) or not SHA256_RE.fullmatch(archive_digest):
            raise DeploymentError("rollback_failed", "saved managed archive digest is invalid")
        validate_private_file(Path(archive_raw))
        try:
            actual_archive_digest = sha256_regular(
                Path(archive_raw), maximum=MAX_BACKUP_ARCHIVE_BYTES
            )
        except DeploymentError as exc:
            raise DeploymentError(
                "rollback_failed", "managed rollback archive is unavailable"
            ) from exc
        if actual_archive_digest != archive_digest:
            raise DeploymentError("rollback_failed", "managed rollback archive checksum differs")
    elif archive_raw is not None or archive_digest is not None:
        raise DeploymentError("rollback_failed", "unexpected managed rollback archive was recorded")
    # Authenticate the backup before removing any currently installed tree.
    for path in MANAGED_BACKUP_PATHS:
        # `/etc/hosts` is guaranteed to pre-exist by the Zulip installer and
        # is restored in-place by tar.  Avoid a transient missing resolver
        # file (or an unlink failure when the host mounts it specially).
        if path == Path("/etc/hosts") and path in existing:
            continue
        _safe_remove_managed(path)
    if existing:
        run_command(
            "restore-managed-files",
            [
                "/usr/bin/tar",
                "--extract",
                "--file",
                archive_raw,
                "--directory",
                "/",
                "--same-owner",
                "--same-permissions",
                "--xattrs",
                "--acls",
                "--selinux",
            ],
            timeout=1800,
        )
    run_command(
        "rollback-update-ca-trust",
        ["/usr/bin/update-ca-trust", "extract"],
        timeout=300,
    )
    run_command("rollback-daemon-reload", ["/usr/bin/systemctl", "daemon-reload"], timeout=120)

    restore_atlas(metadata)
    restore_service_state(_mapping(metadata.get("service_state"), "service_state"))
    restore_docker(metadata)
    restore_local_inference(metadata)
    restore_finance_identity(metadata)
    verify_service_state(_mapping(metadata.get("service_state"), "service_state"))
    for transient_unit in (
        "ops-orchestrator-provider-finance.service",
        "ops-orchestrator-metrics.service",
        "zulip-local-init.service",
    ):
        if systemctl_state(transient_unit, "is-active"):
            raise DeploymentError("rollback_failed", "a transient deployment unit remains active")
    _sync_rollback_filesystems()
    verify_terminal_rollback(metadata)
    metadata["rolled_back"] = True
    metadata["rolled_back_at"] = int(time.time())
    metadata["phase"] = "rolled-back"
    atomic_json(backup / "transaction.json", metadata)
    append_audit(
        {
            "event": "deployment_rolled_back",
            "release_id": metadata["release_id"],
            "transaction_id": metadata["transaction_id"],
        }
    )


def latest_transaction() -> tuple[Path, dict[str, Any]]:
    current = read_json(CURRENT_PATH, maximum=32 * 1024, require_root_owned=True)
    raw_backup = current.get("backup_path")
    if not isinstance(raw_backup, str):
        raise DeploymentError("rollback_unavailable", "no prior deployment transaction is recorded")
    backup = Path(raw_backup)
    try:
        backup.relative_to(BACKUP_ROOT)
    except ValueError as exc:
        raise DeploymentError("rollback_unavailable", "recorded rollback path is outside its allowlist") from exc
    return backup, read_json(
        backup / "transaction.json",
        maximum=64 * 1024,
        require_root_owned=True,
    )


def current_is_healthy(manifest: dict[str, Any]) -> bool:
    try:
        current = read_json(CURRENT_PATH, maximum=32 * 1024, require_root_owned=True)
        if current.get("release_id") != manifest["release_id"] or current.get("status") != "healthy":
            return False
        health_check(manifest)
        return True
    except DeploymentError:
        return False


def recover_interrupted_transaction() -> None:
    if not CURRENT_PATH.exists() and not CURRENT_PATH.is_symlink():
        return
    current = read_json(CURRENT_PATH, maximum=32 * 1024, require_root_owned=True)
    status = current.get("status")
    if status == "rollback-failed":
        raise DeploymentError(
            "rollback_required",
            "the prior deployment rollback must be completed before another apply",
        )
    if status != "deploying":
        return
    backup, metadata = latest_transaction()
    try:
        rollback_transaction(backup, metadata)
    except BaseException as exc:
        atomic_json(
            CURRENT_PATH,
            {
                "schema_version": 1,
                "release_id": metadata["release_id"],
                "status": "rollback-failed",
                "transaction_id": metadata["transaction_id"],
                "backup_path": str(backup),
                "activated_at": int(time.time()),
            },
        )
        append_audit(
            {
                "event": "interrupted_deployment_recovery_failed",
                "release_id": metadata["release_id"],
                "transaction_id": metadata["transaction_id"],
            }
        )
        raise DeploymentError(
            "rollback_failed", "interrupted deployment could not be restored"
        ) from exc
    atomic_json(
        CURRENT_PATH,
        {
            "schema_version": 1,
            "release_id": metadata["release_id"],
            "status": "rolled-back",
            "transaction_id": metadata["transaction_id"],
            "backup_path": str(backup),
            "activated_at": int(time.time()),
        },
    )
    append_audit(
        {
            "event": "interrupted_deployment_recovered",
            "release_id": metadata["release_id"],
            "transaction_id": metadata["transaction_id"],
        }
    )


def _apply_transaction(manifest: dict[str, Any]) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise DeploymentError("permission_denied", "deployment worker must run as root")
    # An already-authorized apply must first finish the automatic recovery of
    # any transaction interrupted after its durable snapshot record was
    # written.  Requiring a fresh one-shot Zulip owner password before this
    # rollback would strand the prior state even though recovery itself never
    # consumes that secret.
    recover_interrupted_transaction()
    already_healthy = current_is_healthy(manifest)
    preflight(
        manifest,
        require_password=not already_healthy,
        require_initial_docker_absent=not already_healthy,
    )
    if already_healthy:
        return {
            "status": "already-current",
            "release_id": manifest["release_id"],
            "local_inference": local_inference_status(),
        }
    try:
        release = stage_release(manifest)
        backup, metadata = capture_backup(manifest)
        atomic_json(
            CURRENT_PATH,
            {
                "schema_version": 1,
                "release_id": manifest["release_id"],
                "status": "deploying",
                "transaction_id": metadata["transaction_id"],
                "backup_path": str(backup),
                "activated_at": int(time.time()),
            },
        )
        append_audit(
            {
                "event": "deployment_started",
                "release_id": manifest["release_id"],
                "transaction_id": metadata["transaction_id"],
            }
        )
        try:
            metadata["phase"] = "installing"
            atomic_json(backup / "transaction.json", metadata)
            install_release(release, manifest, backup, metadata)
            health_check(manifest)
            _sync_rollback_filesystems()
            metadata["phase"] = "healthy"
            atomic_json(backup / "transaction.json", metadata)
            current = {
                "schema_version": 1,
                "release_id": manifest["release_id"],
                "status": "healthy",
                "transaction_id": metadata["transaction_id"],
                "backup_path": str(backup),
                "activated_at": int(time.time()),
            }
            atomic_json(CURRENT_PATH, current)
            append_audit(
                {
                    "event": "deployment_succeeded",
                    "release_id": manifest["release_id"],
                    "transaction_id": metadata["transaction_id"],
                }
            )
        except BaseException as deployment_error:
            rollback_status = "completed"
            try:
                rollback_transaction(backup, metadata)
            except BaseException:
                rollback_status = "failed"
            atomic_json(
                CURRENT_PATH,
                {
                    "schema_version": 1,
                    "release_id": manifest["release_id"],
                    "status": "rolled-back" if rollback_status == "completed" else "rollback-failed",
                    "transaction_id": metadata["transaction_id"],
                    "backup_path": str(backup),
                    "activated_at": int(time.time()),
                },
            )
            append_audit(
                {
                    "event": "deployment_failed",
                    "release_id": manifest["release_id"],
                    "transaction_id": metadata["transaction_id"],
                    "rollback": rollback_status,
                }
            )
            if rollback_status == "failed":
                raise DeploymentError("rollback_failed", "deployment failed and automatic rollback also failed") from deployment_error
            if isinstance(deployment_error, DeploymentError):
                raise deployment_error
            raise DeploymentError("deployment_failed", "deployment failed; previous state was restored") from deployment_error
        return {
            "status": "healthy",
            "release_id": manifest["release_id"],
            "transaction_id": metadata["transaction_id"],
            "local_inference": local_inference_status(),
        }
    finally:
        # The password file is a one-shot bootstrap input.  It is never backed
        # up and is removed even when provisioning or rollback fails.
        ZULIP_PASSWORD_FILE.unlink(missing_ok=True)


def apply(manifest: dict[str, Any]) -> dict[str, Any]:
    try:
        return _apply_transaction(manifest)
    finally:
        # Apply consumes the one-shot secret even when preflight rejects the
        # release or detects that the exact release is already healthy.
        ZULIP_PASSWORD_FILE.unlink(missing_ok=True)


def explicit_rollback(manifest: dict[str, Any]) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise DeploymentError("permission_denied", "deployment worker must run as root")
    backup, metadata = latest_transaction()
    if (
        metadata.get("release_id") != manifest["release_id"]
        or metadata.get("hermes_source_archive_sha256")
        != manifest["artifacts"]["hermes_source_archive"]["sha256"]
    ):
        raise DeploymentError(
            "rollback_unavailable",
            "last transaction belongs to a different reviewed release",
        )
    already_rolled_back = metadata.get("rolled_back") is True
    # A terminal WAL bit is not a substitute for current-state proof.  Replay
    # the idempotent rollback path even when a prior invocation completed so a
    # later service/package/identity drift is rejected and all filesystems are
    # synchronised before reporting success again.
    rollback_transaction(backup, metadata)
    atomic_json(
        CURRENT_PATH,
        {
            "schema_version": 1,
            "release_id": manifest["release_id"],
            "status": "rolled-back",
            "transaction_id": metadata["transaction_id"],
            "backup_path": str(backup),
            "activated_at": int(time.time()),
        },
    )
    return {
        "status": "already-rolled-back" if already_rolled_back else "rolled-back",
        "release_id": manifest["release_id"],
        "transaction_id": metadata["transaction_id"],
        "local_inference": local_inference_status(),
    }


def acquire_lock() -> int:
    LOCK_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    descriptor = os.open(LOCK_PATH, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        os.close(descriptor)
        if exc.errno in {errno.EACCES, errno.EAGAIN}:
            raise DeploymentError("deployment_busy", "another control-plane deployment is running") from exc
        raise
    return descriptor


def write_result(operation: str, result: dict[str, Any], *, ok: bool) -> None:
    safe = {
        "schema_version": 1,
        "operation": operation,
        "ok": ok,
        "finished_at": int(time.time()),
        **result,
    }
    atomic_json(RESULT_PATH, safe, mode=0o600)


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if len(arguments) != 1 or arguments[0] not in {
        "apply", "network-health", "preflight", "rollback", "source-digest"
    }:
        print(
            "Usage: control-plane-deployment-worker apply|network-health|preflight|rollback|source-digest",
            file=sys.stderr,
        )
        return 64
    operation = arguments[0]
    if operation in {"apply", "preflight", "rollback"}:
        # Release .5 is an initial, physical-console bootstrap only. Its public
        # helper owns the outer crash-recovery WAL and the post-commit Docker
        # restart-policy finalizer. Running this inner worker directly would
        # omit those boundaries, so the legacy unit/runbook entry points are
        # deliberately inert.
        print(
            '{"error":"bootstrap_required","ok":false,"status":"failed"}',
            file=sys.stderr,
        )
        return 1
    try:
        # Runtime network validation uses this installed worker's fixed policy.
        # It must also run inside ProtectHome=yes services, without consulting
        # build inputs in the workstation owner's source checkout.
        if operation == "network-health":
            if os.geteuid() != 0:
                raise DeploymentError(
                    "permission_denied", "deployment worker must run as root"
                )
            validate_docker_installation(require_active=True)
            validate_docker_runtime_network()
            print('{"ok":true,"status":"healthy"}')
            return 0
        manifest_path = MANIFEST_PATH
        trusted_manifest = True
        source_manifest = Path(__file__).resolve().parent.parent / "release-manifest.v1.json"
        if operation == "source-digest" and source_manifest.exists():
            manifest_path = source_manifest
            trusted_manifest = False
        manifest = load_manifest(manifest_path, require_root_owned=trusted_manifest)
        if operation == "source-digest":
            print(source_tree_digest(Path(manifest["source"]["root"]), manifest["source"]["roots"]))
            return 0
        if operation == "preflight":
            result = preflight(manifest, require_password=True)
            print(json.dumps({"ok": True, **result}, sort_keys=True, separators=(",", ":")))
            return 0
        lock_descriptor = acquire_lock()
        try:
            result = apply(manifest) if operation == "apply" else explicit_rollback(manifest)
        finally:
            os.close(lock_descriptor)
        write_result(operation, result, ok=True)
        print(json.dumps({"ok": True, **result}, sort_keys=True, separators=(",", ":")))
        return 0
    except DeploymentError as exc:
        if operation in {"apply", "rollback"}:
            write_result(operation, {"status": "failed", "error": exc.code}, ok=False)
        print(json.dumps({"ok": False, "status": "failed", "error": exc.code}, sort_keys=True, separators=(",", ":")), file=sys.stderr)
        return 1
    except BaseException:
        if operation in {"apply", "rollback"}:
            write_result(operation, {"status": "failed", "error": "internal_error"}, ok=False)
        print('{"error":"internal_error","ok":false,"status":"failed"}', file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
