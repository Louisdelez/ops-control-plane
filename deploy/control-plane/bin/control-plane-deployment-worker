    if not isinstance(hermes["commit"], str) or not GIT_COMMIT_RE.fullmatch(hermes["commit"]):
        raise DeploymentError("manifest_invalid", "components.hermes.commit is invalid")

    zulip = _mapping(components["zulip"], "components.zulip")
    _exact_keys(zulip, {"version", "origin", "images"}, "components.zulip")
    _version(zulip["version"], "components.zulip.version")
    if zulip["origin"] != "https://zulip.ops.local:8443":
