    images = _mapping(zulip["images"], "components.zulip.images")
    if set(images) != {"zulip", "postgresql", "memcached", "rabbitmq", "redis"}:
        raise DeploymentError("manifest_invalid", "Zulip image set differs from review")
    for name, digest in images.items():
        _sha256(digest, f"components.zulip.images.{name}")

    model_catalogue = _mapping(
        components["model_catalogue"], "components.model_catalogue"
    )
    _exact_keys(
        model_catalogue,
        {
            "schema_version",
            "revision",
            "sha256",
            "cards",
            "provider_accounts",
