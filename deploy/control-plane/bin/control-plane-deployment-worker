    if model_catalogue["schema_version"] != 2:
        raise DeploymentError("manifest_invalid", "model catalogue schema differs from review")
    _identifier(model_catalogue["revision"], "components.model_catalogue.revision")
    _sha256(model_catalogue["sha256"], "components.model_catalogue.sha256")
    catalogue_cards = _count(
        model_catalogue["cards"], "components.model_catalogue.cards", positive=True
    )
    catalogue_accounts = _count(
        model_catalogue["provider_accounts"],
        "components.model_catalogue.provider_accounts",
        positive=True,
    )
    catalogue_runtime = _mapping(
        model_catalogue["runtime"], "components.model_catalogue.runtime"
    )
    _exact_keys(
        catalogue_runtime,
        {
            "static_cards",
            "static_deployments",
            "dynamic_cards",
            "invocable_cards",
            "blocked_cards",
            "blocked_reasons",
            "provider_deployments",
            "provider_inventory_sha256",
        },
        "components.model_catalogue.runtime",
    )
    runtime_counts = {
        name: _count(
            catalogue_runtime[name], f"components.model_catalogue.runtime.{name}"
        )
        for name in (
            "static_cards",
            "static_deployments",
            "dynamic_cards",
            "invocable_cards",
            "blocked_cards",
            "provider_deployments",
        )
    }
    blocked_reasons = _mapping(
        catalogue_runtime["blocked_reasons"],
        "components.model_catalogue.runtime.blocked_reasons",
    )
    if not blocked_reasons or len(blocked_reasons) > 128:
        raise DeploymentError("manifest_invalid", "catalogue blocked reasons are invalid")
    for reason, count in blocked_reasons.items():
        _identifier(reason, "components.model_catalogue.runtime.blocked_reasons")
        _count(
            count,
            f"components.model_catalogue.runtime.blocked_reasons.{reason}",
            positive=True,
        )
    if (
        runtime_counts["static_cards"] + runtime_counts["dynamic_cards"]
        != runtime_counts["invocable_cards"]
        or runtime_counts["invocable_cards"] + runtime_counts["blocked_cards"]
        != catalogue_cards
        or sum(blocked_reasons.values()) != runtime_counts["blocked_cards"]
        or runtime_counts["static_deployments"] < runtime_counts["static_cards"]
        or runtime_counts["provider_deployments"] < runtime_counts["invocable_cards"]
        or not isinstance(catalogue_runtime["provider_inventory_sha256"], str)
        or not SHA256_RE.fullmatch(catalogue_runtime["provider_inventory_sha256"])
    ):
        raise DeploymentError("manifest_invalid", "catalogue runtime counts are inconsistent")

    provider_integrations = _mapping(
        components["provider_integrations"], "components.provider_integrations"
