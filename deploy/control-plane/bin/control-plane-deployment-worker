class DeploymentError(RuntimeError):
    """Bounded deployment failure safe for the broker result."""

    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


def _mapping(value: Any, location: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise DeploymentError("manifest_invalid", f"{location} must be an object")
    return value


def _exact_keys(value: dict[str, Any], keys: set[str], location: str) -> None:
    if set(value) != keys:
        raise DeploymentError("manifest_invalid", f"{location} fields differ from schema")


def _identifier(value: Any, location: str) -> str:
    if not isinstance(value, str) or not IDENTIFIER_RE.fullmatch(value):
        raise DeploymentError("manifest_invalid", f"{location} is invalid")
    return value


def _version(value: Any, location: str) -> str:
    if not isinstance(value, str) or not VERSION_RE.fullmatch(value):
        raise DeploymentError("manifest_invalid", f"{location} is invalid")
    return value


def _sha256(value: Any, location: str) -> str:
    if not isinstance(value, str) or not SHA256_RE.fullmatch(value):
        raise DeploymentError("manifest_invalid", f"{location} is not SHA-256")
    return value


def _count(value: Any, location: str, *, positive: bool = False) -> int:
    minimum = 1 if positive else 0
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= 100_000:
        raise DeploymentError("manifest_invalid", f"{location} is not a bounded count")
    return value


def _absolute_path(value: Any, location: str, *, required_prefix: Path) -> Path:
    if not isinstance(value, str) or CONTROL_RE.search(value):
        raise DeploymentError("manifest_invalid", f"{location} is invalid")
    path = Path(value)
    if not path.is_absolute() or ".." in path.parts:
        raise DeploymentError("manifest_invalid", f"{location} must be absolute")
    try:
        path.relative_to(required_prefix)
    except ValueError as exc:
        raise DeploymentError("manifest_invalid", f"{location} is outside its allowlist") from exc
    return path


def _relative_path(value: Any, location: str) -> PurePosixPath:
    if not isinstance(value, str) or CONTROL_RE.search(value):
        raise DeploymentError("manifest_invalid", f"{location} is invalid")
    path = PurePosixPath(value)
    if path.is_absolute() or not path.parts or any(part in {"", ".", ".."} for part in path.parts):
        raise DeploymentError("manifest_invalid", f"{location} must be relative")
    return path


def validate_bootstrap_source_coverage(roots: Iterable[PurePosixPath]) -> None:
    normalized = tuple(roots)
    for raw_input in BROKER_BOOTSTRAP_COPIED_INPUTS:
        copied_input = PurePosixPath(raw_input)
        if not any(
            copied_input == root or root in copied_input.parents
            for root in normalized
        ):
            raise DeploymentError(
                "manifest_invalid",
                f"broker bootstrap copy is outside the source footprint: {raw_input}",
            )


def read_json(
    path: Path,
    *,
    maximum: int = MAX_MANIFEST_BYTES,
    require_root_owned: bool = False,
) -> dict[str, Any]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise DeploymentError("file_unavailable", f"required document unavailable: {path.name}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_size > maximum
            or (
                require_root_owned
                and (metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022)
            )
        ):
            raise DeploymentError("file_invalid", f"required document is unsafe: {path.name}")
        raw = b""
        while len(raw) <= maximum:
            chunk = os.read(descriptor, min(65_536, maximum + 1 - len(raw)))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(descriptor)
    if len(raw) > maximum:
        raise DeploymentError("file_invalid", f"required document is oversized: {path.name}")
    try:
        document = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DeploymentError("file_invalid", f"required document is invalid: {path.name}") from exc
    return _mapping(document, path.name)


def validate_manifest(document: dict[str, Any]) -> dict[str, Any]:
    _exact_keys(
        document,
        {
            "schema_version",
            "release_id",
            "architecture",
            "trust_anchor",
            "bootstrap",
            "supply_chain",
            "host",
            "cutover",
            "source",
            "artifacts",
            "components",
            "runtime",
            "rollback",
        },
        "manifest",
    )
    if document["schema_version"] != 1:
        raise DeploymentError("manifest_invalid", "manifest schema is unsupported")
    _identifier(document["release_id"], "release_id")
    if document["release_id"] != "atlas-api-zulip-2026.09.09.29":
        raise DeploymentError(
            "manifest_invalid", "release identity differs from the reviewed bundle"
        )
    if document["architecture"] != "x86_64":
        raise DeploymentError("manifest_invalid", "only the reviewed x86_64 release is supported")

    trust_anchor = _mapping(document["trust_anchor"], "trust_anchor")
    _exact_keys(
        trust_anchor,
        {
            "version_directory", "manifest_path", "bootstrap_helper_path",
            "launcher_path", "manifest_mode", "bootstrap_helper_mode",
            "launcher_mode", "launcher_sha256", "enrollment",
        },
        "trust_anchor",
    )
    if trust_anchor != {
        "version_directory": str(TRUST_ANCHOR_ROOT),
        "manifest_path": str(MANIFEST_PATH),
        "bootstrap_helper_path": str(TRUST_ANCHOR_BOOTSTRAP_HELPER),
        "launcher_path": str(TRUST_ANCHOR_LAUNCHER),
        "manifest_mode": "0444",
        "bootstrap_helper_mode": "0555",
        "launcher_mode": "0555",
        "launcher_sha256": trust_anchor["launcher_sha256"],
        "enrollment": "physical-polkit-tofu-v1",
    }:
        raise DeploymentError(
            "manifest_invalid", "versioned trust anchor differs from review"
        )
    _sha256(trust_anchor["launcher_sha256"], "trust_anchor.launcher_sha256")

    bootstrap = _mapping(document["bootstrap"], "bootstrap")
    _exact_keys(
        bootstrap,
        {
            "mode",
            "actor",
            "helper_sha256",
            "allowed_when",
            "consumed_marker",
            "state_root",
            "approver_state",
            "recovery_units",
            "requires_provider_keys",
            "rollback_keeps_recovered_userpass",
            "gui_protocol",
            "openbao",
            "corrective",
        },
        "bootstrap",
    )
    if bootstrap != {
        "mode": "one-shot-local-physical",
        "actor": "codex-supervised",
        "helper_sha256": bootstrap["helper_sha256"],
        "allowed_when": "zulip-absent",
        "consumed_marker": str(BOOTSTRAP_CONSUMED_PATH),
        "state_root": str(BOOTSTRAP_STATE_ROOT),
        "approver_state": str(BOOTSTRAP_APPROVER_STATE),
        "recovery_units": list(BOOTSTRAP_RECOVERY_UNITS),
        "requires_provider_keys": False,
        "rollback_keeps_recovered_userpass": True,
        "gui_protocol": bootstrap["gui_protocol"],
        "openbao": bootstrap["openbao"],
        "corrective": bootstrap["corrective"],
    }:
        raise DeploymentError("manifest_invalid", "bootstrap contract differs from review")
    _sha256(bootstrap["helper_sha256"], "bootstrap.helper_sha256")
    bootstrap_gui = _mapping(bootstrap["gui_protocol"], "bootstrap.gui_protocol")
    _exact_keys(
        bootstrap_gui,
        {
            "schema_version", "public_operations", "apply_magic",
            "control_magic", "stdout", "atlas_ancestry_required",
            "launcher_mode", "atlas_payload_member", "atlas_payload_sha256",
            "anonymous_pipes_required", "mutation_boundary_event",
            "secrets_outside_process_memory",
        },
        "bootstrap.gui_protocol",
    )
    if bootstrap_gui != {
        "schema_version": 1,
        "public_operations": [
            "gui-preflight", "gui-apply", "gui-corrective-preflight",
            "gui-corrective-apply", "gui-recovery-preflight",
            "gui-recovery-apply",
        ],
        "apply_magic": "ATLASBOOT1",
        "control_magic": "ATLASCTL1",
        "stdout": "bounded-jsonl",
        "atlas_ancestry_required": True,
        "launcher_mode": ATLAS_LAUNCHER_MODE,
        "atlas_payload_member": ATLAS_PAYLOAD_MEMBER,
        "atlas_payload_sha256": bootstrap_gui["atlas_payload_sha256"],
        "anonymous_pipes_required": True,
        "mutation_boundary_event": "mutation-started",
        "secrets_outside_process_memory": False,
    }:
        raise DeploymentError("manifest_invalid", "bootstrap GUI protocol differs from review")
    _sha256(
        bootstrap_gui["atlas_payload_sha256"],
        "bootstrap.gui_protocol.atlas_payload_sha256",
    )
    bootstrap_corrective = _mapping(
        bootstrap["corrective"], "bootstrap.corrective"
    )
    _exact_keys(
        bootstrap_corrective,
        set(BOOTSTRAP_CORRECTIVE_CONTRACT),
        "bootstrap.corrective",
    )
    if bootstrap_corrective != BOOTSTRAP_CORRECTIVE_CONTRACT:
        raise DeploymentError(
            "manifest_invalid", "bootstrap corrective contract differs from review"
        )
    bootstrap_openbao = _mapping(bootstrap["openbao"], "bootstrap.openbao")
    _exact_keys(
        bootstrap_openbao,
        {
            "version",
            "address",
            "listener_config",
            "listener_source_sha256",
            "recovery_credentials",
            "tcp_legacy_endpoint_disabled",
            "temporary_unix_socket",
            "temporary_unix_listener_sha256",
            "root_token_escrow",
            "undo_escrow",
            "userpass_password_escrow",
            "exclusive_local_maintenance",
            "root_generation_max_remints",
            "root_generation_window_seconds",
        },
        "bootstrap.openbao",
    )
    if bootstrap_openbao != {
        "version": "2.6.2",
        "address": "https://127.0.0.1:8200",
        "listener_config": str(BOOTSTRAP_OPENBAO_CONFIG),
        "listener_source_sha256": BOOTSTRAP_OPENBAO_SOURCE_SHA256,
        "recovery_credentials": list(BOOTSTRAP_RECOVERY_CREDENTIALS),
        "tcp_legacy_endpoint_disabled": True,
        "temporary_unix_socket": str(BOOTSTRAP_RECOVERY_SOCKET),
        "temporary_unix_listener_sha256": BOOTSTRAP_UNIX_LISTENER_SHA256,
        "root_token_escrow": str(BOOTSTRAP_ROOT_TOKEN_ESCROW),
        "undo_escrow": str(BOOTSTRAP_OPENBAO_UNDO_ESCROW),
        "userpass_password_escrow": str(BOOTSTRAP_USERPASS_PASSWORD_ESCROW),
        "exclusive_local_maintenance": True,
        "root_generation_max_remints": 1,
        "root_generation_window_seconds": 10,
    }:
        raise DeploymentError("manifest_invalid", "bootstrap OpenBao contract differs from review")

    supply_chain = _mapping(document["supply_chain"], "supply_chain")
    _exact_keys(
        supply_chain,
        {
            "network_required",
            "byte_for_byte_reproducible",
            "python_binary_only",
            "python_no_deps",
            "python_artifact_hashes_present",
            "python_closures",
            "atlas",
            "hermes",
        },
        "supply_chain",
    )
    if (
        supply_chain["network_required"] is not True
        or supply_chain["byte_for_byte_reproducible"] is not False
        or supply_chain["python_binary_only"] is not True
        or supply_chain["python_no_deps"] is not True
        or supply_chain["python_artifact_hashes_present"] is not False
        or supply_chain["python_closures"] != PYTHON_RUNTIME_CLOSURES
        or supply_chain["atlas"] != ATLAS_CARGO_AUDIT
    ):
        raise DeploymentError("manifest_invalid", "release supply-chain contract differs from review")
    hermes_supply = _mapping(supply_chain["hermes"], "supply_chain.hermes")
    if hermes_supply != {
        "uv_version": HERMES_UV_VERSION,
        "uv_lock_from_pinned_commit": True,
        "locked_sync": True,
        "bootstrap_script_pinned": False,
        "source_archive_vendored": True,
        "network_git_transport": False,
    }:
        raise DeploymentError("manifest_invalid", "Hermes supply-chain contract differs from review")

    host = _mapping(document["host"], "host")
    _exact_keys(host, {"os", "docker"}, "host")
    host_os = _mapping(host["os"], "host.os")
    _exact_keys(host_os, {"id", "version_id", "architecture"}, "host.os")
    if host_os != {"id": "fedora", "version_id": "44", "architecture": "x86_64"}:
        raise DeploymentError("manifest_invalid", "host OS differs from the reviewed Fedora release")
    docker = _mapping(host["docker"], "host.docker")
    _exact_keys(
        docker,
        {
            "mode",
            "initial_state",
            "in_place_upgrade_supported",
            "rollback_preserves_named_volumes",
            "rollback_named_volumes_root",
            "service",
            "units",
            "preinstalled_dependencies",
            "daemon_config",
            "network",
            "repositories",
            "install_weak_dependencies",
            "packages",
            "dependencies",
        },
        "host.docker",
    )
    if (
        docker["mode"] != "rootful"
        or docker["initial_state"] != "absent"
        or docker["in_place_upgrade_supported"] is not False
        or docker["rollback_preserves_named_volumes"] is not True
        or docker["rollback_named_volumes_root"] != str(ZULIP_RECOVERED_DATA_ROOT)
        or docker["service"] != DOCKER_SERVICE
        or docker["units"] != list(DOCKER_SERVICE_UNITS)
        or docker["preinstalled_dependencies"]
        != list(DOCKER_PREINSTALLED_DEPENDENCIES)
        or docker["daemon_config"] != DOCKER_DAEMON_CONFIG_DOCUMENT
        or docker["network"]
        != {
            "firewalld_required": True,
            "fixed_networks": ZULIP_DOCKER_NETWORKS,
            "ipv4_forwarding_required": True,
            "ipv6_forwarding_required": False,
        }
        or docker["repositories"] != list(DOCKER_REPOSITORIES)
        or docker["install_weak_dependencies"] is not False
        or docker["packages"] != DOCKER_PACKAGE_NEVRAS
        or docker["dependencies"] != DOCKER_DEPENDENCY_NEVRAS
    ):
        raise DeploymentError("manifest_invalid", "Docker host dependency differs from review")

    cutover = _mapping(document["cutover"], "cutover")
    _exact_keys(cutover, {"local_inference"}, "cutover")
    local_inference = _mapping(cutover["local_inference"], "cutover.local_inference")
    _exact_keys(
        local_inference,
        {"mode", "units", "preserve_historical_artifacts"},
        "cutover.local_inference",
    )
    if (
        local_inference["mode"] != "disabled"
        or local_inference["units"] != list(LOCAL_INFERENCE_UNITS)
        or local_inference["preserve_historical_artifacts"] is not True
    ):
        raise DeploymentError("manifest_invalid", "local inference cutover differs from review")

    source = _mapping(document["source"], "source")
    _exact_keys(source, {"root", "roots", "tree_algorithm", "tree_sha256"}, "source")
    source_root = _absolute_path(source["root"], "source.root", required_prefix=Path("/home/ops-user"))
    if source_root != Path("/home/ops-user/ops-control-plane"):
        raise DeploymentError("manifest_invalid", "source.root differs from the reviewed repository")
    if source["tree_algorithm"] != "sha256-tree-v1":
        raise DeploymentError("manifest_invalid", "source tree algorithm is unsupported")
    _sha256(source["tree_sha256"], "source.tree_sha256")
    roots = source["roots"]
    if not isinstance(roots, list) or not roots or len(roots) > 64:
        raise DeploymentError("manifest_invalid", "source.roots is invalid")
    normalized_roots = [_relative_path(item, "source.roots") for item in roots]
    if len(set(normalized_roots)) != len(normalized_roots):
        raise DeploymentError("manifest_invalid", "source.roots contains duplicates")
    validate_bootstrap_source_coverage(normalized_roots)
    if tuple(item.as_posix() for item in normalized_roots) != SOURCE_ROOTS:
        raise DeploymentError("manifest_invalid", "source.roots differs from the reviewed release scope")
    if sha256_regular(
        source_root / "deploy/control-plane/bin/control-plane-bootstrap"
    ) != bootstrap["helper_sha256"]:
        raise DeploymentError(
            "manifest_invalid", "bootstrap helper digest differs from review"
        )

    artifacts = _mapping(document["artifacts"], "artifacts")
    _exact_keys(artifacts, {"atlas_rpm", "hermes_source_archive"}, "artifacts")
    hermes_archive = _mapping(
        artifacts["hermes_source_archive"], "artifacts.hermes_source_archive"
    )
    _exact_keys(
        hermes_archive,
        {
            "source_path",
            "sha256",
            "format",
            "commit",
            "git_tree_oid",
            "canonical_tree_sha256",
            "top_level_directory",
            "compressed_size",
            "expanded_size",
            "members",
            "regular_files",
            "directories",
            "max_file_size",
        },
        "artifacts.hermes_source_archive",
    )
    hermes_archive_source = _absolute_path(
        hermes_archive["source_path"],
        "artifacts.hermes_source_archive.source_path",
        required_prefix=Path("/home/ops-user/Téléchargements"),
    )
    if (
        hermes_archive_source != HERMES_SOURCE_ARCHIVE_PATH
        or hermes_archive["sha256"] != HERMES_SOURCE_ARCHIVE_SHA256
        or hermes_archive["format"] != "github-codeload-tar-gzip-v1"
        or hermes_archive["commit"] != "29112bef099274229cadff79cdff7bf7b99c4b77"
        or hermes_archive["git_tree_oid"] != "daaffc303ae437041b7f76be17c5f61b14f2ce99"
        or hermes_archive["canonical_tree_sha256"]
        != "7ecc4e3f45d65d6ab33907f9220c06daa66b118af2a0fbbf5df3f2e019776ad1"
        or hermes_archive["top_level_directory"]
        != "hermes-agent-29112bef099274229cadff79cdff7bf7b99c4b77"
        or hermes_archive["compressed_size"] != 69_442_866
        or hermes_archive["expanded_size"] != 167_028_103
        or hermes_archive["members"] != 11_994
        or hermes_archive["regular_files"] != 10_925
        or hermes_archive["directories"] != 1_069
        or hermes_archive["max_file_size"] != 3_871_968
    ):
        raise DeploymentError(
            "manifest_invalid", "Hermes source archive identity differs from review"
        )
    _sha256(
        hermes_archive["sha256"], "artifacts.hermes_source_archive.sha256"
    )
    _sha256(
        hermes_archive["canonical_tree_sha256"],
        "artifacts.hermes_source_archive.canonical_tree_sha256",
    )
    atlas = _mapping(artifacts["atlas_rpm"], "artifacts.atlas_rpm")
    _exact_keys(
        atlas,
        {
            "source_path",
            "sha256",
            "payload_executable_path",
            "payload_executable_sha256",
            "name",
            "initial_state",
            "signed",
            "version",
            "release",
            "architecture",
        },
        "artifacts.atlas_rpm",
    )
    atlas_source = _absolute_path(
        atlas["source_path"],
        "artifacts.atlas_rpm.source_path",
        required_prefix=Path("/home/ops-user/Téléchargements"),
    )
    if atlas_source != ATLAS_ARTIFACT_PATH:
        raise DeploymentError("manifest_invalid", "Atlas artifact name differs from review")
    _sha256(atlas["sha256"], "artifacts.atlas_rpm.sha256")
    _sha256(
        atlas["payload_executable_sha256"],
