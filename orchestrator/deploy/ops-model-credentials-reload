#!/usr/bin/python3 -I
"""Reload the fixed local model consumers after an Atlas key rotation.

This root helper accepts no arguments, never reads a provider credential, and
contacts no provider.  It serializes with deployment and orchestrator installs,
re-runs the OpenBao resolver, then activates only the fixed consumers whose
credential files were atomically published by that resolver.
"""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import stat
import subprocess
import sys


SYSTEMCTL = "/usr/bin/systemctl"
CURL = "/usr/bin/curl"
RUNUSER = "/usr/sbin/runuser"
LOCK_PATHS = (
    Path("/run/lock/ops-control-plane-deployment.lock"),
    Path("/run/lock/ops-orchestrator-install.lock"),
    Path("/run/lock/ops-model-credentials-reload.lock"),
)
STOP_ORDER = (
    "hermes-gateway.service",
    "ops-orchestrator-provider-finance.timer",
    "ops-orchestrator-metrics.timer",
    "ops-orchestrator-provider-finance.service",
    "ops-orchestrator-metrics.service",
    "ops-orchestrator-hermes-facade.service",
    "ops-orchestrator.service",
    "ops-orchestrator-provider-finance-daemon.service",
    "ops-orchestrator-secrets.service",
)
START_ORDER = (
    "ops-orchestrator-secrets.service",
    "ops-orchestrator-provider-finance-daemon.service",
    "ops-orchestrator.service",
    "ops-orchestrator-hermes-facade.service",
    "hermes-gateway.service",
    "ops-orchestrator-metrics.timer",
    "ops-orchestrator-provider-finance.timer",
)
CORE_SERVICES = frozenset(
    {
        "ops-orchestrator-secrets.service",
        "ops-orchestrator-provider-finance-daemon.service",
        "ops-orchestrator.service",
        "ops-orchestrator-hermes-facade.service",
        "hermes-gateway.service",
    }
)
HERMES_CREDENTIAL_FILES = (
    Path("/run/ops-orchestrator-secrets/current/qwen-api-key"),
    Path("/run/ops-orchestrator-secrets/current/deepseek-api-key"),
)
FINANCE_CREDENTIAL_FILES = (
    Path("/run/ops-orchestrator-secrets/current/deepseek-api-key"),
    Path("/run/ops-orchestrator-secrets/current/moonshot-api-key"),
    Path("/run/ops-orchestrator-secrets/current/stepfun-api-key"),
)
OPTIONAL_UNITS = (
    "ops-orchestrator-hermes-facade.service",
    "hermes-gateway.service",
    "ops-orchestrator-provider-finance.timer",
)


class ReloadError(RuntimeError):
    pass


def _run(argv: list[str], *, timeout: int = 90) -> None:
    completed = subprocess.run(
        argv,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=timeout,
        env={"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
    )
    if completed.returncode != 0:
        raise ReloadError("A fixed local reload step failed.")


def _active(unit: str) -> bool:
    completed = subprocess.run(
        [SYSTEMCTL, "is-active", "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
        env={"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
    )
    return completed.returncode == 0


def _enabled(unit: str) -> bool:
    completed = subprocess.run(
        [SYSTEMCTL, "is-enabled", "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
        env={"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
    )
    return completed.returncode == 0


def _credential_published(path: Path) -> bool:
    """Check only fixed file metadata; never open or read the secret value."""

    try:
        parent = os.lstat(path.parent)
        info = os.lstat(path)
    except OSError:
        return False
    return (
        stat.S_ISDIR(parent.st_mode)
        and not stat.S_ISLNK(parent.st_mode)
        and parent.st_uid == 0
        and not stat.S_IMODE(parent.st_mode) & 0o077
        and stat.S_ISREG(info.st_mode)
        and not stat.S_ISLNK(info.st_mode)
        and info.st_uid == 0
        and stat.S_IMODE(info.st_mode) == 0o400
        and 16 <= info.st_size <= 513
    )


def _acquire_locks() -> list[int]:
    descriptors: list[int] = []
    try:
        for path in LOCK_PATHS:
            descriptor = os.open(
                path,
                os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
                0o600,
            )
            info = os.fstat(descriptor)
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0
                or info.st_mode & 0o022
            ):
                os.close(descriptor)
                raise ReloadError("A reload lock has unsafe metadata.")
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                os.close(descriptor)
                raise ReloadError("A control-plane transaction is already running.") from exc
            descriptors.append(descriptor)
    except BaseException:
        for descriptor in reversed(descriptors):
            os.close(descriptor)
        raise
    return descriptors


def _restore_active(active_before: dict[str, bool]) -> None:
    for unit in START_ORDER:
        if active_before.get(unit, False):
            _run([SYSTEMCTL, "start", unit])


def _restore_optional_state(
    active_before: dict[str, bool], enabled_before: dict[str, bool]
) -> None:
    for unit in reversed(OPTIONAL_UNITS):
        _run([SYSTEMCTL, "disable", "--now", unit])
    for unit in OPTIONAL_UNITS:
        if enabled_before.get(unit, False):
            _run([SYSTEMCTL, "enable", unit])
        if active_before.get(unit, False):
            _run([SYSTEMCTL, "start", unit])


def _configure_optional_consumers() -> dict[str, bool]:
    hermes_ready = any(_credential_published(path) for path in HERMES_CREDENTIAL_FILES)
    finance_ready = any(_credential_published(path) for path in FINANCE_CREDENTIAL_FILES)

    if hermes_ready:
        _run([SYSTEMCTL, "enable", "--now", "ops-orchestrator-hermes-facade.service"])
        _run(
            [
                CURL,
                "--silent",
                "--show-error",
                "--fail",
                "--max-time",
                "5",
                "--noproxy",
                "*",
                "--proto",
                "=http",
                "http://127.0.0.1:8643/healthz",
            ],
            timeout=10,
        )
        _run([SYSTEMCTL, "enable", "--now", "hermes-gateway.service"])
    else:
        _run(
            [
                SYSTEMCTL,
                "disable",
                "--now",
                "hermes-gateway.service",
                "ops-orchestrator-hermes-facade.service",
            ]
        )

    if finance_ready:
        _run([SYSTEMCTL, "enable", "--now", "ops-orchestrator-provider-finance.timer"])
    else:
        _run([SYSTEMCTL, "disable", "--now", "ops-orchestrator-provider-finance.timer"])

    return {
        "ops-orchestrator-hermes-facade.service": hermes_ready,
        "hermes-gateway.service": hermes_ready,
        "ops-orchestrator-provider-finance.timer": finance_ready,
    }


def _health(expected_active: dict[str, bool]) -> None:
    for unit in CORE_SERVICES:
        if expected_active.get(unit, False) and not _active(unit):
            raise ReloadError("A model consumer did not recover after credential reload.")
    if expected_active.get("ops-orchestrator.service", False):
        _run(
            [
                CURL,
                "--silent",
                "--show-error",
                "--fail",
                "--max-time",
                "5",
                "--unix-socket",
                "/run/ops-orchestrator/api.sock",
                "http://localhost/v1/health",
            ],
            timeout=10,
        )
    if expected_active.get("ops-orchestrator-provider-finance-daemon.service", False):
        _run(
            [
                RUNUSER,
                "-u",
                "opsorchestrator",
                "--",
                CURL,
                "--silent",
                "--show-error",
                "--fail",
                "--max-time",
                "5",
                "--unix-socket",
                "/run/ops-orchestrator-finance/api.sock",
                "http://localhost/v1/health",
            ],
            timeout=10,
        )
    if expected_active.get("ops-orchestrator-hermes-facade.service", False):
        _run(
            [
                CURL,
                "--silent",
                "--show-error",
                "--fail",
                "--max-time",
                "5",
                "--noproxy",
                "*",
                "--proto",
                "=http",
                "http://127.0.0.1:8643/healthz",
            ],
            timeout=10,
        )


def reload_credentials() -> None:
    if os.geteuid() != 0:
        raise ReloadError("Root is required for the fixed credential reload.")
    if list(sys.argv[1:]):
        raise ReloadError("The credential reload helper accepts no arguments.")
    os.umask(0o077)
    os.environ.clear()
    os.environ.update({"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"})
    locks = _acquire_locks()
    active_before = {unit: _active(unit) for unit in STOP_ORDER}
    enabled_before = {unit: _enabled(unit) for unit in OPTIONAL_UNITS}
    operation_error: BaseException | None = None
    try:
        for unit in STOP_ORDER:
            if active_before[unit]:
                _run([SYSTEMCTL, "stop", unit])

        # A consumer implies that the resolver must be started even if an
        # inconsistent pre-state reported the resolver itself as inactive.
        if any(active_before[unit] for unit in CORE_SERVICES):
            active_before["ops-orchestrator-secrets.service"] = True
        _restore_active(active_before)
        desired_optional = _configure_optional_consumers()
        expected_active = dict(active_before)
        expected_active.update(desired_optional)
        _health(expected_active)
    except BaseException as exc:
        operation_error = exc
        try:
            _restore_active(active_before)
        except BaseException:
            pass
        try:
            _restore_optional_state(active_before, enabled_before)
        except BaseException:
            pass
    finally:
        active_before.clear()
        enabled_before.clear()
        for descriptor in reversed(locks):
            os.close(descriptor)
    if isinstance(operation_error, ReloadError):
        raise operation_error
    if operation_error is not None:
        raise ReloadError("The fixed credential reload failed.") from operation_error


def main() -> int:
    try:
        reload_credentials()
    except (OSError, ReloadError, subprocess.SubprocessError):
        print(json.dumps({"ok": False, "status": "reload-failed"}, separators=(",", ":")))
        return 1
    print(json.dumps({"ok": True, "status": "reloaded"}, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
