# API-first runtime defaults. This file contains flags and endpoint metadata,
# never credentials. systemd injects the Alibaba/Qwen and direct DeepSeek
# credential paths from root-only OpenBao-resolved files after this
# EnvironmentFile is loaded.
# A route still cannot leave the machine unless its request explicitly sets
# remote_allowed=true.

OPS_ORCHESTRATOR_ENABLE_QWEN=1
OPS_ORCHESTRATOR_ENABLE_DEEPSEEK=1
OPS_ORCHESTRATOR_ENABLE_CATALOGUE_API=1

# Qwen and the Alibaba-hosted DeepSeek ops provider share the statically pinned
# Model Studio Global OpenAI-compatible endpoint, activation flag and key file:
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# No QWEN_API_BASE_URL override is read; a hostile environment cannot redirect it.
# QWEN_API_KEY_FILE is set to %d/qwen-api-key by ops-orchestrator.service.
# No third provider secret is required. Alibaba DeepSeek uses the Alibaba chat
# dialect with enable_thinking=false and is only in ROLE_LOCAL_OPS.

# Direct DeepSeek uses the static https://api.deepseek.com base URL from config.
# DEEPSEEK_API_KEY_FILE is set to %d/deepseek-api-key by ops-orchestrator.service.

# Chat prices and pinned model IDs live in orchestrator.json and were reviewed
# on 2026-09-05. Peak/cache-miss DeepSeek prices are intentionally reserved.
# Recheck official pricing before deployment and whenever a provider announces
# a change. Do not lower the configured prices based on cache or temporary offers.

# Embedding and reranking are optional remote-only adapters. They remain off
# until a compatible endpoint, model, credential and current positive prices
# have all been reviewed. The deterministic hash/lexical memory path is separate.
# OPS_ORCHESTRATOR_ENABLE_EMBEDDING_API=1
# EMBEDDING_API_BASE_URL=https://<reviewed-openai-compatible-endpoint>
# EMBEDDING_API_MODEL=<reviewed model identifier>
# EMBEDDING_API_KEY_FILE=/run/ops-orchestrator-secrets/current/embedding-api-key
# EMBEDDING_INPUT_PRICE_USD_PER_MILLION=<current decimal price>
# EMBEDDING_OUTPUT_PRICE_USD_PER_MILLION=<current decimal price>

# OPS_ORCHESTRATOR_ENABLE_RERANKER_API=1
# RERANKER_API_BASE_URL=https://<reviewed-reranker-endpoint>
# RERANKER_API_MODEL=<reviewed model identifier>
# RERANKER_API_KEY_FILE=/run/ops-orchestrator-secrets/current/reranker-api-key
# RERANKER_INPUT_PRICE_USD_PER_MILLION=<current decimal price>
# RERANKER_OUTPUT_PRICE_USD_PER_MILLION=<current decimal price>
