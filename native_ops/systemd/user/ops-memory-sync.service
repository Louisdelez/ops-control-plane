[Unit]
Description=Capture scoped Ops history in shared memory

[Service]
Type=oneshot
ExecStart=/opt/ops-native/venv/bin/python /home/ops-user/ops-control-plane/native_ops/memory_sync.py
Environment=PYTHONPATH=/opt/ops-memory/src
TimeoutStartSec=300
UMask=0077
MemoryMax=200M
CPUQuota=25%
TasksMax=32
Nice=10
