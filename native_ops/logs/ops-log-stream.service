[Unit]
Description=Continuous resumable systemd and Docker logs archive
After=network-online.target ops-observer-secrets.service
Requires=ops-observer-secrets.service
[Service]
User=root
Group=ops-user
ExecStart=/usr/bin/python3 -I /usr/local/libexec/ops-logs/stream-service.py
UMask=0027
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/ops-telemetry
MemoryMax=384M
TasksMax=96
LimitCORE=0
[Install]
WantedBy=multi-user.target
