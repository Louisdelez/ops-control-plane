[Unit]
Description=Private read-only infrastructure logs API and permanent redacted archive
After=network-online.target ops-observer-secrets.service
Requires=ops-observer-secrets.service
[Service]
User=root
Group=ops-user
ExecStart=/usr/bin/python3 -I /usr/local/libexec/ops-logs/service.py
RuntimeDirectory=ops-logs
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/ops-telemetry
MemoryMax=256M
TasksMax=64
LimitCORE=0
[Install]
WantedBy=multi-user.target
