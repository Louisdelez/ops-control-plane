[Unit]
Description=OpenBao native API credential templates
After=network-online.target openbao.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=opsnativeai
Group=opsnativeai
ExecStart=/usr/bin/bao agent -config=/etc/ops-native-model/agent.hcl
LoadCredentialEncrypted=ops-native-api-role-id:/etc/credstore.encrypted/ops-native-api-role-id
LoadCredentialEncrypted=ops-native-api-secret-id:/etc/credstore.encrypted/ops-native-api-secret-id
StateDirectory=ops-native-model
StateDirectoryMode=0700
RuntimeDirectory=ops-native-model
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LimitCORE=0
ReadWritePaths=/run/ops-native-model

[Install]
WantedBy=multi-user.target
