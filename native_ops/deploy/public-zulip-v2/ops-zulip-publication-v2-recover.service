[Unit]
Description=Rollback an interrupted approved Zulip publication
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/ops-zulip-public-v2/state.json
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/ops-zulip-public-20260912-2/publish.py --recover
TimeoutStartSec=600
MemoryMax=256M
TasksMax=64
LimitCORE=0
[Install]
WantedBy=multi-user.target
