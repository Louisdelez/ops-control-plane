[Unit]
Description=Resolve optional memory API key from its native OpenBao reference
After=openbao.service ops-memory.service
ConditionPathExists=/etc/ops-memory/api-openbao-managed

[Service]
Type=oneshot
ExecStart=/opt/ops-native/venv/bin/python -I -m ops_native.memory_secrets
LoadCredentialEncrypted=ops-memory-api-role-id:/etc/credstore.encrypted/ops-memory-api-role-id
LoadCredentialEncrypted=ops-memory-api-secret-id:/etc/credstore.encrypted/ops-memory-api-secret-id
RuntimeDirectory=ops-memory-api
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=100
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
BindPaths=/dev/tpmrm0
DeviceAllow=/dev/tpmrm0 rw
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/credstore.encrypted /etc/ops-memory /run/ops-memory-api /run/lock/ops-execution-mode.lock
IPAddressDeny=any
IPAddressAllow=localhost
LimitCORE=0
MemoryMax=128M
TasksMax=32
