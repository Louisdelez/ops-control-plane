[Unit]
Description=OpenBao Agent for Zulip approvals
After=openbao.service
StartLimitIntervalSec=300
StartLimitBurst=3
[Service]
User=zulipbridge
Group=zulipbridge
ExecStart=/usr/bin/bao agent -config=/etc/ops-native-approval/agent.hcl
LoadCredentialEncrypted=ops-native-approval-role-id:/etc/credstore.encrypted/ops-native-approval-role-id
LoadCredentialEncrypted=ops-native-approval-secret-id:/etc/credstore.encrypted/ops-native-approval-secret-id
RuntimeDirectory=ops-native-approval
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0
Restart=on-failure
RestartSec=15
[Install]
WantedBy=multi-user.target
