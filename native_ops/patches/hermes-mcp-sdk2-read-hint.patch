         assert _mcp_registration._annotation_read_only_hint(
             SimpleNamespace()
         ) is False
+
+
+def test_sdk_annotations_survive_discovery_and_cache():
+    from mcp.types import Tool, ToolAnnotations
+    from tools.registry import ToolRegistry
+
+    server = mcp_tool.MCPServerTask("sdk-trust-test")
+    server.session = MagicMock()
+    server._tools = [Tool(name="inspect", inputSchema={}, annotations=ToolAnnotations(readOnlyHint=True)),
+                     Tool(name="mutate", inputSchema={}, annotations=ToolAnnotations(readOnlyHint=False)),
+                     Tool(name="unknown", inputSchema={})]
+    config = {"trust": "untrusted", "tools": {"resources": False, "prompts": False}}
+    with patch("tools.registry.registry", ToolRegistry()), \
+         patch("tools.mcp_tool_registration._track_mcp_tool_server"):
+        _mcp_registration._register_server_tools("sdk-trust-test", server, config)
+    hints = mcp_tool._tool_read_only_hints["sdk-trust-test"]
+    assert hints == {"inspect": True, "mutate": False, "unknown": False}
+    for tool in server._tools:
+        cached = SimpleNamespace(annotations={"readOnlyHint": _mcp_registration._annotation_read_only_hint(tool)})
+        assert _mcp_registration._annotation_read_only_hint(cached) is (tool.name == "inspect")
