[Unit]
Description=Infrastructure metrics for the local Ops dashboard
After=network-online.target ops-observer-secrets.service
Requires=ops-observer-secrets.service
[Service]
Type=simple
User=root
Group=ops-user
ExecStart=/usr/bin/python3 -I /usr/local/libexec/ops-telemetry/runner.py
RuntimeDirectory=ops-telemetry
RuntimeDirectoryMode=0750
StateDirectory=ops-telemetry
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=10
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=no
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/ops-telemetry /run/ops-telemetry /var/lib/node-exporter/textfile
MemoryMax=256M
CPUQuota=40%
TasksMax=48
LimitCORE=0
[Install]
WantedBy=multi-user.target
