def _validate_contract(
    manifest_raw: bytes, helper_raw: bytes, launcher_raw: bytes
) -> None:
    try:
        manifest = json.loads(
            manifest_raw, object_pairs_hook=_duplicate_safe_object
        )
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise EnrollmentError("Le manifeste de release est invalide.") from exc
    if not isinstance(manifest, dict):
        raise EnrollmentError("Le manifeste de release est invalide.")
    _validate_manifest_structure(manifest)
    bootstrap = manifest.get("bootstrap")
    anchor = manifest.get("trust_anchor")
    if not isinstance(bootstrap, dict) or not isinstance(anchor, dict):
        raise EnrollmentError("Le contrat d'ancre est absent.")
    expected_anchor = {
        "version_directory": str(ANCHOR_ROOT),
        "manifest_path": str(ANCHOR_ROOT / "release-manifest.v1.json"),
        "bootstrap_helper_path": str(ANCHOR_ROOT / "control-plane-bootstrap"),
        "launcher_path": str(ANCHOR_ROOT / "launch-atlas-reviewed-rpm"),
        "manifest_mode": "0444",
        "bootstrap_helper_mode": "0555",
        "launcher_mode": "0555",
        "launcher_sha256": hashlib.sha256(launcher_raw).hexdigest(),
        "enrollment": "physical-polkit-tofu-v1",
    }
    helper_sha256 = bootstrap.get("helper_sha256")
    launcher_sha256 = hashlib.sha256(launcher_raw).hexdigest()
    if (
        manifest.get("release_id") != RELEASE_ID
        or anchor != expected_anchor
        or not isinstance(helper_sha256, str)
        or SHA256_RE.fullmatch(helper_sha256) is None
        or helper_sha256 != hashlib.sha256(helper_raw).hexdigest()
        or launcher_sha256 != REVIEWED_LAUNCHER_SHA256
    ):
        raise EnrollmentError("Les octets ne correspondent pas au contrat d'ancre revu.")
    _validate_python_program(
        helper_raw,
        "bootstrap",
        (b"gui-corrective-preflight", b"def main() -> int:"),
    )
    _validate_python_program(
        launcher_raw,
        "launcher",
        (b"def prepare_reviewed_payload(", b"os.execve(executable"),
    )


def _authority_present(raw: bytes) -> bool:
    if raw.count(AUTHORITY_BYTES) != 1:
        return False
    start = raw.index(AUTHORITY_BYTES)
    before = raw[:start]
    after = raw[start + len(AUTHORITY_BYTES):]
    return (
        (not before or before.endswith(b"\n"))
        and (not after or after.startswith(b"\n"))
    )


def _validate_published(root: Path, expected: dict[str, bytes]) -> None:
    _require_root_directory(root, 0o555)
    try:
        entries = {entry.name for entry in os.scandir(root)}
    except OSError as exc:
        raise EnrollmentError("L'ancre publiée est illisible.") from exc
    if entries != set(ANCHOR_FILES):
        raise EnrollmentError("L'ancre publiée contient des fichiers inattendus.")
    for name, mode in ANCHOR_FILES.items():
        observed = _read_exact(
            root / name,
            max(len(expected[name]), 1),
            owner_uid=ROOT_UID,
            owner_gid=ROOT_GID,
            mode=mode,
        )
        if observed != expected[name]:
            raise EnrollmentError(f"L'ancre publiée diffère : {name}")


def _read_anchor_payload(root: Path) -> dict[str, bytes]:
    """Read one immutable anchor after checking its complete root contract."""
    _require_root_directory(root, 0o555)
    try:
        entries = {entry.name for entry in os.scandir(root)}
    except OSError as exc:
        raise EnrollmentError("L'ancre root est illisible.") from exc
    if entries != set(ANCHOR_FILES):
        raise EnrollmentError("L'ancre root contient des fichiers inattendus.")
    return {
        name: _read_exact(
            root / name,
            ANCHOR_MAXIMUMS[name],
            owner_uid=ROOT_UID,
            owner_gid=ROOT_GID,
            mode=mode,
        )
        for name, mode in ANCHOR_FILES.items()
    }


def _is_exact_payload(
    payload: dict[str, bytes], expected_sha256: dict[str, str]
) -> bool:
    return all(
        hashlib.sha256(payload[name]).hexdigest() == expected_digest
        for name, expected_digest in expected_sha256.items()
    )


def _is_legacy_payload(payload: dict[str, bytes]) -> bool:
    return _is_exact_payload(payload, LEGACY_SHA256)


def _is_intermediate_payload(payload: dict[str, bytes]) -> bool:
    return _is_exact_payload(payload, INTERMEDIATE_SHA256)


def _is_pre_third_payload(payload: dict[str, bytes]) -> bool:
    return _is_exact_payload(payload, PRE_THIRD_SHA256)


def _validate_legacy_anchor(root: Path) -> None:
    payload = _read_anchor_payload(root)
    if not _is_legacy_payload(payload):
        raise EnrollmentError("L'ancienne ancre ne correspond pas aux octets autorisés.")


def _validate_intermediate_anchor(root: Path) -> None:
    payload = _read_anchor_payload(root)
    if not _is_intermediate_payload(payload):
        raise EnrollmentError("L'ancre intermédiaire ne correspond pas aux octets autorisés.")


def _validate_pre_third_anchor(root: Path) -> None:
    payload = _read_anchor_payload(root)
    if not _is_pre_third_payload(payload):
        raise EnrollmentError(
            "La troisième ancre prédécesseur ne correspond pas aux octets autorisés."
        )


def _intermediate_history_anchor() -> Path:
    """Return the fixed second archive path while remaining test-relocatable."""
    return HISTORY_PARENT / f"{ANCHOR_ROOT.name}.pre-second-reconciliation"


def _third_history_anchor() -> Path:
    """Return the fixed third archive path while remaining test-relocatable."""
    return HISTORY_PARENT / f"{ANCHOR_ROOT.name}.pre-third-reconciliation"


def _inspect_history_state() -> tuple[bool, bool, bool]:
    """Validate and report the three append-only, ordered archive generations."""
    intermediate_history = _intermediate_history_anchor()
    third_history = _third_history_anchor()
    if not os.path.lexists(HISTORY_PARENT):
        if any(
            os.path.lexists(path)
            for path in (HISTORY_ANCHOR, intermediate_history, third_history)
        ):
            raise EnrollmentError("Le chemin d'historique root est incohérent.")
        return False, False, False
    _require_root_directory(HISTORY_PARENT, 0o755)
    try:
        entries = {entry.name for entry in os.scandir(HISTORY_PARENT)}
    except OSError as exc:
        raise EnrollmentError("L'historique root est illisible.") from exc
    allowed = {HISTORY_ANCHOR.name, intermediate_history.name, third_history.name}
    if not entries.issubset(allowed):
        raise EnrollmentError("L'historique root contient un objet inattendu.")
    legacy_present = HISTORY_ANCHOR.name in entries
    intermediate_present = intermediate_history.name in entries
    third_present = third_history.name in entries
    if intermediate_present and not legacy_present:
        raise EnrollmentError("L'historique intermédiaire existe sans l'historique initial.")
    if third_present and not intermediate_present:
        raise EnrollmentError(
            "Le troisième historique existe sans l'historique intermédiaire."
        )
    if legacy_present:
        _validate_legacy_anchor(HISTORY_ANCHOR)
    if intermediate_present:
        _validate_intermediate_anchor(intermediate_history)
    if third_present:
        _validate_pre_third_anchor(third_history)
    return legacy_present, intermediate_present, third_present


def _inspect_history() -> bool:
    """Return whether at least one exact immutable archive is present."""
    return any(_inspect_history_state())


def _ensure_history_parent() -> None:
    _require_root_directory(HISTORY_PARENT, 0o755, create=True)
    _inspect_history_state()


def _read_stage_candidate(path: Path, raw: bytes, final_mode: int) -> tuple[bytes, int]:
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        before = os.fstat(descriptor)
        observed_mode = stat.S_IMODE(before.st_mode)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != ROOT_UID
            or before.st_gid != ROOT_GID
            or before.st_nlink != 1
            or observed_mode not in {0o600, final_mode}
            or before.st_size > len(raw)
        ):
            raise EnrollmentError(f"Le temporaire root n'est pas réconciliable : {path.name}")
        observed = b""
        while len(observed) <= len(raw):
            chunk = os.read(descriptor, len(raw) + 1 - len(observed))
            if not chunk:
                break
            observed += chunk
        after = os.fstat(descriptor)
        if (
            len(observed) != before.st_size
            or after.st_dev != before.st_dev
            or after.st_ino != before.st_ino
            or after.st_size != before.st_size
            or after.st_mtime_ns != before.st_mtime_ns
            or after.st_ctime_ns != before.st_ctime_ns
            or after.st_uid != ROOT_UID
            or after.st_gid != ROOT_GID
            or after.st_nlink != 1
            or stat.S_IMODE(after.st_mode) != observed_mode
        ):
            raise EnrollmentError(f"Le temporaire root a changé : {path.name}")
        return observed, observed_mode
    finally:
        os.close(descriptor)


def _publish_stage_file(path: Path, raw: bytes, final_mode: int) -> None:
    if os.path.lexists(path):
        observed = _read_exact(
            path,
            max(len(raw), 1),
            owner_uid=ROOT_UID,
            owner_gid=ROOT_GID,
            mode=final_mode,
        )
        if observed != raw:
            raise EnrollmentError(f"Le staging root diffère : {path.name}")
        return
    temporary = path.with_name(f".{path.name}.next")
    if os.path.lexists(temporary):
        observed, observed_mode = _read_stage_candidate(temporary, raw, final_mode)
        if observed_mode == final_mode:
            if observed != raw:
                raise EnrollmentError(f"Le temporaire root diffère : {path.name}")
            os.rename(temporary, path)
            _fsync_directory(path.parent)
            return
        if not raw.startswith(observed):
            raise EnrollmentError(f"Le temporaire root n'est pas un préfixe exact : {path.name}")
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW,
        )
    else:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
        )
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise EnrollmentError("Écriture incomplète de l'ancre root.")
            view = view[written:]
        os.fsync(descriptor)
        os.fchown(descriptor, ROOT_UID, ROOT_GID)
        os.fsync(descriptor)
        os.fchmod(descriptor, final_mode)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.rename(temporary, path)
    _fsync_directory(path.parent)


def _prepare_staging(expected: dict[str, bytes]) -> None:
    if not os.path.lexists(STAGING_ROOT):
        os.mkdir(STAGING_ROOT, 0o700)
        os.chown(STAGING_ROOT, ROOT_UID, ROOT_GID)
        os.chmod(STAGING_ROOT, 0o700)
        _fsync_directory(ANCHOR_PARENT)
    staging_metadata = STAGING_ROOT.lstat()
    if (
        stat.S_ISDIR(staging_metadata.st_mode)
        and staging_metadata.st_uid == ROOT_UID
        and staging_metadata.st_gid == ROOT_GID
        and stat.S_IMODE(staging_metadata.st_mode) == 0o000
    ):
        os.chmod(STAGING_ROOT, 0o700)
        _fsync_directory(ANCHOR_PARENT)
        staging_metadata = STAGING_ROOT.lstat()
    if (
        not stat.S_ISDIR(staging_metadata.st_mode)
        or staging_metadata.st_uid != ROOT_UID
        or staging_metadata.st_gid != ROOT_GID
        or stat.S_IMODE(staging_metadata.st_mode) not in {0o700, 0o555}
    ):
        raise EnrollmentError("Le répertoire de staging root n'est pas sûr.")
    if stat.S_IMODE(staging_metadata.st_mode) == 0o555:
        os.chmod(STAGING_ROOT, 0o700)
        _fsync_directory(ANCHOR_PARENT)
    _require_root_directory(STAGING_ROOT, 0o700)
    try:
        entries = {entry.name for entry in os.scandir(STAGING_ROOT)}
    except OSError as exc:
        raise EnrollmentError("Le staging root est illisible.") from exc
    allowed_stage_entries = set(ANCHOR_FILES) | {
        f".{name}.next" for name in ANCHOR_FILES
    }
    if not entries.issubset(allowed_stage_entries):
        raise EnrollmentError("Le staging root contient un fichier inattendu.")
    for name, mode in ANCHOR_FILES.items():
        _publish_stage_file(STAGING_ROOT / name, expected[name], mode)
    os.chmod(STAGING_ROOT, 0o555)
    _fsync_directory(STAGING_ROOT)
    _fsync_directory(ANCHOR_PARENT)
    _validate_published(STAGING_ROOT, expected)


def _open_lock() -> int:
    created = False
    try:
        descriptor = os.open(
            LOCK_PATH,
            os.O_RDWR
            | os.O_CREAT
            | os.O_EXCL
            | os.O_CLOEXEC
            | os.O_NOFOLLOW,
            0o600,
        )
        created = True
    except FileExistsError:
        descriptor = os.open(
            LOCK_PATH, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW
        )
    try:
        metadata = os.fstat(descriptor)
        recoverable_zero_mode = (
            not created
            and stat.S_ISREG(metadata.st_mode)
            and metadata.st_uid == ROOT_UID
            and metadata.st_gid == ROOT_GID
            and metadata.st_nlink == 1
            and metadata.st_size == 0
            and stat.S_IMODE(metadata.st_mode) == 0o000
        )
        if created or recoverable_zero_mode:
            os.fchown(descriptor, ROOT_UID, ROOT_GID)
            os.fchmod(descriptor, 0o600)
            os.fsync(descriptor)
            metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != ROOT_UID
            or metadata.st_gid != ROOT_GID
            or metadata.st_nlink != 1
            or metadata.st_size != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise EnrollmentError("Le verrou root de l'ancre n'est pas sûr.")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _publish_or_reconcile(expected: dict[str, bytes]) -> str:
    """Publish current bytes and preserve all authorized predecessor anchors.

    Every rename is followed by fsync of both affected directories.  If power
    is lost after any predecessor -> history but before staging -> anchor,
    the next invocation requires the already sealed staging object and
    completes that same move.  No archive is ever replaced or removed.
    """
    (
        legacy_history_present,
        intermediate_history_present,
        third_history_present,
    ) = _inspect_history_state()
    history_present = any(
        (legacy_history_present, intermediate_history_present, third_history_present)
    )
    anchor_kind = "absent"
    payload: dict[str, bytes] | None = None
    if os.path.lexists(ANCHOR_ROOT):
        payload = _read_anchor_payload(ANCHOR_ROOT)
        if payload == expected:
            anchor_kind = "current"
        elif _is_legacy_payload(payload):
            anchor_kind = "legacy"
        elif _is_intermediate_payload(payload):
            anchor_kind = "intermediate"
        elif _is_pre_third_payload(payload):
            anchor_kind = "pre-third"
        else:
            raise EnrollmentError(
                "L'ancre root existante n'est ni un prédécesseur autorisé ni la cible courante."
            )

    if anchor_kind == "current":
        if os.path.lexists(STAGING_ROOT):
            raise EnrollmentError("Un staging inattendu subsiste après publication.")
        if payload is None:
            raise EnrollmentError("L'identité de l'ancre courante est absente.")
        if _is_legacy_payload(payload) and legacy_history_present:
            raise EnrollmentError("L'ancienne ancre existe à deux emplacements.")
        if _is_intermediate_payload(payload) and intermediate_history_present:
            raise EnrollmentError("L'ancre intermédiaire existe à deux emplacements.")
        if _is_pre_third_payload(payload) and third_history_present:
            raise EnrollmentError(
                "La troisième ancre prédécesseur existe à deux emplacements."
            )
        return "reconciled" if history_present else "already-enrolled"
    if anchor_kind == "legacy" and history_present:
        raise EnrollmentError("L'ancienne ancre existe avec un historique incompatible.")
    if anchor_kind == "intermediate" and (
        not legacy_history_present
        or intermediate_history_present
        or third_history_present
    ):
        raise EnrollmentError("L'état historique de l'ancre intermédiaire est incohérent.")
    if anchor_kind == "pre-third" and (
        not legacy_history_present
        or not intermediate_history_present
        or third_history_present
    ):
        raise EnrollmentError(
            "L'état historique de la troisième ancre prédécesseur est incohérent."
        )
    if anchor_kind == "absent" and history_present:
        # Exact crash frontier: one authorized predecessor has already been
        # archived. Publication of the *already sealed* target is the only
        # permitted transition. Never rebuild it from a later confirmation:
        # that would break the binding between confirmation A and staging A.
        _inspect_history_state()
        if not os.path.lexists(STAGING_ROOT):
            raise EnrollmentError(
                "Le staging physiquement confirmé manque après archivage."
            )
        _validate_published(STAGING_ROOT, expected)
    else:
        _prepare_staging(expected)

    if anchor_kind == "legacy":
        _ensure_history_parent()
        if os.path.lexists(HISTORY_ANCHOR):
            raise EnrollmentError("L'historique exact existe déjà.")
        os.rename(ANCHOR_ROOT, HISTORY_ANCHOR)
        _fsync_directory(HISTORY_PARENT)
        _fsync_directory(ANCHOR_PARENT)
        _validate_legacy_anchor(HISTORY_ANCHOR)
        anchor_kind = "absent"
        legacy_history_present = True
        history_present = True
    elif anchor_kind == "intermediate":
        _ensure_history_parent()
        if _inspect_history_state() != (True, False, False):
            raise EnrollmentError("L'historique requis avant seconde réconciliation diffère.")
        intermediate_history = _intermediate_history_anchor()
        if os.path.lexists(intermediate_history):
            raise EnrollmentError("Le second historique exact existe déjà.")
        os.rename(ANCHOR_ROOT, intermediate_history)
        _fsync_directory(HISTORY_PARENT)
        _fsync_directory(ANCHOR_PARENT)
        _validate_intermediate_anchor(intermediate_history)
        anchor_kind = "absent"
        intermediate_history_present = True
        history_present = True
    elif anchor_kind == "pre-third":
        _ensure_history_parent()
        if _inspect_history_state() != (True, True, False):
            raise EnrollmentError(
                "L'historique requis avant troisième réconciliation diffère."
            )
        third_history = _third_history_anchor()
        if os.path.lexists(third_history):
            raise EnrollmentError("Le troisième historique exact existe déjà.")
        os.rename(ANCHOR_ROOT, third_history)
        _fsync_directory(HISTORY_PARENT)
        _fsync_directory(ANCHOR_PARENT)
        _validate_pre_third_anchor(third_history)
        anchor_kind = "absent"
        third_history_present = True
        history_present = True

    if os.path.lexists(ANCHOR_ROOT):
        raise EnrollmentError("Une ancre concurrente est apparue.")
    os.rename(STAGING_ROOT, ANCHOR_ROOT)
    _fsync_directory(ANCHOR_PARENT)
    _validate_published(ANCHOR_ROOT, expected)
    if history_present:
        observed_history = _inspect_history_state()
        if observed_history != (
            legacy_history_present,
            intermediate_history_present,
            third_history_present,
        ):
            raise EnrollmentError("L'historique a changé pendant la publication.")
        return "reconciled"
    return "enrolled"


def _confirmation_digest(nonce: str, snapshots: tuple[bytes, ...]) -> str:
    identities = ":".join(hashlib.sha256(raw).hexdigest() for raw in snapshots)
    return hashlib.sha256(
        f"atlas-trust-anchor-v1:{RELEASE_ID}:{nonce}:{identities}".encode("ascii")
    ).hexdigest()


def enroll() -> dict[str, str]:
    os.umask(0o077)
    if os.getuid() != 0 or os.geteuid() != 0 or os.getgid() != 0:
        raise EnrollmentError("L'enrôlement exige l'authentification Polkit locale.")
    if len(sys.argv) != 9:
        raise EnrollmentError("Le canal d'enrôlement scellé est invalide.")
    numeric = sys.argv[1:7]
    if any(not value.isascii() or not value.isdigit() or len(value) > 10 for value in numeric):
        raise EnrollmentError("Le canal d'enrôlement scellé est invalide.")
    (
        parent_pid,
        manifest_fd,
        helper_fd,
        launcher_fd,
        authority_fd,
        installer_fd,
    ) = (int(value) for value in numeric)
    nonce = sys.argv[7]
    confirmed_digest = sys.argv[8]
    if (
        parent_pid != os.getppid()
        or not re.fullmatch(r"[0-9a-f]{32}", nonce)
        or SHA256_RE.fullmatch(confirmed_digest) is None
        or sys.argv[0] != f"/proc/{parent_pid}/fd/{installer_fd}"
    ):
        raise EnrollmentError("Le parent ou la confirmation d'enrôlement diffère.")
    account = pwd.getpwnam("ops-user")
    snapshot_policy = {"owner_uid": account.pw_uid, "owner_gid": account.pw_gid}
    manifest_raw = _read_sealed_snapshot(
        parent_pid,
        manifest_fd,
        MAX_MANIFEST_BYTES,
        **snapshot_policy,
    )
    helper_raw = _read_sealed_snapshot(
        parent_pid,
        helper_fd,
        MAX_HELPER_BYTES,
        **snapshot_policy,
    )
    launcher_raw = _read_sealed_snapshot(
        parent_pid,
        launcher_fd,
        MAX_LAUNCHER_BYTES,
        **snapshot_policy,
    )
    authority_raw = _read_sealed_snapshot(
        parent_pid,
        authority_fd,
        MAX_AUTHORITY_BYTES,
        **snapshot_policy,
    )
    installer_raw = _read_sealed_snapshot(
        parent_pid,
        installer_fd,
        MAX_INSTALLER_BYTES,
        **snapshot_policy,
    )
    snapshots = (manifest_raw, helper_raw, launcher_raw, authority_raw, installer_raw)
    if _confirmation_digest(nonce, snapshots) != confirmed_digest:
        raise EnrollmentError("La confirmation physique ne correspond pas aux snapshots scellés.")
    if not _authority_present(authority_raw):
        raise EnrollmentError("L'autorité corrective exacte n'est pas publiée dans AGENTS.md.")
    _validate_contract(manifest_raw, helper_raw, launcher_raw)
    expected = {
        "release-manifest.v1.json": manifest_raw,
        "control-plane-bootstrap": helper_raw,
        "launch-atlas-reviewed-rpm": launcher_raw,
    }

    lock_descriptor = _open_lock()
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
        _require_root_directory(Path("/usr"), 0o755)
        _require_root_directory(Path("/usr/local"), 0o755)
        _require_root_directory(Path("/usr/local/lib"), 0o755)
        _require_root_directory(ANCHOR_PARENT, 0o755, create=True)
        status_value = _publish_or_reconcile(expected)
    finally:
        os.close(lock_descriptor)
    return {
        "status": status_value,
        "release_id": RELEASE_ID,
        "manifest_sha256": hashlib.sha256(manifest_raw).hexdigest(),
        "helper_sha256": hashlib.sha256(helper_raw).hexdigest(),
        "launcher_sha256": hashlib.sha256(launcher_raw).hexdigest(),
    }


if __name__ == "__main__":
    try:
        print(json.dumps(enroll(), sort_keys=True, separators=(",", ":")))
    except EnrollmentError as exc:
        print(f"Ancre Atlas non installée : {exc}", file=sys.stderr)
        raise SystemExit(1) from None
