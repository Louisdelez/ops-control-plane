AUTHORITY_BYTES = b"""## Single corrective local bootstrap exception

  The workstation owner authorizes codex-supervised to execute exactly one corrective local bootstrap transaction from the
  cryptographically verified, terminal rolled-back release atlas-api-zulip-2026.09.08.10 to the reviewed release
  atlas-api-zulip-2026.09.08.11, solely because Zulip was not installed before the first transaction failed.

  The corrective transaction may archive, but never delete or rewrite, the exact prior consumed marker and state under the reviewed
  root-owned history path. It requires physical local Polkit authentication and explicit Atlas confirmation, preserves a durable WAL
  and audit chain, and performs automatic crash recovery and rollback. It may install only the scope authorized by the original local
  bootstrap exception and may not contact remote providers or disclose secrets.

  Before that marker is published, codex-supervised may install and reconcile only the reviewed root-owned versioned Atlas trust anchor
  (release manifest, bootstrap helper, and sealed-RPM launcher), the corrective recovery helper, and its systemd units. This scaffold
  is inert while the corrective marker is absent; an interrupted partial scaffold may only be reconciled to the exact reviewed bytes
  and enablement, and it grants no authority to mutate any service or bootstrap state.

  This corrective capability is consumed when its first persistent transaction marker is published, whether it succeeds or rolls
  back. Resuming that same recorded transaction after interruption is authorized; no second corrective transaction is authorized.
  Every later Class C action requires a separately recorded Zulip approval.
"""


class EnrollmentError(RuntimeError):
    """Fail-closed enrollment error."""


def _duplicate_safe_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise EnrollmentError("Le manifeste contient une clé dupliquée.")
        value[key] = item
    return value


def _read_exact(
    path: Path,
    maximum: int,
    *,
    owner_uid: int,
    owner_gid: int,
    mode: int,
) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise EnrollmentError(f"Fichier indisponible : {path}") from exc
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != owner_uid
            or before.st_gid != owner_gid
            or stat.S_IMODE(before.st_mode) != mode
            or before.st_nlink != 1
            or before.st_size <= 0
            or before.st_size > maximum
        ):
            raise EnrollmentError(f"Fichier non sûr : {path}")
        chunks: list[bytes] = []
        observed = 0
        while observed <= maximum:
            chunk = os.read(descriptor, min(1024 * 1024, maximum + 1 - observed))
            if not chunk:
                break
            chunks.append(chunk)
            observed += len(chunk)
        after = os.fstat(descriptor)
        if (
            observed != before.st_size
            or after.st_dev != before.st_dev
            or after.st_ino != before.st_ino
            or after.st_size != before.st_size
            or after.st_mtime_ns != before.st_mtime_ns
            or after.st_ctime_ns != before.st_ctime_ns
            or after.st_uid != owner_uid
            or after.st_gid != owner_gid
            or stat.S_IMODE(after.st_mode) != mode
            or after.st_nlink != 1
        ):
            raise EnrollmentError(f"Fichier modifié pendant sa lecture : {path}")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _read_sealed_snapshot(
    parent_pid: int,
    descriptor_number: int,
    maximum: int,
    *,
    owner_uid: int,
    owner_gid: int,
) -> bytes:
    path = Path(f"/proc/{parent_pid}/fd/{descriptor_number}")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    except OSError as exc:
        raise EnrollmentError("Un snapshot scellé est indisponible.") from exc
    try:
        before = os.fstat(descriptor)
        required_seals = (
            fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_SEAL
        )
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != owner_uid
            or before.st_gid != owner_gid
            or stat.S_IMODE(before.st_mode) != 0o400
            or before.st_nlink != 0
            or before.st_size <= 0
            or before.st_size > maximum
            or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != required_seals
        ):
            raise EnrollmentError("Un snapshot n'est pas intégralement scellé.")
        chunks: list[bytes] = []
        observed = 0
        while observed <= maximum:
            chunk = os.read(descriptor, min(1024 * 1024, maximum + 1 - observed))
            if not chunk:
                break
            chunks.append(chunk)
            observed += len(chunk)
        after = os.fstat(descriptor)
        if (
            observed != before.st_size
            or after.st_dev != before.st_dev
            or after.st_ino != before.st_ino
            or after.st_size != before.st_size
            or after.st_uid != owner_uid
            or after.st_gid != owner_gid
            or stat.S_IMODE(after.st_mode) != 0o400
            or after.st_nlink != 0
            or fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) != required_seals
        ):
            raise EnrollmentError("Un snapshot scellé a changé.")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _require_root_directory(path: Path, mode: int, *, create: bool = False) -> None:
    if create and not os.path.lexists(path):
        try:
            os.mkdir(path, mode)
            os.chown(path, ROOT_UID, ROOT_GID)
            os.chmod(path, mode)
            _fsync_directory(path)
            _fsync_directory(path.parent)
        except FileExistsError:
            pass
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise EnrollmentError(f"Répertoire root indisponible : {path}") from exc
    if (
        create
        and stat.S_ISDIR(metadata.st_mode)
        and metadata.st_uid == ROOT_UID
        and metadata.st_gid == ROOT_GID
        and stat.S_IMODE(metadata.st_mode) in {0o000, 0o700}
        and mode == 0o755
    ):
        interrupted_mode = stat.S_IMODE(metadata.st_mode)
        if interrupted_mode == 0o000:
            # Crash frontier after mkdir under an unexpectedly restrictive
            # inherited umask.  Only an empty, root-owned directory can be
            # normalized; a foreign payload remains fail-closed.
            os.chmod(path, 0o700)
        if any(os.scandir(path)):
            if interrupted_mode == 0o000:
                os.chmod(path, interrupted_mode)
            raise EnrollmentError(f"Répertoire root interrompu non vide : {path}")
        os.chmod(path, mode)
        _fsync_directory(path)
        _fsync_directory(path.parent)
        metadata = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != ROOT_UID
        or metadata.st_gid != ROOT_GID
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise EnrollmentError(f"Répertoire root non sûr : {path}")


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _exact_mapping(value: Any, keys: set[str], location: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise EnrollmentError(f"Les champs du manifeste diffèrent : {location}")
    return value


def _sha256_value(value: Any, location: str) -> str:
    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
        raise EnrollmentError(f"Empreinte SHA-256 invalide : {location}")
    return value


def _string_list(
    value: Any, location: str, *, minimum: int = 1
) -> list[str]:
    if (
        not isinstance(value, list)
        or len(value) < minimum
        or any(not isinstance(item, str) or not item for item in value)
        or len(set(value)) != len(value)
    ):
        raise EnrollmentError(f"Liste invalide dans le manifeste : {location}")
    return value


def _validate_python_program(raw: bytes, label: str, markers: tuple[bytes, ...]) -> None:
    if not raw.startswith(b"#!/usr/bin/python3 -I\n") or b"\x00" in raw:
        raise EnrollmentError(f"Le programme {label} n'a pas l'interpréteur revu.")
    if any(marker not in raw for marker in markers):
        raise EnrollmentError(f"Le programme {label} n'expose pas son contrat revu.")
    try:
        source = raw.decode("utf-8")
        compile(source, f"<atlas-{label}>", "exec", dont_inherit=True, optimize=2)
    except (SyntaxError, UnicodeDecodeError, ValueError) as exc:
        raise EnrollmentError(f"Le programme {label} n'est pas exécutable.") from exc


def _validate_manifest_structure(document: dict[str, Any]) -> None:
    _exact_mapping(document, MANIFEST_KEYS, "racine")
    if (
        document["schema_version"] != 1
        or document["release_id"] != RELEASE_ID
        or document["architecture"] != "x86_64"
    ):
        raise EnrollmentError("L'identité de release du manifeste diffère.")

    bootstrap = _exact_mapping(document["bootstrap"], BOOTSTRAP_KEYS, "bootstrap")
    fixed_bootstrap = {
        "mode": "one-shot-local-physical",
        "actor": "codex-supervised",
        "allowed_when": "zulip-absent",
        "consumed_marker": "/var/lib/ops-control-plane-bootstrap.consumed.json",
        "state_root": "/var/lib/ops-control-plane-bootstrap",
        "approver_state": "/var/lib/ops-control-plane-bootstrap/zulip-approver.json",
        "requires_provider_keys": False,
        "rollback_keeps_recovered_userpass": True,
    }
    if any(bootstrap[key] != value for key, value in fixed_bootstrap.items()):
        raise EnrollmentError("Le contrat bootstrap fixe diffère.")
    if bootstrap["recovery_units"] != [
        "ops-control-plane-bootstrap-guard.service",
        "ops-control-plane-bootstrap-recovery.service",
        "ops-control-plane-bootstrap-recovery-activate.service",
    ]:
        raise EnrollmentError("Les unités de récupération bootstrap diffèrent.")
    _sha256_value(bootstrap["helper_sha256"], "bootstrap.helper_sha256")

    gui = _exact_mapping(
        bootstrap["gui_protocol"], GUI_PROTOCOL_KEYS, "bootstrap.gui_protocol"
    )
    fixed_gui = {
        "schema_version": 1,
        "public_operations": [
            "gui-preflight",
            "gui-apply",
            "gui-corrective-preflight",
            "gui-corrective-apply",
            "gui-recovery-preflight",
            "gui-recovery-apply",
        ],
        "apply_magic": "ATLASBOOT1",
        "control_magic": "ATLASCTL1",
        "stdout": "bounded-jsonl",
        "atlas_ancestry_required": True,
        "launcher_mode": "sealed-rpm-payload-memfd",
        "atlas_payload_member": "/usr/bin/ops-model-manager",
        "anonymous_pipes_required": True,
        "mutation_boundary_event": "mutation-started",
        "secrets_outside_process_memory": False,
    }
    if any(gui[key] != value for key, value in fixed_gui.items()):
        raise EnrollmentError("Le protocole GUI bootstrap diffère.")
    _sha256_value(gui["atlas_payload_sha256"], "bootstrap.gui_protocol.atlas_payload_sha256")

    openbao = _exact_mapping(bootstrap["openbao"], OPENBAO_KEYS, "bootstrap.openbao")
    fixed_openbao = {
        "version": "2.6.2",
        "address": "https://127.0.0.1:8200",
        "listener_config": "/etc/openbao.d/openbao.hcl",
        "recovery_credentials": ["openbao-unseal-share-1", "openbao-unseal-share-2"],
        "tcp_legacy_endpoint_disabled": True,
        "temporary_unix_socket": "/var/lib/openbao/ops-control-plane-bootstrap.sock",
        "root_token_escrow": "/var/lib/ops-control-plane-bootstrap/root-token.cred",
        "undo_escrow": "/var/lib/ops-control-plane-bootstrap/openbao-undo.cred",
        "userpass_password_escrow": "/var/lib/ops-control-plane-bootstrap/userpass-password.cred",
        "exclusive_local_maintenance": True,
        "root_generation_max_remints": 1,
        "root_generation_window_seconds": 10,
    }
    if any(openbao[key] != value for key, value in fixed_openbao.items()):
        raise EnrollmentError("Le contrat OpenBao bootstrap diffère.")
    if (
        openbao["listener_source_sha256"]
        != "fa35302f0917bfe0cb0a71e5926e0832b59a468cba2d0ceb967a93e3067fe034"
        or openbao["temporary_unix_listener_sha256"]
        != "bb5d13d1ce055fce8855a06cf750ab5515392c926cc7e289a3053cff147060d1"
    ):
        raise EnrollmentError("Les identités de configuration OpenBao diffèrent.")

    corrective = _exact_mapping(
        bootstrap["corrective"], CORRECTIVE_KEYS, "bootstrap.corrective"
    )
    fixed_corrective = {
        "mode": "single-terminal-rollback-repair",
        "max_attempts": 1,
        "consumed_marker": "/var/lib/ops-control-plane-bootstrap-corrective.consumed.json",
        "state_root": "/var/lib/ops-control-plane-bootstrap-corrective",
        "history_root": "/var/lib/ops-control-plane-bootstrap-history",
        "recovery_helper": "/usr/local/libexec/ops-control-plane-bootstrap-corrective",
        "recovery_unit": "ops-control-plane-bootstrap-corrective-recovery.service",
        "recovery_path_unit": "ops-control-plane-bootstrap-corrective-recovery.path",
        "authority_document": "AGENTS.md",
        "recovery_from_release_id": "atlas-api-zulip-2026.09.08.10",
    }
    if any(corrective[key] != value for key, value in fixed_corrective.items()):
        raise EnrollmentError("Le contrat correctif bootstrap diffère.")
    if {
        key: corrective[key]
        for key in (
            "recovery_from_source_tree_sha256",
            "recovery_from_atlas_rpm_sha256",
            "recovery_from_bootstrap_helper_sha256",
            "recovery_from_manifest_sha256",
        )
    } != {
        "recovery_from_source_tree_sha256": "3ede12c444991f12c81359963cfde50bc01d757fba8bf512a56f610a095f40ef",
        "recovery_from_atlas_rpm_sha256": "a571034b4902e951d8af2754eb904be6fe68d0a582f006d34a6b694f77cad32f",
        "recovery_from_bootstrap_helper_sha256": "93561352ce9684ce2eb3a1cc8a9abb13375d31073c5b6a515b716cb2e1c3a9d0",
        "recovery_from_manifest_sha256": "96f137109ea240264f53e994e4e0179c9dbb90db485c595cd34bbf6a692214d2",
    }:
        raise EnrollmentError("Les identités de récupération corrective diffèrent.")

    source = _exact_mapping(
        document["source"], {"root", "roots", "tree_algorithm", "tree_sha256"}, "source"
    )
    if source["root"] != "/home/ops-user/ops-control-plane" or source["tree_algorithm"] != "sha256-tree-v1":
        raise EnrollmentError("Le contrat de source diffère.")
    roots = _string_list(source["roots"], "source.roots", minimum=10)
    expected_roots = [
        "AGENTS.md",
        "README.md",
        "apps/model-manager",
        "bridges/zulip",
        "broker",
        "broker/config/executables.yaml",
        "broker/config/rbac.yaml",
        "broker/deploy/helpers/control-plane-deployment",
        "broker/deploy/sudoers/ops-broker-control-plane-deployment",
        "broker/requirements-mcp.txt",
        "catalog",
        "config/hermes",
        "config/ollama/selection.json",
    "config/openbao",
        "deploy/control-plane/README.md",
        "deploy/control-plane/bin/control-plane-bootstrap",
        "deploy/control-plane/bin/control-plane-deployment-worker",
        "deploy/control-plane/ops-control-plane-deployment.tmpfiles",
        "deploy/control-plane/release-manifest.v1.schema.json",
        "deploy/control-plane/systemd",
        "deploy/zulip-local",
        "docs",
        "memory/config/memory.toml",
    "memory/deploy",
    "memory/src/ops_memory/mcp_server.py",
        "orchestrator",
        "policies",
        "provider-discovery",
        "runbooks",
        "runbooks/local/control-plane-deployment-status.yaml",
        "scripts",
        "systemd",
    ]
    if roots != expected_roots or any(
        item.startswith("/") or ".." in Path(item).parts for item in roots
    ):
        raise EnrollmentError("La couverture de source est invalide.")
    _sha256_value(source["tree_sha256"], "source.tree_sha256")

    artifacts = _exact_mapping(
        document["artifacts"], {"atlas_rpm", "hermes_source_archive"}, "artifacts"
    )
    atlas = _exact_mapping(
        artifacts["atlas_rpm"],
        {
            "source_path",
            "sha256",
            "payload_executable_path",
            "payload_executable_sha256",
            "name",
            "initial_state",
            "signed",
            "version",
            "release",
            "architecture",
        },
        "artifacts.atlas_rpm",
    )
    if (
        atlas["source_path"] != "/home/ops-user/Téléchargements/Atlas-modeles-IA-0.1.0-1.x86_64.rpm"
        or atlas["payload_executable_path"] != "/usr/bin/ops-model-manager"
        or atlas["name"] != "modeles-ia"
        or atlas["initial_state"] != "absent"
        or atlas["signed"] is not False
        or atlas["version"] != "0.1.0"
        or atlas["release"] != "1"
        or atlas["architecture"] != "x86_64"
    ):
        raise EnrollmentError("Le contrat de l'artefact Atlas diffère.")
    _sha256_value(atlas["sha256"], "artifacts.atlas_rpm.sha256")
    atlas_payload_sha256 = _sha256_value(
        atlas["payload_executable_sha256"],
        "artifacts.atlas_rpm.payload_executable_sha256",
    )
    if atlas_payload_sha256 != gui["atlas_payload_sha256"]:
        raise EnrollmentError("L'identité du binaire Atlas diffère entre les contrats.")

    hermes_archive = _exact_mapping(
        artifacts["hermes_source_archive"],
        {
            "source_path",
            "sha256",
            "format",
            "commit",
            "git_tree_oid",
            "canonical_tree_sha256",
            "top_level_directory",
            "compressed_size",
            "expanded_size",
            "members",
            "regular_files",
            "directories",
            "max_file_size",
        },
        "artifacts.hermes_source_archive",
    )
    expected_hermes_archive = {
        "source_path": "/home/ops-user/Téléchargements/Hermes-agent-v2026.8.31-29112bef.tar.gz",
        "sha256": "76b99a8be9b77d66833c3cfe2b35c6d6f6a58e4ff9637ef8effcfc1f420ab35a",
        "format": "github-codeload-tar-gzip-v1",
        "commit": "29112bef099274229cadff79cdff7bf7b99c4b77",
        "git_tree_oid": "daaffc303ae437041b7f76be17c5f61b14f2ce99",
        "canonical_tree_sha256": "7ecc4e3f45d65d6ab33907f9220c06daa66b118af2a0fbbf5df3f2e019776ad1",
        "top_level_directory": "hermes-agent-29112bef099274229cadff79cdff7bf7b99c4b77",
        "compressed_size": 69442866,
        "expanded_size": 167028103,
        "members": 11994,
        "regular_files": 10925,
        "directories": 1069,
        "max_file_size": 3871968,
    }
    if hermes_archive != expected_hermes_archive:
        raise EnrollmentError("Le contrat d'archive Hermes diffère.")
    if not isinstance(hermes_archive["commit"], str) or re.fullmatch(
        r"[0-9a-f]{40}", hermes_archive["commit"]
    ) is None:
        raise EnrollmentError("Le commit Hermes est invalide.")
    if not isinstance(hermes_archive["git_tree_oid"], str) or re.fullmatch(
        r"[0-9a-f]{40}", hermes_archive["git_tree_oid"]
    ) is None:
        raise EnrollmentError("L'arbre Git Hermes est invalide.")
    _sha256_value(hermes_archive["sha256"], "artifacts.hermes_source_archive.sha256")
    _sha256_value(
        hermes_archive["canonical_tree_sha256"],
        "artifacts.hermes_source_archive.canonical_tree_sha256",
    )
    for key in (
        "compressed_size",
        "expanded_size",
        "members",
        "regular_files",
        "directories",
        "max_file_size",
    ):
        if type(hermes_archive[key]) is not int or hermes_archive[key] <= 0:
            raise EnrollmentError(f"La borne Hermes est invalide : {key}")
    if (
        hermes_archive["regular_files"] + hermes_archive["directories"]
        != hermes_archive["members"]
        or hermes_archive["compressed_size"] >= hermes_archive["expanded_size"]
        or hermes_archive["max_file_size"] > hermes_archive["expanded_size"]
    ):
        raise EnrollmentError("Les bornes de l'archive Hermes sont incohérentes.")

