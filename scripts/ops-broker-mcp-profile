#!/usr/bin/bash -p
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if [[ $# -ne 1 ]]; then
  echo "A single fixed broker identity is required." >&2
  exit 64
fi

readonly actor_id=$1
case "$actor_id" in
  hermes-coordinator|minecraft-monitor|infra-operator|infra-network|monitoring-shared|backup-shared|deploy-ops|security-ops) ;;
  *)
    echo "Broker identity is not allowlisted." >&2
    exit 77
    ;;
esac

broker_uid=""
if ! broker_uid=$(/usr/bin/id -u opsbroker 2>/dev/null); then
  echo "The opsbroker account is unavailable." >&2
  exit 69
fi
readonly broker_uid

hermes_uid=""
if ! hermes_uid=$(/usr/bin/id -u hermesd 2>/dev/null); then
  echo "The hermesd account is unavailable." >&2
  exit 69
fi
readonly hermes_uid

if [[ $EUID -eq $hermes_uid ]]; then
  exec /usr/bin/sudo -n -u opsbroker -g opsbroker -- \
    /usr/local/libexec/ops-broker-mcp-profile "$actor_id"
fi

if [[ $EUID -ne $broker_uid ]]; then
  echo "This wrapper is restricted to hermesd through sudoers." >&2
  exit 77
fi

exec /usr/bin/env -i \
  PATH=/usr/sbin:/usr/bin \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  OPS_BROKER_DATABASE=/var/lib/ops-broker/state.db \
  OPS_BROKER_RUNBOOKS=/opt/ops-broker/runbooks \
  OPS_BROKER_ACTION_POLICY=/etc/ops-broker/actions.yaml \
  OPS_BROKER_RBAC_POLICY=/etc/ops-broker/rbac.yaml \
  OPS_BROKER_EXECUTABLES_POLICY=/etc/ops-broker/executables.yaml \
  OPS_BROKER_MCP_ACTOR_ID="$actor_id" \
  /opt/ops-broker/venv/bin/ops-broker-mcp
