#!/usr/bin/python3
"""Interactively provision encrypted Hermes AppRole credentials.

This is a post-bootstrap operator tool.  It never initializes or unseals
OpenBao, never prints a credential, and refuses to rotate a running Hermes
gateway.  Plaintext values exist only in this process and in pipes to
systemd-creds; only host+TPM2 encrypted blobs are persisted.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
from pathlib import Path
import re
import shutil
import ssl
import stat
import subprocess
import sys
import tempfile
from typing import Any
import urllib.error
import urllib.parse
import urllib.request


BAO_ORIGIN = "https://127.0.0.1:8200"
BAO_CA = Path("/etc/openbao.d/tls/ca.crt")
POLICY_FILE = Path(
    "/usr/local/share/ops-control-plane/openbao/policies/hermes-runtime.hcl"
)
LEGACY_POLICY_FILES = {
    "deepseek-client": Path(
        "/usr/local/share/ops-control-plane/openbao/policies/deepseek-client.hcl"
    ),
    "hermes-coordinator": Path(
        "/usr/local/share/ops-control-plane/openbao/policies/hermes-coordinator.hcl"
    ),
}
POLICY_NAME = "hermes-runtime"
ROLE_NAME = "hermes-runtime"
LEGACY_NAMES = tuple(LEGACY_POLICY_FILES)
GATEWAY_KV_PATH = "/v1/kv-infra-shared/data/hermes/gateway"
SERVICE_NAME = "hermes-gateway.service"
CREDSTORE = Path("/etc/credstore.encrypted")
CREDENTIAL_NAMES = (
    "hermes-openbao-role-id",
    "hermes-openbao-secret-id",
    "hermes-openbao-secret-id-accessor",
)
MAX_RESPONSE_BYTES = 32 * 1024
MAX_POLICY_BYTES = 16 * 1024
MAX_CREDENTIAL_BYTES = 256
HTTP_TIMEOUT_SECONDS = 3.0

_EXPECTED_RUNTIME_POLICY = """\
path "kv-infra-shared/data/hermes/gateway" {
capabilities = ["read"]
}
path "auth/token/revoke-self" {
capabilities = ["update"]
}"""
_EXPECTED_QUARANTINE_POLICY = """\
path "auth/token/revoke-self" {
capabilities = ["update"]
}"""

_IDENTIFIER_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{15,127}\Z")
_TOKEN_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._~-]{15,511}\Z")
_SECRET_VALUE_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._~+/=-]{15,511}\Z")


class ProvisioningError(RuntimeError):
    pass


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Provision the dormant Hermes AppRole without exposing credentials."
    )
    parser.add_argument("--password-fd", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--preserve-legacy-roles", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args()


def _password_from_pipe(descriptor: int) -> str:
    if descriptor < 3 or descriptor > 1024:
        raise ProvisioningError("The inherited password descriptor is invalid.")
    try:
        info = os.fstat(descriptor)
        target = os.readlink(f"/proc/self/fd/{descriptor}")
        if not stat.S_ISFIFO(info.st_mode) or not re.fullmatch(r"pipe:\[\d+\]", target):
            raise ProvisioningError("The inherited password descriptor is not a pipe.")
        chunks: list[bytes] = []
        remaining = 4097
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
    except OSError as exc:
        raise ProvisioningError("The inherited password pipe is unavailable.") from exc
    finally:
        try:
            os.close(descriptor)
        except OSError:
            pass
    if not raw or len(raw) > 4096:
        raise ProvisioningError("The inherited password is invalid.")
    try:
        password = raw.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        raise ProvisioningError("The inherited password is invalid.") from exc
    raw = b""
    if (
        len(password) < 10
        or len(password) > 256
        or password != password.strip()
        or any(ord(character) < 32 or ord(character) == 127 for character in password)
    ):
        password = ""
        raise ProvisioningError("The inherited password is invalid.")
    return password


class _RejectRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(  # type: ignore[override]
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> None:
        raise ProvisioningError("OpenBao refused a local request.")


def _validated(value: Any, pattern: re.Pattern[str]) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise ProvisioningError("OpenBao returned an invalid credential format.")
    return value


def _opener() -> urllib.request.OpenerDirector:
    context = ssl.create_default_context(cafile=str(BAO_CA))
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    return urllib.request.build_opener(
        urllib.request.ProxyHandler({}),
        _RejectRedirects(),
        urllib.request.HTTPSHandler(context=context),
    )


def _request(
    method: str,
    path: str,
    *,
    payload: dict[str, Any] | None = None,
    token: str | None = None,
    expect_json: bool = True,
    allow_not_found: bool = False,
) -> dict[str, Any] | None:
    allowed_requests = {
        ("POST", "/v1/auth/userpass/login/ops-user"),
        ("POST", f"/v1/sys/policies/acl/{POLICY_NAME}"),
        ("POST", f"/v1/auth/approle/role/{ROLE_NAME}"),
        ("GET", f"/v1/auth/approle/role/{ROLE_NAME}"),
        ("GET", f"/v1/auth/approle/role/{ROLE_NAME}/role-id"),
        ("POST", f"/v1/auth/approle/role/{ROLE_NAME}/secret-id"),
        ("POST", f"/v1/auth/approle/role/{ROLE_NAME}/secret-id-accessor/destroy"),
        ("POST", "/v1/auth/approle/login"),
        ("GET", GATEWAY_KV_PATH),
        ("POST", "/v1/auth/token/revoke-self"),
    }
    for legacy_name in LEGACY_NAMES:
        allowed_requests.add(("POST", f"/v1/sys/policies/acl/{legacy_name}"))
        allowed_requests.add(("DELETE", f"/v1/auth/approle/role/{legacy_name}"))
        allowed_requests.add(("GET", f"/v1/auth/approle/role/{legacy_name}"))
    if (method, path) not in allowed_requests:
        raise ProvisioningError("Internal OpenBao request rejected.")
    headers = {"Accept": "application/json", "User-Agent": "provision-hermes-openbao/1"}
    body = None
    if payload is not None or method == "POST":
        body = json.dumps(payload or {}, separators=(",", ":")).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if token is not None:
        headers["X-Vault-Token"] = _validated(token, _TOKEN_RE)
    request = urllib.request.Request(
        BAO_ORIGIN + path, data=body, headers=headers, method=method
    )
    try:
        with _opener().open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            if response.status not in ({200} if expect_json else {200, 204}):
                raise ProvisioningError("OpenBao rejected the operation.")
            response_body = response.read(MAX_RESPONSE_BYTES + 1)
    except urllib.error.HTTPError as exc:
        if allow_not_found and exc.code == 404:
            return None
        raise ProvisioningError("OpenBao rejected the operation.") from exc
    except (OSError, ssl.SSLError, urllib.error.URLError) as exc:
        raise ProvisioningError("The local OpenBao request failed.") from exc
    if len(response_body) > MAX_RESPONSE_BYTES:
        raise ProvisioningError("OpenBao returned an oversized response.")
    if not expect_json:
        return None
    try:
        decoded = json.loads(response_body)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise ProvisioningError("OpenBao returned invalid JSON.") from exc
    if not isinstance(decoded, dict):
        raise ProvisioningError("OpenBao returned an invalid response.")
    return decoded


def _data(document: dict[str, Any]) -> dict[str, Any]:
    value = document.get("data")
    if not isinstance(value, dict):
        raise ProvisioningError("OpenBao response data is missing.")
    return value


def _secret_field(document: dict[str, Any], field: str) -> str:
    outer = _data(document)
    inner = outer.get("data")
    if not isinstance(inner, dict):
        raise ProvisioningError("A required Hermes secret is missing.")
    return _validated(inner.get(field), _SECRET_VALUE_RE)


def _validate_root_regular(path: Path, description: str) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise ProvisioningError(f"The {description} is unavailable.") from exc
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != 0
        or stat.S_IMODE(info.st_mode) & 0o022
    ):
        raise ProvisioningError(f"The {description} has unsafe ownership or mode.")


def _normalise_policy(policy: str) -> str:
    effective_lines: list[str] = []
    for raw_line in policy.splitlines():
        # The reviewed policies contain no '#' inside quoted values.  Keeping
        # the accepted grammar this small makes any extra HCL stanza fail.
        effective = raw_line.split("#", 1)[0].strip()
        if effective:
            effective_lines.append(" ".join(effective.split()))
    return "\n".join(effective_lines)


def _validate_policy_scope(policy: str, expected: str, description: str) -> None:
    if _normalise_policy(policy) != expected:
        raise ProvisioningError(f"The {description} does not have the reviewed exact scope.")


def _read_exact_policy(path: Path, expected: str, description: str) -> str:
    _validate_root_regular(path, description)
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != 0
            or stat.S_IMODE(info.st_mode) & 0o022
        ):
            raise ProvisioningError(f"The {description} changed during validation.")
        chunks: list[bytes] = []
        remaining = MAX_POLICY_BYTES + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        if len(raw) > MAX_POLICY_BYTES:
            raise ProvisioningError(f"The {description} is oversized.")
    finally:
        os.close(descriptor)
    try:
        policy = raw.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        raise ProvisioningError(f"The {description} is not valid UTF-8.") from exc
    _validate_policy_scope(policy, expected, description)
    return policy


def _configure_runtime(human_token: str, policy: str) -> None:
    _request(
        "POST",
        f"/v1/sys/policies/acl/{POLICY_NAME}",
        payload={"policy": policy},
        token=human_token,
        expect_json=False,
    )
    _request(
        "POST",
        f"/v1/auth/approle/role/{ROLE_NAME}",
        payload={
            "token_policies": [POLICY_NAME],
            "bind_secret_id": True,
            "secret_id_bound_cidrs": ["127.0.0.1/32"],
            "token_bound_cidrs": ["127.0.0.1/32"],
            "secret_id_num_uses": 1024,
            "secret_id_ttl": "720h",
            "token_ttl": "60s",
            "token_max_ttl": "120s",
            "token_explicit_max_ttl": "120s",
            "token_num_uses": 2,
            "token_no_default_policy": True,
            "token_type": "service",
        },
        token=human_token,
        expect_json=False,
    )


def _quarantine_legacy_access(
    human_token: str, quarantine_policies: dict[str, str], *, preserve_roles: bool = False
) -> None:
    if set(quarantine_policies) != set(LEGACY_NAMES):
        raise ProvisioningError("The legacy Hermes quarantine policy set is incomplete.")
    # Policy replacement comes first: OpenBao evaluates named ACL policies for
    # existing tokens, so legacy tokens lose provider-key access before role
    # deletion is attempted.
    for legacy_name in LEGACY_NAMES:
        _request(
            "POST",
            f"/v1/sys/policies/acl/{legacy_name}",
            payload={"policy": quarantine_policies[legacy_name]},
            token=human_token,
            expect_json=False,
        )
    if preserve_roles:
        # Atlas already quarantined these roles after saving an encrypted undo.
        # Deletion here would irreversibly discard their existing SecretIDs.
        for legacy_name in LEGACY_NAMES:
            observed = _request("GET", f"/v1/auth/approle/role/{legacy_name}",
                                token=human_token, allow_not_found=True)
            if observed is None:
                continue
            data = observed.get("data")
            if not isinstance(data, dict) or data.get("token_policies") != [legacy_name] or data.get("token_no_default_policy") is not True:
                raise ProvisioningError("The retained legacy AppRole is not quarantined.")
        return
    try:
        for legacy_name in LEGACY_NAMES:
            _request(
                "DELETE",
                f"/v1/auth/approle/role/{legacy_name}",
                token=human_token,
                expect_json=False,
                allow_not_found=True,
            )
    except ProvisioningError as exc:
        raise ProvisioningError(
            "Legacy Hermes access is quarantined, but AppRole deletion failed; "
            "keep Hermes stopped and delete auth/approle/role/deepseek-client "
            "and auth/approle/role/hermes-coordinator with an approved human session."
        ) from exc
    try:
        for legacy_name in LEGACY_NAMES:
            remaining = _request(
                "GET",
                f"/v1/auth/approle/role/{legacy_name}",
                token=human_token,
                allow_not_found=True,
            )
            if remaining is not None:
                raise ProvisioningError(f"Legacy AppRole {legacy_name} still exists.")
    except ProvisioningError as exc:
        raise ProvisioningError(
            "Legacy Hermes access is quarantined, but AppRole removal could not be "
            "verified; keep Hermes stopped and delete auth/approle/role/deepseek-client "
            "and auth/approle/role/hermes-coordinator with an approved human session."
        ) from exc


def _reconcile_runtime(
    human_token: str, runtime_policy: str, quarantine_policies: dict[str, str]
) -> None:
    _quarantine_legacy_access(human_token, quarantine_policies)
    _configure_runtime(human_token, runtime_policy)
    role_document = _request(
        "GET", f"/v1/auth/approle/role/{ROLE_NAME}", token=human_token
    )
    if not isinstance(role_document, dict):
        raise ProvisioningError("The reconciled hermes-runtime AppRole is unavailable.")
    _validate_role(role_document)


def _validate_role(document: dict[str, Any]) -> None:
    role = _data(document)
    policies = role.get("token_policies")
    if policies != [POLICY_NAME]:
        raise ProvisioningError("The hermes-runtime AppRole policies are not exact.")
    exact_values = {
        "bind_secret_id": True,
        "token_no_default_policy": True,
        "secret_id_num_uses": 1024,
        "token_num_uses": 2,
        "token_period": 0,
        "token_type": "service",
    }
    for field, expected in exact_values.items():
        if role.get(field) != expected:
            raise ProvisioningError(f"The hermes-runtime AppRole field {field} is unsafe.")
    # OpenBao 2.6 keeps the explicit /32 on SecretID CIDRs but can return the
    # canonical host spelling for token CIDRs. Both exact spellings represent
    # one loopback address; every broader network remains rejected.
    for field in ("secret_id_bound_cidrs", "token_bound_cidrs"):
        if role.get(field) not in (["127.0.0.1/32"], ["127.0.0.1"]):
            raise ProvisioningError(f"The hermes-runtime AppRole field {field} is unsafe.")
    bounded_durations = {
        "secret_id_ttl": 2_592_000,
        "token_ttl": 60,
        "token_max_ttl": 120,
        "token_explicit_max_ttl": 120,
    }
    for field, expected in bounded_durations.items():
        value = role.get(field)
        if isinstance(value, bool) or not isinstance(value, int):
            raise ProvisioningError(f"The hermes-runtime AppRole field {field} is invalid.")
        if value != expected:
            raise ProvisioningError(f"The hermes-runtime AppRole field {field} is unsafe.")


def _credential_paths() -> tuple[Path, ...]:
    return tuple(CREDSTORE / name for name in CREDENTIAL_NAMES)


def _prepare_credstore() -> None:
    try:
        CREDSTORE.mkdir(mode=0o700, parents=True, exist_ok=True)
        store_stat = os.lstat(CREDSTORE)
    except OSError as exc:
        raise ProvisioningError("The encrypted credential store is unavailable.") from exc
    if (
        not stat.S_ISDIR(store_stat.st_mode)
        or store_stat.st_uid != 0
        or stat.S_IMODE(store_stat.st_mode) & 0o022
    ):
        raise ProvisioningError("The encrypted credential store has unsafe ownership or mode.")
    os.chmod(CREDSTORE, 0o700)


def _validate_existing_credential(path: Path) -> None:
    try:
        path_stat = os.lstat(path)
    except OSError as exc:
        raise ProvisioningError("An existing Hermes credential is inaccessible.") from exc
    if (
        not stat.S_ISREG(path_stat.st_mode)
        or path_stat.st_uid != 0
        or stat.S_IMODE(path_stat.st_mode) & 0o077
    ):
        raise ProvisioningError("An existing Hermes credential has unsafe ownership or mode.")


def _decrypt_accessor(path: Path) -> str:
    command = [
        "/usr/bin/systemd-creds",
        "decrypt",
        f"--name={CREDENTIAL_NAMES[2]}",
        str(path),
        "-",
    ]
    completed = subprocess.run(
        command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if completed.returncode != 0 or len(completed.stdout) > MAX_CREDENTIAL_BYTES:
        raise ProvisioningError("The previous SecretID accessor cannot be decrypted.")
    try:
        value = completed.stdout.rstrip(b"\r\n").decode("ascii", errors="strict")
    except UnicodeError as exc:
        raise ProvisioningError("The previous SecretID accessor is invalid.") from exc
    return _validated(value, _IDENTIFIER_RE)


def _encrypt_credential(name: str, value: str, output: Path) -> None:
    command = [
        "/usr/bin/systemd-creds",
        "encrypt",
        "--with-key=host+tpm2",
        f"--name={name}",
        "-",
        str(output),
    ]
    completed = subprocess.run(
        command,
        check=False,
        input=(value + "\n").encode("ascii"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if completed.returncode != 0:
        raise ProvisioningError("systemd-creds could not encrypt an AppRole credential.")
    output_stat = os.lstat(output)
    if not stat.S_ISREG(output_stat.st_mode) or output_stat.st_uid != 0:
        raise ProvisioningError("An encrypted credential has unsafe ownership.")
    os.chmod(output, 0o600)


def _remove_runtime_credentials() -> None:
    for path in _credential_paths():
        try:
            path.unlink()
        except FileNotFoundError:
            pass
    directory_fd = os.open(CREDSTORE, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _destroy_accessor(token: str, accessor: str) -> None:
    _request(
        "POST",
        f"/v1/auth/approle/role/{ROLE_NAME}/secret-id-accessor/destroy",
        payload={"secret_id_accessor": _validated(accessor, _IDENTIFIER_RE)},
        token=token,
        expect_json=False,
    )


def _test_runtime_credentials(role_id: str, secret_id: str) -> None:
    runtime_token: str | None = None
    operation_error: BaseException | None = None
    revocation_error: BaseException | None = None
    try:
        login = _request(
            "POST",
            "/v1/auth/approle/login",
            payload={
                "role_id": _validated(role_id, _IDENTIFIER_RE),
                "secret_id": _validated(secret_id, _IDENTIFIER_RE),
            },
        )
        if not isinstance(login, dict) or not isinstance(login.get("auth"), dict):
            raise ProvisioningError("The issued Hermes AppRole login failed.")
        runtime_token = _validated(login["auth"].get("client_token"), _TOKEN_RE)
        gateway = _request("GET", GATEWAY_KV_PATH, token=runtime_token)
        if not isinstance(gateway, dict):
            raise ProvisioningError("The issued Hermes AppRole cannot read its secrets.")
        _secret_field(gateway, "api_server_key")
        _secret_field(gateway, "orchestrator_api_key")
    except BaseException as exc:
        operation_error = exc
    finally:
        if runtime_token is not None:
            try:
                _request(
                    "POST",
                    "/v1/auth/token/revoke-self",
                    token=runtime_token,
                    expect_json=False,
                )
            except BaseException as exc:
                revocation_error = exc
            runtime_token = None
    if operation_error is not None or revocation_error is not None:
        raise ProvisioningError("The issued Hermes AppRole failed its read/revoke test.")


def _service_is_active() -> bool:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "--quiet", SERVICE_NAME],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return completed.returncode == 0


def provision(*, password_fd: int | None = None, preserve_legacy_roles: bool = False) -> None:
    if os.geteuid() != 0:
        raise ProvisioningError("Run this provisioner as root.")
    if _service_is_active():
        raise ProvisioningError("Stop hermes-gateway.service before rotating its AppRole.")
    if not BAO_CA.is_file() or BAO_CA.is_symlink():
        raise ProvisioningError("The pinned local OpenBao CA is unavailable.")
    runtime_policy = _read_exact_policy(
        POLICY_FILE, _EXPECTED_RUNTIME_POLICY, "installed Hermes runtime policy"
    )
    quarantine_policies = {
        legacy_name: _read_exact_policy(
            policy_file,
            _EXPECTED_QUARANTINE_POLICY,
            f"installed {legacy_name} quarantine policy",
        )
        for legacy_name, policy_file in LEGACY_POLICY_FILES.items()
    }
    _prepare_credstore()

    existing = tuple(os.path.lexists(path) for path in _credential_paths())
    if any(existing) and not all(existing):
        raise ProvisioningError("The Hermes encrypted credential set is incomplete.")
    if all(existing):
        for path in _credential_paths():
            _validate_existing_credential(path)

    if password_fd is None:
        confirmation = input(
            "This rotates the dormant Hermes AppRole. Type PROVISION-HERMES to continue: "
        )
        if confirmation != "PROVISION-HERMES":
            raise ProvisioningError("Provisioning cancelled.")
        password = getpass.getpass("OpenBao password for ops-user (never stored): ")
    else:
        password = _password_from_pipe(password_fd)
    if not password:
        raise ProvisioningError("An OpenBao password is required.")

    human_token: str | None = None
    old_accessor: str | None = None
    new_accessor: str | None = None
    rotation_begun = False
    install_begun = False
    completed_install = False
    staging_directory: Path | None = None
    operation_error: BaseException | None = None
    revocation_error: BaseException | None = None

    try:
        username = urllib.parse.quote("ops-user", safe="")
        login = _request(
            "POST", f"/v1/auth/userpass/login/{username}", payload={"password": password}
        )
        password = ""
        if not isinstance(login, dict) or not isinstance(login.get("auth"), dict):
            raise ProvisioningError("The human OpenBao login failed.")
        human_token = _validated(login["auth"].get("client_token"), _TOKEN_RE)

        # Reconcile the reviewed least-privilege policy and exact two-use role,
        # and fail closed all legacy direct-provider identities, before reading
        # gateway prerequisites or rotating any AppRole credential.
        if preserve_legacy_roles:
            _quarantine_legacy_access(human_token, quarantine_policies, preserve_roles=True)
            _configure_runtime(human_token, runtime_policy)
        else:
            _reconcile_runtime(human_token, runtime_policy, quarantine_policies)

        # Refuse to issue an AppRole SecretID until both local gateway tokens
        # exist and conform to the helper's bounded dotenv format.
        gateway = _request("GET", GATEWAY_KV_PATH, token=human_token)
        if not isinstance(gateway, dict):
            raise ProvisioningError("Required Hermes secrets are unavailable.")
        _secret_field(gateway, "api_server_key")
        _secret_field(gateway, "orchestrator_api_key")
        gateway.clear()

        if all(existing):
            old_accessor = _decrypt_accessor(_credential_paths()[2])

        role_id_document = _request(
            "GET", f"/v1/auth/approle/role/{ROLE_NAME}/role-id", token=human_token
        )
        if not isinstance(role_id_document, dict):
            raise ProvisioningError("The hermes-runtime RoleID is unavailable.")
        role_id = _validated(_data(role_id_document).get("role_id"), _IDENTIFIER_RE)

        secret_document = _request(
            "POST", f"/v1/auth/approle/role/{ROLE_NAME}/secret-id", token=human_token
        )
        if not isinstance(secret_document, dict):
            raise ProvisioningError("OpenBao did not issue a Hermes SecretID.")
        secret_data = _data(secret_document)
        secret_id = _validated(secret_data.get("secret_id"), _IDENTIFIER_RE)
        new_accessor = _validated(secret_data.get("secret_id_accessor"), _IDENTIFIER_RE)
        issued_ttl = secret_data.get("secret_id_ttl")
        if isinstance(issued_ttl, bool) or not isinstance(issued_ttl, int):
            raise ProvisioningError("OpenBao returned an invalid SecretID TTL.")
        if not 1 <= issued_ttl <= 2_592_000:
            raise ProvisioningError("OpenBao returned an unsafe SecretID TTL.")

        _test_runtime_credentials(role_id, secret_id)

        staging_directory = Path(
            tempfile.mkdtemp(prefix=".hermes-openbao-", dir=CREDSTORE)
        )
        os.chmod(staging_directory, 0o700)
        staged_values = (role_id, secret_id, new_accessor)
        for name, value in zip(CREDENTIAL_NAMES, staged_values, strict=True):
            _encrypt_credential(name, value, staging_directory / name)
        staged_values = ("", "", "")
        secret_data.clear()
        secret_document.clear()
        role_id_document.clear()
        role_id = secret_id = ""

        if old_accessor is not None:
            rotation_begun = True
            _destroy_accessor(human_token, old_accessor)
            old_accessor = None

        install_begun = True
        for name in CREDENTIAL_NAMES:
            os.replace(staging_directory / name, CREDSTORE / name)
        restorecon = Path("/usr/sbin/restorecon")
        if restorecon.is_file():
            relabel = subprocess.run(
                [str(restorecon), "-F", *[str(path) for path in _credential_paths()]],
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if relabel.returncode != 0:
                raise ProvisioningError("SELinux credential relabeling failed.")
        directory_fd = os.open(CREDSTORE, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        completed_install = True
    except BaseException as exc:
        operation_error = exc
        if install_begun or rotation_begun:
            try:
                _remove_runtime_credentials()
            except BaseException:
                pass
        if human_token is not None and new_accessor is not None:
            try:
                _destroy_accessor(human_token, new_accessor)
            except BaseException:
                pass
    finally:
        password = ""
        old_accessor = None
        if human_token is not None:
            try:
                _request(
                    "POST",
                    "/v1/auth/token/revoke-self",
                    token=human_token,
                    expect_json=False,
                )
            except BaseException as exc:
                revocation_error = exc
                if completed_install and new_accessor is not None:
                    try:
                        _destroy_accessor(human_token, new_accessor)
                    except BaseException:
                        pass
            human_token = None
        new_accessor = None
        if staging_directory is not None:
            shutil.rmtree(staging_directory, ignore_errors=True)

    if revocation_error is not None and completed_install:
        # Do not leave a locally usable runtime credential set when the
        # privileged provisioning session could not be confirmed revoked.
        try:
            _remove_runtime_credentials()
        except BaseException:
            pass
        completed_install = False
    if operation_error is not None:
        if isinstance(operation_error, (EOFError, KeyboardInterrupt)):
            raise operation_error
        if isinstance(operation_error, ProvisioningError):
            raise operation_error
        raise ProvisioningError("Hermes AppRole provisioning failed.") from operation_error
    if revocation_error is not None:
        raise ProvisioningError(
            "The provisioning token revocation could not be confirmed; local credentials were removed."
        )
    if not completed_install:
        raise ProvisioningError("Hermes AppRole provisioning did not complete.")


def main() -> int:
    args = _parse_args()
    try:
        provision(password_fd=args.password_fd, preserve_legacy_roles=args.preserve_legacy_roles)
    except (EOFError, KeyboardInterrupt):
        print("provision-hermes-openbao: cancelled", file=sys.stderr)
        return 130
    except ProvisioningError as exc:
        print(f"provision-hermes-openbao: {exc}", file=sys.stderr)
        return 1
    print("Hermes AppRole credentials were encrypted for host+TPM2; no value was displayed.")
    print("hermes-gateway.service remains disabled and was not started.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
