#!/usr/bin/python3
"""Resolve the narrowly scoped Hermes runtime secrets from local OpenBao.

The program is intentionally usable only from hermes-gateway.service.  It
keeps the AppRole material and the short-lived OpenBao token in process
memory, performs no redirect or proxy request, revokes the token, and only
then writes the validated dotenv payload to stdout.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import ssl
import stat
import sys
from typing import Any, Callable
import urllib.error
import urllib.request


BAO_ORIGIN = "https://127.0.0.1:8200"
BAO_CA = "/etc/openbao.d/tls/ca.crt"
CREDENTIALS_DIRECTORY = Path("/run/credentials/hermes-gateway.service")
ROLE_ID_CREDENTIAL = "hermes-openbao-role-id"
SECRET_ID_CREDENTIAL = "hermes-openbao-secret-id"
MAX_CREDENTIAL_BYTES = 256
MAX_RESPONSE_BYTES = 32 * 1024
# Three loopback requests are needed for every profile.  Keep the sum
# below Hermes' three-second command-helper deadline even when OpenBao stalls.
HTTP_TIMEOUT_SECONDS = 0.5

ALLOWED_PROFILES = frozenset(
    {
        "default",
        "minecraft-ops",
        "infra-shared",
        "network-shared",
        "monitoring-shared",
        "backup-shared",
        "deploy-ops",
        "security-ops",
    }
)

_IDENTIFIER_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{15,127}\Z")
_TOKEN_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._~-]{15,511}\Z")
_DOTENV_VALUE_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._~+/=-]{15,511}\Z")


class SecretResolutionError(RuntimeError):
    """A deliberately message-free failure visible to the CLI boundary."""


class _RejectRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(  # type: ignore[override]
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> None:
        raise SecretResolutionError


def _validated_ascii(
    value: Any, pattern: re.Pattern[str] = _DOTENV_VALUE_RE
) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise SecretResolutionError
    return value


def _load_credential(name: str) -> str:
    supplied_directory = os.environ.get("CREDENTIALS_DIRECTORY", "")
    if supplied_directory != str(CREDENTIALS_DIRECTORY):
        raise SecretResolutionError

    path = CREDENTIALS_DIRECTORY / name
    try:
        path_stat = os.lstat(path)
        if not stat.S_ISREG(path_stat.st_mode):
            raise SecretResolutionError
        if path_stat.st_uid not in {0, os.geteuid()}:
            raise SecretResolutionError
        mode = stat.S_IMODE(path_stat.st_mode)
        # systemd credentials are immutable to the service and normally 0400.
        # Some Fedora/systemd combinations expose a service-group-readable
        # 0440 file. Accept that exact read-only variant only when its group is
        # one of this process' groups; reject every write/execute/world bit.
        if (
            not mode & stat.S_IRUSR
            or mode & 0o333
            or mode & 0o007
            or mode & 0o070 not in {0, stat.S_IRGRP}
            or (
                mode & stat.S_IRGRP
                and path_stat.st_gid not in {os.getegid(), *os.getgroups()}
            )
        ):
            raise SecretResolutionError
        if not 1 <= path_stat.st_size <= MAX_CREDENTIAL_BYTES:
            raise SecretResolutionError

        flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
        descriptor = os.open(path, flags)
        try:
            opened_stat = os.fstat(descriptor)
            if (
                opened_stat.st_dev != path_stat.st_dev
                or opened_stat.st_ino != path_stat.st_ino
                or not stat.S_ISREG(opened_stat.st_mode)
            ):
                raise SecretResolutionError
            raw_value = os.read(descriptor, MAX_CREDENTIAL_BYTES + 1)
            if len(raw_value) > MAX_CREDENTIAL_BYTES or os.read(descriptor, 1):
                raise SecretResolutionError
        finally:
            os.close(descriptor)
    except (OSError, ValueError) as exc:
        raise SecretResolutionError from exc

    try:
        value = raw_value.rstrip(b"\r\n").decode("ascii", errors="strict")
    except UnicodeError as exc:
        raise SecretResolutionError from exc
    return _validated_ascii(value, _IDENTIFIER_RE)


def _opener() -> urllib.request.OpenerDirector:
    context = ssl.create_default_context(cafile=BAO_CA)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    return urllib.request.build_opener(
        urllib.request.ProxyHandler({}),
        _RejectRedirects(),
        urllib.request.HTTPSHandler(context=context),
    )


def _request(
    method: str,
    path: str,
    *,
    payload: dict[str, Any] | None = None,
    token: str | None = None,
    expect_json: bool = True,
) -> dict[str, Any] | None:
    if method not in {"GET", "POST"} or not path.startswith("/v1/"):
        raise SecretResolutionError

    body = None
    headers = {"Accept": "application/json", "User-Agent": "hermes-secrets-env/1"}
    if payload is not None or method == "POST":
        body = json.dumps(payload or {}, separators=(",", ":")).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if token is not None:
        headers["X-Vault-Token"] = _validated_ascii(token, _TOKEN_RE)

    request = urllib.request.Request(
        BAO_ORIGIN + path, data=body, headers=headers, method=method
    )
    try:
        with _opener().open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            if response.status not in ({200} if expect_json else {200, 204}):
                raise SecretResolutionError
            response_body = response.read(MAX_RESPONSE_BYTES + 1)
    except (OSError, ssl.SSLError, urllib.error.URLError) as exc:
        raise SecretResolutionError from exc

    if len(response_body) > MAX_RESPONSE_BYTES:
        raise SecretResolutionError
    if not expect_json:
        return None
    try:
        decoded = json.loads(response_body)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise SecretResolutionError from exc
    if not isinstance(decoded, dict):
        raise SecretResolutionError
    return decoded


def _nested_string(document: dict[str, Any], *keys: str) -> str:
    value: Any = document
    for key in keys:
        if not isinstance(value, dict) or key not in value:
            raise SecretResolutionError
        value = value[key]
    return _validated_ascii(value)


RequestCallable = Callable[..., dict[str, Any] | None]
CredentialCallable = Callable[[str], str]


def resolve_secrets(
    profile: str,
    *,
    credential_loader: CredentialCallable | None = None,
    request_callable: RequestCallable | None = None,
) -> dict[str, str]:
    if profile not in ALLOWED_PROFILES:
        raise SecretResolutionError
    load = credential_loader or _load_credential
    request = request_callable or _request

    role_id = _validated_ascii(load(ROLE_ID_CREDENTIAL), _IDENTIFIER_RE)
    secret_id = _validated_ascii(load(SECRET_ID_CREDENTIAL), _IDENTIFIER_RE)
    client_token: str | None = None
    resolution_error: BaseException | None = None
    revocation_error: BaseException | None = None
    result: dict[str, str] = {}

    try:
        login = request(
            "POST",
            "/v1/auth/approle/login",
            payload={"role_id": role_id, "secret_id": secret_id},
        )
        if not isinstance(login, dict):
            raise SecretResolutionError
        auth = login.get("auth")
        if not isinstance(auth, dict):
            raise SecretResolutionError
        client_token = _validated_ascii(auth.get("client_token"), _TOKEN_RE)

        gateway = request(
            "GET",
            "/v1/kv-infra-shared/data/hermes/gateway",
            token=client_token,
        )
        if not isinstance(gateway, dict):
            raise SecretResolutionError
        result["HERMES_FACADE_TOKEN"] = _nested_string(
            gateway, "data", "data", "orchestrator_api_key"
        )
        if profile == "default":
            result["API_SERVER_KEY"] = _nested_string(
                gateway, "data", "data", "api_server_key"
            )
    except BaseException as exc:  # Revocation must run for every post-login failure.
        resolution_error = exc
    finally:
        if client_token is not None:
            try:
                request(
                    "POST",
                    "/v1/auth/token/revoke-self",
                    token=client_token,
                    expect_json=False,
                )
            except BaseException as exc:
                revocation_error = exc
            client_token = None
        role_id = ""
        secret_id = ""

    if resolution_error is not None or revocation_error is not None:
        result.clear()
        raise SecretResolutionError
    return result


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("hermes-secrets-env: one profile argument is required", file=sys.stderr)
        return 64
    try:
        values = resolve_secrets(argv[1])
    except BaseException:
        print("hermes-secrets-env: secret resolution failed", file=sys.stderr)
        return 1

    # Values are constrained to a single dotenv-safe ASCII token.  Nothing is
    # emitted until both the reads and token revocation have succeeded.
    for key in ("HERMES_FACADE_TOKEN", "API_SERVER_KEY"):
        if key in values:
            print(f"{key}={values[key]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
