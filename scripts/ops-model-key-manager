#!/usr/bin/python3 -I
"""Rotate one allowlisted model-provider key without exposing it to the WebView.

The installed copy is intentionally a root-owned program executed as ``ops-user``.
It receives only the fixed ``set`` or ``set-stdin`` action and a
provider-account identifier. ``set`` retains the native ask-password flow;
``set-stdin`` accepts one strict binary frame over a private anonymous pipe for
the Tauri UI. Credentials remain out of argv, environment, logs, and files.
After OpenBao confirms the write and token revocation, a single root-owned
no-argument helper refreshes local consumers; it receives no provider identity
or secret.
"""

from __future__ import annotations

import ctypes
import fcntl
import hmac
import json
import os
from pathlib import Path
import pwd
import resource
import select
import ssl
import stat
import subprocess
import sys
import time
from types import MappingProxyType
from typing import Any
import unicodedata
import urllib.error
import urllib.request


EXPECTED_USER = "ops-user"
INSTALLED_PROGRAM = Path("/usr/local/libexec/ops-model-key-manager")
RELOAD_PROGRAM = Path("/usr/local/libexec/ops-model-credentials-reload")
SUDO_PROGRAM = "/usr/bin/sudo"
ASK_PASSWORD_PROGRAM = "/usr/bin/systemd-ask-password"
BAO_ORIGIN = "https://127.0.0.1:8200"
BAO_CA = Path("/etc/openbao.d/tls/ca.crt")
LOGIN_PATH = "/v1/auth/userpass/login/ops-user"
REVOKE_PATH = "/v1/auth/token/revoke-self"
HTTP_TIMEOUT_SECONDS = 4.0
PROMPT_TIMEOUT_SECONDS = 180
MAX_RESPONSE_BYTES = 32 * 1024
MAX_PASSWORD_BYTES = 400
MAX_API_KEY_BYTES = 4096
MAX_TOKEN_LENGTH = 2048
PR_SET_DUMPABLE = 4
STDIN_MAGIC = b"ATLASKEY1\n"
STDIN_TIMEOUT_SECONDS = 60.0


# This is deliberately duplicated rather than derived from user input or from
# a mutable catalogue.  Adding a catalogue card must never grant a credential
# write path implicitly.
PROVIDER_TARGETS = MappingProxyType(
